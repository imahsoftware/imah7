<% if @active_record.present? %>
	$("#variable_<%= @active_record.id %>").replaceWith("<%= j render 'tr', variable: @active_record %>");
<% end %>
$("#variable_form").html("<%= j render 'form' %>");
$(".datetimepicker").datetimepicker();
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
$("#variable_form").collapse("show");
$(".select2").select2();