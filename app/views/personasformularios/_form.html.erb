<div class="box box-danger">
  <div class="box-header">
    <legend>
      <%= link_to index_convocatorias_migraciones_path, data: { toggle: 'tooltip' }, title: 'Regresar' do %>
        <i class="fa fa-arrow-left fa-fw text-success" aria-hidden="true"></i>
      <% end %>
      Información del Candidato -
      <small style="font-size: 14px"><%= @personasformulario.autobuscar rescue nil %> -
        <b>Estado:</b> <%= @personasformulario.estado_formulario.html_safe rescue nil %> </small>
      <div class="pull-right">
        <%= link_to desbloqueo_personasformularios_path(id: @personasformulario.id), data: {toggle: 'tooltip', confirm: '¿Esta seguro?'}, title: 'Desbloquear' do %>
          <button class="btn btn-xs btn-danger"><i class="fa fa-unlock"></i></button>
        <% end %>
        <% if @personasformulario.estado == 'COMPLETADO' %>
          <% if @personasformulario.valida_total_campos && @personasformulario.valida_total_documentos && @personasformulario.valida_encuesta %>
            <%= link_to envio_formulario_personasformularios_path(id: @personasformulario, estado: 'APROBADO'), remote: true, data: { toggle: 'tooltip' }, title: "Aprobar" do %>
              <button class="btn btn-xs btn-primary"><i class="fa fa-check"></i> Aprobar</button>
            <% end %>
          <% end %>
          <%= link_to envio_formulario_personasformularios_path(id: @personasformulario, estado: 'DEVUELTO'), remote: true, data: { toggle: 'tooltip' }, title: "Devuelto" do %>
            <button class="btn btn-xs btn-warning"><i class="fa fa-sign-out"></i> Devolver</button>
          <% end %>
          <%= link_to envio_formulario_personasformularios_path(id: @personasformulario, estado: 'RECHAZADO'), remote: true, data: { toggle: 'tooltip' }, title: "Rechazar" do %>
            <button class="btn btn-xs btn-danger"><i class="fa fa-close"></i> Rechazar</button>
          <% end %>
        <% end %>
        <% if ['RECHAZADO', 'DESISTE','SINCONTACTO'].exclude?(@personasformulario.estado) %>
          <%= link_to envio_formulario_personasformularios_path(id: @personasformulario, estado: 'DESISTE'), remote: true, data: { toggle: 'tooltip' }, title: "Desiste" do %>
            <button class="btn btn-xs btn-primary"><i class="fa fa-check"></i> Desiste</button>
          <% end %>
          <%= link_to envio_formulario_personasformularios_path(id: @personasformulario, estado: 'RECHAZADO'), remote: true, data: { toggle: 'tooltip' }, title: "Rechazar" do %>
            <button class="btn btn-xs btn-danger"><i class="fa fa-close"></i> Rechazar</button>
          <% end %>
          <%= link_to envio_formulario_personasformularios_path(id: @personasformulario, estado: 'SINCONTACTO'), remote: true, data: { toggle: 'tooltip' }, title: "Sin Contacto" do %>
            <button class="btn btn-xs btn-info"><i class="fa fa-close"></i> Sin Contacto</button>
          <% end %>
        <% end %>
        <% if ['DESISTE','RECHAZADO','SINCONTACTO'].include?(@personasformulario.estado) %>
          <%= link_to envio_formulario_personasformularios_path(id: @personasformulario, estado: 'PENDIENTE'), remote: true, data: { toggle: 'tooltip' }, title: "Activar nuevamente" do %>
            <button class="btn btn-xs btn-primary"><i class="fa fa-check"></i> Activar</button>
          <% end %>
        <% end %>
        <% if ['APROBADO'].include?(@personasformulario.estado) %>
          <%= link_to envio_formulario_personasformularios_path(id: @personasformulario, estado: 'DEVUELTO'), remote: true, data: { toggle: 'tooltip' }, title: "Devuelto" do %>
            <button class="btn btn-xs btn-warning"><i class="fa fa-sign-out"></i> Devolver</button>
          <% end %>
        <% end %>
        <% if @personasformulario.estado.to_s == 'PENDIENTE' and @personasformulario.valida_total_campos and @personasformulario.valida_total_documentos %>
          <%= link_to envio_formulario_personasformularios_path(id: @personasformulario, estado: 'COMPLETADO'), remote: true, data: { toggle: 'tooltip' }, title: "Completar" do %>
            <button class="btn btn-xs btn-primary"><i class="fa fa-check"></i> Completar</button>
          <% end %>
        <% end %>
      </div>
    </legend>
  </div>
  <div class="box-body">
    <div class="row">
      <div class="col-xs-12">
        <div class="nav-tabs-custom">
          <ul class="nav nav-tabs">
            <li class="<%= @etapa == "1" ? 'active' : nil %>"> <%= link_to edit_personasformulario_path(etapa: '1', id: @personasformulario.id) do %>
                <i class="fa fa-user"></i> Información
              <% end %></li>
            <li class="<%= @etapa == "6" ? 'active' : nil %>"> <%= link_to edit_personasformulario_path(etapa: '6', id: @personasformulario.id) do %>
                <i class="fa fa-odnoklassniki-square"></i> Información Complementaria
              <% end %></li>
            <li class="<%= @etapa == "2" ? 'active' : nil %>"> <%= link_to edit_personasformulario_path(etapa: '2', id: @personasformulario.id) do %>
                <i class="fa fa-image"></i> Documentos Digitales
              <% end %></li>
            <li class="<%= @etapa == "3" ? 'active' : nil %>"> <%= link_to edit_personasformulario_path(etapa: '3', id: @personasformulario.id) do %>
                <i class="fa fa-heartbeat"></i> Programación Examenes
              <% end %></li>
            <li class="<%= @etapa == "4" ? 'active' : nil %>"> <%= link_to edit_personasformulario_path(etapa: '4', id: @personasformulario.id) do %>
                <i class="fa fa-send"></i> Seguimiento Notificaciones
              <% end %></li>
            <% if @personasformulario.parcargo.encuesta_id.present? %>
              <li class="<%= @etapa == "5" ? 'active' : nil %>"> <%= link_to edit_personasformulario_path(etapa: '5', id: @personasformulario.id) do %>
                  <i class="fa fa-file-word-o"></i> Encuesta Ofimatica
                <% end %></li>
            <% end %>
          </ul>
          <div class="tab-content">
            <% if @etapa == "1" %>
              <%= simple_form_for @personasformulario do |f| %>
                <% @validaC = true %>
                <% @validaP = true %>
                <% @validaS = true %>
                <% @validaZ = true %>
                <% if @personasformulario.genero == "MASCULINO" %>
                  <% @validaC = true %>
                  <% @validaP = false %>
                  <% @validaS = false %>
                  <% @validaZ = false %>
                <% elsif @personasformulario.genero == "FEMENINO" %>
                  <% @validaC = false %>
                  <% @validaP = true %>
                  <% @validaS = true %>
                  <% @validaZ = false %>
                <% end %>

                <div class="row">
                  <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :tipo_identificacion, collection: Iparametro.where(campo: 'tipo_identificacion').order(:descripcion).collect { |p| [p.descripcion, p.descripcion] }, input_html: { class: 'select2' }, as: :select, include_blank: true %></div>
                  <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :identificacion, id: "ide", input_html: { onkeypress: "return justNumbers(event);", maxlength: 15 } %></div>
                  <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :fecha_expedicion, as: :string, input_html: { class: 'datepicker', data: { date_options: { format: 'DD/MM/YYYY', ignoreReadonly: true } }, readonly: true } %></div>
                  <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5"><%= f.input :municipio_lugar_expedicion, collection: Municipio.where("iddian_alegra is not null").order(:autobuscar).collect { |p| [p.autobuscar, p.id] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: "Lugar expedición" %></div>
                </div>
                <div class="row">
                  <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :nombre, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" } %></div>
                  <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :primer_apellido, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Primer apellido" %></div>
                  <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :segundo_apellido, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Segundo apellido" %></div>
                  <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :genero, collection: Iparametro.where(campo: 'genero').order(:descripcion).collect { |p| [p.descripcion, p.descripcion] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: "Genero" %></div>
                  <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :fecha_nacimiento, as: :string, input_html: { class: 'datepicker', data: { date_options: { format: 'DD/MM/YYYY', ignoreReadonly: true } }, readonly: true } %></div>
                </div>
                <div class="row">
                  <div class="col-xs-12 col-sm-12 col-md-1 col-lg-1"><%= f.input :tipo_sangre, as: :select, collection: select_tipo_sangre, input_html: { data: { width: '100%' }, class: 'select2' }, label: "RH" %></div>
                  <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :municipio_lugar_nacimiento, collection: Municipio.where("iddian_alegra is not null").order(:autobuscar).collect { |p| [p.autobuscar, p.id] }, input_html: { class: 'select2' }, as: :select, include_blank: true %></div>
                  <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5"><%= f.input :direccion, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" } %></div>
                  <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :municipio_ciudad, collection: Municipio.where("iddian_alegra is not null").order(:autobuscar).collect { |p| [p.autobuscar, p.id] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: "Ciudad de la dirección" %></div>
                </div>
                <div class="row">
                  <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :telefono, as: :integer %></div>
                  <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3">
                    <div class="input-group">
                      <div class="input-group-btn" style="top: 11px;">
                        <%= link_to reenviar_sms_personasformularios_path(id: @personasformulario), remote: true, data: { toggle: 'tooltip', style: "top: 11px;" }, title: "Reenviar SMS de Acceso" do %>
                          <button type="button" class="btn btn-danger"><i class="fa fa-phone"></i></button>
                        <% end %>
                      </div>
                      <%= f.input :celular, as: :integer %>
                    </div>
                  </div>
                  <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3">
                    <div class="input-group">
                      <div class="input-group-btn" style="top: 11px;">
                        <%= link_to reenviar_sms2_personasformularios_path(id: @personasformulario), remote: true, data: { toggle: 'tooltip', style: "top: 11px;" }, title: "Reenviar SMS de Acceso" do %>
                          <button type="button" class="btn btn-danger"><i class="fa fa-phone"></i></button>
                        <% end %>
                      </div>
                      <%= f.input :celular2, as: :integer %>
                    </div>
                  </div>
                  <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                    <div class="input-group">
                      <div class="input-group-btn" style="top: 11px;">
                        <%= link_to reenviar_correo_personasformularios_path(id: @personasformulario), remote: true, data: { toggle: 'tooltip', style: "top: 11px;" }, title: "Reenviar Correo de Acceso" do %>
                          <button type="button" class="btn btn-danger"><i class="fa fa-send"></i></button>
                        <% end %>
                      </div>
                      <%= f.input :correo, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();", class: "form-control" } %>
                    </div>
                  </div>
                </div>
                <div class="row">
                  <div class="col-xs-12 col-sm-12 col-md-1 col-lg-1"><%= f.input :estrato, collection: Iparametro.where(campo: 'estrato').order(:descripcion).collect { |p| [p.descripcion.to_s, p.descripcion.to_s] }, input_html: { class: 'select2' }, as: :select, include_blank: true %></div>
                  <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :estado_civil, collection: Iparametro.where(campo: 'estado_civil').order(:descripcion).collect { |p| [p.descripcion.to_s, p.descripcion.to_s] }, input_html: { class: 'select2' }, as: :select, include_blank: true %></div>
                  <div class="col-xs-12 col-sm-12 col-md-4 col-lg-3"><%= f.input :nivel_educacion, collection: Iparametro.where(campo: 'nivel_educacion').order(:descripcion).collect { |p| [p.descripcion.to_s, p.descripcion.to_s] }, input_html: { class: 'select2' }, as: :select, include_blank: true %></div>
                  <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :nro_hijos, as: :integer %></div>
                  <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4"><%= f.input :eps, collection: Iparametro.where("campo = 'eps' and codigo_aportes is not null").order(:descripcion).collect { |p| [p.descripcion.to_s, p.descripcion.to_s] }, input_html: { class: 'select2' }, as: :select, include_blank: true %></div>
                </div>
                <div class="row">
                  <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :fondo_pension, collection: Iparametro.where("campo = 'fondo_pension' and codigo_aportes is not null").order(:descripcion).collect { |p| [p.descripcion.to_s, p.descripcion.to_s] }, input_html: { class: 'select2' }, as: :select, include_blank: true %></div>
                  <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :personas_acargo, as: :integer, label: "Nro Personas a Cargo?" %></div>
                  <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5"><%= f.input :contacto_nombre, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Contacto en caso de emergencia" %></div>
                  <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :contacto_telefono, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Teléfono contacto" %></div>
                </div>
                <div class="row">
                  <div class="col-xs-12 col-sm-12 col-md-2 col-lg-3 text-red"><%= f.input :victimas, as: :select, collection: select_sino, input_html: { data: { width: '100%' }, class: 'select2' }, label: "Es victima de conflicto armado?" %></div>
                  <div class="col-xs-12 col-sm-12 col-md-2 col-lg-4 text-red"><%= f.input :retirado_pension, as: :select, collection: select_sino, input_html: { data: { width: '100%' }, class: 'select2' }, label: "Usted ha retirado los aportes del fondo de pensiones?" %></div>
                  <div class="col-xs-12 col-sm-12 col-md-2 col-lg-4 text-red"><%= f.input :regimen_excepcion, as: :select, collection: select_sino, input_html: { data: { width: '100%' }, class: 'select2' }, label: "Pertenece a un regimen de excepción?" %></div>
                </div>
                <div class="box-header">
                  <legend>Dotación</legend>
                </div>
                <div class="row">
                  <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :talla_conjunto, as: :select, collection: select_talla_conjunto, input_html: { data: { width: '100%' }, class: 'select2' }, label: "Talla Conjunto", disabled: @validaC %></div>
                  <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :talla_pantalon, as: :select, collection: select_talla_pantalon, input_html: { data: { width: '100%' }, class: 'select2' }, label: "Talla Pantalon", disabled: @validaP %></div>
                  <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :talla_camisa, as: :select, collection: select_talla_camiseta, input_html: { data: { width: '100%' }, class: 'select2' }, label: "Talla Camisa", disabled: @validaS %></div>
                  <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :talla_zapatos, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Talla Zapatos", disabled: @validaZ %></div>
                </div>
                <div class="box-header">
                  <legend>Anexo perfil sociodemografico</legend>
                </div>
                <div class="box-body">
                  <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :orientacion_sexual, as: :select, collection: select_orientacion_sexual, input_html: { data: { width: '100%' }, class: 'select2' }, label: "Orientación sexual" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :tipo_religion, as: :select, collection: select_tipo_religion, input_html: { data: { width: '100%' }, class: 'select2' }, label: "Tipo de religión" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-4"><%= f.input :tipo_etnia, as: :select, collection: select_tipo_etnia, input_html: { data: { width: '100%' }, class: 'select2' }, label: "Tipo de etnia" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :madre_cabeza, as: :select, collection: select_sino, input_html: { data: { width: '100%' }, class: 'select2' }, label: "Madre o padre cabeza de hogar" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :tipo_vivienda, as: :select, collection: select_tipo_vivienda, input_html: { data: { width: '100%' }, class: 'select2' }, label: "Tipo de vivienda" %></div>
                  </div>
                </div>
                <div class="box-header" style="padding: 0px;">
                  <legend>Información Cargo</legend>
                </div>
                <div class="row">
                  <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :municipio_id, collection: Municipio.where("iddian_alegra is not null").order(:autobuscar).collect { |p| [p.autobuscar, p.id] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: "Municipio" %></div>
                  <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :colegio, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Colegio" %></div>
                  <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :parcargo_id, collection: Parcargo.where("estado = 'ACTIVO'").order(:descripcion).collect { |p| [p.descripcion, p.id] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: 'Cargo' %></div>
                </div>
                <div class="row">
                  <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6"><%= f.input :contrato_id, collection: select_contratos.collect { |p| [p.datos.to_s, p.id] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: 'Contrato' %></div>
                  <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6"><%= f.input :recomendado_por, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Recomendado Por" %></div>
                </div>
                <div class="row">
                  <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6"><%= f.input :observacion_interna, as: :text, :input_html => { :onchange => "javascript:this.value=this.value.toUpperCase();", :rows => 2 }, label: "Observación Interna" %></div>
                  <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6"><%= f.input :user_asignado, collection: User.where(["tipoconsulta = 'SUPERVISOR'"]).order(:nombre).collect { |p| [p.nombrecompleto, p.id] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: "Usuario - Supervisor" %></div>
                </div>
                <% if ['CONTRATACION'].include?(@personasformulario.estado) %>
                <div class="row">
                  <div class="col-xs-12 col-sm-12 col-md-6 col-lg-10"><%= f.input :contratosperfecha_id, collection: Contratosperfecha.where(["contratospersona_id = (select id from contratospersonas where identificacion = '#{@personasformulario.identificacion}' limit 1)"]).order(:id).collect { |p| [p.nombrelista, p.id] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: "Contrato Asociado" %></div>
                </div>
                <% end %>
                <% if ['RECHAZADO', 'DESISTE'].exclude?(@personasformulario.estado) %>
                  <div class="box-footer">
                    <div class="box-tools pull-right">
                      <%= f.button :submit, "Guardar y Continuar", class: "btn btn-danger pull-right" %>
                    </div><!-- /.box-tools -->
                  </div>
                <% end %>
              <% end %>
            <% end %>
            <% if @etapa == "2" %>
              <% unless @personasformulario.new_record? %>
                <%= render 'personasformulariosdocs/personasformulariosdocs' %>
              <% else %>
                <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4> El cargo no ha sido registrado !!!!
                </div>
              <% end %>
            <% end %>
            <% if @etapa == "3" %>
              <%= render "personasformulariosexamenes/personasformulariosexamenes" %>
            <% end %>
            <% if @etapa == "4" %>
              <%= render "personasformulariosmensajes/personasformulariosmensajes" %>
            <% end %>
            <% if @etapa == "5"
                 # Para los casos en los que no hay encuesta, el sistema la crea automaticamente
                 if Personasforencuesta.where("personasformulario_id = #{@personasformulario.id}").present? == false
                    ActiveRecord::Base.connection.execute("call prc_personasforencuesta")
                 end
              %>
              <%= render "personasformularios/encuestas" %>
            <% end %>
            <% if @etapa == "6" %>
              <%= simple_form_for @personasformulario do |f| %>
                <div class="box-header">
                  <legend>Información Familiar</legend>
                </div>
                <div class="box-body">
                  <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :nombre_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 100 }, label: "Nombre esposa(o) o compañera(o)" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :ocupacion_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 255 }, label: "Profesión, ocupación u oficio" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :empresa_trabaja_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 255 }, label: "Empresa donde trabaja" %></div>
                  </div>
                  <div class="row">
