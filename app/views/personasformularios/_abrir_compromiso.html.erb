<div class="modal-header">
  <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
  <h4 class="modal-title"><%= @parcargosdoc.descripcion rescue nil %></h4>
</div>

<div class="modal-body">
  <div class="row">
    <div class="col-md-12">
      <%= simple_form_for(@compromiso, remote: true) do |f| %>
        <%= hidden_field_tag :parcargosdoc_id, params[:parcargosdoc_id], value: @parcargosdoc.id %>
        <%= hidden_field_tag :personasformulario_id, params[:personasformulario_id], value: @personasformulario.id %>
        <div class="bs-callout">
          <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
              <%= f.input :fecha_entrega, as: :string, input_html: { class: 'datepicker', data: { date_options: { format: 'DD/MM/YYYY', ignoreReadonly: true } }, readonly: true } %></div>
            <div class="col-xs-12 col-sm-12 col-md-10 col-lg-10">
              <%= f.input :observacion, as: :text, :input_html => { :onchange => "javascript:this.value=this.value.toUpperCase();", :rows => 3 } %>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6"></div>
            <div class="col-md-6"><% if @compromiso.fecha_entrega.to_s == "" or is_auth_a('cambiofechacompromiso') %>
                    <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
                <% end %>
            </div>
          </div>
        </div>
      <% end %>
      <br/>
    </div>
  </div>
</div>