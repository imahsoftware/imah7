                              <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :exp_contrato_otro3, as: :select, collection: select_sino, input_html: { data: { width: '100%' }, class: 'select2' }, label: "Otro?" %></div>
                              <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :exp_contrato_cual3, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Cual?" %></div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="box-header">
                  <legend>Referencias personales</legend>
                </div>
                <div class="row">
                  <table class="table table-bordered table-condensed table-striped">
                    <tr class="thcolor">
                      <th colspan="4" class=" text-table text-center">Relacione dos nombres de personas distintas a familiares o empleadores
                      </th>
                    </tr>
                    <tr>
                      <th width="30%" class=" text-table">
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :ref_nombre1, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 100 }, label:"Nombre" %></div>
                      </th>
                      <th width="25%" class="text-left text-table">
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :ref_ocupacion1, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 60 }, label:"Ocupación" %></div>
                      </th>
                      <th width="25%" class="text-left text-table">
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :ref_direccion1, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 60 }, label:"Dirección" %></div>
                      </th>
                      <th width="20%" class="text-left text-table">
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :ref_telefono1, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 20 }, label:"Teléfono" %></div>
                      </th>
                    </tr>
                    <tr>
                      <th width="30%" class=" text-table">
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :ref_nombre2, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 60 }, label:"Nombre" %></div>
                      </th>
                      <th width="25%" class="text-left text-table">
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :ref_ocupacion2, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 60 }, label:"Ocupación" %></div>
                      </th>
                      <th width="25%" class="text-left text-table">
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :ref_direccion2, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 100 }, label:"Dirección" %></div>
                      </th>
                      <th width="20%" class="text-left text-table">
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :ref_telefono2, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 20 }, label:"Teléfono" %></div>
                      </th>
                    </tr>
                    <tr class="thcolor">
                      <th colspan="4" class=" text-table text-center">Nombre de un familiar que podemos contactar en
                        caso de no localizarlo a usted directamente
                      </th>
                    </tr>
                    <tr>
                      <th width="30%" class=" text-table">
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :ref_nombre3, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 60 }, label:"Nombre" %></div>
                      </th>
                      <th width="25%" class="text-left text-table">
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :ref_ocupacion3, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 60 }, label:"Ocupación" %></div>
                      </th>
                      <th width="25%" class="text-left text-table">
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :ref_direccion3, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 100 }, label:"Dirección" %></div>
                      </th>
                      <th width="20%" class="text-left text-table">
                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :ref_telefono3, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 20 }, label:"Teléfono" %></div>
                      </th>
                    </tr>
                  </table>
                </div>


                <div class="box-header">
                  <h4 class="box-title"><i class="fa fa-user-secret"></i> Información de Tratamientos de Datos</h4>
                  <hr>
                </div>

                <div class="row" style="margin-top: -15px;">
                  <% if @personasformulario.tratamiento_datos == "SI" %>
                    <div class="col-md-2">
                      <div style='color: white; background-color: red; border-color: red; height: 30px;padding: 5px;border-radius: 10px;'>
                        <i class='fa fa-check'></i> Tratamiendo de datos Aceptado
                      </div>
                    </div>
                  <% else %>
                    <div class="col-md-2">
                      <%= f.input :tratamiento_datos, as: :boolean, checked_value: 'SI', unchecked_value: 'NO', input_html: { id: "tratamiento_datos2_check", 'data-toggle': "modal", 'data-target': "#myModal", class: "checkbox" }, label: false %>
                    </div>
                    <div class="col-md-2" style="right: 180px !important; top: 10px">
                      Tratamiento de Datos
                    </div>
                  <% end %>
                </div>
                <!-- Modal -->
                <div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
                  <div class="modal-dialog" role="document" style="width: 70%;">
                    <div class="modal-content">
                      <div class="modal-header" style="background-color: #F1F1F1">
                        <h4 class="modal-title" id="myModalLabel">
                          <div align="center">
                            <%= image_tag ("logo_inicio_asear.png"), size: "230x70" %>
                          </div>
                        </h4>
                      </div>
                      <div class="modal-body" style="padding: 10px 55px 10px 55px;">
                        <div class="row">
                          <div class="col-md-12" style="padding: 15px">
                            <%= render "tratamiento_datos" %>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <% if @personasformulario.valida_estado %>
                  <div class="box-footer">
                    <div class="box-tools pull-right">
                      <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
                    </div><!-- /.box-tools -->
                  </div>
                <% end %>
              <% end %>
            <% end %>
            <% if @etapa == "2" %>
              <div class="row">
                <div class="col-md-12">
                  <div style="font-size: 10px; width: 100%; background-color: #d73925; color: white; height: auto; border-radius: 5px; padding: 10px;">
                    <strong>MENSAJE SENSIBLE:</strong><br/>
                    PARA ASEAR S.A.S. E.S.P ES DE GRAN IMPORTANCIA QUE TANTO USTED COMO SU GRUPO FAMILIAR QUEDEN
                    COMPLETAMENTE AFILIADOS A LAS DIFERENTES ENTIDADES (EPS, COMFAMA, AFP, ARL) POR ELLO LOS DOCUMENTOS
                    QUE CARGUE EN LA PLATAFORMA DEBEN QUEDAR COMPLETOS Y LEGIBLES.
                    PARA QUE SU GRUPO FAMILIAR NO TENGA PROBLEMAS DE ATENCIÓN PROCURE CARGAR TODOS LOS DOCUMENTOS
                    NECESARIOS PARA LA AFILIACIÓN, DE LO CONTRARIO SERÁ SU RESPONSABILIDAD LA CUALQUIER NOVEDAD QUE
                    OCURRA CON ELLOS.
                  </div>
                  <br/>
                  <% if @personasformulario.parcargo_id.to_i > 0 %>
                    <table style="width: 100%" class="table table-bordered table-condensed table-striped">
                      <% Parcargosdoc.select("parcargosdocs.*, (select distinct 'X' from personasformulariosdocs where personasformulario_id = #{@personasformulario.id} and parcargosdoc_id = parcargosdocs.id) existedoc ")
                                     .where("parcargo_id = #{@personasformulario.parcargo_id}").each do |p| %>
                        <tr>
                          <th class="text-left text-table" width="30%">
                            <div style="padding: 20px 10px 30px 10px;"><%= p.descripcion %><br/>
                              <small><em>Obligatorio: (<%= p.obligatorio rescue nil %>)</em></small>
                              <br/>
                              <div class="text-red" style='font-size: 10px;'>NOTA: <%= p.observacion rescue nil %></div>
                            </div>
                          </th>
                          <td width="5%">
                            <div align="center" style="padding: 20px 10px 30px 10px;">
                              <% if ["PENDIENTE", "DEVUELTO"].include?(@personasformulario.estado) %>
                                <%= link_to abrir_documento_personasformulariosdocs_path(parcargosdoc_id: p.id, personasformulario_id: @personasformulario.id), remote: true, data: { toggle: 'tooltip' }, title: "Cargar Soporte Digital" do %>
                                  <button class="btn btn-xs btn-warning"><i class="fa fa-file-pdf-o"></i></button>
                                <% end %>
                              <% end %>
                            </div>
                          </td>
                          <td>
                            <div class="box-body paddin-body">
                              <div class="row">
                                <div class="col-md-12">
                                  <% if p.existedoc.to_s == 'X' %>
                                    <table class="table table-bordered table-condensed table-striped">
                                      <thead>
                                      <tr class="thcolor">
                                        <th width="5%"></th>
                                        <th width="15%" class="text-center text-table">Fecha</th>
                                        <th width="15%" class="text-center text-table">Estado</th>
                                        <th class="text-left text-table">Soporte Digital</th>
                                      </tr>
                                      </thead>
                                      <tbody id="tbody_personasformulariosdocs">
                                      <% @personasformulario.personasformulariosdocs.where("parcargosdoc_id = #{p.id}").each do |personasformulariosdoc| %>
                                        <tr id="personasformulariosdoc_<%= personasformulariosdoc.id %>">
                                          <td class="text-center">
                                            <% if ["PENDIENTE", "DEVUELTO", "RECHAZADO"].include?(@personasformulario.estado) %>
                                              <% if ["PENDIENTE", "RECHAZADO"].include?(personasformulariosdoc.estado) %>
                                                <%= link_to personasformulario_personasformulariosdoc_path(@personasformulario, personasformulariosdoc), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
                                                  <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i>
                                                  </button>
                                                <% end %>
                                              <% end %>
                                            <% end %>
                                          </td>
                                          <td class="text-center text-table"><%= personasformulariosdoc.created_at.strftime("%Y-%m-%d %X") rescue nil %></td>
                                          <td class="text-center text-table"><%= personasformulariosdoc.estado_documento.html_safe rescue nil %></td>
                                          <td class="text-left text-table">
                                            <% if personasformulariosdoc.soporte_digital_file_name.present? %>
                                              <%= link_to personasformulariosdoc.soporte_digital.url(:original, false), data: { toggle: 'tooltip' }, title: "Ver Documento", onclick: 'window.open(this.href,"new_window","height=450,width=600,scrollbars=yes");return false;' do %>
                                                <i class="fa fa-cloud-download"></i> <%= personasformulariosdoc.soporte_digital_file_name rescue nil %>
                                              <% end %>
                                              <% if personasformulariosdoc.observacion.present? %>
                                                <div class="text-justify text-red">
                                                  <small><b>Observacion: </b> <%= personasformulariosdoc.observacion rescue nil %>
                                                  </small>
                                                </div>
                                              <% end %>
                                            <% end %>
                                          </td>
                                        </tr>
                                      <% end %>
                                      </tbody>
                                    </table>
                                  <% else %>
                                    <div style="font-size: 14px; width: 100%; background-color: #d73925; color: white; height: auto; border-radius: 5px; padding: 10px;">
                                      No hay documentos cargados
                                    </div>
                                  <% end %>
                                </div>
                              </div>
                            </div>
                          </td>
                        </tr>
                        <div class="modal fade" id="abrirdoc<%= p.id %>">
                          <div class="modal-dialog">
                            <div class="modal-content">
                            </div>
                          </div>
                        </div>
                      <% end %>
                    </table>
                  <% else %>
                    <div style="font-size: 14px; width: 100%; background-color: #d73925; color: white; height: auto; border-radius: 5px; padding: 10px;">
                      No hay documentos cargados
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
            <% if @etapa == "3"
                 # Para los casos en los que no hay encuesta, el sistema la crea automaticamente
                 if Personasforencuesta.where("personasformulario_id = #{@personasformulario.id}").present? == false
                   ActiveRecord::Base.connection.execute("
                     INSERT INTO personasforencuestas (id, personasformulario_id, encuesta_id, encuestaspregunta_id, created_at, updated_at)
                     SELECT 0, f.id, e.id, p.id, NOW(), NOW()
                     FROM   encuestapreguntas p
                     LEFT JOIN encuestas e ON e.id = p.encuesta_id
                     LEFT JOIN parcargos g ON g.encuesta_id = e.id
                     LEFT JOIN personasformularios f ON f.parcargo_id = g.id
                     WHERE f.id = #{@personasformulario.id}
                     ORDER BY f.id, p.id ASC, g.id ASC")
                 end
            %>
              <%= render "personasformularios/encuestas" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript" charset="utf-8">

    $('input[name="openmodal"]').on('change', function (e) {
        if (e.target.checked) {
            $('#myModal').modal();
        }
    });

    $('#borrarcheck').on("click", function () {
        $(".checkbox input:checked").prop('checked', false);

    });

    $('#aceptarcheck').on("click", function () {
        $("label[for='tratamiento_datos2_check']").html("<div style='color: #752D67; background-color: #F6B400; height: 30px;padding: 5px;border-radius: 10px;'><i class='fa fa-check'></i> Tratamiendo de datos Aceptado</div>");
    });
</script>



