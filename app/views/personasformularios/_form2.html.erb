<% examen = @personasformulario.personasformulariosexamenes.where("estado = 'PENDIENTE'").first rescue nil %>
<div class="alert alert-info alert-dismissible" style="font-size: 14px;">
  <h4><i class="icon fa fa-info"></i> Bienvenido a la plataforma de ASEAR S.A.S. E.S.P.</h4>
  Este proceso de selección y contratación se realizará de manera VIRTUAL, por lo que lo invitamos gestionar o buscar
  los medios mínimos como: correo electrónico, computador o celular con acceso a internet o datos para que pueda
  realizar su proceso sin tropiezos y evitar así el desplazamiento hasta la oficina.
</div>
<div class="box box-danger">
  <div class="box-header">
    <legend>
      Hola, <%= @personasformulario.nombre rescue nil %>
      <div class="pull-right">
        <b>Estado:</b> <%= @personasformulario.estado_formulario.html_safe rescue nil %>
      </div>
    </legend>
  </div>
  <% if examen.present? %>
    <div class="alert alert-danger alert-dismissible" style="font-size: 14px;">
      <h4><i class="icon fa fa-info"></i> Agendamiento Examen de Ingreso!</h4>
      Recuerda que tienes programado para el día <b><%= examen.fecha.to_date.strftime("%d-%m-%Y") rescue nil %></b> a
      las <b><%= examen.hora rescue nil %></b>, en <b><%= examen.descripcion rescue nil %></b> en la
      direccion <b><%= examen.direccion rescue nil %></b>.
      <% if examen.recomendaciones.present? %><br/>
        Ten en cuenta las siguientes recomendaciones: <b><%= examen.recomendaciones rescue nil %></b>.
      <% end %>
    </div>
  <% end %>
  <div class="box-body" style="padding-top: 0px;">
    <% if @personasformulario.valida_total_campos && @personasformulario.valida_total_documentos && @personasformulario.valida_encuesta %>
      <% if @personasformulario.estado == 'PENDIENTE' %>
        <div class="callout callout-info">
          <h4><i class="fa fa-info"></i> Felicitaciones has finalizado el diligenciamiento de tu inscripción, recuerda que al momento del envio seran analizados tus documentos cargados</h4>
          <p>Para enviar el formulario dar clic aquí
            <% if @personasformulario.valida_estado %>
              <%= link_to envio_formulario_personasformularios_path(id: @personasformulario, estado: 'COMPLETADO'), remote: true, data: { toggle: 'tooltip' }, title: "Enviar Formulario" do %>
                <button class="btn btn-xs btn-warning"><i class="fa fa-hand-pointer-o"></i></button>
              <% end %>
            <% end %>
          </p>
        </div>
      <% elsif @personasformulario.estado == 'COMPLETADO' %>
        <div class="callout callout-info" style="background-color: #F9EE89 !important; color: red !important;">
          <h4><i class="fa fa-info"></i> Tu inscripción se ha enviado con Exito!!!</h4>
        </div>
      <% elsif @personasformulario.estado == 'DEVUELTO' %>
        <div class="callout callout-danger">
          <h4><i class="fa fa-info"></i> <%= @personasformulario.mensaje_documentos rescue nil %> </h4>
          <p>Para enviar el formulario dar clic aquí
            <% if @personasformulario.valida_estado %>
              <%= link_to envio_formulario_personasformularios_path(id: @personasformulario, estado: 'COMPLETADO'), remote: true, data: { toggle: 'tooltip' }, title: "Enviar Formulario" do %>
                <button class="btn btn-xs btn-warning"><i class="fa fa-hand-pointer-o"></i></button>
              <% end %>
            <% end %>
          </p>
        </div>
      <% end %>
    <% end %>
    <div class="row">
      <div class="col-xs-12">
        <div class="nav-tabs-custom">
          <ul class="nav nav-tabs">
            <li class="<%= @etapa == "1" ? 'active' : nil %>"> <%= link_to registro_personasformularios_path(etapa: '1', personasformulario_id: @personasformulario.id) do %>
                <i class="fa fa-user"></i> Información
              <% end %></li>
            <li class="<%= @etapa == "2" ? 'active' : nil %>"> <%= link_to registro_personasformularios_path(etapa: '2', personasformulario_id: @personasformulario.id) do %>
                <i class="fa fa-image"></i> Documentos Digitales
              <% end %></li>
            <% if @personasformulario.parcargo.encuesta_id.present? %>
              <li class="<%= @etapa == "3" ? 'active' : nil %>"> <%= link_to registro_personasformularios_path(etapa: '3', personasformulario_id: @personasformulario.id) do %>
                  <i class="fa fa-file-word-o"></i> Encuesta Ofimatica
                <% end %></li>
            <% end %>
          </ul>
          <div class="tab-content">
            <% if @etapa == "1" %>
              <%= simple_form_for @personasformulario, :url => update2_personasformularios_path(id: @personasformulario.id), :method => :post do |f| %>
                <% @validaC = true %>
                <% @validaP = true %>
                <% @validaS = true %>
                <% @validaZ = true %>
                <% if @personasformulario.genero == "MASCULINO" %>
                  <% @validaC = true %>
                  <% @validaP = false %>
                  <% @validaS = false %>
                  <% @validaZ = false %>
                <% elsif @personasformulario.genero == "FEMENINO" %>
                  <% @validaC = false %>
                  <% @validaP = true %>
                  <% @validaS = true %>
                  <% @validaZ = false %>
                <% end %>
                <div style="font-size: 12px; width: 100%; background-color: #d73925; color: white; height: auto; border-radius: 5px; padding: 10px;">
                  IMPORTANTE: La ZONA o REGIÓN en la que te encuentras tiene un COORDINADOR ASIGNADO, con el cual puedes
                  resolver todas las dudas durante este proceso y durante todo el contrato.
                  Nombre: <%= User.find(@personasformulario.user_asignado).nombre rescue nil %>.
                  Cel: <%= User.find(@personasformulario.user_asignado).celular rescue nil %>. Si necesitas ayuda puedes
                  llamarlo(a).
                </div>
                <br/>
                <div class="box-body">
                  <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :tipo_identificacion, collection: Iparametro.where(campo: 'tipo_identificacion').order(:descripcion).collect { |p| [p.descripcion, p.descripcion] }, input_html: { class: 'select2' }, as: :select, include_blank: true %></div>
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :identificacion, id: "ide", input_html: { onkeypress: "return justNumbers(event);", maxlength: 15 }, disabled: true %></div>
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :fecha_expedicion, as: :string, input_html: { class: 'datepicker', data: { date_options: { format: 'DD/MM/YYYY', ignoreReadonly: true } }, readonly: true } %></div>
                    <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5"><%= f.input :municipio_lugar_expedicion, collection: Municipio.where("iddian_alegra is not null").order(:autobuscar).collect { |p| [p.autobuscar, p.id] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: "Lugar expedición" %></div>
                  </div>
                  <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :nombre, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" } %></div>
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :primer_apellido, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Primer apellido" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :segundo_apellido, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Segundo apellido" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :genero, collection: Iparametro.where(campo: 'genero').order(:descripcion).collect { |p| [p.descripcion, p.descripcion] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: "Genero" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :fecha_nacimiento, as: :string, input_html: { class: 'datepicker', data: { date_options: { format: 'DD/MM/YYYY', ignoreReadonly: true } }, readonly: true } %></div>
                  </div>
                  <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-1 col-lg-1"><%= f.input :tipo_sangre, as: :select, collection: select_tipo_sangre, input_html: { data: { width: '100%' }, class: 'select2' }, label: "RH" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :municipio_lugar_nacimiento, collection: Municipio.where("iddian_alegra is not null").order(:autobuscar).collect { |p| [p.autobuscar, p.id] }, input_html: { class: 'select2' }, as: :select, include_blank: true %></div>
                    <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5"><%= f.input :direccion, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" } %></div>
                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :municipio_ciudad, collection: Municipio.where("iddian_alegra is not null").order(:autobuscar).collect { |p| [p.autobuscar, p.id] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: "Ciudad de la dirección" %></div>
                  </div>
                  <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :telefono, as: :integer %></div>
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :celular, as: :integer %></div>
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :celular2, as: :integer %></div>
                    <div class="col-xs-12 col-sm-12 col-md-5 col-lg-4"><%= f.input :correo, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" } %></div>
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :estado_civil, collection: Iparametro.where(campo: 'estado_civil').order(:descripcion).collect { |p| [p.descripcion.to_s, p.descripcion.to_s] }, input_html: { class: 'select2' }, as: :select, include_blank: true %></div>
                  </div>
                  <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-1 col-lg-1"><%= f.input :estrato, collection: Iparametro.where(campo: 'estrato').order(:descripcion).collect { |p| [p.descripcion.to_s, p.descripcion.to_s] }, input_html: { class: 'select2' }, as: :select, include_blank: true %></div>
                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-3"><%= f.input :nivel_educacion, collection: Iparametro.where(campo: 'nivel_educacion').order(:descripcion).collect { |p| [p.descripcion.to_s, p.descripcion.to_s] }, input_html: { class: 'select2' }, as: :select, include_blank: true %></div>
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :nro_hijos, as: :integer %></div>
                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4"><%= f.input :eps, collection: Iparametro.where("campo = 'eps' and codigo_aportes is not null").order(:descripcion).collect { |p| [p.descripcion.to_s, p.descripcion.to_s] }, input_html: { class: 'select2' }, as: :select, include_blank: true %></div>
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :fondo_pension, collection: Iparametro.where("campo = 'fondo_pension' and codigo_aportes is not null").order(:descripcion).collect { |p| [p.descripcion.to_s, p.descripcion.to_s] }, input_html: { class: 'select2' }, as: :select, include_blank: true %></div>
                  </div>
                  <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :personas_acargo, as: :integer, label: "Nro Personas a Cargo?" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5"><%= f.input :contacto_nombre, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Contacto en caso de emergencia" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :contacto_telefono, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Teléfono contacto" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-3 text-red"><%= f.input :victimas, as: :select, collection: select_sino, input_html: { data: { width: '100%' }, class: 'select2' }, label: "Es victima de conflicto armado?" %></div>
                  </div>
                  <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-4 text-red"><%= f.input :retirado_pension, as: :select, collection: select_sino, input_html: { data: { width: '100%' }, class: 'select2' }, label: "Usted ha retirado los aportes del fondo de pensiones?" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-4 text-red"><%= f.input :regimen_excepcion, as: :select, collection: select_sino, input_html: { data: { width: '100%' }, class: 'select2' }, label: "Pertenece a un regimen de excepción?" %></div>
                  </div>
                </div>
                <div class="box-header">
                  <legend>Dotación</legend>
                </div>
                <div class="box-body">
                  <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :talla_conjunto, as: :select, collection: select_talla_conjunto, input_html: { data: { width: '100%' }, class: 'select2' }, label: "Talla Conjunto", disabled: @validaC %></div>
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :talla_pantalon, as: :select, collection: select_talla_pantalon, input_html: { data: { width: '100%' }, class: 'select2' }, label: "Talla Pantalon", disabled: @validaP %></div>
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :talla_camisa, as: :select, collection: select_talla_camiseta, input_html: { data: { width: '100%' }, class: 'select2' }, label: "Talla Camisa", disabled: @validaS %></div>
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :talla_zapatos, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Talla Zapatos", disabled: @validaZ %></div>
                  </div>
                </div>
                <div class="box-header">
                  <legend>Anexo perfil sociodemografico</legend>
                </div>
                <div class="box-body">
                  <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :orientacion_sexual, as: :select, collection: select_orientacion_sexual, input_html: { data: { width: '100%' }, class: 'select2' }, label: "Orientación sexual" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :tipo_religion, as: :select, collection: select_tipo_religion, input_html: { data: { width: '100%' }, class: 'select2' }, label: "Tipo de religión" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-4"><%= f.input :tipo_etnia, as: :select, collection: select_tipo_etnia, input_html: { data: { width: '100%' }, class: 'select2' }, label: "Tipo de etnia" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :madre_cabeza, as: :select, collection: select_sino, input_html: { data: { width: '100%' }, class: 'select2' }, label: "Madre o padre cabeza de hogar" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :tipo_vivienda, as: :select, collection: select_tipo_vivienda, input_html: { data: { width: '100%' }, class: 'select2' }, label: "Tipo de vivienda" %></div>
                  </div>
                </div>
                <div class="box-header">
                  <legend>Información Familiar</legend>
                </div>
                <div class="box-body">
                  <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :nombre_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 100 }, label: "Nombre esposa(o) o compañera(o)" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :ocupacion_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 255 }, label: "Profesión, ocupación u oficio" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :empresa_trabaja_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 255 }, label: "Empresa donde trabaja" %></div>
                  </div>
                  <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :cargo_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 255 }, label: "Cargo actual" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :direccion_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 255 }, label: "Dirección" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :telefono_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 20 }, label: "Teléfono" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :ciudad_familiar, collection: Municipio.where("iddian_alegra is not null").order(:autobuscar).collect { |p| [p.autobuscar, p.id] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: "Ciudad" %></div>
                  </div>
                  <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :nro_personas_depende_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 10 }, label: "Nro de personas que dependen económicamente del solicitante" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :parentesto_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 50 }, label: "Parentesco" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :edad_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 20 }, label: "Edades" %></div>
                  </div>
                  <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :nombre_padre_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 100 }, label: "Nombre(s) padre(s)" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :profesion_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 255 }, label: "Profesión, ocupación u oficio" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :telefono_familiar2, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 20 }, label: "Teléfono" %></div>
                  </div>
                  <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :nombre_herm_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 100 }, label: "Nombre(s) hermano(s)" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :profesion_herm_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 255 }, label: "Profesión, ocupación u oficio" %></div>
                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :telefono_herm_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();",:maxlength => 20 }, label: "Teléfono" %></div>
                  </div>
                </div>
                <div class="box-header">
                  <legend>Educación y Aptitudes
                  </legend>
                </div>
                <div class="box-body">
                  <div class="box-body">
                    <div class="row">
                      <table class="table table-bordered table-condensed table-striped">
                        <tr class="thcolor">
                          <th width="10%" class=" text-table">ESTUDIOS</th>
                          <th width="10%" class="text-center text-table">TIPO</th>
                          <th width="10%" class="text-center text-table">AÑO DE FINALIZACION</th>
                          <th width="10%" class="text-center text-table">AÑOS CURSADO</th>
                          <th width="20%" class="text-center text-table">TITULO OBTENIDO</th>
                          <th width="20%" class="text-center text-table">NOMBRE DE LA INSTITUCION</th>
                          <th width="20%" class="text-center text-table">CIUDAD</th>
                        </tr>
                        <tr>
                          <th>Primaria</th>
                          <th></th>
                          <th><div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :est_primaria_anno_fin, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: false %></div></th>
                          <th><div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :est_primaria_anno_cur, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: false %></div></th>
                          <th><div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :est_primaria_titulo, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: false %></div></th>
                          <th><div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :est_primaria_institucion, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: false %></div></th>
                          <th><div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :est_primaria_ciudad, collection: Municipio.where("iddian_alegra is not null").order(:autobuscar).collect { |p| [p.autobuscar, p.id] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: false %></div>
                          </th>
                        </tr>
                        <tr>
