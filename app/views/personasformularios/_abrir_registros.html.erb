<div class="modal-header">
  <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
  <h4 class="modal-title">Registros Cargados - <small>Lote (<%= @archivo %>)</small></h4>
</div>
<div class="modal-body" style='width: 100%;'>
  <div class="row">
    <div class="col-md-12" style="width: 99%;">
      <div class="table-responsive">
        <table class="table table-bordered table-condensed table-striped">
          <thead>
          <tr class="thcolor">
            <th width="5%"></th>
            <th width="5%" class="text-center text-table">ID</th>
            <th width="15%" class="text-center text-table">Identificación</th>
            <th width="20%" class="text-left text-table">Nombre</th>
            <th width="20%" class="text-left text-table">Cargo</th>
            <th width="20%" class="text-left text-table">Correo</th>
            <th width="10%" class="text-center text-table">Estado</th>
          </tr>
          </thead>
          <tbody>
          <% @personasformularios.each do |personasformulario| %>
            <tr id="parcargo_<%= personasformulario.id %>">
              <td class="text-center">
                <%= link_to edit_personasformulario_path(personasformulario), class: 'edit_parcargo_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
                  <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
                <% end %>
              </td>
              <td class="text-center text-table"><%= personasformulario.id rescue nil %></td>
              <td class="text-center text-table"><%= personasformulario.identificacion rescue nil %></td>
              <td class="text-left text-table"><%= personasformulario.nombre rescue nil %></td>
              <td class="text-left text-table"><%= personasformulario.parcargo.descripcion rescue nil %></td>
              <td class="text-left text-table"><%= personasformulario.correo rescue nil %></td>
              <td class="text-center text-table"><%= personasformulario.estado rescue nil %></td>
            </tr>
          <% end %>
          </tbody>
        </table>
        <div class="box-tools pull-right">
          <%= will_paginate @personasformularios, renderer: BootstrapPagination::Rails %>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
    $(function () {
        $('.pagination a').attr('data-remote', 'true')
    });
</script>




