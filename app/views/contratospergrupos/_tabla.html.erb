      <tr>
        <td width="10%"></td>
        <th width="20%" class="text-left">Identificación</th>
        <th class="text-left">Nombre</th>
        <th width="20%" class="text-center">Parentesco</th>
      </tr>
    </thead>
	  <tbody id="tbody_contratospergrupos">
	    <% @contratospersona.contratospergrupos.order(id: :desc).each do |contratospergrupo| %>
