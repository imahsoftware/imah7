<tr id="contratosperliqnovedad_<%=contratosperliqnovedad.id %>">
  <td class="text-center">
        <%= link_to contratosperliquidacion_contratosperliqnovedad_path(@contratosperliquidacion, contratosperliqnovedad), remote: true, method: :delete, data: {confirm: "#{t :elimina_confirma}", toggle: 'tooltip'}, title: "#{t :title_elimina}" do %>
          <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
        <% end %>
    <button class="btn btn-xs btn-info"><span data-toggle="tooltip" data-html="true" data-original-title="<div align='left'>
    <%= contratosperliqnovedad.created_at.strftime("%Y-%m-%d %X") rescue nil %>- <%= contratosperliqnovedad.user.username rescue nil %>
    </div>"><i class="fa fa-user" aria-hidden="true"></i></span></button>
  </td>
  <td><div align="left" style="font-size: 11px;"><%= contratosperliqnovedad.tiposnovedad.descripcion rescue nil %></div></td>
  <td class="text-right" style="font-size: 11px;"><%= camponumerico contratosperliqnovedad.numero rescue nil %></td>
  <td class="text-right" style="font-size: 11px;"><%= camponumerico contratosperliqnovedad.valor_novedad rescue nil %></td>
  <td class="text-justify" style="font-size: 10px;"><%= contratosperliqnovedad.observacion rescue nil %></td>
</tr>
