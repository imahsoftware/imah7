<%= simple_form_for([@contratosperinvdetalle, @contratosperdetallesdoc], remote: true) do |f| %>
  <div class="modal-header">
    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
    <h3 class="modal-title"><strong><%= @contratosperdetallesdoc.new_record? ? 'Agregar' : 'Editar' %> Documento</strong>
    </h3>
    <div class="pull-left">
      <small><%= @contratosperinvdetalle.item rescue nil %></small>
    </div>
  </div>
  <div class="modal-body">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5">
        <%= f.input :invdetalle_doc, as: :file, label: 'Archivo a cargar' %>
      </div>
    </div>
  </div>
  <div class="modal-footer">
    <button type="button" class="pull-left btn btn-flat btn-default" data-dismiss="modal"><%= t :cancelar %></button>
    <div class="box-tools pull-right">
      <%= f.button :submit, 'Aceptar', class: 'btn btn-flat btn-primary' %>
    </div><!-- /.box-tools -->
  </div><!-- box-footer -->
<% end %>
