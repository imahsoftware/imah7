<%= simple_form_for(@egresosdetalle) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.association :egreso %>
    <%= f.input :concepto %>
    <%= f.input :cantidad %>
    <%= f.input :valor_unitario %>
    <%= f.input :iva %>
    <%= f.input :valor_iva %>
    <%= f.input :subtotal %>
    <%= f.input :total %>
    <%= f.association :user %>
    <%= f.input :retencion %>
    <%= f.input :retecre %>
    <%= f.input :claseretencion %>
    <%= f.association :centroscosto %>
    <%= f.association :eproveedorescompra %>
  </div>

  <div class="form-actions">
    <%= f.button :submit %>
  </div>
<% end %>
