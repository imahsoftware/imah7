<div class="box-header">
  <h3 class="box-title"><strong>Servicios</strong></h3>
  <div class="box-tools pull-right">
    <%# if is_auth_c('contratosservicio') %>
      <%= link_to new_contrato_contratosservicio_path(@contrato), id: 'new_contratosservicio_button', class: 'btn btn-sm btn-warning', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
      <% end %>
    <%# end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="contratosservicio_form" class="collapse"></div>
  <div id="contratosservicios">
    <% if @contrato.contratosservicios.present? %>
      <%= render 'contratosservicios/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
    <% end %>
  </div>
</div>

<div class="modal fade" id="temporal">
  <div class="modal-dialog modal-dialog-responsive" role="document">
    <div class="modal-content"></div>
  </div>
</div>
