<div class="box-header">
  <h3 class="box-title"><strong>Detalles</strong></h3>
  <div class="box-tools pull-right">
    <% if ['PENDIENTE', 'RECHAZADO'].include?(@contratosentepp.estado) %>
      <%= link_to new_contratosentepp_contratosenteppsdetalle_path(@contratosentepp), id: 'new_contratosenteppsdetalle_button', class: 'btn btn-sm btn-info', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
      <% end %>
    <% end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="contratosenteppsdetalle_form" class="collapse"></div>
  <div id="contratosenteppsdetalles">
    <% if @contratosentepp.contratosenteppsdetalles.present? %>
      <%= render 'contratosenteppsdetalles/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %>
      </div>
    <% end %>
  </div>
</div>

