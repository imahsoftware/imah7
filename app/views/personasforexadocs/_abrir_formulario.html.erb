<%= simple_form_for([@personasformulariosexamen, @personasforexadoc], remote: true) do |f| %>
  <%= f.hidden_field :personasformulariosexamen_id, value: @personasformulariosexamen.id %>
  <div class="modal-header">
    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
    <h3 class="modal-title"><strong><%= @personasforexadoc.new_record? ? 'Agregar' : 'Editar' %> documento</strong></h3>
  </div>
  <div class="modal-body">
    <div class="row">
      <div class="col-md-12">
        <%= f.input :descripcion, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Descripción" %>
      </div>
    </div>
    <div class="row">
      <div class="col-md-12">
        <%= f.input :documento_examen, as: :file, label: 'Archivo a cargar' %>
        <p class="help-block">Formatos permitidos: PDF, PNG, JPG, JPGE</p>
      </div>
    </div>
  </div>
  <div class="modal-footer">
    <button type="button" class="pull-left btn btn-flat btn-default" data-dismiss="modal"><%=t :cancelar%></button>
    <div class="box-tools pull-right">
      <%= f.button :submit, 'Aceptar', class: 'btn btn-flat btn-primary' %>
    </div><!-- /.box-tools -->
  </div><!-- box-footer -->
<% end %>

