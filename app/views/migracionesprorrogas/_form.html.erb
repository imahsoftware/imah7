<%= simple_form_for(@migracionesprorroga) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.association :user %>
    <%= f.association :archivo %>
    <%= f.input :estado %>
    <%= f.input :identificacion %>
    <%= f.input :contratosperfecha_id %>
    <%= f.input :contratospersona_id %>
    <%= f.input :fecha_fin %>
  </div>

  <div class="form-actions">
    <%= f.button :submit %>
  </div>
<% end %>
