<%
  @egreso.egresosdetalles[0].eproveedorescompra_id rescue nil
  #@eproveedorescompra = Eproveedorescompra.find(@egreso.egresosdetalles[0].eproveedorescompra_id) rescue nil
  @logo = @egreso.portafolio.logoportafolio.to_s

%>
<div align="center">
  <table width="100%" border="0">
    <tr>
      <td width="30%">
        <div align="center">
          <%= wicked_pdf_image_tag "#{image_url(@logo)}", size: "280x120" %>
        </div>
      </td>
      <td style="font-size: 14px; font-family: Tahoma; line-height:150%">
        <div align="center">
          <strong><div style="font-size: 25px; font-family: Tahoma;">COMPROBANTE DE EGRESO</div></strong>
          <br/>
          <div style="font-size: 18px; font-family: Tahoma;">
            <%=@egreso.portafolio.razon_social rescue nil %><br/>
            <%=@egreso.portafolio.identificacion rescue nil %>-<%=@egreso.portafolio.digito rescue nil %>
          </div>
        </div>
      </td>
      <td width="15%" style="font-size: 14px; font-family: Tahoma; line-height:150%">
        <table width="100%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
          <tr>
            <th height="20" style="background: #E8E3E3; font-size: 12px; font-family: Tahoma;">&nbsp;<strong>NÚMERO</strong></th>
          </tr>
          <tr>
            <th height="20" style="border:1px solid #CCCCCC;font-size: 12px; font-family: Tahoma;">&nbsp;<%=@egreso.nro_egreso rescue nil %>

            <% if @egreso.estado.to_s == 'ANULADO' %> - ANULADO -<% end %></th>
          </tr>
          <tr>
            <th height="20" style="background: #E8E3E3; font-size: 12px; font-family: Tahoma;">&nbsp;<strong>FECHA</strong></th>
          </tr>
          <tr>
            <th height="20" style="border:1px solid #CCCCCC;font-size: 12px; font-family: Tahoma;">&nbsp;<%=@egreso.created_at.strftime("%Y-%m-%d") rescue nil %></th>
          </tr>
        </table>
      </td>
    </tr>
  </table>
  <br/>
  <table width="100%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
    <tr>
      <td width="20%" height="20" style="background: #E8E3E3; font-size: 10px; font-family: Tahoma;">&nbsp;<strong>PROVEEDOR : </strong></td>
      <td width="80%" style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma;">&nbsp;<%=@egreso.eproveedor.nombre rescue nil%></td>
    </tr>
    <tr>
      <td height="20" style="background: #E8E3E3; font-size: 10px; font-family: Tahoma;">&nbsp;<strong>NIT : </strong></td>
      <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma;">&nbsp;<%=@egreso.eproveedor.identificacion rescue nil%>
        <% if @egreso.eproveedor.digito.to_i > 0 %>-<%=@egreso.eproveedor.digito rescue nil%><% end %></td>
    </tr>
    <tr>
      <td height="20" style="background: #E8E3E3; font-size: 10px; font-family: Tahoma;">&nbsp;<strong>BANCO : </strong></td>
      <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma;">&nbsp;<%=@egreso.cuenta.descripcion rescue nil%></td>
    </tr>
  </table>
  <br/>
  <table width="100%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 10px; font-family: Verdana, Geneva, sans-serif;">
    <thead>
    <tr>
      <th height="20" width="10%" align="center" style="background: #E8E3E3;">Nro Factura</th>
      <th width="10%" align="center" style="background: #E8E3E3;">Fecha</th>
      <th style="background: #E8E3E3;">Concepto</th>
      <th width="15%" class="text-right" style="background: #E8E3E3;">Valor</th>
    </tr>
    </thead>
    <% @egreso.egresosdetalles.each do |egresosdetalle| %>
      <tr valign="middle">
        <td height="20" align="center" style="font-size: 9px; font-family: Verdana, Geneva, sans-serif;"><%=egresosdetalle.eproveedorescompra.nro_factura rescue nil%></td>
        <td align="center" style="font-size: 9px; font-family: Verdana, Geneva, sans-serif;"><%=egresosdetalle.eproveedorescompra.fecha rescue nil%><%=egresosdetalle.eproveedorestemegreso.fecha rescue nil%></td>
        <td class="text-left" style="font-size: 9px; font-family: Verdana, Geneva, sans-serif;"><%=egresosdetalle.eproveedorescompra.observacion rescue nil%><%=egresosdetalle.concepto rescue nil%>
          <% if Eproveedorescompretencion.where(eproveedorescompra_id: egresosdetalle.eproveedorescompra_id).exists? %>
            <div align="center">
              <br/>
              <table width="98%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
                <tr>
                  <th width="22%" class="text-left" style="font-size: 9px; font-family: Verdana, Geneva, sans-serif; background: #E8E3E3;">Concepto</th>
                  <th class="text-left" style="font-size: 9px; font-family: Verdana, Geneva, sans-serif; background: #E8E3E3;">Retencion</th>
                  <th width="12%" class="text-right" style="font-size: 9px; font-family: Verdana, Geneva, sans-serif; background: #E8E3E3;">Valor</th>
                </tr>
                <% Eproveedorescompretencion.includes([:tipospretencion,:concepto]).where(eproveedorescompra_id: egresosdetalle.eproveedorescompra_id).each do |a| %>
                  <tr>
                    <td align="left" style="font-size:8px;"><%= a.concepto.descripcion rescue nil %></td>
                    <td align="left" style="font-size:8px;"><%= a.tipospretencion.descripcion rescue nil %> - (<%= a.tipospretencion.porcentaje rescue nil %>%)</td>
                    <td align="right" style="font-size:8px;"><%= camponumerico a.valor %></td>
                  </tr>
                <% end %>
              </table>
              <br/>
            </div>
          <% end %>
        </td>
        <td><div align="right"><%=camponumerico(egresosdetalle.total) rescue 0 %></div></td>
      </tr>
    <% end %>
  </table>
  <br/>
  <table width="100%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
    <tr>
      <td valign="top" style="font-size: 10px; font-family: Verdana, Geneva, sans-serif;">
        <div align="center">
          ELABORO<br/><br/><br/><br/>
          ____________________________________<br/>
          <%=@egreso.user.nombre rescue nil %>
        </div></td>
      <td valign="top" style="font-size: 10px; font-family: Verdana, Geneva, sans-serif;">
        <div align="center">
          REVISO<br/><br/><br/><br/>
          ____________________________________<br/>
        </div></td>
      <td width="25%"><div align="center">
        <table width="96%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
          <tr>
            <th height="20" style="background: #E8E3E3; font-size: 12px; font-family: Tahoma;">&nbsp;<strong>TOTAL DINERO</strong></th>
          </tr>
          <tr>
            <th height="20" style="border:1px solid #CCCCCC;font-size: 12px; font-family: Tahoma;">&nbsp;<%=camponumerico(@egreso.egresosdetalles.sum("total")) rescue 0 %></th>
          </tr>
        </table></div>
      </td>
    </tr>
  </table>
</div>





