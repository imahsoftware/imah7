<div class="box-header">
  <h3 class="box-title"><strong>Bitacora</strong></h3>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="contratossoleppsbitacora_form" class="collapse"></div>
  <div id="contratossoleppsbitacoras">
    <% if @contratossolepp.contratossoleppsbitacoras.present? %>
      <%= render 'contratossoleppsbitacoras/tabla' %>
    <% else %>
      <div class="alert alert-danger"><i class="icon fa fa-info"></i> <%= t :atencion %> - <%= t :atencion_msj %></div>
    <% end %>
  </div>
</div>

