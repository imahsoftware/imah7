<% if is_auth_c("interventoriacont") %>

  <legend>Contabilidad</legend>

  <% @objetos.each do |objeto| %>
    <%
      sql_estado = if objeto.ano == Time.now.strftime("%Y") && objeto.mes == '12'
                     %w[PENDIENTE APROBADOGH APROBADOFINAL]
                   else
                     %w[APROBADOGH APROBADOFINAL]
                   end
      interventoriascont = Interventoria
        .where(anno: objeto.ano, mes: objeto.mesc, estado: sql_estado)
        .order(updated_at: :asc)
    %>

    <div style="font-size:13px; font-family: Tahoma;">
      <strong>
        <a href="javascript:void(0);" onclick="SINO('demo1<%= objeto.ano %>_<%= objeto.mes %>')">
          <img src="/images/1nuevo.png"/>
        </a>
        &nbsp;
        <a href="javascript:void(0);" onclick="SINO('demo1<%= objeto.ano %>_<%= objeto.mes %>')">
          <%= objeto.ano %> - <%= descmesmin(objeto.mes) %> (<%= interventoriascont.count %>)
        </a>
      </strong>
    </div>

    <div id="demo1<%= objeto.ano %>_<%= objeto.mes %>" style="display:none;">
      <% if interventoriascont.any? %>
        <table class="table table-bordered table-condensed table-striped">
          <tr class="thcolor">
            <th width="10%" class="text-center">Acción</th>
            <th width="15%" class="text-center">Fecha</th>
            <th width="10%" class="text-center">Identificación</th>
            <th width="35%" class="text-center">Nombre</th>
            <th width="15%" class="text-center">Contrato</th>
            <th width="15%" class="text-center">Periodo</th>
          </tr>
          <% interventoriascont.each do |interventoria| %>
            <tr valign="top" class="<%= cycle('even1', 'odd1') %> text_tr">
              <td class="text-center">
                <%= link_to 'Informe', verificacionfinal_interventorias_path(id: interventoria.id),
                            class: "btn btn-xs btn-success" %>
                <%= link_to new_interventoriasdoc_path(interventoria_id: interventoria.id),
                            remote: true, data: { toggle: 'tooltip' }, title: 'Soporte Digital' do %>
                  <button class="btn btn-xs btn-danger"><i class="fa fa-rocket"></i></button>
                <% end %>
              </td>
              <td class="text-center"><%= interventoria.updated_at.strftime("%Y-%m-%d %X") rescue nil %></td>
              <td class="text-center"><%= interventoria.contrato.empleado.identificacion rescue nil %></td>
              <td class="text-justify">
                <% if interventoria.contrato.contratosimagenes.exists? %>
                  <a href="javascript:void(0);" onclick="SINO('democon1<%= interventoria.id %>')">
                    <%= interventoria.contrato.empleado.nombres rescue nil %>
                  </a>
                  <div id="democon1<%= interventoria.id %>" style="display:none;">
                    <% interventoria.contrato.contratosimagenes.order(created_at: :DESC).each do |img| %>
                      <%= link_to img.descripcion, img.contrato.url(:original, false), class: 'popup' %>
                      <br/>
                    <% end %>
                  </div>
                <% else %>
                  <div style="color:red;" class="camposDescN11">
                    <%= interventoria.contrato.empleado.nombres rescue nil %>
                  </div>
                <% end %>
              </td>
              <td class="text-center">
                <%= interventoria.contrato.nro_contrato %>
                de <%= interventoria.contrato.fecha_firma.strftime("%Y-%m-%d") rescue nil %>
              </td>
              <td class="text-center">
                <%= interventoria.anno %> - <%= descmesmin(interventoria.mes) rescue nil %>
              </td>
            </tr>
          <% end %>
        </table>
      <% else %>
        <div class="text-center" style="color:red;">
          <img src="/images/connect.png"/> No hay cuentas de cobro pendientes de contabilizar
        </div>
      <% end %>
    </div>
  <% end %>

  <br>

  <%# ── CUENTAS REVISADAS (APROBADOCONT) ──────────────────────────────────── %>
  <legend>Cuentas de Cobro Revisadas</legend>
  <table class="table table-bordered table-condensed table-striped">
    <tr>
      <td>
        <% @objetos.each do |objeto| %>
          <% interventorias_ok = Interventoria
            .where(anno: objeto.ano, mes: objeto.mesc, estado: 'APROBADOCONT')
            .order(updated_at: :asc) %>

          <div style="font-size:13px; font-family: Tahoma;">
            <strong>
              <a href="javascript:void(0);" onclick="SINO('demo2<%= objeto.ano %>_<%= objeto.mes %>')">
                <img src="/images/1nuevo.png"/>
              </a>
              &nbsp;
              <a href="javascript:void(0);" onclick="SINO('demo2<%= objeto.ano %>_<%= objeto.mes %>')">
                <%= objeto.ano %> - <%= descmesmin(objeto.mes) %> (<%= interventorias_ok.count %>)
              </a>
            </strong>
          </div>

          <div id="demo2<%= objeto.ano %>_<%= objeto.mes %>" style="display:none;">
            <% if interventorias_ok.any? %>
              <table class="table table-bordered table-condensed table-striped">
                <tr class="thcolor">
                  <th width="10%" class="text-center">Acción</th>
                  <th width="15%" class="text-center">Fecha</th>
                  <th width="10%" class="text-center">Nro. Contrato</th>
                  <th width="10%" class="text-center">Estado</th>
                  <th width="40%" class="text-center">Contratista</th>
                  <th width="15%" class="text-center">Periodo</th>
                </tr>
                <% interventorias_ok.each do |interventoria| %>
                  <tr valign="middle" class="<%= cycle('even1', 'odd1') %>">
                    <td class="text-center">
                      <%= link_to verificacion_interventorias_path(id: interventoria.id),
                                  data: { toggle: 'tooltip' }, title: 'Informe', class: 'popup' do %>
                        <button class="btn btn-xs btn-info">
                          <i class="fa fa-file-pdf-o"></i> Informe
                        </button>
                      <% end %>
                    </td>
                    <td class="text-center"><%= interventoria.updated_at.strftime("%Y-%m-%d %X") rescue nil %></td>
                    <td class="text-center"><%= interventoria.contrato.nro_contrato rescue nil %></td>
                    <td class="text-center"><%= interventoria.estado rescue nil %></td>
                    <td class="text-center">
                      <%= interventoria.contrato.empleado.identificacion rescue nil %> -
                      <%= interventoria.contrato.empleado.nombres rescue nil %>
                    </td>
                    <td class="text-center">
                      <%= interventoria.anno %> - <%= descmesmin(interventoria.mes) rescue nil %>
                    </td>
                  </tr>
                <% end %>
              </table>
            <% else %>
              <div class="text-center" style="color:red;">
                <img src="/images/connect.png"/> No hay cuentas de cobro
              </div>
            <% end %>
          </div>
        <% end %>
      </td>
    </tr>
  </table>

<% end %>