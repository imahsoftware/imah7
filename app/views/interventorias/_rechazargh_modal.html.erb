<div class="modal-header" style="background: #3c4b5e; color: #fff; border-radius: 0;">
  <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color: white; opacity: 0.8;">
    <span aria-hidden="true">&times;</span>
  </button>
  <h4 class="modal-title" style="font-weight: 700; font-size: 15px;">
    <i class="fa fa-times-circle"></i> Rechazar Informe - Gestión Humana
  </h4>
</div>
<div class="modal-body" style='padding: 20px;'>
  <%= form_tag rechazargh_interventorias_path, method: :post, remote: true do %>
    <%= hidden_field_tag :id, @interventoria.id %>
    
    <div style="background: #fcf8e3; border-left: 4px solid #f0ad4e; border: 1px solid #faebcc; padding: 12px 16px; margin-bottom: 16px; font-size: 12.5px;">
      <div style="display: flex; align-items: flex-start; gap: 12px;">
        <i class="fa fa-exclamation-triangle" style="color: #f0ad4e; font-size: 20px; margin-top: 2px;"></i>
        <div>
          <strong style="color: #8a6d3b;">Atención:</strong> 
          <p style="margin: 4px 0 0 0; color: #8a6d3b;">
            Está a punto de rechazar el informe del contratista 
            <strong><%= @interventoria.nombre_contratista %></strong> 
            correspondiente al periodo 
            <strong><%= @interventoria.desc_mes_upcase %> - <%= @interventoria.anno %></strong>.
          </p>
        </div>
      </div>
    </div>
    
    <div style="background: #f4f6f9; padding: 15px; border: 1px solid #e0e4ea; border-radius: 4px; margin-bottom: 15px;">
      <div class="form-group" style="margin-bottom: 0;">
        <label for="razon_rechazo" style="font-size: 12px; font-weight: 700; color: #3c4b5e; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">
          <i class="fa fa-comment"></i> Motivo del rechazo: 
          <span class="text-danger">*</span>
        </label>
        <%= text_area_tag :razon_rechazo, nil, 
            class: 'form-control', 
            rows: 4, 
            placeholder: 'Describa detalladamente el motivo del rechazo del informe...',
            required: true,
            style: 'border: 1px solid #d2d6de; border-radius: 0; font-size: 13px; padding: 8px;' %>
        <small class="text-muted" style="display: block; margin-top: 6px; font-size: 11px;">
          <i class="fa fa-info-circle"></i> 
          Este motivo será registrado en la bitácora.
        </small>
      </div>
    </div>
    
    <div style="background: #f4f6f9; padding: 15px; border: 1px solid #e0e4ea; border-radius: 4px; margin-bottom: 15px;">
      <div style="text-align: center; margin-bottom: 12px;">
        <i class="fa fa-mobile" style="font-size: 24px; color: #3c4b5e;"></i>
        <h5 style="margin: 8px 0 5px 0; color: #3c4b5e; font-weight: 700; font-size: 13px;">Verificación OTP</h5>
        <p style="font-size: 11px; color: #777; margin: 0;">
          Se enviará un código de verificación a su celular registrado
        </p>
      </div>
      
      <div id="mensaje_sms_status" style="margin-bottom: 10px;"></div>
      
      <button type="button" id="btn_generar_otp" 
              class="btn btn-primary btn-sm btn-block" 
              style="font-weight: 600;"
              onclick="generarOtpSupervisorGH(<%= @interventoria.id %>)">
        <i class="fa fa-paper-plane"></i> Enviar código SMS
      </button>
      
      <div id="otp_inputs_container" style="display: none; margin-top: 15px;">
        <label style="font-size: 11px; font-weight: 600; color: #555; display: block; text-align: center; margin-bottom: 8px;">
          Ingrese el código recibido:
        </label>
        <div style="text-align: center;">
          <% (1..6).each do |i| %>
            <%= text_field_tag "nr#{i}", params["nr#{i}"], {
              class: "campo_otp",
              maxlength: "1",
              id: "nr#{i}",
              pattern: "[0-9]*",
              inputmode: "numeric",
              oninput: "if(this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);",
              onkeyup: "moveToNext(this, 'nr#{i + 1}')",
              onkeydown: "moveToPrevious(this, 'nr#{i - 1}')",
              style: "margin: 0 2px;"
            } %>
          <% end %>
        </div>
      </div>
    </div>
    
    <div id="mensaje_otp" style="margin-bottom: 10px;"></div>
    
    <div class="row">
      <div class="col-sm-6">
        <button type="button" class="btn btn-default btn-sm btn-block" data-dismiss="modal">
          <i class="fa fa-times"></i> Cancelar
        </button>
      </div>
      <div class="col-sm-6">
        <%= submit_tag 'Confirmar Rechazo', 
            class: 'btn btn-danger btn-sm btn-block', 
            id: 'btn_confirmar_rechazo', 
            disabled: true,
            style: 'font-weight: 600;' %>
      </div>
    </div>
    
    <script>
      function moveToNext(current, nextFieldID) {
        if (current.value.length >= current.maxLength) {
          let nextField = document.getElementById(nextFieldID);
          if (nextField) {
            nextField.focus();
          }
        }
        checkOtpComplete();
      }
      
      function moveToPrevious(current, previousFieldID) {
        if (event.key === "Backspace" && current.value.length === 0) {
          const prevField = document.getElementById(previousFieldID);
          if (prevField) {
            prevField.focus();
          }
        }
        checkOtpComplete();
      }
      
      function checkOtpComplete() {
        let allFilled = true;
        for (let i = 1; i <= 6; i++) {
          if ($('#nr' + i).val().length === 0) {
            allFilled = false;
            break;
          }
        }
        $('#btn_confirmar_rechazo').prop('disabled', !allFilled);
      }
      
      function generarOtpSupervisorGH(interventoriaId) {
        $('#btn_generar_otp').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Enviando...');
        $('#mensaje_sms_status').html('<div style="background: #d9edf7; border: 1px solid #bce8f1; border-radius: 4px; padding: 8px; font-size: 11px; color: #31708f;"><i class="fa fa-spinner fa-spin"></i> Enviando SMS...</div>');
        
        $.ajax({
          url: '/interventorias/' + interventoriaId + '/generar_otp_supervisor_gh',
          type: 'POST',
          dataType: 'script',
          headers: {
            'X-CSRF-Token': $('meta[name="csrf-token"]').attr('content')
          }
        });
      }
      
      // Monitorear cambios en los campos OTP
      $(document).on('input', '.campo_otp', function() {
        checkOtpComplete();
      });
    </script>
  <% end %>
</div>
