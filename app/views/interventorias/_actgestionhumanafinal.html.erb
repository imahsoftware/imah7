<%# Botones de acción para Gestión Humana - Aprobación Final %>

<div class="box-footer" style="background-color: #f9f9f9; padding: 15px; margin-top: 20px;">
  <div class="row">
    <div class="col-md-12">
      <% if @interventoria.estado == 'REVISIONFINALGH' %>
        <div class="alert alert-info">
          <i class="fa fa-info-circle"></i>
          <strong>Revisión Final - Gestión Humana:</strong> 
          Este informe requiere su aprobación final. Por favor, revise cuidadosamente antes de aprobar.
        </div>
        
        <div class="btn-group pull-right">
          <!-- Botón APROBAR con OTP por SMS -->
          <%= link_to aprobar_supervisor_gh_modal_interventoria_path(@interventoria), 
              remote: true,
              class: 'btn btn-success',
              style: 'padding: 4px 10px; font-size: 12px;',
              data: { toggle: 'tooltip', placement: 'top', title: 'Aprobar con código de verificación SMS' } do %>
            <i class="fa fa-check-circle"></i> Aprobar con OTP
          <% end %>
          
          <!-- Botón RECHAZAR -->
          <%= link_to rechazar_supervisor_gh_modal_interventoria_path(@interventoria), 
              remote: true,
              class: 'btn btn-danger',
              style: 'padding: 4px 10px; font-size: 12px;',
              data: { toggle: 'tooltip', placement: 'top', title: 'Rechazar informe' } do %>
            <i class="fa fa-times-circle"></i> Rechazar
          <% end %>
          
          <!-- Botón Ver Informe -->
          <%= link_to verificacion_interventorias_path(id: @interventoria.id),
              class: 'btn btn-info popup',
              style: 'padding: 4px 10px; font-size: 12px;',
              data: { toggle: 'tooltip', placement: 'top', title: 'Ver informe en PDF' } do %>
            <i class="fa fa-file-pdf-o"></i> Ver Informe
          <% end %>
        </div>
        
        <div class="clearfix"></div>
        
      <% elsif @interventoria.estado == 'APROBADO' %>
        <div class="alert alert-warning">
          <i class="fa fa-clock-o"></i>
          <strong>Pendiente de Revisión:</strong> 
          Este informe está pendiente de su revisión y aprobación.
        </div>
        
        <div class="btn-group pull-right">
          <!-- Botón APROBAR con OTP por SMS -->
          <%= link_to aprobar_supervisor_gh_modal_interventoria_path(@interventoria), 
              remote: true,
              class: 'btn btn-success',
              style: 'padding: 4px 10px; font-size: 12px;',
              data: { toggle: 'tooltip', placement: 'top', title: 'Aprobar con código de verificación SMS' } do %>
            <i class="fa fa-check-circle"></i> Aprobar con OTP
          <% end %>
          
          <!-- Botón RECHAZAR -->
          <%= link_to rechazar_supervisor_gh_modal_interventoria_path(@interventoria), 
              remote: true,
              class: 'btn btn-danger',
              style: 'padding: 4px 10px; font-size: 12px;',
              data: { toggle: 'tooltip', placement: 'top', title: 'Rechazar informe' } do %>
            <i class="fa fa-times-circle"></i> Rechazar
          <% end %>
          
          <!-- Botón Ver Informe -->
          <%= link_to verificacion_interventorias_path(id: @interventoria.id),
              class: 'btn btn-info popup',
              style: 'padding: 4px 10px; font-size: 12px;',
              data: { toggle: 'tooltip', placement: 'top', title: 'Ver informe en PDF' } do %>
            <i class="fa fa-file-pdf-o"></i> Ver Informe
          <% end %>
        </div>
        
        <div class="clearfix"></div>
        
      <% elsif @interventoria.estado == 'APROBADOGH' %>
        <div class="alert alert-success">
          <i class="fa fa-check-circle"></i>
          <strong>Informe Aprobado:</strong> 
          Este informe ya ha sido aprobado por Gestión Humana.
          <% if @interventoria.fecha_firma_supervisor.present? %>
            <br><small>Fecha de aprobación: <%= @interventoria.fecha_firma_supervisor.strftime("%d/%m/%Y %H:%M") %></small>
          <% end %>
        </div>
        
      <% elsif @interventoria.estado.to_s.include?('RECHAZADO') %>
        <div class="alert alert-danger">
          <i class="fa fa-times-circle"></i>
          <strong>Informe Rechazado:</strong> 
          Este informe ha sido rechazado. Revise la bitácora para ver los motivos.
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Modales para OTP -->
<div id="aprobar_supervisor_gh_modal<%= @interventoria.id %>" class="modal fade" role="dialog">
  <div class="modal-dialog modal-lg">
    <div class="modal-content"></div>
  </div>
</div>

<div id="rechazar_supervisor_gh_modal<%= @interventoria.id %>" class="modal fade" role="dialog">
  <div class="modal-dialog modal-lg">
    <div class="modal-content"></div>
  </div>
</div>

<script>
  $(document).ready(function() {
    $('[data-toggle="tooltip"]').tooltip();
  });
</script>
