<%# app/views/interventorias/_buscar.html.erb %>

<% anno_actual = Date.today.year %>
<% mes_actual  = Date.today.month %>
<% annos = (2018..anno_actual).to_a.reverse %>
<% meses_lista = [
  ['Enero','01'],['Febrero','02'],['Marzo','03'],['Abril','04'],
  ['Mayo','05'],['Junio','06'],['Julio','07'],['Agosto','08'],
  ['Septiembre','09'],['Octubre','10'],['Noviembre','11'],['Diciembre','12']
] %>

<div class="box box-default" style="border-top: 3px solid #3c8dbc; margin-bottom: 0;">
  <div class="box-header with-border" style="background: #f7f9fc;">
    <h3 class="box-title">
      <i class="fa fa-search" style="color: #3c8dbc;"></i>
      &nbsp;Buscar Informes de Supervisión
    </h3>
  </div>

  <%= form_tag buscar_interventorias_path, method: :get,
               id: 'form-buscar-interventorias',
               data: { remote: true } do %>

    <div class="box-body">
      <div class="row">

        <%# Identificación o Nombre %>
        <div class="col-xs-12 col-sm-6 col-md-4">
          <div class="form-group">
            <label style="font-size:12px; font-weight:600; color:#555;">
              <i class="fa fa-id-card-o"></i> Identificación o Nombre
            </label>
            <%= text_field_tag :buscar,
                               params[:buscar],
                               placeholder: 'Cédula o nombre del contratista...',
                               class: 'form-control input-sm',
                               autocomplete: 'off',
                               style: 'border-radius:0;' %>
          </div>
        </div>

        <%# Año %>
        <div class="col-xs-6 col-sm-3 col-md-2">
          <div class="form-group">
            <label style="font-size:12px; font-weight:600; color:#555;">
              <i class="fa fa-calendar"></i> Año
            </label>
            <%= select_tag :anno,
                           options_for_select([['— Todos —', '']] + annos.map { |a| [a, a] }, params[:anno]),
                           class: 'form-control input-sm',
                           style: 'border-radius:0;' %>
          </div>
        </div>

        <%# Mes %>
        <div class="col-xs-6 col-sm-3 col-md-2">
          <div class="form-group">
            <label style="font-size:12px; font-weight:600; color:#555;">
              <i class="fa fa-calendar-o"></i> Mes
            </label>
            <%= select_tag :mes,
                           options_for_select([['— Todos —', '']] + meses_lista, params[:mes]),
                           class: 'form-control input-sm',
                           style: 'border-radius:0;' %>
          </div>
        </div>

        <%# Estado %>
        <div class="col-xs-12 col-sm-6 col-md-2">
          <div class="form-group">
            <label style="font-size:12px; font-weight:600; color:#555;">
              <i class="fa fa-flag"></i> Estado
            </label>
            <%= select_tag :estado,
                           options_for_select(
                             [['— Todos —', '']] + Interventoria::ESTADOS.map { |e| [e, e] },
                             params[:estado]
                           ),
                           class: 'form-control input-sm',
                           style: 'border-radius:0;' %>
          </div>
        </div>

        <%# Botón %>
        <div class="col-xs-12 col-sm-6 col-md-2">
          <div class="form-group">
            <label style="font-size:12px; color:transparent;">_</label>
            <div>
              <button type="submit" class="btn btn-primary btn-sm btn-block" style="border-radius:0;">
                <i class="fa fa-search"></i> Buscar
              </button>
            </div>
          </div>
        </div>

      </div><%# /row %>
    </div><%# /box-body %>

    <% end %><%# /form %>
</div><%# /box %>
