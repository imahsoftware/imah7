<%# app/views/interventorias/verificacionfinal.html.erb %>
<%# Vista de contabilidad para revisar y aprobar un informe con OTP %>
<%
  contrato = @interventoria.contrato
  perfecha = @interventoria.contratosperfecha
  persona  = perfecha&.contratospersona
  valor_mes_display = @interventoria.valor_mes.to_i > 0 ? @interventoria.valor_mes.to_i : perfecha&.salariofinal.to_i
  total_display     = @interventoria.total.to_i > 0 ? @interventoria.total.to_i : nil
%>

<style>
  .rv-header     { background:#3c4b5e; color:#fff; border-radius:6px; padding:14px 20px;
                   display:flex; align-items:center; justify-content:space-between;
                   flex-wrap:wrap; gap:8px; margin-bottom:16px; }
  .rv-title      { font-size:15px; font-weight:700; display:flex; align-items:center; gap:10px; }
  .rv-badge      { padding:3px 12px; border-radius:20px; font-size:11px; font-weight:700; }
  .rv-card       { background:#fff; border:1px solid #e0e4ea; border-radius:6px;
                   margin-bottom:14px; overflow:hidden; }
  .rv-card-hdr   { background:#f4f6f9; border-bottom:1px solid #e0e4ea; padding:9px 16px;
                   font-size:12px; font-weight:700; color:#3c4b5e; text-transform:uppercase;
                   letter-spacing:.5px; display:flex; align-items:center; gap:7px; }
  .rv-card-body  { padding:14px 16px; }
  .rv-grid       { display:grid; grid-template-columns:1fr 1fr; gap:10px 20px; font-size:12.5px; }
  .rv-field label{ display:block; font-size:10px; font-weight:700; color:#3c8dbc;
                   text-transform:uppercase; letter-spacing:.5px; margin-bottom:2px;
                   border-bottom:1px solid #e8ecf0; padding-bottom:2px; }
  .rv-field span { color:#2c3e50; font-size:13px; font-weight:500; display:block; padding-top:1px; }
  .rv-field.full { grid-column:1/-1; }
  .rv-acciones   { display:flex; gap:10px; align-items:center; flex-wrap:wrap;
                   padding:14px 16px; background:#f9fafb; border-top:1px solid #e0e4ea; }
  .rv-obs        { width:100%; }
  .rv-obs textarea { width:100%; border:1px solid #d2d6de; border-radius:4px;
                     padding:8px 10px; font-size:12px; resize:vertical; }
</style>

<%# ── CABECERA ──────────────────────────────────────────────────────────── %>
<div class="rv-header">
  <div class="rv-title">
    <i class="fa fa-calculator"></i>
    Revisión Contabilidad — Contrato N° <%= contrato&.nro_contrato %>
  </div>
  <div style="display:flex; gap:6px; flex-wrap:wrap; align-items:center;">
    <span class="rv-badge" style="background:#f39c12;"><%= contrato&.tiposcontrato&.descripcion %></span>
    <span class="rv-badge" style="background:#3c8dbc;"><%= @interventoria.periodo_actual %></span>
    <span class="rv-badge" style="background:#e67e22;"><%= @interventoria.estado %></span>
    <%= link_to interventorias_path, class: 'btn btn-xs btn-default' do %>
      <i class="fa fa-arrow-left"></i> Volver
    <% end %>
  </div>
</div>

<%# ── DATOS CONTRATISTA + CONTRATO ───────────────────────────────────────── %>
<div style="display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:14px;">
  <div class="rv-card">
    <div class="rv-card-hdr"><i class="fa fa-user"></i> Contratista</div>
    <div class="rv-card-body">
      <div class="rv-grid">
        <div class="rv-field full">
          <label>Nombre</label>
          <span style="font-size:14px; font-weight:700;"><%= persona&.nombre_completo %></span>
        </div>
        <div class="rv-field">
          <label>Identificación</label>
          <span><%= persona&.tipodoc_identificacion.presence || "#{persona&.tipo_identificacion} #{persona&.identificacion}" %></span>
        </div>
        <div class="rv-field">
          <label>Cargo / Perfil</label>
          <span><%= perfecha&.contratoscargo&.perfil %></span>
        </div>
        <div class="rv-field">
          <label>Correo</label>
          <span><%= persona&.correo %></span>
        </div>
        <div class="rv-field">
          <label>Teléfono</label>
          <span><%= persona&.tele %></span>
        </div>
      </div>
    </div>
  </div>

  <div class="rv-card">
    <div class="rv-card-hdr"><i class="fa fa-file-text-o"></i> Contrato</div>
    <div class="rv-card-body">
      <div class="rv-grid">
        <div class="rv-field full">
          <label>Objeto</label>
          <span><%= contrato&.objeto %></span>
        </div>
        <div class="rv-field">
          <label>Valor Mensual</label>
          <span style="font-size:14px; font-weight:700;">
            $ <%= number_to_currency(perfecha&.salariofinal, precision: 0, unit: '', delimiter: '.') %>
          </span>
        </div>
        <div class="rv-field">
          <label>Vigencia</label>
          <span>
            <%= perfecha&.fecha_inicio&.strftime("%d/%m/%Y") %>
            <% if perfecha&.fecha_fin.present? %>
              al <%= perfecha.fecha_fin.strftime("%d/%m/%Y") %>
            <% else %>
              <span style="background:#27ae60;color:#fff;padding:2px 8px;border-radius:10px;font-size:10px;">En ejecución</span>
            <% end %>
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

<%# ── CUENTA DE COBRO (solo lectura) ─────────────────────────────────────── %>
<div class="rv-card">
  <div class="rv-card-hdr"><i class="fa fa-calculator"></i> Cuenta de Cobro</div>
  <div class="rv-card-body">
    <div class="rv-grid">
      <div class="rv-field">
        <label>Honorarios del Periodo</label>
        <span style="font-size:15px; font-weight:700;">$ <%= number_to_currency(valor_mes_display, precision: 0, unit: '', delimiter: '.') %></span>
      </div>
      <div class="rv-field">
        <label>Total a Pagar</label>
        <% if total_display %>
          <span style="font-size:15px; font-weight:700; color:#27ae60;">$ <%= number_to_currency(total_display, precision: 0, unit: '', delimiter: '.') %></span>
        <% else %>
          <span style="color:#aaa; font-size:12px;"><i class="fa fa-info-circle"></i> Pendiente de diligenciar</span>
        <% end %>
      </div>
      <div class="rv-field">
        <label>Aportes Salud</label>
        <span>$ <%= number_to_currency(@interventoria.salud, precision: 0, unit: '', delimiter: '.') %></span>
      </div>
      <div class="rv-field">
        <label>Aportes Pensión</label>
        <span>$ <%= number_to_currency(@interventoria.pension, precision: 0, unit: '', delimiter: '.') %></span>
      </div>
      <div class="rv-field">
        <label>Aportes ARL</label>
        <span>$ <%= number_to_currency(@interventoria.arl, precision: 0, unit: '', delimiter: '.') %></span>
      </div>
      <div class="rv-field">
        <label>Retención en la Fuente (383)</label>
        <span>$ <%= number_to_currency(@interventoria.retefuente383, precision: 0, unit: '', delimiter: '.') %></span>
      </div>
      <div class="rv-field full">
        <label>Observaciones y Forma de Pago</label>
        <span><%= @interventoria.observaciones %></span>
      </div>
    </div>
  </div>
</div>

<%# ── ACTIVIDADES ─────────────────────────────────────────────────────────── %>
<div class="rv-card">
  <div class="rv-card-hdr">
    <i class="fa fa-list-ul"></i> Obligaciones del Contrato
    <span class="badge" style="background:#3c8dbc; margin-left:6px;"><%= @interventoria.interactividades.count %></span>
  </div>
  <div class="rv-card-body" style="padding:0;">
    <% if @interventoria.interactividades.any? %>
      <table class="table table-condensed table-striped" style="margin:0; font-size:12px;">
        <thead>
          <tr class="thcolor">
            <th width="4%" class="text-center">N°</th>
            <th width="28%">Actividad</th>
            <th>Desarrollo</th>
            <th width="7%" class="text-center">Soporte</th>
          </tr>
        </thead>
        <tbody>
          <% @interventoria.interactividades.order(:consecutivo).each do |act| %>
            <tr>
              <td class="text-center"><%= act.consecutivo %></td>
              <td>
                <strong><%= act.actividad %></strong>
                <% if act.interactobservaciones.exists? %>
                  <div style="margin-top:6px;">
                    <% act.interactobservaciones.each do |obs| %>
                      <div style="background:#fff3cd; border-left:3px solid #f39c12; padding:4px 8px; font-size:11px; margin-bottom:3px;">
                        <i class="fa fa-sticky-note" style="color:#f39c12;"></i>
                        <%= obs.obs %>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </td>
              <td style="color:<%= act.desarrollo.present? ? '#2c3e50' : '#ccc' %>; white-space:pre-wrap;">
                <%= act.desarrollo.presence || 'Sin desarrollo' %>
              </td>
              <td class="text-center">
                <% if act.interactimagenes.exists? %>
                  <% act.interactimagenes.each do |img| %>
                    <%= link_to img.interactividad.url(:original, false),
                                onclick: 'window.open(this.href,"nw","height=600,width=830,scrollbars=yes");return false',
                                class: 'btn btn-xs btn-info',
                                title: img.interactividad_file_name do %>
                      <i class="fa fa-paperclip"></i>
                    <% end %>
                  <% end %>
                <% else %>
                  <span style="color:#ccc;">—</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="alert alert-warning" style="margin:10px;">
        <i class="fa fa-exclamation-triangle"></i> No hay actividades registradas.
      </div>
    <% end %>
  </div>
</div>

<%# ── BITÁCORA ────────────────────────────────────────────────────────────── %>
<%= render 'bitacora' %>

<%# ── ACCIONES DE CONTABILIDAD ───────────────────────────────────────────── %>
<% if is_auth_c("interventoriacont") && @interventoria.estado.in?(['APROBADOGH', 'TESORERIA']) %>
  <div class="rv-card" style="margin-top: 20px;">
    <div class="rv-card-hdr" style="background: #16a085;">
      <i class="fa fa-calculator"></i> Decisión de Contabilidad
    </div>
    
    <div style="padding: 15px; background: #ecf0f1;">
      <div class="alert alert-info" style="margin-bottom: 15px;">
        <i class="fa fa-info-circle"></i>
        <strong>Revisión de Contabilidad:</strong> 
        Este informe requiere su aprobación. La aprobación se realizará mediante código OTP enviado a su celular.
      </div>
      
      <div class="rv-acciones">
        <%# Botón APROBAR con OTP %>
        <%= link_to aprobarcont_modal_interventoria_path(@interventoria), 
            remote: true,
            class: 'btn btn-success',
            style: 'padding: 4px 10px; font-size: 12px;',
            data: { toggle: 'tooltip', placement: 'top', title: 'Aprobar con código de verificación SMS' } do %>
          <i class="fa fa-check-circle"></i> Aprobar con OTP
        <% end %>
        
        <%# Botón Ver Informe %>
        <%= link_to verificacion_interventoria_path(id: @interventoria.id),
            class: 'btn btn-info popup',
            style: 'padding: 4px 10px; font-size: 12px;',
            data: { toggle: 'tooltip', placement: 'top', title: 'Ver informe en PDF' } do %>
          <i class="fa fa-file-pdf-o"></i> Ver Informe
        <% end %>
      </div>
    </div>
  </div>
  
  <%# Modal para OTP de Contabilidad %>
  <div id="aprobarcont_modal<%= @interventoria.id %>" class="modal fade" role="dialog">
    <div class="modal-dialog modal-lg">
      <div class="modal-content"></div>
    </div>
  </div>
<% end %>
