<div class="modal-header" style="background: #3c4b5e; color: #fff; border-radius: 0;">
  <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color: white; opacity: 0.8;">
    <span aria-hidden="true">&times;</span>
  </button>
  <h4 class="modal-title" style="font-weight: 700; font-size: 15px;">
    <i class="fa fa-calculator"></i> Aprobación de Informe - Contabilidad
  </h4>
</div>
<div class="modal-body" style='padding: 20px;'>
  <%= form_tag aprobarcont_interventoria_path(@interventoria), method: :post, remote: true do %>
    <%= hidden_field_tag :id, @interventoria.id %>
    
    <div style="background: #f4f6f9; padding: 15px; border-radius: 4px; border: 1px solid #e0e4ea; margin-bottom: 15px;">
      <h4 style="margin-top: 0; color: #3c4b5e; font-size: 13px; font-weight: 700;">
        <i class="fa fa-user"></i> <%= @interventoria.nombre_contratista rescue nil %>
      </h4>
      <table class="table table-condensed table-bordered" style="background: white; margin-top: 10px; margin-bottom: 0; font-size: 12px;">
        <tbody>
          <tr>
            <th width="30%" style="background: #f9fafb; font-weight: 600; color: #555; font-size: 11px;">
              <i class="fa fa-file-text-o"></i> Contrato:
            </th>
            <td><strong><%= @interventoria.contrato.nro_contrato rescue nil %></strong></td>
          </tr>
          <tr>
            <th style="background: #f9fafb; font-weight: 600; color: #555; font-size: 11px;">
              <i class="fa fa-tag"></i> Tipo:
            </th>
            <td><%= @interventoria.contrato.tiposcontrato.descripcion rescue nil %></td>
          </tr>
          <tr>
            <th style="background: #f9fafb; font-weight: 600; color: #555; font-size: 11px;">
              <i class="fa fa-money"></i> Valor mensual:
            </th>
            <td>
              <strong style="color: #00a65a;">
                $ <%= number_to_currency(@interventoria.valor_mes, { precision: 0, unit: "", delimiter: "." }) %>
              </strong>
            </td>
          </tr>
          <tr>
            <th style="background: #f9fafb; font-weight: 600; color: #555; font-size: 11px;">
              <i class="fa fa-calendar"></i> Periodo:
            </th>
            <td>
              <span class="label label-primary" style="font-size: 11px;">
                <%= @interventoria.desc_mes_upcase %> - <%= @interventoria.anno %>
              </span>
            </td>
          </tr>
          <tr>
            <th style="background: #f9fafb; font-weight: 600; color: #555; font-size: 11px;">
              <i class="fa fa-info-circle"></i> Estado:
            </th>
            <td>
              <span class="label label-warning" style="font-size: 11px;"><%= @interventoria.estado %></span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    
    <div style="background: #d9edf7; border-left: 4px solid #5bc0de; border: 1px solid #bce8f1; padding: 10px 12px; margin-bottom: 15px; font-size: 12px;">
      <div style="display: flex; align-items: flex-start; gap: 10px;">
        <i class="fa fa-info-circle" style="color: #31708f; font-size: 18px; margin-top: 2px;"></i>
        <div style="color: #31708f;">
          <strong>Revisión de Contabilidad:</strong> Este informe requiere su aprobación. La aprobación se realizará mediante código OTP enviado a su celular.
        </div>
      </div>
    </div>
    
    <div style="background: #f4f6f9; padding: 15px; border: 1px solid #e0e4ea; border-radius: 4px; margin-bottom: 15px;">
      <div style="text-align: center; margin-bottom: 12px;">
        <i class="fa fa-mobile" style="font-size: 24px; color: #3c4b5e;"></i>
        <h5 style="margin: 8px 0 5px 0; color: #3c4b5e; font-weight: 700; font-size: 13px;">Verificación OTP</h5>
        <p style="font-size: 11px; color: #777; margin: 0;">
          Se enviará un código de verificación a su celular registrado
        </p>
      </div>
      
      <div id="mensaje_sms_status" style="margin-bottom: 10px;"></div>
      
      <button type="button" id="btn_generar_otp" 
              class="btn btn-primary btn-sm btn-block" 
              style="font-weight: 600;"
              onclick="generarOtpContabilidad(<%= @interventoria.id %>)">
        <i class="fa fa-paper-plane"></i> Enviar código SMS
      </button>
      
      <div id="otp_inputs_container" style="display: none; margin-top: 15px;">
        <label style="font-size: 11px; font-weight: 600; color: #555; display: block; text-align: center; margin-bottom: 8px;">
          Ingrese el código recibido:
        </label>
        <div style="text-align: center;">
          <% (1..6).each do |i| %>
            <%= text_field_tag "nr#{i}", params["nr#{i}"], {
              class: "campo_otp",
              maxlength: "1",
              id: "nr#{i}",
              pattern: "[0-9]*",
              inputmode: "numeric",
              oninput: "if(this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);",
              onkeyup: "moveToNext(this, 'nr#{i + 1}')",
              onkeydown: "moveToPrevious(this, 'nr#{i - 1}')",
              style: "margin: 0 2px;"
            } %>
          <% end %>
        </div>
      </div>
    </div>
    
    <div id="mensaje_otp" style="margin-bottom: 10px;"></div>
    
    <div class="row">
      <div class="col-sm-6">
        <button type="button" class="btn btn-default btn-sm btn-block" data-dismiss="modal">
          <i class="fa fa-times"></i> Cancelar
        </button>
      </div>
      <div class="col-sm-6">
        <%= submit_tag 'Confirmar Aprobación', 
            class: 'btn btn-success btn-sm btn-block', 
            id: 'btn_confirmar_aprobacion', 
            disabled: true,
            style: 'font-weight: 600;' %>
      </div>
    </div>
    
    <script>
      function moveToNext(current, nextFieldID) {
        if (current.value.length >= current.maxLength) {
          let nextField = document.getElementById(nextFieldID);
          if (nextField) {
            nextField.focus();
          }
        }
      }
      
      function moveToPrevious(current, previousFieldID) {
        if (event.key === "Backspace" && current.value.length === 0) {
          const prevField = document.getElementById(previousFieldID);
          if (prevField) {
            prevField.focus();
          }
        }
      }
      
      function generarOtpContabilidad(interventoriaId) {
        $('#btn_generar_otp').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Enviando...');
        $('#mensaje_sms_status').html('<div style="background: #d9edf7; border: 1px solid #bce8f1; border-radius: 4px; padding: 8px; font-size: 11px; color: #31708f;"><i class="fa fa-spinner fa-spin"></i> Enviando SMS...</div>');
        
        $.ajax({
          url: '/interventorias/' + interventoriaId + '/generar_otp_contabilidad',
          type: 'POST',
          dataType: 'script',
          headers: {
            'X-CSRF-Token': $('meta[name="csrf-token"]').attr('content')
          }
        });
      }
    </script>
  <% end %>
</div>
