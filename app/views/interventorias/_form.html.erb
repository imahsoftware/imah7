<%
  contrato  = @interventoria.contrato
  perfecha  = @interventoria.contratosperfecha
  persona   = perfecha&.contratospersona

  # Valor mensual: del perfecha (salariofinal) o calculado del contrato
  valor_mes_c = perfecha&.salariofinal.to_i
  if valor_mes_c == 0
    valor_mes_c = contrato&.monto_maximo_mes.to_i
  end
  if valor_mes_c == 0
    plazo = contrato&.plazo_mes.to_i
    valor_mes_c = plazo > 0 ? (contrato&.valor.to_i / plazo) : 0
  end

  # Calcular días laborados reales en el mes del informe
  anno_inf = @interventoria.anno.to_i
  mes_inf  = @interventoria.mes.to_i
  if anno_inf > 0 && mes_inf > 0
    primer_dia_mes = Date.new(anno_inf, mes_inf, 1)
    ultimo_dia_mes = primer_dia_mes.end_of_month

    # Día de inicio: si el contrato empezó en este mes, usar fecha_inicio; si no, día 1
    inicio_real = if perfecha&.fecha_inicio.present? &&
                     perfecha.fecha_inicio.year == anno_inf &&
                     perfecha.fecha_inicio.month == mes_inf
                    perfecha.fecha_inicio
                  else
                    primer_dia_mes
                  end

    # Día de fin: si el contrato terminó en este mes, usar fecha_fin; si no, último día
    fin_real = if perfecha&.fecha_fin.present? &&
                  perfecha.fecha_fin.year == anno_inf &&
                  perfecha.fecha_fin.month == mes_inf
                 perfecha.fecha_fin
               else
                 ultimo_dia_mes
               end

    dias_laborados = (fin_real - inicio_real).to_i + 1
    dias_laborados = [[dias_laborados, 0].max, 30].min
  else
    dias_laborados = 30
  end

  valor_dia       = valor_mes_c > 0 ? (valor_mes_c.to_f / 30).round(0).to_i : 0
  desc_suspension = valor_dia * @interventoria.diassuspension.to_i
  total_suspension = Interventoria.where(contrato_id: @interventoria.contrato_id).sum(:diassuspension).to_i
  estados_bloqueados = %w[APROBADO APROBADOGH APROBADOCONT REVISIONFINALGH REVISIONFINALINT]
  puede_guardar = @interventoria.editable? &&
                  !estados_bloqueados.include?(@interventoria.estado.to_s) &&
                  !@interventoria.bloqueado?
%>

<style>
  .ic2-header        { background: #3c4b5e; color:#fff; border-radius:6px 6px 0 0; padding:14px 20px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px; }
  .ic2-header-title  { font-size:16px; font-weight:700; display:flex; align-items:center; gap:10px; }
  .ic2-header-badges { display:flex; gap:6px; flex-wrap:wrap; align-items:center; }
  .ic2-badge         { padding:3px 10px; border-radius:20px; font-size:11px; font-weight:600; }
  .ic2-card          { background:#fff; border:1px solid #e0e4ea; border-radius:6px; margin-bottom:16px; overflow:hidden; }
  .ic2-card-header   { background:#f4f6f9; border-bottom:1px solid #e0e4ea; padding:9px 16px; font-size:12px; font-weight:700; color:#3c4b5e; text-transform:uppercase; letter-spacing:.5px; display:flex; align-items:center; gap:7px; }
  .ic2-card-body     { padding:14px 16px; }
  .ic2-grid          { display:grid; grid-template-columns:1fr 1fr; gap:10px 20px; font-size:12.5px; }
  .ic2-grid-3        { display:grid; grid-template-columns:1fr 1fr 1fr; gap:10px 16px; font-size:12.5px; }
  .ic2-field label   { display:block; font-size:10px; font-weight:700; color:#3c8dbc; text-transform:uppercase; letter-spacing:.5px; margin-bottom:3px; border-bottom: 1px solid #e8ecf0; padding-bottom:2px; }
  .ic2-field span    { color:#2c3e50; font-size:13px; font-weight:500; display:block; padding-top:1px; }
  .ic2-field.full    { grid-column:1/-1; }
  .ic2-valor         { font-size:15px; font-weight:700; color:#2c3e50; padding-top:1px; }
  .ic2-palabras      { font-size:10px; color:#888; margin-top:1px; }
  .ic2-periodo       { background:#3c8dbc; color:#fff; padding:3px 12px; border-radius:20px; font-size:12px; font-weight:700; display:inline-block; }
  .ic2-alert         { border-radius:5px; padding:10px 14px; margin-bottom:12px; display:flex; align-items:flex-start; gap:10px; font-size:12.5px; }
  .ic2-alert i       { margin-top:2px; font-size:15px; flex-shrink:0; }
  .ic2-alert-danger  { background:#fdf2f2; border-left:4px solid #e74c3c; color:#922b21; }
  .ic2-alert-warning { background:#fef9e7; border-left:4px solid #f39c12; color:#7d6608; }
  .ic2-alert-info    { background:#eaf4fb; border-left:4px solid #3498db; color:#1a5276; }
  .ic2-alert-success { background:#eafaf1; border-left:4px solid #27ae60; color:#1e8449; }
  .ic2-ded-table     { width:100%; border-collapse:collapse; font-size:12px; }
  .ic2-ded-table th  { background:#3c4b5e; color:#fff; padding:8px 10px; font-size:11px; text-transform:uppercase; letter-spacing:.4px; }
  .ic2-ded-table td  { padding:7px 10px; border-bottom:1px solid #f0f2f5; vertical-align:middle; }
  .ic2-ded-table tr:last-child td { border-bottom:none; }
  .ic2-ded-table tr:hover td { background:#fafbfc; }
  .ic2-grp td        { background:#edf0f5 !important; font-weight:700; color:#3c4b5e; font-size:11px; text-transform:uppercase; letter-spacing:.5px; }
  .ic2-total td      { background:#2c3e50 !important; color:#fff !important; font-weight:700; font-size:14px; }
  .ic2-subtotal td   { background:#eaf4fb !important; font-weight:700; color:#1a5276; }
  .ic2-esp           { color:#888; font-size:11px; }
  .ic2-hon           { display:flex; gap:12px; margin-bottom:14px; flex-wrap:wrap; }
  .ic2-hon-box       { flex:1; min-width:120px; background:#f4f6f9; border:1px solid #e0e4ea; border-radius:5px; padding:10px 14px; text-align:center; }
  .ic2-hon-box.total { background:#2c3e50; color:#fff; border-color:#2c3e50; }
  .ic2-hon-label     { font-size:10px; text-transform:uppercase; letter-spacing:.4px; color:#888; margin-bottom:4px; }
  .ic2-hon-box.total .ic2-hon-label { color:#aac4d8; }
  .ic2-hon-value     { font-size:15px; font-weight:700; color:#2c3e50; }
  .ic2-hon-box.total .ic2-hon-value { color:#fff; }
  .ic2-mod-table     { width:100%; border-collapse:collapse; font-size:11.5px; }
  .ic2-mod-table th  { background:#5d6d7e; color:#fff; padding:6px 10px; }
  .ic2-mod-table td  { padding:6px 10px; border-bottom:1px solid #f0f2f5; }
  .ic2-flash         { animation: ic2pulse .4s ease; }
  @keyframes ic2pulse { 0%{background:#fff3cd} 100%{background:transparent} }
</style>

<%# ── CABECERA ──────────────────────────────────────────────────────────── %>
<div class="ic2-header">
  <div class="ic2-header-title">
    <i class="fa fa-file-text-o"></i>
    Cuenta de Cobro — Contrato N° <%= contrato&.nro_contrato %>
  </div>
  <div class="ic2-header-badges">
    <span class="ic2-badge" style="background:#f39c12;">
      <%= contrato&.tiposcontrato&.descripcion %>
    </span>
    <span class="ic2-periodo"><%= @interventoria.periodo_actual %></span>
    <span class="ic2-badge" style="background:<%= @interventoria.estado.to_s == 'PENDIENTE' ? '#95a5a6' : '#27ae60' %>;">
      <%= @interventoria.estado %>
    </span>
    <% if @interventoria.persisted? && is_auth_c("interventoriasrecalculo") %>
      <%= link_to validaresp_interventorias_path(id: @interventoria.id),
                  class: 'btn btn-xs btn-warning', title: 'Recalcular retención' do %>
        <i class="fa fa-refresh"></i> Recálculo
      <% end %>
    <% end %>
  </div>
</div>

<div style="padding:16px 0;">
<%= simple_form_for(@interventoria) do |f| %>
  <%= hidden_field_tag :id, @interventoria.id %>

  <%# ── ALERTAS DE ESTADO ──────────────────────────────────────────────── %>
  <% if @interventoria.editable? %>
    <% if @interventoria.estado.to_s == 'PREPARAFINAL' %>
      <% fecha_limite = Sifi.find(110).valor.to_s rescue '9999-12-31 23:59:59' %>
      <% if Time.now.strftime("%Y-%m-%d %H:%M:%S") <= fecha_limite %>
        <div class="ic2-alert ic2-alert-warning">
          <i class="fa fa-clock-o"></i>
          <div>Recuerde tener la cuenta de cobro diligenciada y los soportes de seguridad social cargados.
            <% if @interventoria.habilitado_final? %>
              Si el informe está listo pulse
              <% if @interventoria.fin_anno.blank? %>
                <%= link_to 'Aquí', enviofinalgh_interventoria_path(@interventoria, fin_anno: 'SI'), method: :post, class: 'btn btn-xs btn-danger', data: { confirm: '¿Está seguro?' } %>
              <% else %>
                <%= link_to 'Aquí', enviofinalint_interventoria_path(@interventoria), method: :post, class: 'btn btn-xs btn-danger', data: { confirm: '¿Está seguro?' } %>
              <% end %>
            <% else %>
              <strong>No has completado el diligenciamiento. Verifica!!</strong>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="ic2-alert ic2-alert-danger"><i class="fa fa-ban"></i><div>El tiempo para enviar la cuenta de cobro ha finalizado.</div></div>
      <% end %>
    <% elsif @interventoria.estado.to_s == 'RECHAZADOFINALINT' %>
      <%
        ultima_bita = @interventoria.interbitacoras
                        .where("observacion LIKE ?", '%RECHAZADO POR EL SUPERVISOR%')
                        .order(created_at: :desc).first
        motivo_rechazo = ultima_bita&.observacion.to_s
                           .gsub(/.*INFORME RECHAZADO POR EL SUPERVISOR\s*—?\s*/i, '')
                           .strip
      %>
      <div class="ic2-alert ic2-alert-danger">
        <i class="fa fa-times-circle"></i>
        <div>
          <strong>El informe fue rechazado por el supervisor.</strong>
          <% if motivo_rechazo.present? %>
            <br/><span style="margin-top:4px; display:block;">
              <i class="fa fa-comment"></i> <em><%= motivo_rechazo %></em>
            </span>
          <% end %>
          <br/>
          <%= link_to 'Reenviar', enviofinalint_interventoria_path(@interventoria), method: :post, class: 'btn btn-xs btn-danger', data: { confirm: '¿Está seguro?' } %>
        </div>
      </div>
    <% elsif @interventoria.estado.to_s == 'RECHAZADOFINALGH' %>
      <div class="ic2-alert ic2-alert-danger"><i class="fa fa-times-circle"></i>
        <div>Su informe fue rechazado por Gestión Humana. Corríjalo y reenvíe.
          <%= link_to 'Reenviar', enviofinalgh_interventoria_path(@interventoria), method: :post, class: 'btn btn-xs btn-danger', data: { confirm: '¿Está seguro?' } %>
        </div>
      </div>
    <% elsif !%w[APROBADO APROBADOGH APROBADOCONT].include?(@interventoria.estado.to_s) %>
      <% errores = @interventoria.validainforme.to_s %>
      <% if errores.present? %>
        <div class="ic2-alert ic2-alert-danger"><i class="fa fa-exclamation-circle"></i>
          <div><strong>Se detectaron inconsistencias:</strong><%= errores.html_safe %></div>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <%# ── FILA 1: INFO CONTRATO + INFO CONTRATISTA ───────────────────────── %>
  <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">

    <%# Datos del contrato %>
    <div class="ic2-card">
      <div class="ic2-card-header"><i class="fa fa-file-text-o"></i> Datos del Contrato</div>
      <div class="ic2-card-body">
        <div class="ic2-grid">
          <div class="ic2-field full">
            <label>Objeto</label>
            <span><%= contrato&.objeto %></span>
          </div>
          <div class="ic2-field">
            <label>Valor Mensual</label>
            <div class="ic2-valor">$ <%= number_to_currency(valor_mes_c, precision: 0, unit: '', delimiter: '.') %></div>
            <div class="ic2-palabras"><%= numero_a_palabras(valor_mes_c) rescue '' %></div>
          </div>
          <div class="ic2-field">
            <label>Vigencia</label>
            <span>
              <%= contrato&.fecha_inicio&.strftime("%d/%m/%Y") %> al
              <%= (contrato&.fecha_fin || contrato&.fecha_final)&.strftime("%d/%m/%Y") %>
            </span>
          </div>
          <div class="ic2-field">
            <label>Duración</label>
            <span>
              <% if contrato&.plazo_mes.to_i > 0 %><strong><%= contrato.plazo_mes %></strong> meses<% end %>
              <% if contrato&.plazo_dia.to_i > 0 %>&nbsp;/ <strong><%= contrato.plazo_dia %></strong> días<% end %>
            </span>
          </div>
          <% if contrato&.try(:nro_compromiso).present? %>
            <div class="ic2-field">
              <label>Nro Compromiso</label>
              <span><%= contrato.nro_compromiso %></span>
            </div>
          <% end %>
          <% if contrato&.try(:nro_disponibilidad).present? %>
            <div class="ic2-field">
              <label>Nro Disponibilidad</label>
              <span><%= contrato.nro_disponibilidad %></span>
            </div>
          <% end %>
          <div class="ic2-field">
            <label>Días Suspensión Acum.</label>
            <span><%= total_suspension %> días</span>
          </div>
          <div class="ic2-field">
            <label>Estado Contrato</label>
            <span>
              <span style="display:inline-block; padding:3px 12px; border-radius:20px; font-size:11px; font-weight:700;
                           background:<%= contrato&.estado == 'A' ? '#27ae60' : '#95a5a6' %>; color:#fff;">
                <%= contrato&.estado == 'A' ? 'EN EJECUCIÓN' : (contrato&.estado || '—') %>
              </span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <%# Datos del contratista %>
    <div class="ic2-card">
      <div class="ic2-card-header"><i class="fa fa-user"></i> Datos del Contratista</div>
      <div class="ic2-card-body">
        <div class="ic2-grid">
          <div class="ic2-field full">
            <label>Nombre</label>
            <span style="font-size:14px; font-weight:700;"><%= persona&.nombre_completo %></span>
          </div>
          <div class="ic2-field">
            <label>Identificación</label>
            <span><%= persona&.tipodoc_identificacion %></span>
          </div>
          <div class="ic2-field">
            <label>Cargo / Perfil</label>
            <span><%= perfecha&.contratoscargo&.perfil %></span>
          </div>
          <div class="ic2-field">
            <label>Fecha Inicio</label>
            <span><%= perfecha&.fecha_inicio&.strftime("%d/%m/%Y") %></span>
          </div>
          <div class="ic2-field">
            <label>Fecha Fin</label>
            <span>
              <% if perfecha&.fecha_fin.present? %>
                <%= perfecha.fecha_fin.strftime("%d/%m/%Y") %>
              <% else %>
                <span style="display:inline-block; padding:3px 12px; border-radius:20px; font-size:11px; font-weight:700; background:#95a5a6; color:#fff;">En ejecución</span>
              <% end %>
            </span>
          </div>
          <div class="ic2-field">
            <label>Correo</label>
            <span><%= persona&.correo %></span>
          </div>
          <div class="ic2-field">
            <label>Teléfono / Móvil</label>
            <span><%= persona&.tele %></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# ── MODIFICACIONES (si existen) ───────────────────────────────────── %>
  <% if contrato&.contratosmodificaciones&.exists? %>
    <div class="ic2-card" style="margin-bottom:16px;">
      <div class="ic2-card-header"><i class="fa fa-edit"></i> Modificaciones al Contrato</div>
      <div class="ic2-card-body" style="padding:0;">
        <table class="ic2-mod-table">
          <thead>
            <tr>
              <th>Tipo</th><th>Meses</th><th>Días</th>
              <th>Nro Compromiso</th><th>Fch Compromiso</th>
              <th>Nro Disponibilidad</th><th>Valor</th>
            </tr>
          </thead>
          <tbody>
            <% contrato.contratosmodificaciones.each do |m| %>
              <tr>
                <td><%= m.tipo_modificacion rescue '—' %></td>
                <td><%= m.plazo_mes rescue '—' %></td>
                <td><%= m.try(:plazo_dia) || m.try(:plazo_dias) || '—' %></td>
                <td><%= m.try(:nro_compromiso) || '—' %></td>
                <td><%= m.try(:fecha_compromiso) || '—' %></td>
                <td><%= m.try(:nro_disponibilidad) || m.try(:nro_diponibilidad) || '—' %></td>
                <td><%= camponumerico(m.valor) rescue '0' %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <%# ── DEDUCCIONES Y RETENCIÓN ────────────────────────────────────────── %>
  <div class="ic2-card" style="margin-bottom:16px;">
    <div class="ic2-card-header"><i class="fa fa-calculator"></i> Deducciones y Cálculo de Retención</div>
    <div class="ic2-card-body">

      <div class="ic2-hon">
        <div class="ic2-hon-box">
          <div class="ic2-hon-label">Días laborados</div>
          <div class="ic2-hon-value"><%= dias_laborados %></div>
        </div>
        <div class="ic2-hon-box">
          <div class="ic2-hon-label">Valor día</div>
          <div class="ic2-hon-value" style="font-size:13px;">$ <%= number_to_currency(valor_mes_c.to_f / 30, precision: 2, unit: '', delimiter: '.') %></div>
        </div>
        <% if @interventoria.diassuspension.to_i > 0 %>
          <div class="ic2-hon-box">
            <div class="ic2-hon-label">Días suspensión</div>
            <div class="ic2-hon-value" style="color:#e74c3c;"><%= @interventoria.diassuspension %></div>
          </div>
          <div class="ic2-hon-box">
            <div class="ic2-hon-label">Descuento suspensión</div>
            <div class="ic2-hon-value" style="color:#e74c3c;">- $ <%= number_to_currency(desc_suspension, precision: 0, unit: '', delimiter: '.') %></div>
          </div>
        <% end %>
        <div class="ic2-hon-box total">
          <div class="ic2-hon-label">Honorarios del periodo</div>
          <%
            honorarios_periodo = if @interventoria.valor_mes.to_i > 0
                                   @interventoria.valor_mes.to_i
                                 elsif dias_laborados >= 30
                                   valor_mes_c
                                 else
                                   # Proporcional exacto: evita pérdida por redondeo de valor_dia
                                   (valor_mes_c.to_f * dias_laborados / 30).round(0).to_i
                                 end
          %>
          <div class="ic2-hon-value">$ <%= number_to_currency(honorarios_periodo, precision: 0, unit: '', delimiter: '.') %></div>
        </div>
      </div>

      <table class="ic2-ded-table">
        <thead>
          <tr>
            <th style="text-align:left; width:46%">Descripción</th>
            <th style="width:22%">Valor Esperado</th>
            <th style="width:32%">Valor Real</th>
          </tr>
        </thead>
        <tbody>
          <tr class="ic2-grp"><td colspan="3">Rentas Exentas</td></tr>
          <tr>
            <td>Aportes Salud</td>
            <td class="ic2-esp">$ <%= number_to_currency(@interventoria.salud_auto, precision: 0, unit: '', delimiter: '.') %></td>
            <td><%= f.input :salud, label: false, input_html: { id: 'interventoria_salud', style: 'text-align:center' } %></td>
          </tr>
          <tr>
            <td>Aportes Obligatorios Fondos de Pensión</td>
            <td class="ic2-esp">$ <%= number_to_currency(@interventoria.pension_auto, precision: 0, unit: '', delimiter: '.') %></td>
            <td><%= f.input :pension, label: false, input_html: { id: 'interventoria_pension', style: 'text-align:center' } %></td>
          </tr>
          <tr>
            <td>Aportes Cuentas AFC</td>
            <td class="ic2-esp">0</td>
            <td><%= f.input :afc, label: false, input_html: { id: 'interventoria_afc', style: 'text-align:center' } %></td>
          </tr>
          <tr>
            <td>Aportes Voluntarios Fondos de Pensión</td>
            <td class="ic2-esp">0</td>
            <td><%= f.input :voluntarias, label: false, input_html: { id: 'interventoria_voluntarias', style: 'text-align:center' } %></td>
          </tr>
          <tr class="ic2-subtotal">
            <td colspan="2"><strong>Total Rentas Exentas</strong></td>
            <td id="ic-subtotalr">$ <%= number_to_currency(@interventoria.subtotalr, precision: 0, unit: '', delimiter: '.') %></td>
          </tr>

          <tr class="ic2-grp"><td colspan="3">Deducciones</td></tr>
          <tr>
            <td>Aportes ARL</td>
            <td class="ic2-esp">$ <%= number_to_currency(@interventoria.arl_auto, precision: 0, unit: '', delimiter: '.') %></td>
            <td><%= f.input :arl, label: false, input_html: { id: 'interventoria_arl', style: 'text-align:center' } %></td>
          </tr>
          <tr>
            <td>Intereses Créditos de Vivienda <small style="color:#aaa">(máx. $ <%= number_to_currency(@interventoria.limite_vivienda, precision: 0, unit: '', delimiter: '.') %>)</small></td>
            <td class="ic2-esp">0</td>
            <td><%= f.input :interes_credito, as: :select, collection: select_sino_credito, label: false, input_html: { id: 'interventoria_interes_credito', class: 'select2', data: { width: '100%' } } %></td>
          </tr>
          <tr>
            <td>Salud Medicina Prepagada <small style="color:#aaa">(máx. $ <%= number_to_currency(@interventoria.limite_prepagada, precision: 0, unit: '', delimiter: '.') %>)</small></td>
            <td class="ic2-esp">0</td>
            <td><%= f.input :salud_prepagada, as: :select, collection: select_sino_prepagada, label: false, input_html: { id: 'interventoria_salud_prepagada', class: 'select2', data: { width: '100%' } } %></td>
          </tr>
          <tr>
            <td>Dependientes (10% honorarios) <small style="color:#aaa">(máx. $ <%= number_to_currency(@interventoria.limite_dependencia, precision: 0, unit: '', delimiter: '.') %>)</small></td>
            <td class="ic2-esp">0</td>
            <td><%= f.input :dependientes, as: :select, collection: select_sino_dependiente, label: false, input_html: { id: 'interventoria_dependientes', class: 'select2', data: { width: '100%' } } %></td>
          </tr>
          <tr class="ic2-total">
            <td colspan="2">TOTAL A PAGAR</td>
            <td id="ic-total-display">$ <%= number_to_currency(@interventoria.total, precision: 0, unit: '', delimiter: '.') %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <%# ── OBSERVACIONES ──────────────────────────────────────────────────── %>
  <div class="ic2-card" style="margin-bottom:16px;">
    <div class="ic2-card-header"><i class="fa fa-comment"></i> Observaciones y Forma de Pago</div>
    <div class="ic2-card-body">
      <%= f.input :observaciones, as: :text, label: false,
                  input_html: { rows: 4, onchange: 'this.value=this.value.toUpperCase();',
                                placeholder: 'Ingrese las observaciones y forma de pago...' } %>
    </div>
  </div>

  <%# ── PIE: ÚLTIMA ACTUALIZACIÓN + GUARDAR + ENVIAR ─────────────────── %>
  <%
    # Interventor asociado al contrato via contratosusers
    contratosuser    = Contratosuser.find_by(contrato_id: contrato&.id)
    interventor_user = User.find_by(id: contratosuser&.user_interventor) rescue nil

    # Condiciones para mostrar botón de envío
    errores_envio   = @interventoria.validainforme.to_s
    sin_dev         = @interventoria.interactividades.where("desarrollo IS NULL OR desarrollo = ''").count
    total_acts      = @interventoria.interactividades.count
    listo_para_envio = @interventoria.editable? &&
                       !@interventoria.bloqueado? &&
                       %w[PENDIENTE RECHAZADO RECHAZADOGH].include?(@interventoria.estado.to_s) &&
                       errores_envio.blank? &&
                       sin_dev == 0 &&
                       total_acts > 0 &&
                       @interventoria.observaciones.present?
  %>
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; font-size:11.5px; color:#888; padding:8px 0; border-top:1px solid #e0e4ea; margin-top:4px;">
    <span>
      <i class="fa fa-clock-o"></i>
      Última actualización:
      <strong><%= User.find(@interventoria.user_actualiza).username rescue '—' %></strong>
      — <%= @interventoria.updated_at&.strftime("%Y-%m-%d %H:%M:%S") %>
    </span>
    <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
      <% if puede_guardar || is_auth_c("interventoriaespecial") %>
        <%= f.button :submit, 'Guardar',
                     class: 'btn btn-success',
                     data: { disable_with: 'Guardando...' } %>
      <% end %>

      <% if listo_para_envio %>
        <% path_envio = @interventoria.estado.to_s == 'RECHAZADOGH' ?
                          enviogh_interventoria_path(@interventoria) :
                          envio_interventoria_path(@interventoria) %>
        <%= link_to path_envio,
                    method: :post,
                    class: 'btn btn-primary',
                    data: { confirm: interventor_user.present? ?
                      "Se enviará el informe al interventor #{interventor_user.nombre rescue interventor_user.username}. ¿Está seguro?" :
                      '¿Está seguro de enviar el informe para revisión?' } do %>
          <i class="fa fa-paper-plane"></i> Enviar para revisión
          <% if interventor_user.present? %>
            &nbsp;<small style="opacity:.8;">→ <%= interventor_user.nombre rescue interventor_user.username %></small>
          <% end %>
        <% end %>
      <% elsif @interventoria.editable? && !@interventoria.bloqueado? && %w[PENDIENTE RECHAZADO RECHAZADOGH].include?(@interventoria.estado.to_s) %>
        <%# Mostrar por qué no se puede enviar aún %>
        <span style="color:#e67e22; font-size:11px;">
          <i class="fa fa-exclamation-triangle"></i>
          <% if total_acts == 0 %>
            Sin actividades registradas
          <% elsif sin_dev > 0 %>
            <%= sin_dev %> actividad(es) sin desarrollo
          <% elsif @interventoria.observaciones.blank? %>
            Faltan observaciones y forma de pago
          <% elsif errores_envio.present? %>
            Hay inconsistencias pendientes
          <% end %>
        </span>
      <% end %>
    </div>
  </div>

<% end %><%# /simple_form_for %>
</div>

<script>
$(document).ready(function(){
  function fmt(n){ return '$ ' + parseInt(n||0).toLocaleString('es-CO'); }
  function recalcular(){
    $.ajax({
      url: '<%= recalcular_retencion_interventoria_path(@interventoria) %>',
      type: 'POST',
      data: {
        id: <%= @interventoria.id %>,
        salud:            $('#interventoria_salud').val(),
        arl:              $('#interventoria_arl').val(),
        interes_credito:  $('#interventoria_interes_credito').val(),
        salud_prepagada:  $('#interventoria_salud_prepagada').val(),
        dependientes:     $('#interventoria_dependientes').val(),
        pension:          $('#interventoria_pension').val(),
        afc:              $('#interventoria_afc').val(),
        voluntarias:      $('#interventoria_voluntarias').val()
      },
      headers: { 'X-CSRF-Token': $('meta[name="csrf-token"]').attr('content') },
      success: function(r){
        if(r.subtotalr !== undefined) $('#ic-subtotalr').text(fmt(r.subtotalr));
        if(r.total !== undefined){
          $('#ic-total-display').text(fmt(r.total)).addClass('ic2-flash');
          setTimeout(function(){ $('#ic-total-display').removeClass('ic2-flash'); }, 500);
        }
      }
    });
  }
  $(document).on('change',
    '#interventoria_salud,#interventoria_arl,#interventoria_pension,' +
    '#interventoria_afc,#interventoria_voluntarias,' +
    '#interventoria_interes_credito,#interventoria_salud_prepagada,#interventoria_dependientes',
    recalcular
  );
});
</script>
