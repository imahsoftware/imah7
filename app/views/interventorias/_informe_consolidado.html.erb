<%#
  Partial compartido por visualizaracum.html.erb y visualizarfinal.html.erb
  Locals esperados:
    tipo         -> 'acum' o 'final'
    contrato     -> Contrato
    interventoria-> Interventoria del periodo seleccionado (puede ser nil)
    periodos     -> Colección de Interventoria (todas las acumuladas hasta el periodo seleccionado), ordenadas por anno, mes
%>
<%
  es_final = tipo.to_s == 'final'
  perfecha = interventoria&.contratosperfecha
  persona  = perfecha&.contratospersona

  ic_total_periodo = lambda do |interv|
    if interv.total.to_i > 0
      interv.total.to_i
    elsif interv.valor_mes.to_i > 0
      interv.valor_mes.to_i
    else
      interv.contratosperfecha&.salariofinal.to_i
    end
  end

  total_general = periodos.to_a.sum { |p| ic_total_periodo.call(p) }
%>

<style>
  .ic-header     { background:#3c4b5e; color:#fff; border-radius:6px; padding:14px 20px;
                   display:flex; align-items:center; justify-content:space-between;
                   flex-wrap:wrap; gap:8px; margin-bottom:16px; }
  .ic-title      { font-size:15px; font-weight:700; display:flex; align-items:center; gap:10px; }
  .ic-badge      { padding:3px 12px; border-radius:20px; font-size:11px; font-weight:700; color:#fff; }
  .ic-card       { background:#fff; border:1px solid #e0e4ea; border-radius:6px;
                   margin-bottom:14px; overflow:hidden; }
  .ic-card-hdr   { background:#f4f6f9; border-bottom:1px solid #e0e4ea; padding:9px 16px;
                   font-size:12px; font-weight:700; color:#3c4b5e; text-transform:uppercase;
                   letter-spacing:.5px; }
  .ic-card-body  { padding:14px 16px; }
  .ic-grid       { display:grid; grid-template-columns:1fr 1fr; gap:10px 20px; font-size:12.5px; }
  .ic-field label{ display:block; font-size:10px; font-weight:700; color:#3c8dbc;
                   text-transform:uppercase; letter-spacing:.5px; margin-bottom:2px;
                   border-bottom:1px solid #e8ecf0; padding-bottom:2px; }
  .ic-field span { color:#2c3e50; font-size:13px; font-weight:500; display:block; padding-top:1px; }
  .ic-field.full { grid-column:1/-1; }
  .ic-table      { width:100%; border-collapse:collapse; font-size:11.5px; }
  .ic-table th   { background:#3c8dbc; color:#fff; padding:6px 8px; text-align:left;
                   font-weight:700; font-size:10.5px; text-transform:uppercase; letter-spacing:.4px; }
  .ic-table td   { padding:6px 8px; border-bottom:1px solid #eef1f4; }
  .ic-table tr:nth-child(even) td { background:#f9fafb; }
  .ic-table tfoot td { font-weight:700; background:#eef6fb; border-top:2px solid #3c8dbc; }
  .ic-estado     { font-size:9.5px; padding:2px 7px; border-radius:10px; color:#fff; }
  .ic-final-note { background:#fff7e6; border-left:4px solid #f39c12; padding:10px 14px;
                   font-size:12px; color:#5a4a1c; margin-bottom:14px; border-radius:0 6px 6px 0; }
  .ic-firmas     { display:grid; grid-template-columns:1fr 1fr; gap:30px; margin-top:30px; font-size:12px; }
  .ic-firma-box  { border-top:1px solid #888; padding-top:6px; text-align:center; color:#444; }
</style>

<div style="margin-left:35px; margin-right:35px;">

  <div class="ic-header">
    <div class="ic-title">
      <i class="fa fa-file-text-o"></i>
      <%= es_final ? 'Informe Final de Interventoría' : 'Informe Acumulado de Interventoría' %>
      — Contrato N° <%= contrato&.nro_contrato %>
    </div>
    <div style="display:flex; gap:6px; flex-wrap:wrap; align-items:center;">
      <span class="ic-badge" style="background:#f39c12;"><%= contrato&.tiposcontrato&.descripcion %></span>
      <% if interventoria %>
        <span class="ic-badge" style="background:#3c8dbc;"><%= interventoria.periodo_actual %></span>
        <span class="ic-badge" style="background:<%= interventoria.estado.to_s.start_with?('APROBADO') ? '#27ae60' : '#e67e22' %>;">
          <%= interventoria.estado %>
        </span>
      <% end %>
      <% if params[:format].to_s != 'pdf' %>
        <button onclick="window.close();" class="btn btn-xs btn-default">
          <i class="fa fa-times"></i> Cerrar
        </button>
      <% end %>
    </div>
  </div>

  <% if es_final %>
    <div class="ic-final-note">
      <i class="fa fa-flag-checkered"></i>
      Este documento consolida la información de interventoría registrada durante toda la
      ejecución del contrato N° <%= contrato&.nro_contrato %>
      <% if contrato&.fecha_fin.present? %>
        (finaliza el <%= contrato.fecha_fin.strftime("%d/%m/%Y") %>)
      <% end %>.
    </div>
  <% end %>

  <%# ── CONTRATISTA + CONTRATO ─────────────────────────────────────────────── %>
  <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:14px;">
    <div class="ic-card">
      <div class="ic-card-hdr"><i class="fa fa-user"></i> Contratista</div>
      <div class="ic-card-body">
        <div class="ic-grid">
          <div class="ic-field full">
            <label>Nombre</label>
            <span style="font-size:14px; font-weight:700;"><%= persona&.nombre_completo %></span>
          </div>
          <div class="ic-field">
            <label>Identificación</label>
            <span><%= persona&.tipodoc_identificacion.presence || "#{persona&.tipo_identificacion} #{persona&.identificacion}" %></span>
          </div>
          <div class="ic-field">
            <label>Cargo / Perfil</label>
            <span><%= perfecha&.contratoscargo&.perfil %></span>
          </div>
        </div>
      </div>
    </div>

    <div class="ic-card">
      <div class="ic-card-hdr"><i class="fa fa-file-text-o"></i> Contrato</div>
      <div class="ic-card-body">
        <div class="ic-grid">
          <div class="ic-field full">
            <label>Objeto</label>
            <span><%= contrato&.objeto %></span>
          </div>
          <div class="ic-field">
            <label>Valor Mensual</label>
            <span style="font-size:14px; font-weight:700;">
              $ <%= number_to_currency(perfecha&.salariofinal, precision: 0, unit: '', delimiter: '.') %>
            </span>
          </div>
          <div class="ic-field">
            <label>Vigencia</label>
            <span>
              <%= perfecha&.fecha_inicio&.strftime("%d/%m/%Y") %>
              <% if perfecha&.fecha_fin.present? %>
                al <%= perfecha.fecha_fin.strftime("%d/%m/%Y") %>
              <% else %>
                <span style="background:#27ae60;color:#fff;padding:2px 8px;border-radius:10px;font-size:10px;">En ejecución</span>
              <% end %>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# ── RESUMEN ACUMULADO POR PERIODO ───────────────────────────────────────── %>
  <div class="ic-card">
    <div class="ic-card-hdr"><i class="fa fa-list-ol"></i> Resumen por Periodo</div>
    <div class="ic-card-body" style="padding:0;">
      <% if periodos.to_a.any? %>
        <table class="ic-table">
          <thead>
            <tr>
              <th>Periodo</th>
              <th>Estado</th>
              <th class="text-right">Honorarios</th>
              <th class="text-right">Total a Pagar</th>
            </tr>
          </thead>
          <tbody>
            <% periodos.each do |p| %>
              <tr>
                <td><%= p.periodo_actual %></td>
                <td>
                  <span class="ic-estado" style="background:<%= p.estado.to_s.start_with?('APROBADO') ? '#27ae60' : '#e67e22' %>;">
                    <%= p.estado %>
                  </span>
                </td>
                <td class="text-right">$ <%= number_to_currency(p.valor_mes.to_i > 0 ? p.valor_mes.to_i : p.contratosperfecha&.salariofinal.to_i, precision: 0, unit: '', delimiter: '.') %></td>
                <td class="text-right">$ <%= number_to_currency(ic_total_periodo.call(p), precision: 0, unit: '', delimiter: '.') %></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot>
            <tr>
              <td colspan="3">TOTAL <%= es_final ? 'GENERAL DEL CONTRATO' : 'ACUMULADO' %></td>
              <td class="text-right">$ <%= number_to_currency(total_general, precision: 0, unit: '', delimiter: '.') %></td>
            </tr>
          </tfoot>
        </table>
      <% else %>
        <div class="alert alert-warning" style="margin:10px;">
          <i class="fa fa-exclamation-triangle"></i> No hay periodos registrados para este contrato.
        </div>
      <% end %>
    </div>
  </div>

  <%# ── OBLIGACIONES DEL PERIODO SELECCIONADO ───────────────────────────────── %>
  <% if interventoria %>
    <div class="ic-card">
      <div class="ic-card-hdr">
        <i class="fa fa-list-ul"></i> Obligaciones del Periodo (<%= interventoria.periodo_actual %>)
      </div>
      <div class="ic-card-body" style="padding:0;">
        <% if interventoria.interactividades.any? %>
          <table class="ic-table">
            <thead>
              <tr>
                <th width="5%">N°</th>
                <th width="30%">Actividad</th>
                <th>Desarrollo</th>
              </tr>
            </thead>
            <tbody>
              <% interventoria.interactividades.order(:consecutivo).each do |act| %>
                <tr>
                  <td><%= act.consecutivo %></td>
                  <td><%= act.actividad %></td>
                  <td style="color:<%= act.desarrollo.present? ? '#2c3e50' : '#ccc' %>; white-space:pre-wrap;">
                    <%= act.desarrollo.presence || 'Sin desarrollo' %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="alert alert-warning" style="margin:10px;">
            <i class="fa fa-exclamation-triangle"></i> No hay actividades registradas.
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if es_final %>
    <div class="ic-firmas">
      <div class="ic-firma-box">Firma Supervisor</div>
      <div class="ic-firma-box">Firma Contratista</div>
    </div>
  <% end %>

</div>
