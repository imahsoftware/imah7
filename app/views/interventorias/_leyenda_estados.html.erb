<%# app/views/interventorias/_leyenda_estados.html.erb %>
<div class="box box-default box-solid" style="margin-bottom: 15px;">
  <div class="box-header with-border">
    <h4 class="box-title"><i class="fa fa-info-circle"></i> Estado de los Informes</h4>
  </div>
  <div class="box-body" style="padding: 12px 15px;">
    <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 0; font-size: 11px;">

      <% [
        { color: '#95a5a6', icono: 'fa-file-o',       label: 'No generado' },
        { color: '#bdc3c7', icono: 'fa-clock-o',       label: 'Pendiente envío' },
        { color: '#f39c12', icono: 'fa-paper-plane',   label: 'Enviado a revisor' },
        { color: '#e74c3c', icono: 'fa-times-circle',  label: 'Rechazado' },
        { color: '#27ae60', icono: 'fa-check-circle',  label: 'Aprobado Int. → SGSST' },
        { color: '#3c8dbc', icono: 'fa-shield',        label: 'Aprobado SGSST' },
        { color: '#00a65a', icono: 'fa-money',         label: 'Contabilizado' },
      ].each_with_index do |paso, i| %>
        <div style="text-align: center; min-width: 80px;">
          <div style="width: 36px; height: 36px; border-radius: 50%;
                      background: <%= paso[:color] %>; color: #fff;
                      display: flex; align-items: center; justify-content: center;
                      margin: 0 auto 4px; font-size: 15px;">
            <i class="fa <%= paso[:icono] %>"></i>
          </div>
          <span style="color: #555; font-size: 10px;"><%= paso[:label] %></span>
        </div>
        <% unless i == 6 %>
          <div style="flex: 1; min-width: 12px; height: 2px; background: #ddd; margin: 0 2px; margin-bottom: 20px;"></div>
        <% end %>
      <% end %>

    </div>
  </div>
</div>
