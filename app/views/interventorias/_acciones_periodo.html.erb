<%# app/views/interventorias/_acciones_periodo.html.erb %>
<%# Renderiza los botones de acción para un periodo dado %>
<%# Variables: contrato, periodo, interventoria (puede ser nil), perfecha %>

<% if interventoria.nil? %>
  <%# Periodo no generado — crear %>
  <%= link_to validar_interventorias_path(
                contrato_id: contrato.id,
                ano:         periodo[:ano],
                mes:         periodo[:mes]),
              method: :get,
              class: 'btn btn-xs btn-default',
              title: 'Generar informe' do %>
    <i class="fa fa-plus"></i> Generar
  <% end %>

<% else %>
  <%# Periodo existente — botones según estado %>

  <%# Ver / Editar informe %>
  <% if interventoria.editable? %>
    <%= link_to edit_interventoria_path(interventoria, etapa: '1'),
                class: 'btn btn-xs btn-primary',
                title: 'Editar informe' do %>
      <i class="fa fa-pencil"></i> Editar
    <% end %>
  <% else %>
    <%= link_to verificacion_interventorias_path(id: interventoria.id),
                class: 'btn btn-xs btn-info popup',
                title: 'Ver informe' do %>
      <i class="fa fa-file-pdf-o"></i> Informe
    <% end %>
  <% end %>

  <%# Enviar para revisión (estado PENDIENTE) %>
  <% if interventoria.estado.to_s == 'PENDIENTE' %>
    <%= link_to enviogh_interventorias_path(id: interventoria.id),
                method: :post,
                data: { confirm: '¿Está seguro de enviar el informe para revisión?' },
                class: 'btn btn-xs btn-warning',
                title: 'Enviar a revisión' do %>
      <i class="fa fa-send"></i> Enviar
    <% end %>
  <% end %>

  <%# Informe final / acumulado para el supervisor %>
  <% if interventoria.firmado_supervisor? %>
    <% es_ultimo_mes = contrato.fecha_fin&.strftime("%m") == periodo[:mes] &&
                       contrato.fecha_fin&.strftime("%Y") == periodo[:ano] %>
    <% if es_ultimo_mes %>
      <%= link_to visualizaracum_interventorias_path(
                    contrato_id: contrato.id,
                    ano:         periodo[:ano],
                    mes:         periodo[:mes]),
                  class: 'btn btn-xs btn-dropbox popup',
                  title: 'Informe Final' do %>
        <i class="fa fa-file-pdf-o"></i> Final
      <% end %>
    <% else %>
      <%= link_to visualizaracum_interventorias_path(
                    contrato_id: contrato.id,
                    ano:         periodo[:ano],
                    mes:         periodo[:mes]),
                  class: 'btn btn-xs btn-warning popup',
                  title: 'Informe Acumulado' do %>
        <i class="fa fa-file-pdf-o"></i> Acum.
      <% end %>
    <% end %>
  <% end %>

  <%# Eliminar (solo si no está bloqueado) %>
  <% if interventoria.editable? && !interventoria.bloqueado? %>
    <%= link_to borrar_interventorias_path(
                  contrato_id: contrato.id,
                  ano:         periodo[:ano],
                  mes:         periodo[:mes]),
                method: :delete,
                data: { confirm: 'Atención: Se eliminarán todas las actividades, soportes y observaciones de este periodo. ¿Está seguro?' },
                class: 'btn btn-xs btn-danger',
                title: 'Eliminar' do %>
      <i class="fa fa-trash"></i>
    <% end %>
  <% end %>
<% end %>
