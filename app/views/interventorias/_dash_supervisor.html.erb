<%# app/views/interventorias/_dash_supervisor.html.erb %>
<%
  anno_actual      = Date.today.year.to_s
  anno_anterior    = (Date.today.year - 1).to_s
  mes_actual       = Date.today.month.to_s.rjust(2, '0')
%>

<div class="box box-primary box-solid" style="margin-bottom:16px;">
  <div class="box-header with-border">
    <h3 class="box-title"><i class="fa fa-inbox"></i> Revisión Cuentas de Cobro
      <span class="badge" style="background:#e74c3c; margin-left:6px;"><%= @interventorias.count %></span>
    </h3>
  </div>
  <div class="box-body" style="padding:0;">
    <% if @interventorias.any? %>
      <table class="table table-bordered table-condensed table-striped" style="margin:0; font-size:12px;">
        <thead>
          <tr class="thcolor">
            <th width="18%" class="text-center">Acción</th>
            <th width="12%" class="text-center">Enviado</th>
            <th width="12%" class="text-center">Identificación</th>
            <th class="text-center">Contratista</th>
            <th width="10%" class="text-center">Contrato</th>
            <th width="12%" class="text-center">Periodo</th>
          </tr>
        </thead>
        <tbody>
          <% @interventorias.each do |interventoria| %>
            <% persona = interventoria.contratosperfecha&.contratospersona %>
            <tr class="<%= cycle('even1', 'odd1') %>">
              <td class="text-center">
                <%= link_to verificacion_interventorias_path(id: interventoria.id),
                            class: 'btn btn-xs btn-info popup', title: 'Ver informe' do %>
                  <i class="fa fa-file-pdf-o"></i> Informe
                <% end %>
                &nbsp;
                <% limite = Sifi.find_by(id: 107)&.valor.to_s rescue '9999-12-31 23:59:59' %>
                <% if Time.now.strftime("%Y-%m-%d %H:%M:%S") <= limite %>
                  <%= link_to revisioninter_interventorias_path(id: interventoria.id),
                              class: 'btn btn-xs btn-success', title: 'Revisar' do %>
                    <i class="fa fa-check"></i> Revisar
                  <% end %>
                <% else %>
                  <span class="text-danger" style="font-size:10px;">Límite superado</span>
                <% end %>
              </td>
              <td class="text-center"><%= interventoria.updated_at&.strftime("%Y-%m-%d %H:%M") %></td>
              <td class="text-center"><%= persona&.identificacion %></td>
              <td>
                <strong><%= persona&.nombre_completo %></strong>
                <% if interventoria.contrato.contratosimagenes.exists? %>
                  <br/>
                  <% interventoria.contrato.contratosimagenes.order(created_at: :DESC).each do |img| %>
                    <%= link_to img.imagen_file_name, img.imagen.url(:original, false), class: 'popup', style: 'font-size:10px;' %>
                  <% end %>
                <% end %>
              </td>
              <td class="text-center"><%= interventoria.contrato&.nro_contrato %></td>
              <td class="text-center"><%= interventoria.anno %> - <%= descmesmin(interventoria.mes) rescue interventoria.mes %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="text-center" style="padding:20px; color:#888;">
        <i class="fa fa-check-circle" style="font-size:24px; color:#27ae60;"></i>
        <p style="margin-top:8px;">No hay cuentas de cobro pendientes de revisión.</p>
      </div>
    <% end %>
  </div>
</div>

<%# ── CUENTAS REVISADAS AÑO ACTUAL ───────────────────────────────────────── %>
<div class="box box-default box-solid" style="margin-bottom:16px;">
  <div class="box-header with-border">
    <h3 class="box-title"><i class="fa fa-history"></i> Cuentas Revisadas — <%= anno_actual %></h3>
  </div>
  <div class="box-body">
    <%
      scope_revisadas = if @interventorempleado_id.present?
                          Interventoria.where(
                            "interventorempleado_id = ? OR (interventorempleado_id IS NULL AND contratosperfecha_id IN (?))",
                            @interventorempleado_id,
                            (Contratosperfecha.where(contratospersona_id:
                              Contratosperuser.where(user_id: @user.id, fecha_fin: nil).pluck(:contratospersona_id)
                            ).pluck(:id).presence || [0])
                          ).where(anno: anno_actual)
                        else
                          contratistas_ids = Contratosperuser.where(user_id: @user.id, fecha_fin: nil).pluck(:contratospersona_id)
                          perfechas_ids    = Contratosperfecha.where(contratospersona_id: contratistas_ids).pluck(:id)
                          Interventoria.where(anno: anno_actual, contratosperfecha_id: perfechas_ids)
                        end
      meses_revisados = scope_revisadas
        .where.not(estado: %w[REVISION REVISIONFINALINT])
        .distinct.pluck(:mes).sort.reverse
    %>
    <% if meses_revisados.any? %>
      <% meses_revisados.each do |mes| %>
        <% intervs = if @interventorempleado_id.present?
                        pf_ids = Contratosperfecha.where(contratospersona_id:
                          Contratosperuser.where(user_id: @user.id, fecha_fin: nil).pluck(:contratospersona_id)
                        ).pluck(:id).presence || [0]
                        Interventoria.includes(contratosperfecha: :contratospersona)
                          .where(anno: anno_actual, mes: mes)
                          .where("interventorempleado_id = ? OR (interventorempleado_id IS NULL AND contratosperfecha_id IN (?))",
                                 @interventorempleado_id, pf_ids)
                          .order(updated_at: :asc)
                      else
                        Interventoria.includes(contratosperfecha: :contratospersona)
                          .where(anno: anno_actual, mes: mes, contratosperfecha_id: perfechas_ids)
                          .order(updated_at: :asc)
                      end %>
        <div style="margin-bottom:8px;">
          <a href="javascript:void(0);" onclick="$('#rev_<%= anno_actual %>_<%= mes %>').toggle();"
             style="font-weight:700; font-size:13px;">
            <i class="fa fa-chevron-right"></i>
            <%= anno_actual %> - <%= descmesmin(mes) rescue mes %>
            <span class="badge"><%= intervs.count %></span>
          </a>
        </div>
        <div id="rev_<%= anno_actual %>_<%= mes %>" style="display:none; margin-bottom:12px;">
          <%= render 'tabla_revisadas', intervs: intervs %>
        </div>
      <% end %>
    <% else %>
      <p class="text-muted"><i class="fa fa-info-circle"></i> Sin cuentas revisadas este año.</p>
    <% end %>
  </div>
</div>

<%# ── CUENTAS AÑO ANTERIOR ───────────────────────────────────────────────── %>
<div class="box box-default box-solid">
  <div class="box-header with-border">
    <h3 class="box-title"><i class="fa fa-archive"></i> Cuentas Revisadas — <%= anno_anterior %></h3>
  </div>
  <div class="box-body">
    <%
      scope_anterior = if @interventorempleado_id.present?
                         Interventoria.where(anno: anno_anterior, interventorempleado_id: @interventorempleado_id)
                       else
                         contratistas_ids = Contratosperuser.where(user_id: @user.id, fecha_fin: nil).pluck(:contratospersona_id)
                         perfechas_ids2   = Contratosperfecha.where(contratospersona_id: contratistas_ids).pluck(:id)
                         Interventoria.where(anno: anno_anterior, contratosperfecha_id: perfechas_ids2)
                       end
      meses_anteriores = scope_anterior.distinct.pluck(:mes).sort.reverse
    %>
    <% if meses_anteriores.any? %>
      <% meses_anteriores.each do |mes| %>
        <% intervs = if @interventorempleado_id.present?
                        Interventoria.includes(contratosperfecha: :contratospersona)
                          .where(anno: anno_anterior, mes: mes, interventorempleado_id: @interventorempleado_id)
                          .order(updated_at: :asc)
                      else
                        Interventoria.includes(contratosperfecha: :contratospersona)
                          .where(anno: anno_anterior, mes: mes, contratosperfecha_id: perfechas_ids2)
                          .order(updated_at: :asc)
                      end %>
        <div style="margin-bottom:8px;">
          <a href="javascript:void(0);" onclick="$('#rev_<%= anno_anterior %>_<%= mes %>').toggle();"
             style="font-weight:700; font-size:13px;">
            <i class="fa fa-chevron-right"></i>
            <%= anno_anterior %> - <%= descmesmin(mes) rescue mes %>
            <span class="badge"><%= intervs.count %></span>
          </a>
        </div>
        <div id="rev_<%= anno_anterior %>_<%= mes %>" style="display:none; margin-bottom:12px;">
          <%= render 'tabla_revisadas', intervs: intervs %>
        </div>
      <% end %>
    <% else %>
      <p class="text-muted"><i class="fa fa-info-circle"></i> Sin cuentas del año anterior.</p>
    <% end %>
  </div>
</div>
