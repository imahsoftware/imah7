<%# app/views/interventorias/_bitacora.html.erb %>
<%# Control y Seguimiento — sin dependencia de Empleado %>

<div class="box box-primary">
  <div class="box-header with-border">
    <h3 class="box-title">
      <i class="fa fa-history"></i> Control y Seguimiento
    </h3>
    <div class="box-tools pull-right">
      <span class="badge bg-blue"><%= @interventoria.interbitacoras.count %></span>
    </div>
  </div>
  <div class="box-body no-padding">
    <% if @interventoria.interbitacoras.any? %>
      <div style="padding: 10px">
        <table class="table table-bordered table-condensed table-striped" style="font-size: 12px; margin-bottom: 0;">
          <thead>
          <tr class="thcolor">
            <th style="width: 15%; text-align: center;">Fecha</th>
            <th style="width: 25%;">Usuario</th>
            <th>Observación</th>
          </tr>
          </thead>
          <tbody>
          <% @interventoria.interbitacoras.order(created_at: :desc).each do |bita| %>
            <tr>
              <td style="text-align: center; white-space: nowrap;">
                <%= bita.created_at.strftime("%Y-%m-%d") rescue '—' %>
                <small class="text-muted"><%= bita.created_at.strftime("%H:%M") rescue '' %></small>
              </td>
              <td>
                <%= bita.user&.nombre || bita.user&.username || '—' %>
              </td>
              <td>
                <%= bita.observacion %>
                <%# Mostrar supervisor desde contratosperfecha (sin Empleado) %>
                <% supervisor = @interventoria.contratosperfecha&.contratospersona %>
                <% if supervisor.present? %>
                  <small class="text-muted">
                    — Supervisor: <%= supervisor.nombre_completo.presence || supervisor.autobuscar %>
                  </small>
                <% end %>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="box-body">
        <div class="alert alert-info" style="margin: 0;">
          <i class="fa fa-info-circle"></i>
          No hay registros en la bitácora para este informe.
        </div>
      </div>
    <% end %>
  </div>
</div>
