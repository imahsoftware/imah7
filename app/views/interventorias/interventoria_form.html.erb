<% if @interventoria.etapa.to_s == "1" %>
  <%= render "form" %>
<% else %>
  <div style="margin-bottom: 10px; font-size: 14px;">
    <strong>Supervisión</strong> <small>(<%= @interventoria.nombre_contratista rescue nil %>)</small>
  </div>

  <% case @interventoria.etapa.to_s
     when "21" %>

    <% case @interventoria.estado.to_s
       when "RECHAZADOGH" %>

      <% if @interventoria.acceso.to_s == 'S' %>
        <div align="center" style="color:red; background-color: #FFFFCC;" class="camposDescN16">
          <% if @interventoria.interactividades.where(desarrollo: nil).count > 0 %>
            <br/>
            Usted tiene <%= @interventoria.interactividades.count %> obligaciones registradas, de las cuales tienes
            (<%= @interventoria.interactividades.where(desarrollo: nil).count %>) sin evaluar.<br/><br/>
          <% elsif @interventoria.estado.to_s == 'RECHAZADO' %>
            <div align="center" style="color:red; background-color: #FFFFCC;" class="camposDescN16"><br/>
              El informe ha sido rechazado por el interventor, por favor verifique y complemente las actividades.<br/><br/>
            </div>
          <% elsif @interventoria.estado.to_s == 'RECHAZADOGH' %>
            <div align="center" style="color:red; background-color: #FFFFCC;" class="camposDescN16"><br/>
              El informe ha sido rechazado por gestion humana, por favor verifique y complemente las actividades.<br/><br/>
            </div>
          <% else %><br/>
            Usted tiene <%= @interventoria.interactividades.count %> obligaciones registradas y todas estan debidamente registradas<br/><br/>
          <% end %>
        </div>
      <% end %>

      <div class="box box-primary">
        <div class="box-body">
          <legend>Obligación del Contrato</legend>
          <table class="table table-bordered table-condensed table-striped">
            <thead>
            <tr class="thcolor">
              <th width="10%"></th>
              <th width="50%" class="text-center">Actividad</th>
              <th width="40%" class="text-center">Desarrollo Actividad</th>
            </tr>
            </thead>
            <tbody>
            <% @interventoria.interactividades.where("actividad LIKE ?", "%PAGO%DE%SEGURIDAD%SOCIAL%").each do |interactividad| %>
              <tr>
                <td class="text-center" style="font-size:12px;">
                  <% if @interventoria.acceso.to_s == 'S' %>
                    <% if @interventoria.estado.to_s == 'RECHAZADO' %>
                      <% if interactividad.interactobservaciones.exists? %>
                        <%= link_to image_tag("editar.png"), edit_interactividad_path(interactividad), title: "Registrar avance" %>
                      <% end %>
                    <% elsif @interventoria.estado.to_s == 'APROBADO' %>
                    <% elsif interactividad.bloqueado.to_s == 'SI' %>
                    <% else %>
                      <% if User.find_by_identificacion(Empleado.find(@interventoria.interventorempleado_id).identificacion).id == is_admin.id %>
                        <%= link_to cargue_observaciones_interactividades_path(interactividad_id: interactividad.id), remote: true, data: { toggle: 'tooltip' }, title: "Cargar Observaciones" do %>
                          <button class="btn btn-xs btn-success"><i class="fa fa-sticky-note"></i></button>
                        <% end %>
                      <% end %>
                      <%= link_to cargue_documentos_interactividades_path(interactividad_id: interactividad.id), remote: true, data: { toggle: 'tooltip' }, title: "Cargar Soporte Digital" do %>
                        <button class="btn btn-xs btn-warning"><i class="fa fa-upload"></i></button>
                      <% end %>
                    <% end %>
                  <% end %>
                  <br><br>
                  <% if interactividad.interactobservaciones.exists? %>
                      <span class="text-red" data-toggle="tooltip">
                        <strong><i class="fa fa-sticky-note"></i> Actividad con observaciones</strong>
                      </span>
                  <% end %>
                </td>
                <td class="text-justify" style="font-size:12px;">
                  <strong><%= interactividad.actividad %></strong>
                  <% if interactividad.interactobservaciones.exists? %>
                    <% interactividad.interactobservaciones.each do |interactobservacion| %>
                      <div align="justify" style="color:red;"><strong><%= interactobservacion.obs rescue nil %></strong></div>
                    <% end %>
                  <% end %>
                  <div style="width: 800px; word-wrap: break-word; white-space: normal; overflow-wrap: break-word;" align="justify">
                    <%= replaceenter(interactividad.desarrollo).html_safe rescue nil %>
                  </div>
                  <% if interactividad.interactimagenes.exists? %>
                    <div align="center">
                      <table class="table table-bordered table-condensed table-striped" style="width: 70%;">
                        <thead>
                        <tr class="thcolor">
                          <th width="90%" class="text-center" style="font-size:12px;">Soporte Digital - Descripcion y Nombre del documento</th>
                          <td width="10%" style="font-size:12px;"></td>
                        </tr>
                        </thead>
                        <tbody>
                        <% interactividad.interactimagenes.each do |interactimagen| %>
                          <tr>
                            <td class="text-justify" style="font-size:12px;"><%= interactimagen.descripcion rescue nil %> - <%= interactimagen.interactividad_file_name rescue nil %></td>
                            <td class="text-center" style="font-size:12px;">
                              <%= link_to "Ver", interactimagen.interactividad.url(:original, false), data: { toggle: 'tooltip' }, title: 'Ver documento', onclick: 'window.open(this.href,"new_window","height=600,width=830,scrollbars=yes");return false' %>
                            </td>
                          </tr>
                        <% end %>
                        </tbody>
                      </table>
                    </div>
                  <% end %>
                  <br/>
                </td>
                <td class="camposDesc text-justify">
                  <%= interactividad.desarrollo rescue nil %>
                </td>
              </tr>

              <script type="text/javascript">
                     autosize(document.getElementById("note<%= interactividad.id %>"));
                     function convertirAMayusculas(textarea) { textarea.value = textarea.value.toUpperCase(); }
                     function saveObservation(textarea) {
                            var desarrollo = textarea.value.toUpperCase();
                            var interactividadId = textarea.getAttribute('data-interactividad-id');
                            $.ajax({
                                   url: '/interactividades/update_observation', type: 'POST',
                                   data: { id: interactividadId, desarrollo: desarrollo, interventoria_id: '<%= interactividad.interventoria_id %>' },
                                   success: function(data) { console.log('Observación actualizada:', data); },
                                   error: function(error) { console.error('Error:', error); }
                            });
                     }
              </script>
              <style>textarea { overflow: hidden; resize: none; box-sizing: border-box; width: 100%; }</style>

              <div class="modal fade" id="cargar_documento<%= interactividad.id %>">
                <div class="modal-dialog modal-dialog-responsive" role="document" style="width: 70%"><div class="modal-content"></div></div>
              </div>
              <div class="modal fade" id="cargar_observacion<%= interactividad.id %>">
                <div class="modal-dialog modal-dialog-responsive" role="document" style="width: 70%"><div class="modal-content"></div></div>
              </div>
            <% end %>
            </tbody>
          </table>
        </div>
      </div>

    <% when "APROBADOGH" %>

      <div class="box box-primary">
        <div class="box-body">
          <legend>Obligación del Contrato</legend>
          <table class="table table-bordered table-condensed table-striped">
            <thead>
            <tr class="thcolor">
              <th width="5%" class="text-center"></th>
              <th width="95%" class="text-center">Actividad</th>
            </tr>
            </thead>
            <tbody>
            <% @interventoria.interactividades.order(consecutivo: :asc).each do |interactividad| %>
              <tr>
                <td class="text-center" style="font-size:12px;"><%= interactividad.consecutivo %>.</td>
                <td class="text-justify" style="font-size:12px;">
                  <strong><%= interactividad.actividad %></strong>
                  <div style="width: 800px; word-wrap: break-word; white-space: normal; overflow-wrap: break-word;" align="justify">
                    <%= replaceenter(interactividad.desarrollo).html_safe rescue nil %>
                  </div>
                  <% if interactividad.interactimagenes.exists? %>
                    <div align="center">
                      <table class="table table-bordered table-condensed table-striped" style="width: 70%;">
                        <thead>
                        <tr class="thcolor">
                          <th width="90%" style="font-size:12px;" class="text-center">Soporte Digital - Descripción y Nombre del documento</th>
                          <th width="10%" style="font-size:12px;"></th>
                        </tr>
                        </thead>
                        <tbody>
                        <% interactividad.interactimagenes.each do |interactimagen| %>
                          <tr>
                            <td class="text-justify" style="font-size:12px;"><%= interactimagen.descripcion rescue nil %> - <%= interactimagen.interactividad_file_name rescue nil %></td>
                            <td class="text-center" style="font-size:12px;">
                              <%= link_to "Ver", interactimagen.interactividad.url(:original, false), data: { toggle: 'tooltip' }, title: 'Ver documento', onclick: 'window.open(this.href,"new_window","height=600,width=830,scrollbars=yes");return false' %>
                            </td>
                          </tr>
                        <% end %>
                        </tbody>
                      </table>
                    </div>
                  <% end %>
                  <% if interactividad.interactobservaciones.exists? %>
                    <div align="center">
                      <table class="table table-bordered table-condensed table-striped" style="width: 70%;">
                        <thead>
                        <tr class="thcolor">
                          <th width="95%" class="text-center" style="font-size:12px;">Observaciones Registradas</th>
                        </tr>
                        </thead>
                        <tbody>
                        <% interactividad.interactobservaciones.each do |interactobservacion| %>
                          <tr valign="middle" class="interactobservacion_<%= interactobservacion.id %>">
                            <td class="camposDesc"><div align="justify"><%= interactobservacion.obs rescue nil %></div></td>
                          </tr>
                        <% end %>
                        </tbody>
                      </table>
                    </div>
                  <% end %>
                </td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>
      </div>

    <% when 'PREPARAFINAL', 'RECHAZADOFINALGH', 'RECHAZADOFINALINT' %>

      <% if @interventoria.acceso.to_s == 'S' %>
        <div align="center" style="color:red; background-color: #FFFFCC;" class="camposDescN16">
          <% if @interventoria.estado.to_s == 'PREPARAFINAL' || @interventoria.estado.to_s == 'RECHAZADOFINALGH' %>
          <% else %>
            <% if @interventoria.interactividades.where(desarrollo: nil).count > 0 %>
              <br/>
              Usted tiene <%= @interventoria.interactividades.count %> obligaciones registradas, de las cuales tienes
              (<%= @interventoria.interactividades.where(desarrollo: nil).count %>) sin evaluar.<br/><br/>
            <% elsif @interventoria.estado.to_s == 'RECHAZADO' %>
              <div align="center" style="color:red; background-color: #FFFFCC;" class="camposDescN16"><br/>
                El informe ha sido rechazado por el interventor, por favor verifique y complemente las actividades.<br/><br/>
              </div>
            <% elsif @interventoria.estado.to_s == 'RECHAZADOGH' %>
              <div align="center" style="color:red; background-color: #FFFFCC;" class="camposDescN16"><br/>
                El informe ha sido rechazado por gestion humana, por favor verifique y complemente las actividades.<br/><br/>
              </div>
            <% else %><br/>
              Usted tiene <%= @interventoria.interactividades.count %> obligaciones registradas y todas estan debidamente registradas<br/><br/>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <div class="box box-primary">
        <div class="box-body">
          <legend>Obligación del Contrato</legend>
          <table class="table table-bordered table-condensed table-striped">
            <thead>
            <tr class="thcolor">
              <th width="10%"></th>
              <th width="50%" class="text-center">Actividad</th>
              <th width="40%" class="text-center">Desarrollo Actividad</th>
            </tr>
            </thead>
            <tbody>
            <% @interventoria.interactividades.where("actividad like '%%PAGO%%DE%%SEGURIDAD%%SOCIAL%%'").each do |interactividad| %>
              <tr>
                <td class="text-center" style="font-size:11px;">
                  <%= interactividad.consecutivo %>.
                  <% if interactividad.desarrollo.to_s != "" %>
                    <img src="/images/connect.png" title="Actividad desarrollada"/>
                  <% end %>
                  <% if @interventoria.acceso.to_s == 'S' %>
                    <% if @interventoria.estado.to_s == 'RECHAZADO' %>
                      <% if interactividad.interactobservaciones.exists? %>
                        <%= link_to image_tag("editar.png"), edit_interactividad_path(interactividad), title: "Registrar avance" %>
                      <% end %>
                    <% elsif @interventoria.estado.to_s == 'APROBADO' %>
                    <% elsif interactividad.bloqueado.to_s == 'SI' %>
                    <% else %>
                      <% if User.find_by_identificacion(Empleado.find(@interventoria.interventorempleado_id).identificacion).id == is_admin.id %>
                        <%= link_to cargue_observaciones_interactividades_path(interactividad_id: interactividad.id), remote: true, data: { toggle: 'tooltip' }, title: "Cargar Observaciones" do %>
                          <button class="btn btn-xs btn-success"><i class="fa fa-sticky-note"></i></button>
                        <% end %>
                      <% end %>
                      <%= link_to cargue_documentos_interactividades_path(interactividad_id: interactividad.id), remote: true, data: { toggle: 'tooltip' }, title: "Cargar Soporte Digital" do %>
                        <button class="btn btn-xs btn-warning"><i class="fa fa-upload"></i></button>
                      <% end %>
                    <% end %>
                  <% end %>
                  <% if @interventoria.estado.to_s == 'RECHAZADO' || @interventoria.estado.to_s == 'RECHAZADOFINALGH' %>
                    <%= link_to cargue_documentos_interactividades_path(interactividad_id: interactividad.id), remote: true, data: { toggle: 'tooltip' }, title: "Cargar Soporte Digital" do %>
                      <button class="btn btn-xs btn-warning"><i class="fa fa-upload"></i></button>
                    <% end %>
                  <% end %>
                  <br><br>
                  <% if interactividad.interactobservaciones.exists? %>
                    <span class="text-red" data-toggle="tooltip"><strong><i class="fa fa-sticky-note"></i> Actividad con observaciones</strong></span>
                  <% end %>
                </td>
                <td class="text-justify" style="font-size:11px;">
                  <strong><%= interactividad.actividad %></strong><br/>
                  <% if interactividad.interactobservaciones.exists? %><br/>
                    <legend style="font-size: 12px; margin: 5px;"><strong>Observaciones Interventor</strong></legend><br/>
                    <% interactividad.interactobservaciones.each do |interactobservacion| %>
                      <div align="justify" style="color:red;"><strong><%= interactobservacion.obs rescue nil %></strong></div>
                    <% end %>
                  <% end %>
                  <div id="desarrollo_actividad<%= interactividad.id %>"><br/>
                    <% if interactividad.desarrollo.present? %>
                      <legend style="font-size: 12px; margin: 5px;"><strong>Desarrollo de la actividad</strong></legend><br/>
                      <div style="width: 800px; word-wrap: break-word; white-space: normal; overflow-wrap: break-word;" align="justify">
                        <%= replaceenter(interactividad.desarrollo).html_safe rescue nil %>
                      </div>
                    <% end %>
                  </div>
                  <% if interactividad.interactimagenes.exists? %><br/>
                    <div align="center">
                      <table class="table table-bordered table-condensed table-striped" style="width: 90%;">
                        <thead>
                        <tr class="thcolor">
                          <th width="90%" style="font-size:11px;" class="text-center">Soporte Digital - Descripción y Nombre del Documento</th>
                          <th width="10%" style="font-size:11px;"></th>
                        </tr>
                        </thead>
                        <tbody>
                        <% interactividad.interactimagenes.each do |interactimagen| %>
                          <tr>
                            <td class="text-justify" style="font-size:11px;"><%= interactimagen.descripcion rescue nil %> - <%= interactimagen.interactividad_file_name rescue nil %></td>
                            <td class="text-center" style="font-size:11px;">
                              <%= link_to "Ver", interactimagen.interactividad.url(:original, false), data: { toggle: 'tooltip' }, title: 'Ver documento', onclick: 'window.open(this.href,"new_window","height=600,width=830,scrollbars=yes");return false' %>
                              <%= link_to interactividad_interactimagen_path(interactividad, interactimagen), method: :delete, data: { confirm: '¿Seguro?', toggle: 'tooltip' }, title: 'Eliminar Documento' do %>
                                <i class="fa fa-trash text-red"></i>
                              <% end %>
                            </td>
                          </tr>
                        <% end %>
                        </tbody>
                      </table>
                    </div>
                  <% end %>
                  <br/>
                </td>
                <td class="camposDesc">
                  <% if @interventoria.acceso.to_s == 'S' %>
                    <% if @interventoria.estado.to_s == 'RECHAZADO' || @interventoria.estado.to_s == 'RECHAZADOFINALGH' %>
                      <% if interactividad.interactobservaciones.exists? %>
                        <textarea id="note<%= interactividad.id %>" class="form-control desarrollo-textarea" rows="4" data-interactividad-id="<%= interactividad.id %>" oninput="convertirAMayusculas(this); saveObservation(this);"><%= interactividad.desarrollo %></textarea>
                      <% end %>
                    <% elsif @interventoria.estado.to_s == 'APROBADO' %>
                      <%= interactividad.desarollo rescue nil %>
                    <% elsif interactividad.bloqueado.to_s == 'SI' %>
                    <% else %>
                      <textarea id="note<%= interactividad.id %>" class="form-control desarrollo-textarea" rows="4" data-interactividad-id="<%= interactividad.id %>" oninput="convertirAMayusculas(this); saveObservation(this);"><%= interactividad.desarrollo %></textarea>
                    <% end %>
                  <% end %>
                </td>
              </tr>

              <script type="text/javascript">
                     autosize(document.getElementById("note<%= interactividad.id %>"));
                     function convertirAMayusculas(textarea) { textarea.value = textarea.value.toUpperCase(); }
                     function saveObservation(textarea) {
                            var desarrollo = textarea.value.toUpperCase();
                            var interactividadId = textarea.getAttribute('data-interactividad-id');
                            $.ajax({
                                   url: '/interactividades/update_observation', type: 'POST',
                                   data: { id: interactividadId, desarrollo: desarrollo, interventoria_id: '<%= interactividad.interventoria_id %>' },
                                   success: function(data) {
                                          console.log('Observación actualizada:', data);
                                          var updatedDesarrollo = data.desarrollo || "";
                                          var desarrolloDiv = $("#desarrollo_actividad" + interactividadId);
                                          if (updatedDesarrollo) {
                                                 desarrolloDiv.html('<legend style="font-size: 12px; margin: 5px;"><strong>Desarrollo de la actividad</strong></legend><br/>' + updatedDesarrollo.replace(/\n/g, '<br/>'));
                                          } else {
                                                 desarrolloDiv.html("");
                                          }
                                   },
                                   error: function(error) { console.error('Error:', error); }
                            });
                     }
              </script>
              <style>textarea { overflow: hidden; resize: none; box-sizing: border-box; width: 100%; }</style>

              <div class="modal fade" id="cargar_documento<%= interactividad.id %>">
                <div class="modal-dialog modal-dialog-responsive" role="document" style="width: 70%"><div class="modal-content"></div></div>
              </div>
              <div class="modal fade" id="cargar_observacion<%= interactividad.id %>">
                <div class="modal-dialog modal-dialog-responsive" role="document" style="width: 70%"><div class="modal-content"></div></div>
              </div>
            <% end %>
            </tbody>
          </table>
        </div>
      </div>

    <% else %>

      <div align="center" style="margin-bottom: 10px; border-radius: 5px;">
        <% if @interventoria.acceso.to_s == 'S' %>
          <div align="center" style="color:red; background-color: #FFFFCC;" class="camposDescN16">
            <% if @interventoria.interactividades.where(desarrollo: nil).count > 0 %>
              <br/>
              Usted tiene <%= @interventoria.interactividades.count %> obligaciones registradas, de las cuales tienes
              (<%= @interventoria.interactividades.where(desarrollo: nil).count %>) sin evaluar.<br/><br/>
            <% elsif @interventoria.estado.to_s == 'RECHAZADO' %>
              <div align="center" style="color:red; background-color: #FFFFCC;" class="camposDescN16"><br/>
                El informe ha sido rechazado por el interventor, por favor verifique y complemente las actividades.<br/><br/>
              </div>
            <% elsif @interventoria.estado.to_s == 'RECHAZADOGH' %>
              <div align="center" style="color:red; background-color: #FFFFCC;" class="camposDescN16"><br/>
                El informe ha sido rechazado por gestion humana, por favor verifique y complemente las actividades.<br/><br/>
              </div>
            <% else %><br/>
              Usted tiene <%= @interventoria.interactividades.count %> obligaciones registradas y todas estan debidamente registradas<br/><br/>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="box box-primary">
        <div class="flash_messages"></div>
        <div class="box-body">
          <legend>Obligación del Contrato
            <div class="box-tools pull-right"></div>
          </legend>
          <div id="interactividad_form" class="collapse"></div>
          <div id="interactividades">
            <% if @interventoria.interactividades.any? %>
              <%= render 'interactividades/tabla' %>
            <% else %>
              <div class="alert alert-warning" style="margin-top: 10px;">
                <h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

    <% end %><%# fin case estado %>

  <% when "3" %>

    <div class="box box-primary">
      <div class="box-body">
        <h4>Control y Seguimiento</h4>
        <table class="table table-bordered table-condensed table-striped">
          <thead>
          <tr class="thcolor">
            <th width="20%" class="text-center" style="font-size:12px;">Fecha de Gestión</th>
            <th width="30%" class="text-center" style="font-size:12px;">Usuario</th>
            <th width="50%" class="text-center" style="font-size:12px;">Observación</th>
          </tr>
          </thead>
          <tbody>
          <% @interventoria.interbitacoras.order(created_at: :desc).each do |p| %>
            <tr class="text_tr">
              <td class="text-center"><%= p.created_at.strftime("%Y-%m-%d %X") rescue nil %></td>
              <td class="text-justify"><%= p.user.nombre rescue nil %></td>
              <td class="text-justify">
                <%= p.observacion rescue nil %><br/>
                Supervisor:(
                <%
                       superp  = Interventoria.find_by(id: p.interventoria_id)
                       superp1 = Empleado.find_by(id: superp.interventorempleado_id)
                %>
                <%= superp1.autobuscar rescue nil %>)
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    </div>

  <% end %><%# fin case etapa %>

<% end %><%# fin etapa == "1" %>