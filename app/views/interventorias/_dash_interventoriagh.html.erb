<%# app/views/interventorias/_dash_gh.html.erb %>

<% if is_auth_c("interventoriagh") %>

  <%# ── REVISIÓN GESTIÓN HUMANA (pendientes) ───────────────────────────────── %>
  <div class="box box-primary box-solid" style="margin-bottom:16px;">
    <div class="box-header with-border">
      <h3 class="box-title">
        <i class="fa fa-inbox"></i> Revisión Gestión Humana
        <span class="badge" style="background:#e74c3c; margin-left:6px;"><%= @interventoriasgh.count.to_i rescue 0 %></span>
      </h3>
    </div>
    <div class="box-body" style="padding:0;">
      <% if @interventoriasgh.count.to_i > 0 %>
        <table class="table table-bordered table-condensed table-striped" style="margin:0; font-size:12px;">
          <thead>
          <tr class="thcolor">
            <th width="18%" class="text-center">Acción</th>
            <th width="15%" class="text-center">Fecha</th>
            <th width="15%" class="text-center">Identificación</th>
            <th class="text-center">Nombre</th>
            <th width="15%" class="text-center">Periodo</th>
          </tr>
          </thead>
          <tbody>
          <% @interventoriasgh.each do |interventoria| %>
            <% persona = interventoria.contratosperfecha&.contratospersona %>
            <tr class="<%= cycle('even1', 'odd1') %>">
              <td class="text-center">
                <% if interventoria.mes.to_s == '12' && interventoria.estado.to_s == 'REVISIONFINALGH' %>
                  <%= link_to revisionfinal_interventorias_path(id: interventoria.id),
                              class: 'btn btn-xs btn-danger', title: 'Informe Final' do %>
                    <i class="fa fa-file-pdf-o"></i> Informe Final
                  <% end %>
                <% else %>
                  <%= link_to revisioninter_interventorias_path(id: interventoria.id),
                              class: 'btn btn-xs btn-info', title: 'Ver informe' do %>
                    <i class="fa fa-file-pdf-o"></i> Informe
                  <% end %>
                <% end %>
              </td>
              <td class="text-center"><%= interventoria.updated_at&.strftime("%Y-%m-%d %H:%M") %></td>
              <td class="text-center"><%= persona&.identificacion %></td>
              <td>
                <% if interventoria.contrato&.contratosimagenes&.exists? %>
                  <strong>
                    <a href="javascript:void(0);" onclick="$('#demogh_<%= interventoria.id %>').toggle();">
                      <%= persona&.nombre_completo %>
                    </a>
                  </strong>
                  <div id="demogh_<%= interventoria.id %>" style="display:none;">
                    <% interventoria.contrato.contratosimagenes.order(created_at: :DESC).each do |img| %>
                      <%= link_to img.imagen_file_name, img.imagen.url(:original, false),
                                  class: 'popup', style: 'font-size:10px;' %><br/>
                    <% end %>
                  </div>
                <% else %>
                  <strong><%= persona&.nombre_completo %></strong>
                <% end %>
              </td>
              <td class="text-center"><%= interventoria.anno %> - <%= descmesmin(interventoria.mes) rescue interventoria.mes %></td>
            </tr>
          <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="text-center" style="padding:20px; color:#888;">
          <i class="fa fa-check-circle" style="font-size:24px; color:#27ae60;"></i>
          <p style="margin-top:8px;">No hay cuentas de cobro pendientes de revisión.</p>
        </div>
      <% end %>
    </div>
  </div>

<% end %>

<%
  anno_actual   = Date.today.year.to_s
  anno_anterior = (Date.today.year - 1).to_s
  mes_actual_i  = Date.today.month

  objetos_actual = @objetos_actual.presence || (1..mes_actual_i).to_a.reverse.map do |m|
    OpenStruct.new(ano: anno_actual, mes: m.to_s, mesc: m.to_s.rjust(2, '0'))
  end

  objetos_anterior = @objetos_anterior.presence || (1..12).to_a.reverse.map do |m|
    OpenStruct.new(ano: anno_anterior, mes: m.to_s, mesc: m.to_s.rjust(2, '0'))
  end
%>

<%# ── CUENTAS REVISADAS AÑO ACTUAL ───────────────────────────────────────── %>
<div class="box box-default box-solid" style="margin-bottom:16px;">
  <div class="box-header with-border">
    <h3 class="box-title"><i class="fa fa-history"></i> Cuentas Revisadas — <%= anno_actual %></h3>
  </div>
  <div class="box-body">
    <% if objetos_actual.any? %>
      <% objetos_actual.each do |objeto| %>
        <%
          intervs = Interventoria
            .includes(contratosperfecha: :contratospersona)
            .where(anno: objeto.ano, mes: objeto.mes, estado: %w[APROBADOGH TESORERIA])
            .order(updated_at: :asc)
        %>
        <div style="margin-bottom:8px;">
          <a href="javascript:void(0);"
             onclick="$('#rev_gh_<%= objeto.ano %>_<%= objeto.mes %>').toggle();"
             style="font-weight:700; font-size:13px;">
            <i class="fa fa-chevron-right"></i>
            <%= objeto.ano %> - <%= descmesmin(objeto.mes) %>
            <span class="badge"><%= intervs.count %></span>
          </a>
        </div>
        <div id="rev_gh_<%= objeto.ano %>_<%= objeto.mes %>" style="display:none; margin-bottom:12px;">
          <% if intervs.any? %>
            <table class="table table-bordered table-condensed table-striped" style="font-size:12px;">
              <thead>
              <tr class="thcolor">
                <th width="18%" class="text-center">Acción</th>
                <th width="15%" class="text-center">Fecha</th>
                <th width="12%" class="text-center">Nro. Contrato</th>
                <th width="12%" class="text-center">Estado</th>
                <th class="text-center">Contratista</th>
                <th width="15%" class="text-center">Periodo</th>
              </tr>
              </thead>
              <tbody>
              <% intervs.each do |interventoria| %>
                <% persona = interventoria.contratosperfecha&.contratospersona %>
                <tr class="<%= cycle('even1', 'odd1') %>">
                  <td class="text-center">
                    <%= link_to verificacion_interventorias_path(id: interventoria.id),
                                class: 'btn btn-xs btn-info popup', title: 'Ver informe' do %>
                      <i class="fa fa-file-pdf-o"></i> Informe
                    <% end %>
                  </td>
                  <td class="text-center"><%= interventoria.updated_at&.strftime("%Y-%m-%d %H:%M") %></td>
                  <td class="text-center"><%= interventoria.contrato&.nro_contrato %></td>
                  <td class="text-center"><%= interventoria.estado %></td>
                  <td><strong><%= persona&.identificacion %> - <%= persona&.nombre_completo %></strong></td>
                  <td class="text-center"><%= interventoria.anno %> - <%= descmesmin(interventoria.mes) rescue interventoria.mes %></td>
                </tr>
              <% end %>
              </tbody>
            </table>
          <% else %>
            <div class="text-center" style="padding:12px; color:#888;">
              <i class="fa fa-info-circle"></i> No hay cuentas de cobro.
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <p class="text-muted"><i class="fa fa-info-circle"></i> Sin cuentas revisadas este año.</p>
    <% end %>
  </div>
</div>

<%# ── CUENTAS AÑO ANTERIOR ───────────────────────────────────────────────── %>
<div class="box box-default box-solid">
  <div class="box-header with-border">
    <h3 class="box-title"><i class="fa fa-archive"></i> Cuentas Revisadas — <%= anno_anterior %></h3>
  </div>
  <div class="box-body">
    <% if objetos_anterior.any? %>
      <% objetos_anterior.each do |objeto| %>
        <%
          intervs = Interventoria
            .includes(contratosperfecha: :contratospersona)
            .where(anno: objeto.ano, mes: objeto.mes, estado: %w[APROBADOGH TESORERIA])
            .order(updated_at: :asc)
        %>
        <div style="margin-bottom:8px;">
          <a href="javascript:void(0);"
             onclick="$('#rev_gh_<%= objeto.ano %>_<%= objeto.mes %>').toggle();"
             style="font-weight:700; font-size:13px;">
            <i class="fa fa-chevron-right"></i>
            <%= objeto.ano %> - <%= descmesmin(objeto.mes) %>
            <span class="badge"><%= intervs.count %></span>
          </a>
        </div>
        <div id="rev_gh_<%= objeto.ano %>_<%= objeto.mes %>" style="display:none; margin-bottom:12px;">
          <% if intervs.any? %>
            <table class="table table-bordered table-condensed table-striped" style="font-size:12px;">
              <thead>
              <tr class="thcolor">
                <th width="18%" class="text-center">Acción</th>
                <th width="15%" class="text-center">Fecha</th>
                <th width="12%" class="text-center">Nro. Contrato</th>
                <th width="12%" class="text-center">Estado</th>
                <th class="text-center">Contratista</th>
                <th width="15%" class="text-center">Periodo</th>
              </tr>
              </thead>
              <tbody>
              <% intervs.each do |interventoria| %>
                <% persona = interventoria.contratosperfecha&.contratospersona %>
                <tr class="<%= cycle('even1', 'odd1') %>">
                  <td class="text-center">
                    <%= link_to verificacion_interventorias_path(id: interventoria.id),
                                class: 'btn btn-xs btn-info popup', title: 'Ver informe' do %>
                      <i class="fa fa-file-pdf-o"></i> Informe
                    <% end %>
                  </td>
                  <td class="text-center"><%= interventoria.updated_at&.strftime("%Y-%m-%d %H:%M") %></td>
                  <td class="text-center"><%= interventoria.contrato&.nro_contrato %></td>
                  <td class="text-center"><%= interventoria.estado %></td>
                  <td><strong><%= persona&.identificacion %> - <%= persona&.nombre_completo %></strong></td>
                  <td class="text-center"><%= interventoria.anno %> - <%= descmesmin(interventoria.mes) rescue interventoria.mes %></td>
                </tr>
              <% end %>
              </tbody>
            </table>
          <% else %>
            <div class="text-center" style="padding:12px; color:#888;">
              <i class="fa fa-info-circle"></i> No hay cuentas de cobro.
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <p class="text-muted"><i class="fa fa-info-circle"></i> Sin cuentas del año anterior.</p>
    <% end %>
  </div>
</div>
