$("#contratosprefimagen_form").collapse("hide");

$("#contratosprefimagen_form").empty();

<% if @active_record.present? %>
	$("#contratosprefimagen_<%= @active_record.id %>").replaceWith("<%= j render 'tr', contratosprefimagen: @active_record %>");
<% end %>

$("#contratosprefimagen_<%= @contratosprefimagen.id %>").html("<td colspan='12'><%= j render 'form' %></td>");

$("#contratosprefimagen_<%= @contratosprefimagen.id %>").addClass("active_contratosprefimagen");

$(".select2").select2();

$(".tooltip").tooltip("hide");

$('[data-toggle="tooltip"]').tooltip();
$(".datetimepicker").datetimepicker();