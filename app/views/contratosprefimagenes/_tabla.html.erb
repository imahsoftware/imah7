<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
	  <thead class="thcolor">
      <tr>
        <td width="10%"></td>
        <th width="20%" class="text-left">Fecha</th>
        <th width="25%" class="text-left">Descripción</th>
        <th class="text-left">Imagen</th>
      </tr>
    </thead>
	  <tbody id="tbody_contratosprefimagenes">
	    <% @contratosprefactura.contratosprefimagenes.order(id: :desc).each do |contratosprefimagen| %>
	      <%= render 'contratosprefimagenes/tr', contratosprefimagen: contratosprefimagen %>
	    <% end %>
	  </tbody>
	</table>
</div>