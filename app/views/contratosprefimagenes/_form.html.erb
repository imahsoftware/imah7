<%= simple_form_for([@contratosprefactura, @contratosprefimagen], remote: true) do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
        <%= f.input :descripcion%>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
        <%= f.input :facturasimagen, as: :file, label: "Documento" %>
      </div>
    </div><br/>
    <div class="row">
      <div class="col-md-6">
        <% if @contratosprefimagen.new_record? %>
          <%= button_tag "#{t :cancelar}", type: 'button', data: {target: '#contratosprefimagen_form'}, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}", contratosprefactura_contratosprefimagen_path(@contratosprefactura, @contratosprefimagen), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
<br/>