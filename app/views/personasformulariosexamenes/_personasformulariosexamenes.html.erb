<div class="box-body paddin-body">
  <div class="row">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header">
          <h4 class="box-title"><strong>Examenes</strong>
            <div class="box-tools pull-right">
              <% if is_auth_c("examensst") %>
                <% #if !@personasformulario.personasformulariosexamenes.present? %>
                  <%= link_to new_personasformulario_personasformulariosexamen_path(@personasformulario), id: 'new_personasformulariosexamen_button', class: 'btn btn-sm btn-warning', remote: true do %>
                    <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
                  <% end %>
                <% #end %>
              <% end %>
            </div>
          </h4>
        </div>
        <div class="card-body" style="padding-top: 10px">
          <div id="personasformulariosexamen_form" class="collapse"></div>
          <div id="personasformulariosexamenes" style="margin-top: 10px;">
            <% if @personasformulario.personasformulariosexamenes.any? %>
              <%= render 'personasformulariosexamenes/tabla' %>
            <% else %>
              <%= render 'layouts/procesos/alert_message' %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

