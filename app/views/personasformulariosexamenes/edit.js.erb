<% if @active_record.present? %>
	$("#personasformulariosexamen_<%= @active_record.id %>").replaceWith("<%= j render 'tr', personasformulariosexamen: @active_record %>");
<% end %>

$("#personasformulariosexamen_<%= @personasformulariosexamen.id %>").html("<td colspan='8'><%= j render 'form' %></td>");
$("#personasformulariosexamen_<%= @personasformulariosexamen.id %>").addClass("active_personasformulariosexamen");
$("#personasformulariosexamen_form").empty();
$("#personasformulariosexamen_form").collapse("hide");
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
$('.wysihtml5').wysihtml5({ 'toolbar': {
        'font-styles': false,
        'color': false,
        'emphasis': {
            'small': false
        },
        'blockquote': false,
        'lists': false,
        'html': false,
        'link': false,
        'image': false,
        'smallmodals': false
    }})

// Selector normal
$(document).ready(function () {
    $('.js-searchable').select2({
        allowClear: true,
        width: '100%',
        placeholder: '-- Seleccionar --'
    });
});

/// Calendario

$(".datetimepicker").datetimepicker({
    showClear: true
});


/// Convierte texto en mayuscula
$('.uppercaseInput').keyup(function () {
    $(this).val($(this).val().toUpperCase());
});

$(".select2").select2();

$(function () {
    return $('.select2Ciudad').select2({
        minimumInputLength: 3,
        maximumInputLength: 20,
        placeholder: "[ Seleccionar Ciudad... ]",
        ajax: {
            url: '/personasformularios/search.json',
            dataType: 'json',
            delay: 250,
            data: function (params) {
                return {
                    q: params.term,
                    page: params.page
                };
            },
            processResults: function (data) {
                return {
                    results: $.map(data, function (item) {
                        return {
                            text: item.name,
                            id: item.id
                        };
                    })
                };
            }
        }
    });
});

$('.datepicker').datepicker({
    dayNamesMin: [ "Dom", "Lun", "Mar", "Mie", "Jue", "Vie", "Sáb" ],
    monthNamesShort: [ "Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic" ],
    dateFormat: "yy-mm-dd",
    yearRange: '1950:2027',
    changeMonth: true,
    changeYear: true,
});