<table class="table table-bordered table-condensed table-striped">
  <thead>
  <tr class="thcolor">
    <% if is_tipoconsulta != "CANDIDATO" %>
      <td width="10%"></td>
    <% end %>
    <th width="10%" class="text-center">Tipo</th>
    <th class="text-left">Examen</th>
    <th width="33%" class="text-left">Direccion</th>
    <th width="15%" class="text-center">Fecha y hora</th>
    <th width="10%" class="text-center">Estado</th>
  </tr>
  </thead>
  <tbody id="tbody_personasformulariosexamenes">
  <% @personasformulario.personasformulariosexamenes.order(id: :desc).each do |personasformulariosexamen| %>
    <%= render 'personasformulariosexamenes/tr', personasformulariosexamen: personasformulariosexamen %>
  <% end %>
  </tbody>
</table>