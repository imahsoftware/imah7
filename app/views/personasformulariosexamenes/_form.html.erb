<%= simple_form_for([@personasformulario, @personasformulariosexamen], remote: true) do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6"><%= f.input :descripcion, as: :text,:input_html => {:onchange => "javascript:this.value=this.value.toUpperCase();", :rows => 2 }, label: "Descripción del examen requerido" %></div>
      <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6"><%= f.input :direccion, as: :text,:input_html => {:onchange => "javascript:this.value=this.value.toUpperCase();", :rows => 2 }, label: "Direccion Sitio" %></div>
    </div>
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :recomendaciones, as: :text,:input_html => {:onchange => "javascript:this.value=this.value.toUpperCase();", :rows => 2 }, label: "Recomendaciones" %></div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :tipo, collection: Iparametro.where(campo: 'tipo_examen').order(:descripcion).collect { |p| [p.descripcion.to_s, p.descripcion.to_s] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: 'Tipo' %></div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :fecha, as: :string, input_html: { class: 'datepicker', data: {date_options: {format: 'DD/MM/YYYY', ignoreReadonly: true}}, readonly: true } %></div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :hora %></div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :estado, as: :select, collection: select_estadoexamen, input_html: { data: { width: '100%' }, class: 'select2'}%></div>
    </div>
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6"><%= f.input :observacion_eps, as: :text,:input_html => {:onchange => "javascript:this.value=this.value.toUpperCase();", class: "wysihtml5", :rows => 4 }, label: "Observación Notificación Examen" %></div>
      <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6"><%= f.input :observacion_interna, as: :text,:input_html => {:onchange => "javascript:this.value=this.value.toUpperCase();", class: "wysihtml5", :rows => 4 }, label: "Observación Interna" %></div>
    </div>
    <div class="row">
      <div class="col-md-6">
        <% if @personasformulariosexamen.new_record? %>
          <%= link_to "Cancelar", cancelar_personasformulariosexamenes_path, remote: true, class: 'cancel_button btn btn-flat btn-warning pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "Cancelar", personasformulario_personasformulariosexamen_path(@personasformulario, @personasformulariosexamen), class: 'btn btn-warning float-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "Guardar", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>

