<% if @parcargo.parcargosdocs.present? %>
	$("#parcargosdocs").html("<%= j render 'tabla' %>");
<% else %>
	$("#tbody_parcargosdocs").prepend("<%= j render 'tr', parcargosdoc: @parcargosdoc %>");
<% end %>

$(".clean").val("").trigger('change');
$('[data-toggle="tooltip"]').tooltip();
$( ":input" ).removeClass("is-invalid");
$("[for='inputError']").remove();
$("#parcargosdoc_form").collapse("hide");