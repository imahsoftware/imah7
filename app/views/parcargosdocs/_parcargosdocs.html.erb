
  <div class="box-body paddin-body">
    <div class="row">
      <div class="col-md-12">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title"> Documentos del Cargo
              <div class="pull-right">
                <%= link_to new_parcargo_parcargosdoc_path(@parcargo), id: 'new_contratoscaractividad_button', class: 'btn btn-sm btn-warning', remote: true do %>
                  <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
                <% end %>
              </div>
            </h3>
          </div>

          <div class="card-body">
            <div id="parcargosdoc_form" class="collapse"></div>
            <div id="parcargosdocs" style="margin-top: 10px;">
              <% if @parcargo.parcargosdocs.any? %>
                <%= render 'parcargosdocs/tabla' %>
              <% else %>
                <%= render 'layouts/procesos/alert_message' %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

