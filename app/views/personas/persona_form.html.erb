                          <th width="40%"><div align="left">Empresa</div></th>
                          <th width="5%"><div align="center"><span data-toggle="tooltip" data-original-title="1. ¿Tienes sensación de falta de aire de inicio brusco (en ausencia de cualquier otra patología que justifique este síntoma)?">P1</span></div></th>
                          <th width="5%"><div align="center"><span data-toggle="tooltip" data-original-title="2. ¿Tienes fiebre de difícil control por más de 3 días? (+ 37,8°C)">P2</span></div></th>
                          <th width="5%"><div align="center"><span data-toggle="tooltip" data-original-title="3. ¿Tienes tos seca y persistente?">P3</span></div></th>
                          <th width="5%"><div align="center"><span data-toggle="tooltip" data-original-title="4. ¿Tienes sensación de fatiga o cansancio muscular?">P4</span></div></th>
                          <th width="5%"><div align="center"><span data-toggle="tooltip" data-original-title="5. ¿Tienes secreciones nasales?">P5</span></div></th>
                          <th width="5%"><div align="center"><span data-toggle="tooltip" data-original-title="6. ¿Tienes dolor de garganta o dolor de cabeza?">P6</span></div></th>
                          <th width="5%"><div align="center"><span data-toggle="tooltip" data-original-title="7. ¿Tienes pérdida del olfato y/o el gusto?">P7</span></div></th>
                          <th width="5%"><div align="center"><span data-toggle="tooltip" data-original-title="8. ¿Tienes sensación de malestar general?">P8</span></div></th>
                          <th width="5%"><div align="center"><span data-toggle="tooltip" data-original-title="9. ¿Tienes trastornos gástricos o intestinales (náuseas, vómito, diarrea)">P9</span></div></th>
                        </tr>
                        <tbody>
                        <% @personasevaluacionesinf.each do |personasevaluacion| %>
                          <tr>
                            <td><div align="center"><%= personasevaluacion.created_at.strftime("%Y-%m-%d %X") rescue nil %></div></td>
                            <td>
                              <div align="left"><%= link_to personasevaluacion_path(id: personasevaluacion.id), data: {toggle: 'tooltip'}, class: 'popup', title: 'Ver Evaluación' do %>
                                  <i class="fa fa-clone"></i>
                                <% end %>
                                <strong><%= personasevaluacion.persona.nombreportafolio rescue nil %>
                                <small><%= personasevaluacion.persona.centrodetrabajo rescue nil %></small></strong>
                              </div>
                            </td>
                            <td <% if personasevaluacion.eva_1.to_s == 'SI' %>class="thcolorred"<% end%>><div align="center"><%= personasevaluacion.eva_1 rescue nil %></div></td>
                            <td <% if personasevaluacion.eva_2.to_s == 'SI' %>class="thcolorred"<% end%>><div align="center"><%= personasevaluacion.eva_2 rescue nil %></div></td>
                            <td <% if personasevaluacion.eva_3.to_s == 'SI' %>class="thcolorred"<% end%>><div align="center"><%= personasevaluacion.eva_3 rescue nil %></div></td>
                            <td <% if personasevaluacion.eva_4.to_s == 'SI' %>class="thcolorred"<% end%>><div align="center"><%= personasevaluacion.eva_4 rescue nil %></div></td>
                            <td <% if personasevaluacion.eva_5.to_s == 'SI' %>class="thcolorred"<% end%>><div align="center"><%= personasevaluacion.eva_5 rescue nil %></div></td>
                            <td <% if personasevaluacion.eva_6.to_s == 'SI' %>class="thcolorred"<% end%>><div align="center"><%= personasevaluacion.eva_6 rescue nil %></div></td>
                            <td <% if personasevaluacion.eva_7.to_s == 'SI' %>class="thcolorred"<% end%>><div align="center"><%= personasevaluacion.eva_7 rescue nil %></div></td>
                            <td <% if personasevaluacion.eva_8.to_s == 'SI' %>class="thcolorred"<% end%>><div align="center"><%= personasevaluacion.eva_8 rescue nil %></div></td>
                            <td <% if personasevaluacion.eva_9.to_s == 'SI' %>class="thcolorred"<% end%>><div align="center"><%= personasevaluacion.eva_9 rescue nil %></div></td>
                          </tr>
                        <% end %>
                        </tbody>
                      </table>
                    <% else %>
                      <div class="alert alert-success" align="justify">
                        <h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4>
                        No hay información
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
