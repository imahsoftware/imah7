<%= simple_form_for(@persona) do |f| %>
  <div class="box box-danger">
    <div class="box-header">
      <legend>
        Información Básica Persona
      </legend>
    </div>
    <div class="box-body">
      <table width="100%">
        <tr>
          <td width="80%">
            <div class="row">
              <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
                <%= f.input :identificacion, input_html: {:onchange => "javascript:this.value=this.value.toUpperCase();"}, label: 'Identificación' %>
              </div>
              <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                <%= f.input :nombre, :input_html => {:onChange => "javascript:this.value=this.value.toUpperCase();"}, label: 'Nombres' %>
              </div>
            </div>
          </td>
        </tr>
      </table>
    </div>
    <div class="box-footer">
      <div class="box-tools pull-right">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-warning pull-right" %>
      </div><!-- /.box-tools -->
    </div>
  </div>
<% end %>