<div class="box-header">
  <h3 class="box-title"><strong>Solicitudes EPP</strong></h3>
  <div class="box-tools pull-right">
    <%# if is_auth_c('contratossolepp') %>
    <% if Time.now.strftime("%d").to_i <= Parametro.find(20).valor.to_i %>
      <%= link_to new_contratossolepp_path, remote: true, class: 'btn btn-sm btn-success', id: 'new_visita_button', data: { toggle: 'tooltip' }, title: 'Agregar' do %>
        <i class="fa fa-plus-square"> </i> Agregar<span></span>
      <% end %>
    <% end %>
    <%# end %>
  </div>
</div>
<% isadmin = is_admin
   bloqueoporepp = 'NO'
   if Objeto.find_by_sql("SELECT * FROM view_eppsinfirmar WHERE user_id = #{isadmin}").present?
     bloqueoporepp = 'SI'
   end
   if bloqueoporepp == 'SI' %>
  <br/><div class="alert alert-danger">
  <h4><i class="icon fa fa-info"></i> Que paso? </h4>Tienes EPP despachados y no firmados, es indispensable finalizar el proceso.... hasta que no termines no puedes continuar con tus actividades. Asi que realizalo YA!</div>
<% end %>

<div class="box-body">
  <div class="flash_messages"></div>
  <div id="contratossolepp_form" class="collapse"></div>
  <div id="contratossolepps">
    <% if @contratossolepps.any? %>
      <%= render 'contratossolepps/tabla' %>
    <% else %>
      <div class="alert alert-danger"><i class="icon fa fa-info"></i> <%= t :atencion %> <%= t :atencion_msj %></div>
    <% end %>
  </div>
</div>
