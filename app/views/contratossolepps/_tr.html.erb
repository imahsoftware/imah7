<tr id="contratossolepp_<%= contratossolepp.id %>">
  <td class="text-center">

    <div class="btn-group" id="botones<%= contratossolepp.id %>">
      <button type="button" class="btn btn-warning dropdown-toggle btn-xs" data-toggle="dropdown">
        Opciones <span class="caret"></span>
        <span class="sr-only">Toggle Dropdown</span>
      </button>
      <ul class="dropdown-menu" role="menu">
        <li>
          <%= link_to complementar_contratossolepps_path(id: contratossolepp.id, etapa: 'A'), class: 'edit_contratossolepp_button',  data: { toggle: 'tooltip' } do %>
            <div class="text-orange"><i class="fa fa-edit"></i> Editar solicitud</div>
          <% end %>
        </li>
        <li>
          <%= link_to ver_contratossolepps_path(id: contratossolepp.id), data: { toggle: 'tooltip' }, class: 'popup' do %>
            <div class="text-blue"><i class="fa fa-clone"></i> Ver solicitud</div>
          <% end %>
        </li>
        <% if contratossolepp.estado == 'PENDIENTE' %>
          <li>
          <%= link_to contratossolepp_path(id: contratossolepp.id), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
              <div class="text-blue"><i class="fa fa-trash"></i> Eliminar Solicitud</div>
          <% end %>
          </li>
        <% end %>
      </ul>
    </div>

  </td>
  <td class="text-left text-tr-table"><%= contratossolepp.created_at.strftime("%Y-%m-%d %X") rescue nil %> - <%= contratossolepp.user.username rescue nil %></td>
  <td class="text-tr-table">
    <small><%= contratossolepp.contrato.empresa.identnombre rescue nil %>
      <br/><strong>Nro Contrato : </strong><%= contratossolepp.contrato.nro_contrato rescue nil %></small>
  </td>
  <td class="text-tr-table text-center"><%= contratossolepp.estado rescue nil %></td>
</tr>
