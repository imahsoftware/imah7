<% if @active_record.present? %>
	$("#contratossolepp_<%= @active_record.id %>").replaceWith("<%= j render 'tr', contratossolepp: @active_record %>");
<% end %>
$("#contratossolepp_form").html("<%= j render 'form' %>");
$(".datetimepicker").datetimepicker({
	showClear: true
});
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
$("#contratossolepp_form").collapse("show");
$(".select2").select2();


$(function() {
	return $('.select2User').select2({
		minimumInputLength: 3,
		maximumInputLength: 20,
		placeholder: "[ Seleccionar Usuario... ]",
		ajax: {
			url: '/menus/searchUser.json',
			dataType: 'json',
			delay: 250,
			data: function(params) {
				return {
					q: params.term,
					page: params.page
				};
			},
			processResults: function(data) {
				return {
					results: $.map(data, function(item) {
						return {
							text: item.name,
							id: item.id
						};
					})
				};
			}
		}
	});
});
