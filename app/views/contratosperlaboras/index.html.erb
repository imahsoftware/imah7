<p id="notice"><%= notice %></p>

<h1>Contratosperlaboras</h1>

<table>
  <thead>
    <tr>
      <th>Contratosperfecha</th>
      <th>Contratospersona</th>
      <th>Anno</th>
      <th>Mes</th>
      <th>Labora</th>
      <th>User asigna</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @contratosperlaboras.each do |contratosperlabora| %>
      <tr>
        <td><%= contratosperlabora.contratosperfecha %></td>
        <td><%= contratosperlabora.contratospersona %></td>
        <td><%= contratosperlabora.anno %></td>
        <td><%= contratosperlabora.mes %></td>
        <td><%= contratosperlabora.labora %></td>
        <td><%= contratosperlabora.user_asigna %></td>
        <td><%= link_to 'Show', contratosperlabora %></td>
        <td><%= link_to 'Edit', edit_contratosperlabora_path(contratosperlabora) %></td>
        <td><%= link_to 'Destroy', contratosperlabora, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Contratosperlabora', new_contratosperlabora_path %>
