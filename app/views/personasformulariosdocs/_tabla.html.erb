<legend>Documentos Obligatorios</legend>
<%
  is_auth_c_contratacionaprobar = is_auth_c("contratacionaprobar")
  is_auth_c_contratosdocvalidacion = is_auth_c("contratosdocvalidacion")
%>
<table class="table table-bordered table-condensed table-striped">
  <% Parcargosdoc.where("parcargo_id = #{@personasformulario.parcargo_id} and obligatorio = 'SI'").each do |p| %>
    <% compromiso = Compromiso.where("parcargosdoc_id = #{p.id} and personasformulario_id = #{@personasformulario.id}").first rescue nil %>
  <tr>
    <th class="text-left text-table" width="20%">
      <div style="padding: 20px 10px 30px 10px;"><%= p.descripcion %><br/><small><em>Obligatorio:
        (<%= p.obligatorio rescue nil %>)</em></small>
        <br/>
        <%= link_to abrir_compromiso_personasformularios_path(personasformulario_id: @personasformulario.id, parcargosdoc_id: p.id), remote: true, data: { toggle: 'tooltip' } do %>
          <% if compromiso.present? %>
            <button class="btn btn-xs btn-success"><i class="fa fa-sticky-note"></i> Ver Compromiso</button>
          <% else %>
            <button class="btn btn-xs btn-primary"><i class="fa fa-plus"></i> Agregar Compromiso</button>
          <% end %>
        <% end %>

      </div>
      <div class="modal fade" id="abrir_compromiso<%= @personasformulario.id rescue nil %><%= p.id %>">
        <div class="modal-dialog modal-dialog-responsive" role="document">
          <div class="modal-content">
          </div>
        </div>
      </div>
    </th>
    <td width="50%">
      <% if @personasformulario.personasformulariosdocs.where("parcargosdoc_id = #{p.id}").present? %>
        <% if is_auth_c_contratacionaprobar or is_auth_c_contratosdocvalidacion %>
          <%= link_to abrir_documento_personasformulariosdocs_path(parcargosdoc_id: p.id, personasformulario_id: @personasformulario.id), remote: true, data: { toggle: 'tooltip' }, title: "Cargar Soporte Digital" do %>
            <button class="btn btn-xs btn-warning"><i class="fa fa-file-pdf-o">Cargar..</i></button>
          <% end %>
          <div class="modal fade" id="abrirdoc<%= p.id %>">
            <div class="modal-dialog">
              <div class="modal-content">
              </div>
            </div>
          </div>
        <% end %>
        <table class="table table-bordered table-condensed table-striped">
          <thead>
          <tr class="thcolor">
            <th width="10%"></th>
            <th width="16%" class="text-center text-table">Estado</th>
            <th class="text-left text-table">Soporte Digital</th>
          </tr>
          </thead>
          <tbody id="tbody_personasformulariosdocs">
          <% @personasformulario.personasformulariosdocs.where("parcargosdoc_id = #{p.id}").order(id: :desc).each do |personasformulariosdoc| %>
            <%= render 'personasformulariosdocs/tr', personasformulariosdoc: personasformulariosdoc, obl: "obl" %>
          <% end %>
          </tbody>
        </table>
      <% else %>
        <% if is_auth_c_contratacionaprobar or is_auth_c_contratosdocvalidacion %>
          <%= link_to abrir_documento_personasformulariosdocs_path(parcargosdoc_id: p.id, personasformulario_id: @personasformulario.id), remote: true, data: { toggle: 'tooltip' }, title: "Cargar Soporte Digital" do %>
            <button class="btn btn-xs btn-warning"><i class="fa fa-file-pdf-o">Cargar..</i></button>
          <% end %>
          <div class="modal fade" id="abrirdoc<%= p.id %>">
            <div class="modal-dialog">
              <div class="modal-content">
              </div>
            </div>
          </div>
        <% end %>
        <div style="font-size: 14px; width: 100%; background-color: #d73925; color: white; height: auto; border-radius: 5px; padding: 10px;">
          No hay documentos cargados
        </div>
      <% end %>
    </td>
  </tr>
  <% end %>
</table>

<legend>Documentos Opcionales</legend>
<table class="table table-bordered table-condensed table-striped">
  <% Parcargosdoc.where("parcargo_id = #{@personasformulario.parcargo_id} and obligatorio = 'NO'").each do |p| %>
    <tr>
      <th class="text-left text-table" width="20%">
        <div style="padding: 20px 10px 30px 10px;"><%= p.descripcion %><br/><small><em>Obligatorio:
          (<%= p.obligatorio rescue nil %>)</em></small></div>
      </th>
      <td width="50%">
        <% if @personasformulario.personasformulariosdocs.where("parcargosdoc_id = #{p.id}").present? %>
          <% if is_auth_c_contratacionaprobar or is_auth_c_contratosdocvalidacion %>
            <%= link_to abrir_documento_personasformulariosdocs_path(parcargosdoc_id: p.id, personasformulario_id: @personasformulario.id), remote: true, data: { toggle: 'tooltip' }, title: "Cargar Soporte Digital" do %>
              <button class="btn btn-xs btn-warning"><i class="fa fa-file-pdf-o">Cargar..</i></button>
            <% end %>
            <div class="modal fade" id="abrirdoc<%= p.id %>">
              <div class="modal-dialog">
                <div class="modal-content">
                </div>
              </div>
            </div>
          <% end %>
          <table class="table table-bordered table-condensed table-striped">
            <thead>
            <tr class="thcolor">
              <th width="10%"></th>
              <th width="10%" class="text-center text-table">Estado</th>
              <th class="text-left text-table">Soporte Digital</th>
            </tr>
            </thead>
            <tbody id="tbody_personasformulariosdocs">
            <% @personasformulario.personasformulariosdocs.where("parcargosdoc_id = #{p.id}").order(id: :desc).each do |personasformulariosdoc| %>
              <%= render 'personasformulariosdocs/tr', personasformulariosdoc: personasformulariosdoc, obl: "opc" %>
            <% end %>
            </tbody>
          </table>
        <% else %>
          <% if is_auth_c_contratacionaprobar or is_auth_c_contratosdocvalidacion %>
            <%= link_to abrir_documento_personasformulariosdocs_path(parcargosdoc_id: p.id, personasformulario_id: @personasformulario.id), remote: true, data: { toggle: 'tooltip' }, title: "Cargar Soporte Digital" do %>
              <button class="btn btn-xs btn-warning"><i class="fa fa-file-pdf-o">Cargar..</i></button>
            <% end %>
            <div class="modal fade" id="abrirdoc<%= p.id %>">
              <div class="modal-dialog">
                <div class="modal-content">
                </div>
              </div>
            </div>
          <% end %>
          <div style="font-size: 14px; width: 100%; background-color: #d73925; color: white; height: auto; border-radius: 5px; padding: 10px;">
            No hay documentos cargados
          </div>
        <% end %>
      </td>
    </tr>
  <% end %>
</table>
