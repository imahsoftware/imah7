<% if @active_record.present? %>
	$("#tiposcargo_<%= @active_record.id %>").replaceWith("<%= j render 'tr', tiposcargo: @active_record %>");
<% end %>
$("#tiposcargo_form").html("<%= j render 'form' %>");
$(".datetimepicker").datetimepicker();
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
$("#tiposcargo_form").collapse("show");
$(".select2").select2();