$("#tiposcargo_form").collapse("hide");

$("#tiposcargo_form").empty();

<% if @active_record.present? %>
	$("#tiposcargo_<%= @active_record.id %>").replaceWith("<%= j render 'tr', tiposcargo: @active_record %>");
<% end %>

$("#tiposcargo_<%= @tiposcargo.id %>").html("<td colspan='5'><%= j render 'form' %></td>");

$("#tiposcargo_<%= @tiposcargo.id %>").addClass("active_tiposcargo");
$(".datetimepicker").datetimepicker();
$(".select2").select2();

$(".tooltip").tooltip("hide");

$('[data-toggle="tooltip"]').tooltip();