<%= simple_form_for @tiposcargo, remote: true do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5">
        <%= f.input :descripcion, input_html: {:onchange => "javascript:this.value=this.value.toUpperCase();"} %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
        <%= f.input :perfil, as: :text,:input_html => {:onchange => "javascript:this.value=this.value.toUpperCase();", :rows => 4 } %>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <% if @tiposcargo.new_record? %>
          <%= button_tag "#{t :cancelar}", type: 'button', data: { target: '#tiposcargo_form' }, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}", tiposcargo_path(@tiposcargo), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
<br/>
