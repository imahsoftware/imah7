<div class="box-header">
  <h3 class="box-title"><strong>Detalles</strong></h3>
  <div class="box-tools pull-right">
      <%# if is_auth_c('contratossoleppsdetalle') %>
    <% if ['PENDIENTE', 'RECHAZADO'].include?(@contratossolepp.estado) %>
      <%= link_to new_contratossolepp_contratossoleppsdetalle_path(@contratossolepp), id: 'new_contratossoleppsdetalle_button', class: 'btn btn-sm btn-info', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
      <% end %>
    <% end %>
      <%# end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="contratossoleppsdetalle_form" class="collapse"></div>
  <div id="contratossoleppsdetalles">
    <% if @contratossolepp.contratossoleppsdetalles.present? %>
      <%= render 'contratossoleppsdetalles/tabla' %>
    <% else %>
      <div class="alert alert-danger"><i class="icon fa fa-info"></i> <%= t :atencion %> - <%= t :atencion_msj %></div>
    <% end %>
  </div>
</div>

