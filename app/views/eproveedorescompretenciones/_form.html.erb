<%= simple_form_for(@eproveedorescompretencion) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.association :eproveedorescompra %>
    <%= f.association :tipospretencion %>
    <%= f.input :valor %>
  </div>

  <div class="form-actions">
    <%= f.button :submit %>
  </div>
<% end %>
