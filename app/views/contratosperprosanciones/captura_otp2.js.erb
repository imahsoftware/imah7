<% if @valida %>
$("#otp2<%= @contratosperprosancion.id %>").modal("hide");
$("#firmado_check<%= @contratosperprosancion.id %>").html(" <div> <b>Firmado:</b> <i class='fa fa-check text-success'></i> - <b>Fecha: </b><%= @contratosperprosancion.codigo_fecha.strftime('%Y-%m-%d %X') rescue nil %> <br/> <b>Usuario:</b> <%= User.find(@contratosperprosancion.user_firma).nombre rescue nil %></div>");
$("#remove_boton<%= @contratosperprosancion.id %>").remove();
$("#remove_boton_citacion_<%= @contratosperprosancion.id %>").remove();
<% else %>
$("#mensaje<%= @contratosperprosancion.id %>").replaceWith("<div class='row' id='mensaje'><div class='col-xs-12 col-sm-12 col-md-2 col-lg-2' style='text-align: center;width: 100%;margin-bottom: 30px;color: red;font-weight: 600;font-size: 20px;'>CODIGO NO VALIDO</div></div>");
<% end %>