<div class="modal-content">
  <div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span>
    </button>
    <h4 class="modal-title"><small>FIRMA EMPLEADO: <%= @contratosperprosancion.sancion rescue nil %></small></h4>
  </div>
  <div class="modal-body" style="padding: 50px">
    <div class="row" style=" background-color: #E5E5E5 !important; padding: 70px !important;border-radius: 18px !important;">
      <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <%= form_tag captura_otp2_contratosperprosanciones_path(id: @contratosperprosancion.id), remote: true, method: :post, class: 'form-inline' do %>
          <%= render 'menus/input_otp' %>
          <div class="row" id="mensaje<%= @contratosperprosancion.id %>">
            <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2 text-center"></div>
          </div>
          <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 text-center">
              <%= button_tag type: 'submit', :disable_with => "Validando...", class: 'btn btn-primary', style: "height: 60px; border-radius: 5px; background-color: #d73925 !important; border-color: #d73925;" do %>
                Verificar Codigo
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
