      <th class="text-left text-table" width="18%">Sanción</th>
      <th class="text-left text-table">Reglamento</th>
      <th class="text-center text-table" width="12%">Desvinculación</th>
    </tr>
    </thead>
    <tbody id="tbody_contratosperprosanciones">
    <% @contratosperproceso.contratosperprosanciones.order(id: :desc).each do |contratosperprosancion| %>
      <%= render 'contratosperprosanciones/tr', contratosperprosancion: contratosperprosancion %>
    <% end %>
    </tbody>
  </table>
</div>
