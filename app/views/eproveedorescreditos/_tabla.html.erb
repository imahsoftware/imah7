<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
	  <thead class="thcolor">
      <tr>
        <td width="10%"></td>
        <th width="10%" class="text-center">Fecha</th>
        <th width="15%" class="text-center">Numero</th>
        <th width="20%" class="text-center">Factura Compra</th>
        <th width="20%" class="text-right">Valor</th>
        <th class="text-justify">Observaciones</th>
      </tr>
    </thead>
	  <tbody id="tbody_eproveedorescreditos">
     <% @eproveedor.eproveedorescreditos.includes([:eproveedorescompra])
                   .order(id: :desc).each do |eproveedorescredito| %>
       <%= render 'eproveedorescreditos/tr', eproveedorescredito: eproveedorescredito %>
     <% end %>
	  </tbody>
	</table>

</div>
<div class="box-tools pull-right" id="page_links">
  <%#= will_paginate @eproveedorescreditos, :param_name => 'eproveedorescreditos' , renderer: BootstrapPagination::Rails %>
</div>
