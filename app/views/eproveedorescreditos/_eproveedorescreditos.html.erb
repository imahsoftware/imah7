<div class="box-header">
  <h3 class="box-title"><strong>Notas Credito</strong></h3>
  <div class="box-tools pull-right">
    <%= link_to new_eproveedor_eproveedorescredito_path(@eproveedor), id: 'new_eproveedorescredito_button', class: 'btn btn-sm btn-warning', remote: true do %>
      <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
    <% end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="eproveedorescredito_form" class="collapse"></div>
  <div id="eproveedorescreditos">
    <% if @eproveedor.eproveedorescreditos.present? %>
      <%= render 'eproveedorescreditos/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
    <% end %>
  </div>
</div>

