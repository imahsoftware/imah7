<div class="box-header">
  <h3 class="modal-title"><legend>Novedades</legend></h3>
  <div class="box-tools pull-right">
      <%= link_to new_contratospersona_contratospernovedad_path(@contratospersona), id: 'new_contratospernovedad_button', class: 'btn btn-sm btn-warning', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
      <% end %>
  </div>
</div>
<% if !Contratosperfecha.where(contratospersona_id: @contratospersona.id, estado:'ACTIVO').exists? %>
  <div class="alert alert-danger"><b><%= t :atencion %></b> NO hay un contrato activo.</div><br/><br/>
<% end %>
<div class="box-body" style="margin-top: -35px;">
  <div id="contratospernovedad_form" class="collapse"></div>
  <div id="contratospernovedades">
    <% if @contratospersona.contratospernovedades.present? %>
      <%= render 'contratospernovedades/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %></div>
    <% end %>
  </div>
</div>

