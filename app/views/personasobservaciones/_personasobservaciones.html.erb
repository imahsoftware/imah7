
  <div class="box-header">
    <h3 class="box-title"><strong>Observaciones</strong></h3>
    <div class="box-tools pull-right">
      <% if is_auth_c('personasobservacion') %>
        <%= link_to new_persona_personasobservacion_path(@persona), id: 'new_personasobservacion_button', class: 'btn btn-sm btn-info', remote: true do %>
          <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
        <% end %>
      <% end %>
    </div>
  </div>
  <div class="box-body">
    <div class="flash_messages"></div>
    <div id="personasobservacion_form" class="collapse"></div>
    <div id="personasobservaciones">
      <% if @persona.personasobservaciones.present? %>
        <%= render 'personasobservaciones/tabla' %>
      <% else %>
        <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
      <% end %>
    </div>
  </div>

