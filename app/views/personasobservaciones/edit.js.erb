$("#personasobservacion_form").collapse("hide");

$("#personasobservacion_form").empty();

<% if @active_record.present? %>
	$("#personasobservacion_<%= @active_record.id %>").replaceWith("<%= j render 'tr', personasobservacion: @active_record %>");
<% end %>

$("#personasobservacion_<%= @personasobservacion.id %>").html("<td colspan='12'><%= j render 'form' %></td>");

$("#personasobservacion_<%= @personasobservacion.id %>").addClass("active_personasobservacion");

$(".select2").select2();

$(".tooltip").tooltip("hide");

$('[data-toggle="tooltip"]').tooltip();
$(".datetimepicker").datetimepicker();