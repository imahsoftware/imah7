<% if @active_record.present? %>
	$("#personasobservacion_<%= @active_record.id %>").replaceWith("<%= j render 'tr', personasobservacion: @active_record %>");
<% end %>
$("#personasobservacion_form").html("<%= j render 'form' %>");
$(".datetimepicker").datetimepicker();
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
$("#personasobservacion_form").collapse("show");
$(".select2").select2();
