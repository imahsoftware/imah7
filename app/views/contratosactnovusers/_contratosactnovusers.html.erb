<div class="box-header">
  <h3 class="box-title"><strong>Asignaciones</strong></h3>
  <div class="box-tools pull-right">
    <% if is_auth_c('adminnovedadesmetro') %>
      <% if @contratosactnovedad.estado.to_s != 'ATENDIDO' and @contratosactnovedad.user_id != is_admin %>
        <%= link_to new_contratosactnovedad_contratosactnovuser_path(@contratosactnovedad), id: 'new_contratosactnovuser_button', class: 'btn btn-sm btn-warning', remote: true do %>
          <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="contratosactnovuser_form" class="collapse"></div>
  <div id="contratosactnovusers">
    <% if @contratosactnovedad.contratosactnovusers.order("created_at desc").present? %>
      <%= render 'contratosactnovusers/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
    <% end %>
  </div>
</div>
