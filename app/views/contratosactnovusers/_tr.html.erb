<tr id="contratosactnovuser_<%= contratosactnovuser.id %>">
  <td class="text-center">
    <% if is_auth_a('adminnovedadesmetro') %>
      <% if @contratosactnovedad.estado.to_s == 'PENDIENTE' and @contratosactnovedad.user_id == is_admin %>
        <%= link_to edit_contratosactnovedad_contratosactnovuser_path(@contratosactnovedad, contratosactnovuser), remote: true, class: 'edit_contratosmodificacion_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
          <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
        <% end %>
        <%= link_to contratosactnovedad_contratosactnovuser_path(@contratosactnovedad, contratosactnovuser), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
           <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
        <% end %>
      <% end %>
    <% end %>
  </td>
  <td align="left"><%= contratosactnovuser.created_at.strftime("%Y-%m-%d %X") rescue nil %><br/><%= contratosactnovuser.user.nombre.html_safe rescue nil %></td>
  <td align="justify"><%= User.find(contratosactnovuser.user_asig).nombre rescue nil %></td>
</tr>



