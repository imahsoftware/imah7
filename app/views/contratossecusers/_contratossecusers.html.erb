<div class="box-header">
  <h3 class="modal-title"><legend>Supervisores / Interventores</legend></h3>
  <div class="box-tools pull-right">
      <%= link_to new_contratosseccion_contratossecuser_path(@contratosseccion), id: 'new_contratossecuser_button', class: 'btn btn-sm btn-warning', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
      <% end %>
  </div>
</div>
<div class="box-body" style="margin-top: -35px;">
  <div id="contratossecuser_form" class="collapse"></div>
  <div id="contratossecusers">
    <% if @contratosseccion.contratossecusers.present? %>
      <%= render 'contratossecusers/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %></div>
    <% end %>
  </div>
</div>

