<div class="box-header">
  <h3 class="box-title"><strong>Datos Asociados por Contrato (<%=@capacitacion.contratoscapacitaciones.count.to_i rescue 0 %>)
    <% if is_auth_c('capacitacion') %>
      <%= link_to incluirtodos_capacitaciones_path(capacitacion_id: @capacitacion.id, clase: 'I'), data: { toggle: 'tooltip', confirm: "Estas Seguro que desea incluirlos todos?" }, title: "Cargar todos los contratos" do %>
        <button class="btn btn-xs btn-success"><i class="fa fa-check"></i> Incluir Todos</button>
      <% end %> - <%= link_to incluirtodos_capacitaciones_path(capacitacion_id: @capacitacion.id, clase: 'E'), data: { toggle: 'tooltip', confirm: "Estas Seguro que desea eliminar todos los que no tengan procesos?" }, title: "Eliminar todos los contratos" do %>
        <button class="btn btn-xs btn-danger"><i class="fa fa-check"></i> Eliminar Todos</button>
      <% end %>
    <% end %>
      </strong></h3>
  <div class="box-tools pull-right">
    <% if is_auth_c('capacitacion') %>
      <%= link_to new_capacitacion_contratoscapacitacion_path(@capacitacion), id: 'new_contratoscapacitacion_button', class: 'btn btn-sm btn-warning', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
      <% end %>
    <% end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="contratoscapacitacion_form" class="collapse"></div>
  <div id="contratoscapacitaciones">
    <% if @capacitacion.contratoscapacitaciones.present? %>
      <%= render 'contratoscapacitaciones/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
    <% end %>
  </div>
</div>

