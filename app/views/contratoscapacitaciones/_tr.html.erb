<tr id="contratoscapacitacion_<%= contratoscapacitacion.id %>">
  <td class="text-center">
    <%
      btnColor = "warning"
      if (contratoscapacitacion.otros_pendientes.to_i + contratoscapacitacion.pendiente_iniciar.to_i + contratoscapacitacion.enproceso.to_i + contratoscapacitacion.finalizados.to_i) > 0
        btnColor = "info"
      end %>
    <div class="btn-group" id="botones<%= contratoscapacitacion.id %>">
      <button type="button" class="btn btn-<%=btnColor %> dropdown-toggle btn-xs" data-toggle="dropdown">
        OPC <span class="caret"></span>
        <span class="sr-only">Toggle Dropdown</span>
      </button>
      <ul class="dropdown-menu" role="menu">
        <li>
          <%= link_to edit_capacitacion_contratoscapacitacion_path(@capacitacion, contratoscapacitacion), remote: true, data: { toggle: 'tooltip' } do %>
            <i class="fa fa-edit"></i> Editar
          <% end %>
        </li>
        <% if contratoscapacitacion.existeneval.to_s == 'NO' %>
          <li>
            <%= link_to capacitacion_contratoscapacitacion_path(@capacitacion, contratoscapacitacion), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' } do %>
              <i class="fa fa-trash"></i> Eliminar
            <% end %>
          </li>
        <% end %>
        <li><%= link_to capacitacion_pdf_contratoscapacitaciones_path(id: contratoscapacitacion.id, contrato_id: contratoscapacitacion.contrato_id), class: 'popup', data: { toggle: 'tooltip' } do %>
            <i class="fa fa-file-pdf-o"></i> Informe
          <% end %>
        </li>
        <li><%= link_to capacitacion_pdf_contratoscapacitaciones_path(id: contratoscapacitacion.id, contrato_id: contratoscapacitacion.contrato_id, full: 'SI'), class: 'popup', data: { toggle: 'tooltip' } do %>
            <i class="fa fa-file-pdf-o"></i> Informe FULL
          <% end %>
        </li>
        <li>
          <%= link_to show_detalle_contratos_path(contratoscapacitacion_id: contratoscapacitacion.id, capacitacion_id: contratoscapacitacion.capacitacion_id)  do %>
            <i class="fa fa-users"></i> Ver Detalle
          <% end %>
        </li>
      </ul>
    </div>
  </td>
  <td align="left" class="text-table-10"><%= contratoscapacitacion.nombresuper rescue nil %></td>
  <td align="center" class="text-table-10"><%= contratoscapacitacion.fecha_programacion rescue nil %></td>
  <td class="text-center text-table text-table-10"><%= contratoscapacitacion.pendientes rescue 0 %></td>
  <td class="text-center text-table text-table-10"><%= contratoscapacitacion.noaplica rescue 0 %></td>
  <td class="text-center text-table text-table-10"><%= contratoscapacitacion.otros_pendientes rescue 0 %></td>
  <td class="text-center text-table text-table-10"><%= contratoscapacitacion.pendiente_iniciar rescue 0 %></td>
  <td class="text-center text-table text-table-10"><%= contratoscapacitacion.enproceso rescue 0 %></td>
  <td class="text-center text-table text-table-10"><%= contratoscapacitacion.finalizados rescue 0 %></td>
</tr>

<div class="modal fade" id="abrir_detalle<%= contratoscapacitacion.id %>">
  <div class="modal-dialog" style="width: 70%;">
    <div class="modal-content">
    </div>
  </div>
</div>
