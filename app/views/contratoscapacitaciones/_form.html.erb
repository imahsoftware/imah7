<%= simple_form_for([@capacitacion, @contratoscapacitacion], remote: true) do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-4 col-lg-6">
        <%= f.input :contrato_id, collection: Contrato.includes([:empresa]).where("estado = 'EN EJECUCION'").order(:nro_contrato).collect {|p| [ p.nombrecontrato, p.id ] }, input_html: { class: 'select2' }, as: :select, label: 'Contrato - Empresa',include_blank: true%>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-4 col-lg-6"><%= f.input :user_supervisor, collection: User.where(["(tipoconsulta not in ('CANDIDATO','PERSONA','RECTOR') or id = 1) and activo = 'S'"]).order(:nombre).collect {|p| [ p.nombrecompleto, p.id ] }, input_html: { class: 'select2 clean' }, as: :select,  include_blank: true, label: "Supervisor" %></div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :fecha_programacion, as: :string, input_html: { class: 'datepicker', data: {date_options: {format: 'DD/MM/YYYY', ignoreReadonly: true}}, readonly: true } %></div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :fecha_real, as: :string, input_html: { class: 'datepicker', data: {date_options: {format: 'DD/MM/YYYY', ignoreReadonly: true}}, readonly: true } %></div>
    </div>
    <div class="row">
      <div class="col-md-6">
        <% if @contratoscapacitacion.new_record? %>
          <%= button_tag "#{t :cancelar}", type: 'button', data: {target: '#contratoscapacitacion_form'}, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}", capacitacion_contratoscapacitacion_path(@capacitacion, @contratoscapacitacion), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
<br/>
