<div class="box-header">
  <h3 class="box-title"><strong>Datos Asociados por Capacitador (<%=@capacitacion.contratoscapacitaciones.count.to_i rescue 0 %>)</strong></h3>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="contratoscapacitacion_form" class="collapse"></div>
  <div id="contratoscapacitaciones">
    <% if @capacitacion.contratoscapacitaciones.present? %>
      <%= render 'contratoscapacitaciones/tablad' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
    <% end %>
  </div>
</div>

