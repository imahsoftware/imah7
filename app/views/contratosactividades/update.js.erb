$(".alert_flash").fadeOut(300, function() {
	$(this).remove();
});

$("#contratosactividad_<%= @contratosactividad.id %>").replaceWith("<%= j render 'tr', contratosactividad: @contratosactividad %>");

$('[data-toggle="tooltip"]').tooltip();

$(".flash_messages").html("<%= j render 'layouts/flash_messages' %>");

setTimeout(function() {
	$(".alert_flash").fadeOut(300, function() {
		$(this).remove();
	});
}, 5000);
