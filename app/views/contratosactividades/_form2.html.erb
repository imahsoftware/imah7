<%= simple_form_for @contratosactividad, :url => update2_contratosactividades_path, :method => :post, remote: true do |f| %>
  <%= hidden_field_tag :id, params[:id], value: params[:id] %>
  <div class="modal-header">
    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
    <h3 class="modal-title"><strong><%= @contratosactividad.new_record? ? 'Agregar' : 'Editar' %> Actividad</strong></h3>
  </div>
  <div class="modal-body">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :detalle, as: :text,:input_html => {:onchange => "javascript:this.value=this.value.toUpperCase();", :rows => 4 }, label: 'Actividad' %></div>
    </div>
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :clase, as: :select, collection: select_act_clase, input_html: { data: { width: '100%' }, class: 'select2'}, label: "Clase - Ubicación"%></div>
    </div>
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :tipo, as: :select, collection: select_act_tipo, input_html: { data: { width: '100%' }, class: 'select2'}, label: "Tipo Aseo"%></div>
    </div>
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :cantidad, as: :moneda %></div>
    </div>
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :contratossede_id, collection: @contrato.contratossedes.order(:nombre).collect {|p| [ p.nombre_consulta, p.id ] },input_html: { data: { width: '100%' }, class: 'select2'}, include_blank: true, label: "Sede de la actividad"%></div>
    </div>
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :dia_semana, as: :select, collection: select_diassemana,input_html: { data: { width: '100%' }, class: 'select2'},  label: "Dia de la Semana"%></div>
    </div>
  </div>
  <div class="modal-footer">
    <button type="button" class="pull-left btn btn-flat btn-default" data-dismiss="modal"><%=t :cancelar%></button>
    <div class="box-tools pull-right">
      <%= f.button :submit, 'Aceptar', class: 'btn btn-flat btn-primary' %>
    </div><!-- /.box-tools -->
  </div>
<% end %>