<%= simple_form_for(@contratosactividad) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.association :contrato %>
    <%= f.association :user %>
    <%= f.input :detalle %>
    <%= f.input :clase %>
    <%= f.input :cantidad %>
    <%= f.input :tipo %>
    <%= f.input :contratossede_id %>
    <%= f.input :dia_semana %>
  </div>

  <div class="form-actions">
    <%= f.button :submit %>
  </div>
<% end %>
