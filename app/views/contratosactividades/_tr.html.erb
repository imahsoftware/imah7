<tr id="contratosactividad_<%= contratosactividad.id %>">
  <td class="text-center">
    <%# if @contrato.contratosusers.exists?(empresasactividad_id: contratosactividad.empresasactividad_id) == false and @contrato.contratoscargos.exists?(empresasactividad_id: contratosactividad.empresasactividad_id) == false  %>
      <%= link_to edit_contrato_contratosactividad_path(@contrato, contratosactividad), remote: true, class: 'edit_contratosmodificacion_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
        <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
      <% end %>
       <%# if is_auth_e("contratosactividad")%>
        <%= link_to contrato_contratosactividad_path(@contrato, contratosactividad), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
           <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
        <% end %>
    <%# end %>
    <button class="btn btn-xs btn-info"><span data-toggle="tooltip" data-html="true" data-original-title="<div align='left'><%= contratosactividad.user_nombre.html_safe rescue nil %><%= contratosactividad.user_actnombre.html_safe rescue nil %></div>"><i class="fa fa-user" aria-hidden="true"></i></span></button>
  </td>
  <td align="left"><%= contratosactividad.detalle rescue nil %></td>
  <td align="left"><small><%= contratosactividad.clase rescue nil %></small></td>
  <td align="left"><small><%= contratosactividad.tipo rescue nil %></small></td>
  <td align="left"><small><%= contratosactividad.contratossede.nombre rescue nil %></small></td>
  <td align="left"><small><%= contratosactividad.dia_semana rescue nil %></small></td>
</tr>
