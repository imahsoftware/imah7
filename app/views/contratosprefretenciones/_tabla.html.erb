<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
	  <thead class="thcolor">
      <tr>
        <td width="10%"></td>
        <th class="text-left">Retencion</th>
        <th width="10%" class="text-right">Porcentaje</th>
        <th width="15%" class="text-right">Valor</th>
      </tr>
    </thead>
	  <tbody id="tbody_contratosprefretenciones">
	    <% @contratosprefactura.contratosprefretenciones.order(id: :desc).each do |contratosprefretencion| %>
	      <%= render 'contratosprefretenciones/tr', contratosprefretencion: contratosprefretencion %>
	    <% end %>
	  </tbody>
	</table>
</div>
