<%= simple_form_for(@personastemporal) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.association :contrata %>
    <%= f.association :user %>
    <%= f.input :tipo_identificacion %>
    <%= f.input :identificacion %>
    <%= f.input :nombres %>
    <%= f.input :apellidos %>
    <%= f.input :telefono %>
    <%= f.input :movil %>
    <%= f.input :cargo %>
    <%= f.input :user_asignado %>
    <%= f.input :autobuscar %>
    <%= f.input :nombre_completo %>
    <%= f.input :tipo_usuario %>
  </div>

  <div class="form-actions">
    <%= f.button :submit %>
  </div>
<% end %>
