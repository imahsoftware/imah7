$("#tiposevaluacion_form").collapse("hide");

$("#tiposevaluacion_form").empty();

<% if @active_record.present? %>
	$("#tiposevaluacion_<%= @active_record.id %>").replaceWith("<%= j render 'tr', tiposevaluacion: @active_record %>");
<% end %>

$("#tiposevaluacion_<%= @tiposevaluacion.id %>").html("<td colspan='12'><%= j render 'form' %></td>");

$("#tiposevaluacion_<%= @tiposevaluacion.id %>").addClass("active_tiposevaluacion");
$(".select2").select2();
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
$(".datetimepicker").datetimepicker();
$('.datepicker').datepicker({
    dayNamesMin: [ "Dom", "Lun", "Mar", "Mie", "Jue", "Vie", "Sáb" ],
    monthNamesShort: [ "Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic" ],
    dateFormat: "yy-mm-dd",
    yearRange: '2000:2027',
    changeMonth: true,
    changeYear: true,
});