<% if @active_record.present? %>
	$("#tiposevaluacion_<%= @active_record.id %>").replaceWith("<%= j render 'tr', tiposevaluacion: @active_record %>");
<% end %>
$("#tiposevaluacion_form").html("<%= j render 'form' %>");
$(".datetimepicker").datetimepicker();
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
$("#tiposevaluacion_form").collapse("show");
$(".select2").select2();