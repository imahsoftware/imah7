<tr id="tiposevaluacion_<%= tiposevaluacion.id %>">
  <% if is_auth_c('tiposevaluacion') %>
  	<td class="text-center">
      <%= link_to edit_tiposevaluacion_path(tiposevaluacion), class: 'edit_tiposevaluacion_button', remote: true, data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
         <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
      <% end %>
      <%= link_to tiposevaluacion, remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
          <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
      <% end %>
    </td>
  <% end %>
  <td width="10%"><%= tiposevaluacion.tipo %></td>
  <td><strong><%= tiposevaluacion.descripcion %></strong>
  <br/><small><%= tiposevaluacion.detalle_esp2 %></small></td>
  <td width="10%"><%= tiposevaluacion.valor1 %></td>
  <td width="10%"><%= tiposevaluacion.valor2 %></td>
  <td width="10%"><%= tiposevaluacion.valor3 %></td>
  <td width="10%"><%= tiposevaluacion.clase %></td>
</tr>
