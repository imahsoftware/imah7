<tr id="contratosautoinsumo_<%= contratosautoinsumo.id %>">
  <td class="text-center">
    <% if is_auth_e("contratosautoinsumo")%>
        <%= link_to contrato_contratosautoinsumo_path(@contrato, contratosautoinsumo), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
           <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
        <% end %>
    <% end %>
    <button class="btn btn-xs btn-info"><span data-toggle="tooltip" data-html="true" data-original-title="<div align='left'><%= contratosautoinsumo.user_nombre.html_safe rescue nil %></div>"><i class="fa fa-user" aria-hidden="true"></i></span></button>
  </td>
  <td align="left"><small><%= contratosautoinsumo.insumo.insumodetalle rescue nil %></small></td>
</tr>

