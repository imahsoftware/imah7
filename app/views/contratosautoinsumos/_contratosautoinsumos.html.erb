<div class="box-header">
  <h3 class="box-title"><strong>Insumos Autorizados para solicitar del inventario general
  </strong></h3>
  <div class="box-tools pull-right">
    <% if is_auth_c('contratosautoinsumo') %>
      <%= link_to new_contrato_contratosautoinsumo_path(@contrato), id: 'new_contratosautoinsumo_button', class: 'btn btn-sm btn-warning', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
      <% end %>
    <% end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="contratosautoinsumo_form" class="collapse"></div>
  <div id="contratosautoinsumos">
    <% if @contrato.contratosautoinsumos.present? %>
      <%= render 'contratosautoinsumos/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
    <% end %>
  </div>
</div>
