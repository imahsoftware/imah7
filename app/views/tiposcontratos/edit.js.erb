$("#tiposcontrato_form").collapse("hide");

$("#tiposcontrato_form").empty();

<% if @active_record.present? %>
	$("#tiposcontrato_<%= @active_record.id %>").replaceWith("<%= j render 'tr', tiposcontrato: @active_record %>");
<% end %>

$("#tiposcontrato_<%= @tiposcontrato.id %>").html("<td colspan='5'><%= j render 'form' %></td>");

$("#tiposcontrato_<%= @tiposcontrato.id %>").addClass("active_tiposcontrato");
$(".datetimepicker").datetimepicker();
$(".select2").select2();

$(".tooltip").tooltip("hide");

$('[data-toggle="tooltip"]').tooltip();