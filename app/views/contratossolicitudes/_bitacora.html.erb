<div class="box-body">
  <div class="row">
    <div class="col-md-11">
      <legend>Bitacora de la Solicitud</legend>
    </div>
  </div>
  <% if @contratossolicitud.contratossolbitacoras.exists? %>
    <div class="row">
      <div class="col-md-12">
        <div class="table-responsive">
          <table class="table table-bordered table-condensed table-striped">
            <thead>
            <tr class="thcolor">
              <th width="20%" class="text-center">Fecha</th>
              <th width="45%" class="text-left" style="font-size:12px;">Usuario</th>
              <th width="25%" class="text-center">Estado</th>
            </tr>
            </thead>
            <tbody id="tbody">
            <% @contratossolicitud.contratossolbitacoras.order("id desc").each do |p| %>
              <tr>
                <td class="text-center" style="font-size:12px;"><%= p.created_at.strftime("%Y-%m-%d %X") rescue nil%></td>
                <td class="text-left" style="font-size:12px;"><%= p.user.nombre rescue nil%></td>
                <td class="text-center" style="font-size:12px;"><%= p.estado rescue nil%></td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% else %>
    <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
  <% end %>
</div>