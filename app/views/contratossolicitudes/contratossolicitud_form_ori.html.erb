<div class="box ">
  <div class="box-body">
    <div class="row">
      <div class="col-md-12">
        <legend>
          <% if is_auth_c('solicitudseguimiento') %>
            <%= link_to edit_contrato_path(id: @contrato.id, etapa: 'S' ), data: {toggle: 'tooltip'}, title: 'Regresar' do %>
              <i class="fa fa-arrow-left fa-fw text-success" aria-hidden="true"></i>
            <% end %>
          <% elsif is_auth_c('solicitudescontrato') %>
            <%= link_to root_path, data: {toggle: 'tooltip'}, title: 'Regresar' do %>
              <i class="fa fa-arrow-left fa-fw text-success" aria-hidden="true"></i>
            <% end %>
          <% else %>
            <%= link_to edit_contrato_path(id: @contrato.id, etapa: 'S' ), data: {toggle: 'tooltip'}, title: 'Regresar' do %>
              <i class="fa fa-arrow-left fa-fw text-success" aria-hidden="true"></i>
            <% end %>
          <% end %>
          Información Contrato (<%= @contrato.empresa.identificacion rescue nil %>-<%= @contrato.empresa.digito rescue nil %> <%= @contrato.empresa.nombre rescue nil %>)
        </legend>
      </div>
    </div>
    <div class="row">
      <div class="col-md-12">
        <div class="table-responsive">
          <table class="table table-bordered table-condensed table-striped">
            <thead>
              <tr class="thcolor">
                <th width="15%" class="text-center">Nro Contrato</th>
                <th width="10%" class="text-center">Nro Solicitud</th>
                <th width="20%" class="text-center">Fecha creación</th>
                <th width="20%" class="text-center">Periodo</th>
                <th width="20%" class="text-center">Estado Solicitud</th>
                <th width="10%" class="text-center">Opciones</th>
              </tr>
            </thead>
            <tbody id="tbody">
              <tr>
                <td class="text-center" style="font-size:12px;"><%= @contrato.nro_contrato rescue nil%></td>
                <td class="text-center" style="font-size:12px;"><%= @contratossolicitud.id rescue nil%></td>
                <td class="text-center" style="font-size:12px;"><%= @contratossolicitud.created_at.strftime("%Y-%m-%d %X") rescue nil%></td>
                <td class="text-center" style="font-size:12px;"><%= @contratossolicitud.periodo rescue nil%></td>
                <td class="text-center" style="font-size:12px;"><%= @contratossolicitud.estado rescue nil%></td>
                <td class="text-center" style="font-size:12px;">
                  <% if @contratossolicitud.estado.to_s == 'PENDIENTE' %>
                    <div class="box-tools pull-center">
                      <%= link_to cambioestado_contratossolicitudes_path(id: @contratossolicitud.id, estado: "ENVIADO"), data: {toggle: 'tooltip', confirm: "Seguro que desea enviar esta Solicitud?"}, title: 'Enviar solicitud' do %>
                        <button class="btn btn-xs btn-danger"><i class="fa fa-arrow-right fa-fw" aria-hidden="true"></i> <strong>Enviar Solicitud</strong></button>
                      <% end %>
                    </div>
                  <% end %>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="row">
  <div class="col-md-12">
    <div class="nav-tabs-custom">
      <ul class="nav nav-tabs">
        <% if @contratossolicitud.etapa.to_s == "A" %>
          <li class="active"><%= link_to edit_contratossolicitud_path(id: @contratossolicitud.id, etapa: "A") do %>Insumos<%end %></li>
        <% else %>
          <li><%= link_to edit_contratossolicitud_path(id: @contratossolicitud.id, etapa: "A") do %>Insumos<% end %></li>
        <% end %>
        <% if @contratossolicitud.etapa.to_s == "B" %>
          <li class="active"><%= link_to edit_contratossolicitud_path(id: @contratossolicitud.id, etapa: "B") do %>Equipos, Maquinaria<% end %></li>
        <% else %>
          <li><%= link_to edit_contratossolicitud_path(id: @contratossolicitud.id, etapa: "B") do %>Equipos, Maquinaria<% end %></li>
        <% end %>
        <% if @contratossolicitud.etapa.to_s == "C" %>
          <li class="active"><%= link_to edit_contratossolicitud_path(id: @contratossolicitud.id, etapa: "C") do %>Otros Servicios<%end %></li>
        <% else %>
          <li><%= link_to edit_contratossolicitud_path(id: @contratossolicitud.id, etapa: "C") do %>Otros Servicios<% end %></li>
        <% end %>
        <% if @contratossolicitud.etapa.to_s == "D" %>
          <li class="active"><%= link_to edit_contratossolicitud_path(id: @contratossolicitud.id, etapa: "D") do %>Inventario General<%end %></li>
        <% else %>
          <li><%= link_to edit_contratossolicitud_path(id: @contratossolicitud.id, etapa: "D") do %>Inventario General<% end %></li>
        <% end %>
        <% if is_auth_c('solicitudescontratoauditoria') %>
          <% if @contratossolicitud.etapa.to_s == "E" %>
            <li class="active"><%= link_to edit_contratossolicitud_path(id: @contratossolicitud.id, etapa: "E") do %>Bitacora<%end %></li>
          <% else %>
            <li><%= link_to edit_contratossolicitud_path(id: @contratossolicitud.id, etapa: "E") do %>Bitacora<% end %></li>
          <% end %>
        <% end %>
        <% if @contratossolicitud.etapa.to_s == "F" %>
          <li class="active"><%= link_to edit_contratossolicitud_path(id: @contratossolicitud.id, etapa: "F") do %>Observaciones<%end %></li>
        <% else %>
          <li><%= link_to edit_contratossolicitud_path(id: @contratossolicitud.id, etapa: "F") do %>Observaciones<% end %></li>
        <% end %>

      </ul>
      <div class="tab-content">
        <% if ["A","B","C","L"].include?(@contratossolicitud.etapa.to_s) %>
          <div class="tab-pane active"><%= render 'contratossoldetalles/contratossoldetalles' %></div>
        <% elsif @contratossolicitud.etapa.to_s == 'D' %>
          <div class="tab-pane active"><%= render 'contratossolotros/contratossolotros' %></div>
        <% elsif @contratossolicitud.etapa.to_s == 'E' %>
          <div class="tab-pane active"><%= render 'bitacora' %></div>
        <% elsif @contratossolicitud.etapa.to_s == 'F' %>
          <div class="tab-pane active"><%= render 'contratossolnotas/contratossolnotas' %></div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="abrircargue">
  <div class="modal-dialog" style="width:1000px;">
    <div class="modal-content" style="width:1000px;">
    </div>
  </div>
</div>