<%= simple_form_for(@entrada) do |f| %>
  <script>
      function justNumbers(e) {
          var keynum = window.event ? window.event.keyCode : e.which;
          if ((keynum == 8) || (keynum == 46))
              return true;

          return /\d/.test(String.fromCharCode(keynum));
      }

      function habcampo() {

      }
      function disable() {
          document.getElementById("myRadio").disabled = true;
      }

      function undisable() {
          document.getElementById("myRadio").disabled = false;
      }

      $("#ide").keyup(function () {
          var  ta = $("#ide");
          letras = ta.val().replace('//g',"");
          ta.val(letras);
      });

  </script>
  <div class="box box-danger">
    <div class="box-header">
      <legend>Información Básica</legend>
    </div>
    <div class="box-body">
      <table width="100%">
        <tr>
          <td width="80%">
            <div class="row">
              <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
                <%= f.input :identificacion, input_html: {maximum: 20, onkeypress: "return justNumbers(event);"}, label: 'Identificación' %>
              </div>
              <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                <%= f.input :nombre, :input_html => {:onChange => "javascript:this.value=this.value.toUpperCase();"}, label: 'Nombre y apellido' %>
              </div>
              <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                <%= f.input :portafolio_id, collection: Portafolio.order(:nombre).collect {|p| [ p.nombre, p.id ] }, input_html: { class: 'select2' }, as: :select, label: 'Compañia', wrapper: false, include_blank: true%>
              </div>
            </div>
            <div class="row">
              <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                <%= f.input :barrio_id, collection: Barrio.order(:descripcion).collect {|p| [ p.descripcion, p.id ] }, input_html: { class: 'select2' }, as: :select, label: 'Barrio', wrapper: false, include_blank: true%>
              </div>
              <br/>
                <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                <%= f.input :celular, input_html: {maximum: 10, onkeypress: "return justNumbers(event);"}, label: 'Celular' %>
              </div>
              <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                <%= f.input :temperatura, :input_html => {maximum: 5}, label: 'Temperatura' %>
              </div>
              <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                <%= f.input :clase, as: :radio_buttons,collection: [['VISITANTE','VISITANTE'], ['ADMINISTRATIVO DE PLANTA','ADMINISTRATIVO DE PLANTA'],['ADMINISTRATIVO GENERAL','ADMINISTRATIVO GENERAL'],['OPERATIVO','OPERATIVO']], item_label_class: "radio-inline"%>
              </div>
            </div>
          </td>
        </tr>
      </table>
    </div>
    <div class="box-footer">
      <div class="box-tools pull-left">
        <%= link_to "Regresar", buscador_entradas_path, class: 'btn btn-danger'%>
      </div><!-- /.box-tools -->
      <div class="box-tools pull-right">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div><!-- /.box-tools -->
    </div>
  </div>
<% end %>