<%
  @contratossecciones =  contratossecciones.select("contratossecciones.*, (select autobuscar from municipios where id = contratossecciones.municipio_id) autobuscar_municipios,
                                              (select descripcion from contratosgrupos where id = contratossecciones.contratosgrupo_id) descripcion_contratosgrupo,
                                              (select nombre from users where id = contratossecciones.user_id) nombre_users,
                                              (select concat(perfil,' ($ ',salario,')') from contratoscargos where id = contratossecciones.contratoscargo_id) descripcion_contratoscargo,
                                              (select distinct 'X' from contratosperfechas where contratosseccion_id = contratossecciones.id) existeseccion,
                                              (select distinct 'X' from contratossecusers where contratosseccion_id = contratossecciones.id) existeusers")
                                   .order(id: :desc).paginate(:page => params[:contratossecciones], :per_page => 10)  %>
<div class="table-responsive">
  <%= form_tag search_contratossecciones_path(contrato_id: @contrato.id), method: :post, remote: true do %>
    <div class="row">
      <div class="col-xs-12 col-ms-7 col-md-4 col-lg-4"><b style="color: red;">*</b>
        <b>Descripción</b><br/>
        <div class="form-group input-group" style="padding-bottom: 10px;">
          <span class="input-group-addon"><i class="fa fa-credit-card"></i></span>
          <%= text_field_tag :descripcion2, params[:descripcion2], class: 'form-control uppercaseInput', autocomplete: 'off', style: "width: 100%", placeholder: 'Descripción' %>
        </div>
      </div>
      <div class="col-xs-12 col-ms-7 col-md-5 col-lg-5" style="padding-top: 20px;">
        <%= button_tag type: 'submit', class: 'btn btn-primary', data: { toggle: 'tooltip' }, title: 'Buscar' do %>
          <i class="fa fa-search" aria-hidden="true"></i> Buscar
        <% end %>
      </div>
    </div>
  <% end %>
  <table class="table table-bordered table-condensed table-striped">
    <thead class="thcolor">
    <tr>
      <td width="10%"></td>
      <th class="text-left text-table">Descripción</th>
      <th width="20%" class="text-left text-table">Municipio</th>
      <th width="15%" class="text-left text-table">Grupo</th>
      <th width="20%" class="text-left text-table">Cargo</th>
      <th width="5%" class="text-center text-table">Cnt</th>
    </tr>
    </thead>
    <tbody id="tbody_contratossecciones">
    <% @contratossecciones.each do |contratosseccion| %>
      <%= render 'contratossecciones/tr', contratosseccion: contratosseccion %>
    <% end %>
    </tbody>
  </table>
</div>
<div class="modal fade" id="secuser">
  <div class="modal-dialog modal-dialog-responsive" role="document">
    <div class="modal-content"></div>
  </div>
</div>