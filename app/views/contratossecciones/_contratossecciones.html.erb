<div class="box-header">
  <h3 class="box-title"><strong>Secciones</strong>
    <%= link_to procesos_contratossecciones_path(contrato_id: @contrato.id), class: 'btn btn-xs btn-info' do %>
      <span>Ejecutar proceso Nelcy</span>
    <% end %>
    <%= link_to informedat_datas_path(format: :xlsx, infgrupo_id: 79, contrato_id: @contrato.id), data: { toggle: 'tooltip' }, title: "Generar Reporte" do %>
      <button class="btn btn-xs btn-info"><i class="fa fa-file-excel-o"></i> Informe Especial Secciones </button>
    <% end %>
  </h3>
  <div class="box-tools pull-right">
    <%# if is_auth_c('contratosseccion') %>
    <%= link_to new_contrato_contratosseccion_path(@contrato), id: 'new_contratosseccion_button', class: 'btn btn-sm btn-warning', remote: true do %>
      <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
    <% end %>
    <%# end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="contratosseccion_form" class="collapse"></div>
  <div id="search">
    <%= form_tag search_contratossecciones_path(contrato_id: @contrato.id), method: :post, remote: true do %>
      <div class="row">
        <div class="col-xs-12 col-ms-7 col-md-4 col-lg-4"><b style="color: red;">*</b>
          <b>Descripción</b><br/>
          <div class="form-group input-group" style="padding-bottom: 10px;">
            <span class="input-group-addon"><i class="fa fa-credit-card"></i></span>
            <%= text_field_tag :descripcion2, params[:descripcion2], class: 'form-control uppercaseInput', autocomplete: 'off', style: "width: 100%", placeholder: 'Descripción' %>
          </div>
        </div>
        <div class="col-xs-12 col-ms-7 col-md-5 col-lg-5" style="padding-top: 20px;">
          <%= button_tag type: 'submit', class: 'btn btn-primary', data: { toggle: 'tooltip' }, title: 'Buscar' do %>
            <i class="fa fa-search" aria-hidden="true"></i> Buscar
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div id="contratossecciones">
    <% if @contrato.contratossecciones.present? %>
      <%= render 'contratossecciones/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %>
      </div>
    <% end %>
  </div>
  <div id="buscador2"></div>
</div>

