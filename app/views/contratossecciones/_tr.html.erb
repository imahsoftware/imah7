<tr id="contratosseccion_<%= contratosseccion.id %>">
  <td class="text-center">
    <%# if is_auth_e("contratosseccion")%>
    <%= link_to edit_contrato_contratosseccion_path(@contrato, contratosseccion), remote: true, class: 'edit_contratosmodificacion_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
      <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
    <% end %>
    <% if contratosseccion.existeseccion.to_s != 'X' %>
      <%= link_to contrato_contratosseccion_path(@contrato, contratosseccion), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
        <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
      <% end %>
    <% end %>
    <% if contratosseccion.existeusers.to_s != 'X' %>
      <%= link_to secuser_contratossecciones_path(id: contratosseccion.id), data: {toggle: 'tooltip'}, title: 'Supervisores', remote: true do %>
        <button class="btn btn-xs btn-danger"><i class="fa fa-cc-mastercard"></i></button>
      <% end %>
    <% else %>
      <%= link_to secuser_contratossecciones_path(id: contratosseccion.id), data: {toggle: 'tooltip'}, title: 'Supervisores', remote: true do %>
        <button class="btn btn-xs btn-info"><i class="fa fa-cc-mastercard"></i></button>
      <% end %>
    <% end %>
    <button class="btn btn-xs btn-info"><span data-toggle="tooltip" data-html="true" data-original-title="<div align='left'>Creacion: <%= contratosseccion.created_at.strftime("%Y-%m-%d %X") rescue nil %> - <%= contratosseccion.nombre_users rescue nil %></div>"><i class="fa fa-user" aria-hidden="true"></i></span></button>
    <%# end %>
  </td>
  <td align="left" style="font-size: 11px;"><%= contratosseccion.descripcion rescue nil %></td>
  <td align="left" style="font-size: 11px;"><%= contratosseccion.autobuscar_municipios rescue nil %></td>
  <td align="left" style="font-size: 11px;"><%= contratosseccion.descripcion_contratosgrupo rescue nil %></td>
  <td align="left" style="font-size: 11px;"><%= contratosseccion.descripcion_contratoscargo rescue nil %></td>
  <td align="center" style="font-size: 11px;"><%= contratosseccion.cantidad rescue nil %></td>
</tr>