<div class="box-header">
  <h3 class="box-title"><strong>Insumos</strong></h3>
  <% if @contrato.tiposcontrato_id.to_i == 24 %>
    <%= link_to abrircargue_contratos_path(id: @contrato.id, clase: 'INSUMO'), remote: true, data: { toggle: 'tooltip' }, title: 'Carga masiva CCE' do %>
      <button class="btn btn-xs btn-info"><i class="fa fa-cloud-upload"></i> Cargue</button>
    <% end %>
  <% else %>
    <%= link_to abrircargue_contratos_path(id: @contrato.id, clase: 'OTROS'), remote: true, data: { toggle: 'tooltip' }, title: 'Carga masiva NOCCE' do %>
      <button class="btn btn-xs btn-info"><i class="fa fa-cloud-upload"></i> Cargue</button>
    <% end %>
  <% end %>
  <%= link_to informe_datas_path(infgrupo_id: 14, portafolio_id: @contrato.id, format: :xlsx), data: { toggle: 'tooltip' }, title: 'Descargar insumos contrato' do %>
    <button class="btn btn-xs btn-danger"><i class="fa fa-file-excel-o"></i> Contrato</button>
  <%end %>
  <%= link_to edit_individual_contratosinsumos_path(contrato_id: @contrato.id), class: 'edit_personasantropo_button', data: {toggle: 'tooltip'}, title: "#{t :title_editar}" do %>
    <button class="btn btn-xs btn-warning"><i class="fa fa-external-link"></i> Edición Avanzada...</button>
  <% end %>
  <% if Contratossolicitud.where(contrato_id: @contrato.id).exists? == false %>
    <%= link_to depurarinsumos_contratos_path(id: @contrato.id), data: { toggle: 'tooltip' }, title: 'Depurar' do %>
      <button class="btn btn-xs btn-danger"><i class="fa fa-cloud-upload"></i> Depurar</button>
    <% end %>
  <% end %>
  <%= link_to edit_individual_contratosinsumos_path(contrato_id: @contrato.id), class: 'edit_personasantropo_button', data: {toggle: 'tooltip'}, title: "#{t :title_editar}" do %>
    <button class="btn btn-xs btn-warning"><i class="fa fa-external-link"></i> Edición Avanzada...</button>
  <% end %>
  <div class="box-tools pull-right">
    <% if is_auth_c('contratosinsumo') %>
      <%= link_to new_contrato_contratosinsumo_path(@contrato), id: 'new_contratosinsumo_button', class: 'btn btn-sm btn-warning', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
      <% end %>
    <% end %>
  </div>
</div>
<% if @contrato.tiposcontrato_id.to_i == 24 %>

<% end %>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="contratosinsumo_form" class="collapse"></div>
  <div id="contratosinsumos">
    <% if @insumos.present? %>
    <%# if @contrato.contratosinsumos.any? %>
      <%= render 'contratosinsumos/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
    <% end %>
  </div>
</div>
