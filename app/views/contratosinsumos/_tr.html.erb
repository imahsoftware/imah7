<tr id="contratosinsumo_<%= contratosinsumo.id %>">
  <td class="text-center">
    <% if contratosinsumo.insumo_id.to_i > 0
        if contratosinsumo.insumo.insumosfichas.where("estado = 'ACTIVO'").present? %>
          <%= link_to fichas_insumos_path(id: contratosinsumo.insumo_id), remote: true, class: 'edit_insumo_button', data: { toggle: 'tooltip' }, title: "Ver Fichas" do %>
            <button class="btn btn-xs btn-primary"><i class="fa fa-newspaper-o"></i></button>
          <% end %>
    <%  end
      end %>
    <% if @is_auth_e_contratosinsumo
         if contratosinsumo.insumo_id.to_s != ""
           est = contratosinsumo.insumo.estado.to_s
         else
           est = 'ACTIVO'
         end
    %>
      <% if est.to_s == 'ACTIVO' %>
        <%= link_to edit_contrato_contratosinsumo_path(@contrato, contratosinsumo), remote: true, class: 'edit_contratosmodificacion_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
          <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
        <% end %>
        <%= link_to new_contratosinsimagen_path(contratosinsumo_id: contratosinsumo.id), remote: true, data: { toggle: 'tooltip' }, title: 'Añadir Soporte Digital' do %>
          <button class="btn btn-xs btn-primary"><i class="fa fa-image"></i></button>
        <% end %>
      <% end %>
    <% end %>
    <% if @is_auth_e_contratosinsumo1 and contratosinsumo.existedet.to_s == "" %>
        <%= link_to contrato_contratosinsumo_path(@contrato, contratosinsumo), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
           <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
        <% end %>
    <% end %>
    <button class="btn btn-xs btn-info"><span data-toggle="tooltip" data-html="true" data-original-title="<div align='left'><%= contratosinsumo.user_nombre.html_safe rescue nil %><%= contratosinsumo.user_actnombre.html_safe rescue nil %></div>"><i class="fa fa-user" aria-hidden="true"></i></span></button>
  </td>
  <td align="left"><small><%= contratosinsumo.insumo_cliente rescue nil %>
    <% if contratosinsumo.presentacion %>
      <%= link_to fichatecnica_contratosinsumos_path(contratosinsumo_id: contratosinsumo.id), data: { toggle: 'tooltip' }, title: 'Ficha', remote: true do %>
        <i class="fa fa-life-ring text-red"></i>
      <% end %>
    <% end %>
    <% if contratosinsumo.existeimg.to_s == "X"
      Contratosinsimagen.where(contratosinsumo_id: contratosinsumo.id).each do |b| %>
        <div style="color:red; font-size:10px;"><%= link_to b.insumosimagen.url(:original, false), data: { toggle: 'tooltip' }, title: 'Ver Imagen', onclick: 'window.open(this.href,"new_window","height=450,width=600,scrollbars=yes");return false;' do %>
            <i class="fa fa-cloud-download text-danger"></i><%=b.insumosimagen_file_name %></div>
          <% end %>
      <% end %>
    <% end %>
  </small></td>
  <td align="left"><small><%= contratosinsumo.insumo.insumodetalle rescue nil %></small></td>
  <td align="center"><small><%= camponumerico contratosinsumo.cantidad_mensual rescue nil %></small></td>
  <td align="right"><small><%= camponumerico contratosinsumo.precio_condescuento rescue nil %></small></td>
</tr>

<div class="modal fade" id="fichas<%= contratosinsumo.insumo.id rescue nil%>">
  <div class="modal-dialog modal-dialog-responsive" role="document">
    <div class="modal-content"></div>
  </div>
</div>
