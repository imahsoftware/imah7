
<div align="center">
  <%  isadminnombre = User.find(@isadmin).nombre rescue nil
      cant = @contratospermasdetalles.count.to_i rescue 0
      @contratospermasdetalles.each do |contratospermasdetalle|
        contratosperfecha = Contratosperfecha.includes([:contrato, :contratospersona, :contratoscargo]).find(contratospermasdetalle.contratosperfecha_id)
        logo = contratosperfecha.contrato.empresa.logo.to_s
  %>
    <br/>
    <table width="760" border="0" cellspacing="0" cellpadding="1">
      <tr>
        <td valign="center">
          <table width="100%">
            <tr>
              <td>
                <div align="center">
                  <%= wicked_pdf_image_tag "#{image_url(logo)}", size: "230x100" %>
                </div>
              </td>
              <th style="font-size: 18px; font-family: Tahoma;"><div align="center"><%=contratospermasdetalle.contratospermasiva.proceso rescue nil%> DE EMPLEADO</div><br/>
                <div align="center" style="font-size: 10px; font-family: Tahoma;"><%=contratosperfecha.contrato.empresa.identnombre rescue nil%></div></th>
            </tr>
            <tr>
              <td colspan="2" width="80%">
                <table width="100%" border="0" cellpadding="0" cellspacing="0" style="border:1px solid #CCCCCC; font-size: 10px; font-family: Tahoma;" id="sample">
                  <tr>
                    <td width="35%" style="background: #adadad; border:1px solid #CCCCCC; font-size: 11px; font-family: Tahoma;"><strong>EMPLEADO : </strong></td>
                    <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma;">&nbsp;<%=contratosperfecha.contratospersona.autobuscar rescue nil%></td>
                  </tr>
                  <tr>
                    <td style="background: #adadad; border:1px solid #CCCCCC; font-size: 11px; font-family: Tahoma;"><strong>LUGAR Y FECHA : </strong></td>
                    <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma;">&nbsp;MEDELLÍN, <%=Time.now.strftime("%Y-%m-%d") rescue nil%></td>
                  </tr>
                  <tr>
                    <td style="background: #adadad; border:1px solid #CCCCCC; font-size: 11px; font-family: Tahoma;"><strong>ULTIMO CARGO DESEMPEÑADO : </strong></td>
                    <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma;">&nbsp;<%=contratosperfecha.contratoscargo.perfil rescue nil%></td>
                  </tr>
                  <tr>
                    <td style="background: #adadad; border:1px solid #CCCCCC; font-size: 11px; font-family: Tahoma;"><strong>GRUPO DE NOMINA : </strong></td>
                    <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma;">&nbsp;<%=contratosperfecha.contratosgrupo.descripcion rescue nil%></td>
                  </tr>
                  <tr>
                    <td style="background: #adadad; border:1px solid #CCCCCC; font-size: 11px; font-family: Tahoma;"><strong>FECHA INICIO CONTRATO : </strong></td>
                    <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma;">&nbsp;<%=contratosperfecha.fecha_inicio rescue nil%></td>
                  </tr>
                  <tr>
                    <td style="background: #adadad; border:1px solid #CCCCCC; font-size: 11px; font-family: Tahoma;"><strong>FECHA FIN CONTRATO : </strong></td>
                    <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma;">&nbsp;<%=contratosperfecha.fecha_fin rescue nil%></td>
                  </tr>
                  <tr>
                    <td style="background: #adadad; border:1px solid #CCCCCC; font-size: 11px; font-family: Tahoma;"><strong>PROCESO : </strong></td>
                    <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma;">&nbsp;<%=contratospermasdetalle.contratospermasiva.proceso rescue nil%></td>
                  </tr>
                  <tr>
                    <td style="background: #adadad; border:1px solid #CCCCCC; font-size: 11px; font-family: Tahoma;"><strong>FECHA INICIO PROCESO : </strong></td>
                    <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma;">&nbsp;<%=contratospermasdetalle.contratospermasiva.fecha_inicio rescue nil%></td>
                  </tr>
                  <tr>
                    <td style="background: #adadad; border:1px solid #CCCCCC; font-size: 11px; font-family: Tahoma;"><strong>FECHA FIN PROCESO : </strong></td>
                    <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma;">&nbsp;<%=contratospermasdetalle.contratospermasiva.fecha_fin rescue nil%></td>
                  </tr>
                  <tr>
                    <td style="background: #adadad; border:1px solid #CCCCCC; font-size: 11px; font-family: Tahoma;"><strong>NRO CUENTA : </strong></td>
                    <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma;">&nbsp;<%=contratosperfecha.contratospersona.banco rescue nil%> - <%=contratosperfecha.contratospersona.cuenta_bancolombia rescue nil%></td>
                  </tr>
                  <tr>
                    <td style="background: #adadad; border:1px solid #CCCCCC; font-size: 11px; font-family: Tahoma;"><strong>VALOR PAGADO : </strong></td>
                    <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma;">&nbsp;<%=camponumerico contratospermasdetalle.prima rescue nil%></td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
          <br/>
          <div align="justify" style="font-size: 10px; font-family: Tahoma;">FYH: <%=Time.now.strftime("%Y-%m-%d %X") rescue nil%> - <%=isadminnombre rescue nil%></div>
        </td>
      </tr>
    </table>
    <% if cant > 1 %>
      <div style="page-break-after:always; border:0px solid blue;">........................................................................</div>
    <%end%>
  <%end%>
</div>
<style>
    .stiloprint {
        border-collapse: collapse; border:1px solid #CCCCCC; font-size: 8px; font-family: Tahoma; line-height: 150%; padding: 5px;
    }
</style>


