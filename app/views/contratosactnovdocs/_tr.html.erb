<tr id="contratosactnovdoc_<%= contratosactnovdoc.id %>">
  <td class="text-center">
    <% if @contratosactnovedad.estado.to_s != 'ATENDIDO' and @contratosactnovedad.user_id == is_admin %>
      <%= link_to contratosactnovedad_contratosactnovdoc_path(@contratosactnovedad, contratosactnovdoc), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
         <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
      <% end %>
    <% end %>
    <%= link_to contratosactnovdoc.novedad.url(:original, false), data: { toggle: 'tooltip' },title: "Ver Documento", onclick: 'window.open(this.href,"new_window","height=450,width=600,scrollbars=yes");return false;' do %>
      <button class="btn btn-xs btn-primary"><i class="fa fa-cloud-download"></i></button>
    <% end %>
  </td>
  <td align="left"><%= contratosactnovdoc.created_at.strftime("%Y-%m-%d %X") rescue nil %>
    <br/><small><%= contratosactnovdoc.user.nombre rescue nil %></small></td>
  <td align="left"><%= contratosactnovdoc.descripcion rescue nil %></td>
  <td align="left"><%= contratosactnovdoc.novedad_file_name rescue nil %></td>
</tr>