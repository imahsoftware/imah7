<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
	  <thead class="thcolor">
      <tr>
        <td width="10%"></td>
        <th width="20%" class="text-left">Fecha</th>
        <th class="text-left">Observación</th>
      </tr>
    </thead>
	  <tbody id="tbody_contratosobservaciones">
	    <% @contrato.contratosobservaciones.order(id: :desc).each do |contratosobservacion| %>
	      <%= render 'contratosobservaciones/tr', contratosobservacion: contratosobservacion %>
	    <% end %>
	  </tbody>
	</table>
</div>