      <tr>
        <td width="10%"></td>
        <th width="25%" class="text-left text-table">Tipo de Imagen</th>
        <th class="text-left text-table">Imagen</th>
      </tr>
    </thead>
	  <tbody id="tbody_contratosperimagenes">
