$("#contratosperimagen_form").collapse("hide");

$("#contratosperimagen_form").empty();

<% if @active_record.present? %>
	$("#contratosperimagen_<%= @active_record.id %>").replaceWith("<%= j render 'tr', contratosperimagen: @active_record %>");
<% end %>

$("#contratosperimagen_<%= @contratosperimagen.id %>").html("<td colspan='12'><%= j render 'form' %></td>");

$("#contratosperimagen_<%= @contratosperimagen.id %>").addClass("active_contratosperimagen");

$(".select2").select2();

$(".tooltip").tooltip("hide");

$('[data-toggle="tooltip"]').tooltip();
$(".datetimepicker").datetimepicker();