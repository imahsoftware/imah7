<%= render "form" %>
<% unless @proveedor.new_record? %>
  <div class="row">
    <div class="col-md-12">
      <div class="nav-tabs-custom">
        <ul class="nav nav-tabs">
          <% if @proveedor.etapa.to_s == "A" %>
            <li class="active"><%= link_to edit_proveedor_path(id: @proveedor.id, etapa: "A") do %>Contactos<%end %></li>
          <% else %>
            <li><%= link_to edit_proveedor_path(id: @proveedor.id, etapa: "A") do %>Contactos<% end %></li>
          <% end %>
          <% if @proveedor.etapa.to_s == "B" %>
            <li class="active"><%= link_to edit_proveedor_path(id: @proveedor.id, etapa: "B") do %>Imagenes<% end %></li>
          <% else %>
            <li><%= link_to edit_proveedor_path(id: @proveedor.id, etapa: "B") do %>Imagenes<% end %></li>
          <% end %>
        </ul>
        <div class="tab-content">
          <% if @proveedor.etapa.to_s == "A" %>
            <div class="tab-pane active"><%= render 'proveedorescontactos/proveedorescontactos' %></div>
          <% elsif @proveedor.etapa.to_s == "B" %>
            <div class="tab-pane active"><%= render 'proveedoresimagenes/proveedoresimagenes' %></div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
