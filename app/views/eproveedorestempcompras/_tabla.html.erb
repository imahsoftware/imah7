       <%= render 'eproveedorestempcompras/tr', eproveedorestempcompra: eproveedorestempcompra %>
     <% end %>
	  </tbody>
    <thead class="thcolor">
    <tr>
      <th class="alert-danger text-center" colspan="4">Valor total egreso....</th>
      <th class="alert-danger text-right"> <%= camponumerico @eproveedor.eproveedorestempcompras.sum("total") rescue 0 %></th>
    </tr>
    </thead>
	</table>

</div>
<div class="box-tools pull-right" id="page_links">
  <%#= will_paginate @eproveedorestempcompras, :param_name => 'eproveedorestempcompras' , renderer: BootstrapPagination::Rails %>
</div>
