<tr id="eproveedorestempcompra_<%= eproveedorestempcompra.id %>">
  <td class="text-center">
      <%= link_to edit_eproveedor_eproveedorestempcompra_path(@eproveedor, eproveedorestempcompra), remote: true, class: 'edit_eproveedorsmodificacion_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
        <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
      <% end %>
      <%= link_to eproveedor_eproveedorestempcompra_path(@eproveedor, eproveedorestempcompra), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
         <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
      <% end %>
    <button class="btn btn-xs btn-info"><span data-toggle="tooltip" data-html="true" data-original-title="<div align='left'><%= eproveedorestempcompra.user_nombre.html_safe rescue nil %><%= eproveedorestempcompra.user_actnombre.html_safe rescue nil %></div>"><i class="fa fa-user" aria-hidden="true"></i></span></button>
  </td>
  <td align="center"><%= eproveedorestempcompra.fecha %></td>
  <td align="center"><%= eproveedorestempcompra.eproveedorescompra.nro_factura %></td>
  <td align="center"><%= eproveedorestempcompra.forma_pago %></td>
  <td align="right"><%= camponumerico eproveedorestempcompra.total %></td>
</tr>



