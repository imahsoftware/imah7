<%= simple_form_for([@eproveedor, @eproveedorestempcompra], remote: true) do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :fecha, as: :string, input_html: { class: 'datepicker', data: { date_options: { format: 'DD/MM/YYYY', ignoreReadonly: true } }, readonly: true } %></div>
      <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5">
        <% if @eproveedorestempcompra.id %>
          <%= f.input :eproveedorescompra_id, collection: Eproveedorescompra.where(["eproveedor_id =  #{@eproveedor.id} and id = #{@eproveedorestempcompra.eproveedorescompra_id}"]).order(:nro_factura).collect { |p| [p.detallecausacion, p.id] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: "Causación" %></div>
        <% else %>
          <%= f.input :eproveedorescompra_id, collection: Eproveedorescompra.where(["eproveedor_id =  #{@eproveedor.id} and saldo > 0"]).order(:nro_factura).collect { |p| [p.detallecausacion, p.id] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: "Causación" %></div>
        <% end %>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :total, as: :moneda %></div>
      <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :forma_pago, as: :select, collection: select_formapago, input_html: { data: { width: '100%' }, class: 'select2'}%></div>
    </div>
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :nro_cheque, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" } %></div>
      <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6"><%= f.input :cuenta_id, collection: Cuenta.order(:descripcion).collect { |p| [p.descripcion, p.id] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: "Nro de Cuenta" %></div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :incluir_otras, as: :select, collection: select_sino, input_html: { class: 'select2' }, include_blank: true, label: "Asociar las demas"  %></div>
    </div>
    <div class="row">
      <div class="col-md-6">
        <% if @eproveedorestempcompra.new_record? %>
          <%= button_tag "#{t :cancelar}", type: 'button', data: {target: '#eproveedorestempcompra_form'}, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}", eproveedor_eproveedorestempcompra_path(@eproveedor, @eproveedorestempcompra), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
<br/>
