<% if @capacitacionevaluaciones.present? %>
	$("#capacitacionevaluaciones").html("<div class='alert alert-warning'><h4><i class='icon fa fa-info'></i> <%=t :atencion%></h4><%=t :atencion_msj%><span></div>");
<% else %>
	$("#capacitacionevaluacion_<%= @capacitacionevaluacion.id %>").remove();
<% end %>
$('.tooltip').tooltip('hide');