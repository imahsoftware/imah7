<table class="table table-bordered table-condensed table-striped">
  <thead>
  <tr class="thcolor">
    <th width="10%"></th>
    <th class="font-size-text-tabla text-center" width="5%">ID</th>
    <th class="font-size-text-tabla">Descripción</th>
    <th class="font-size-text-tabla text-center" width="15%">Estado</th>
  </tr>
  </thead>
  <tbody id="tbody_capacitacionevaluaciones">
  <% @capacitacion.capacitacionevaluaciones.order(id: :desc).each do |capacitacionevaluacion| %>
    <%= render 'capacitacionevaluaciones/tr', capacitacionevaluacion: capacitacionevaluacion %>
  <% end %>
  </tbody>
</table>