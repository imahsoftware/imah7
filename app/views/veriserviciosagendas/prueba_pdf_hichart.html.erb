<%
  base_url = Rails.env.production? ? 'https://appasearesp.com' : 'http://localhost:3000'
  @veriservicio = Veriservicio.find(veriservicio_id) if veriserviciosagenda_id rescue nil
  @veriserviciosagenda = Veriserviciosagenda.find(veriserviciosagenda_id) if veriserviciosagenda_id rescue nil
  portafolio = Portafolio.find(@veriservicio.contrato.empresa.portafolio_id)
  @logo_firma = portafolio.logo_firma
  @logo = portafolio.logo_empresa_assets
  @nombre_firma = portafolio.nombre_rep.to_s
  @nombre_empresa = portafolio.razon_social.to_s


  # Consulta SQL para obtener los datos
  @datos = Objeto.find_by_sql("SELECT  orden , total
                              FROM veriserviciosagendasdatos
                              WHERE veriservicio_id = #{@veriservicio.id}
                              AND   veriserviciosagenda_id = #{@veriserviciosagenda.id}
                              ORDER BY orden ASC
                            ")


  g = Gruff::Bar.new
  g.title = 'Calificación'
  g.theme = {
    marker_color: 'blue',
    background_colors: %w(white white)
  }
  g.spacing_factor = 0.1

  # Configurar el espaciado entre las barras
  g.bar_spacing = 0.6 # Ajusta este valor para cambiar el espaciado entre las barras dentro de un grupo
  g.group_spacing = 1.1 # Ajusta este valor para cambiar el espaciado entre grupos de barras

  resultado = []
  labels = {}

  @datos.each_with_index do |d, index|
    resultado << d.total
    labels[index] = d.orden.to_s # Asignar el valor de 'orden' a las etiquetas
  end

  # Ajustar el rango del eje X para que inicie desde 0
  g.minimum_value = 0

  g.data "Fecha de Agenda #{@veriserviciosagenda.fecha_reprogramacion}", resultado, '#990000'

  g.labels = labels


  # Guardar el gráfico en un archivo temporal
  temp_file = Tempfile.new(["veriservicio_#{@veriservicio.id}", '.png'])
  g.write(temp_file.path)

  # Buscar y eliminar el registro de la tabla Graph
  Graph.where(tabla: 'INFORME_VERISERVICIOAGENDA', id_registro: @veriserviciosagenda.id).destroy_all

  # Crear un nuevo objeto Graph y adjuntar la imagen
  @graph = Graph.new
  @graph.tabla = 'INFORME_VERISERVICIOAGENDA'
  @graph.id_registro = @veriserviciosagenda.id
  @graph.graphimage = File.open(temp_file.path) # Asegúrate de usar File.open para almacenar la imagen
  @graph.save

  # Cerrar y eliminar el archivo temporal
  temp_file.close
  temp_file.unlink

%>



<div align="center">
  <table width="900" border="0" cellspacing="0" cellpadding="0" style=" font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
    <tr valign="top">
      <td width="10%">
        <div align="justify" style="font-size: 12px; font-family: Tahoma; padding: 5px">
          <b>Objetivo:</b> Realizar una revisión detallada del que ASEAR S.A.S. E.S.P presta a la entidad con el fin de
          verificar el cumplimiento de las obligaciones contractuales en los contratos y validar la calidad del servicio
          prestado.
        </div>
      </td>
    </tr>
  </table>
  <br/>
  <table width="900" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Tahoma">
    <tr>
      <td style="background-color: #CF0000; color: white; text-align: center; font-family: Tahoma; padding: 5px" colspan="4">
        INFORMACION DEL CONTRATO
      </td>
    </tr>
    <tr>
      <th width="18%" style="text-align: left; font-family: Tahoma; padding: 3px;font-size: 12px; ">CLIENTE:</th>
      <td width="32%" style="text-align: left; font-family: Tahoma; padding: 3px;font-size: 12px;"><%= @veriservicio.contrato.empresa.identnombre rescue nil %></td>
      <th width="18%" style="text-align: left; font-family: Tahoma; padding: 3px;font-size: 12px;">N° DE CONTRATO</th>
      <td width="32%" style="text-align: left; font-family: Tahoma; padding: 3px;font-size: 12px; "><%= @veriservicio.contrato.nro_contrato rescue nil %></td>
    </tr>
    <tr>
      <th width="18%" style="text-align: left; font-family: Tahoma; padding: 3px;font-size: 12px; ">OBJETO:</th>
      <td style="text-align: left; font-family: Tahoma; padding: 3px;font-size: 12px;" colspan="3"><%= @veriservicio.contrato.objeto %></td>
    </tr>
    <tr>
      <th width="18%" style="text-align: left; font-family: Tahoma; padding: 3px;font-size: 12px; ">FECHA DE CREACIÓN:
      </th>
      <td width="32%" style="text-align: left; font-family: Tahoma; padding: 3px;font-size: 12px;"><%= @veriservicio.created_at.strftime("%d/%m/%Y") rescue nil %></td>
      <th width="18%" style="text-align: left; font-family: Tahoma; padding: 3px;font-size: 12px;">USUARIO CREA:</th>
      <td width="32%" style="text-align: left; font-family: Tahoma; padding: 3px;font-size: 12px; "><%= @veriservicio.user.nombre rescue nil %></td>
    </tr>
    <tr>
      <th width="18%" style="text-align: left; font-family: Tahoma; padding: 3px;font-size: 12px; ">FECHA AGENDA:
      </th>
      <td width="32%" style="text-align: left; font-family: Tahoma; padding: 3px;font-size: 12px;"><%= @veriserviciosagenda.fecha_reprogramacion.strftime("%d/%m/%Y") rescue nil %></td>
      <th width="18%" style="text-align: left; font-family: Tahoma; padding: 3px;font-size: 12px;">USUARIO AGENDA:
      </th>
      <td width="32%" style="text-align: left; font-family: Tahoma; padding: 3px;font-size: 12px; "><%= @veriserviciosagenda.user.nombre rescue nil %></td>
    </tr>
  </table>
  <% if @veriserviciosagenda.veriserviciosusers.where("user_id != #{@veriserviciosagenda.user_id}").present? %>
    <table width="900" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Tahoma">
      <% @veriserviciosagenda.veriserviciosusers.where("user_id != #{@veriserviciosagenda.user_id}").each_slice(4) do |veriserviciosusers| %>
        <tr>
          <% veriserviciosusers.each do |veriserviciosuser| %>
            <% personasformulariosdoc = Personasformulariosdoc.where("personasformulario_id in (select id from personasformularios where identificacion = '#{veriserviciosuser.user.identificacion}') and parcargosdoc_id in (select id from parcargosdocs where descripcion = 'FOTO PARA EL CARNET')").first %>

            <td width="25%" style="text-align: center; font-family: Tahoma; padding: 3px; font-size: 11px;">
              <% if personasformulariosdoc.present? %>
                <% url = personasformulariosdoc.soporte_digital.url(:original, false) %>
                <img src="<%= base_url + url %>" width="100" height="100"/><br/>
              <% else %>
                <b>Sin Foto</b>
              <% end %>
              <p style="font-size: 10px">
                <%= veriserviciosuser.user.nombrecompleto rescue nil %>
              </p>
            </td>
          <% end %>

          <% (4 - veriserviciosusers.size).times do %>
            <td width="25%" style="text-align: center; font-family: Tahoma; padding: 3px; font-size: 11px;">
              <!-- Celda vacía para alinear la tabla -->
            </td>
          <% end %>
        </tr>
      <% end %>
    </table>
    <br/>
  <% end %>

  <table width="900" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Tahoma">
    <tr valign="top">
      <th style="background-color: #CF0000; color: white; text-align: center; font-family: Tahoma; padding: 5px" colspan="3">RESUMEN</th>
    </tr>
    <tr>
      <td>
        <table width="900" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Tahoma">
          <tr>
            <th width="5%" style="background-color: #D6D6D6; text-align: left; font-family: Tahoma; padding: 3px;font-size: 11px;">Orden</th>
            <th style="background-color: #D6D6D6; text-align: left; font-family: Tahoma; padding: 3px;font-size: 11px;">Clasificación</th>
            <% veriserviciosagendas = Veriserviciosagendasdato.select("veriserviciosagenda_id").where("veriservicio_id = #{@veriservicio.id}").distinct.order("veriserviciosagenda_id asc") %>
            <% veriserviciosagendas.each do |p| %>
              <th width="10%" style="background-color: #D6D6D6; text-align: center; font-family: Tahoma; padding: 3px;font-size: 11px;">
                <%= Veriserviciosagenda.find(p.veriserviciosagenda_id).fecha_reprogramacion rescue nil %>
              </th>
            <% end %>
          </tr>

          <%
            total_por_columna = Array.new(veriserviciosagendas.size, 0)
          %>

          <% Veriserviciosagendasdato.select("clasificacion, orden").where("veriservicio_id = #{@veriservicio.id}").distinct.order("orden asc").each do |v| %>
            <tr>
              <td style="text-align: center; font-family: Tahoma; padding: 3px;font-size: 10px;"><%= v.orden %></td>
              <td style="text-align: left; font-family: Tahoma; padding: 3px;font-size: 10px;"><%= v.clasificacion %></td>

              <% veriserviciosagendas.each_with_index do |p, col_index| %>
                <% total_celda = Veriserviciosagendasdato.where("clasificacion = ? AND veriserviciosagenda_id = ? AND veriservicio_id = ?", v.clasificacion, p.veriserviciosagenda_id, @veriservicio.id).sum(:total) %>
                <td width="12%" style="text-align: center; font-family: Tahoma; padding: 3px;font-size: 10px;">
                  <%= total_celda %>
                </td>
                <% total_por_columna[col_index] += total_celda %> <!-- Acumular el total por columna -->
              <% end %>
            </tr>
          <% end %>

          <!-- Fila para mostrar los promedios por columna -->
          <tr>
            <th style="background-color: #D6D6D6; text-align: center; font-family: Tahoma; padding: 3px;font-size: 10px;" colspan="2" rowspan="2">
              TOTAL PROMEDIO
            </th>
            <% totalesPromedio = 0 %>
            <% veriserviciosagendas.each_with_index do |agenda, col_index| %>
              <%
                total_items = Veriserviciosagendasdato.where("veriservicio_id = ? AND veriserviciosagenda_id = ?", @veriservicio.id, agenda.veriserviciosagenda_id).count
                promedio_columna = (total_por_columna[col_index].to_f / total_items) rescue 0
                totalesPromedio += promedio_columna
              %>
              <th width="12%" style="background-color: #D6D6D6; text-align: center; font-family: Tahoma; padding: 3px;font-size: 10px;">
                <%= promedio_columna.round(2) %>
              </th>
            <% end %>
          </tr>
          <tr>
            <%
              total_agendas_count = @veriservicio.veriserviciosagendas.count.to_i
              promedio_total = (totalesPromedio.round(2) / total_agendas_count) rescue 0
            %>
            <th colspan="<%= total_agendas_count %>" style="background-color: #CF0000; text-align: center; font-family: Tahoma; padding: 3px;font-size: 10px; color: white">
              <%= promedio_total.round(2) %>
            </th>
          </tr>

        </table>
      </td>
    </tr>

    <tr>
      <td width="100%">
        <div align="center" style="padding: 5px">
          <% graph_image_url = Graph.where("tabla = 'INFORME_VERISERVICIOAGENDA' and id_registro = ?", @veriserviciosagenda.id).first&.graphimage&.url(:original) %>
          <img src="https://appasearesp.com/<%= graph_image_url %>" alt="" style="width: 550px; height: 250px;">
        </div>
      </td>
    </tr>
  </table>
  <br/>
  <% @veriservicio.veriserviciositems.select(:clasificacion).distinct.each do |pp|
    @datoTotal = Objeto.find_by_sql("SELECT
                    ROUND(SUM(calificacion) / COUNT(9), 2) AS total
                    FROM veriserviciositems
                    WHERE veriservicio_id = #{@veriservicio.id}
                    AND clasificacion = '#{pp.clasificacion}'
                    AND calificacion IN (1, 2, 3, 4, 5)")[0].total

  %>
    <table width="900" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Tahoma">
      <!-- Encabezado con clasificación -->
      <tr>
        <th style="background-color: #CF0000; color: white; text-align: center; font-family: Tahoma; padding: 3px" colspan="8">
          <%= pp.clasificacion %>
        </th>
      </tr>

      <!-- Descripción de la evaluación -->
      <tr>
        <td style="text-align: left; font-family: Tahoma; padding: 3px" colspan="8">
          Marcar con una X la evaluación de las condiciones encontradas, siendo 1 deficiente y 5 excelente. En caso de
          no aplicar, indicar en cada casilla N/A.
        </td>
      </tr>

      <!-- Encabezado de la tabla -->
      <tr>
        <th style="background-color: #D6D6D6; text-align: left; font-family: Tahoma; padding: 3px; font-size: 12px;" colspan="3">
          Servicio Contratado
        </th>
        <th width="20%" style="background-color: #D6D6D6; text-align: center; font-family: Tahoma; padding: 3px; font-size: 12px;">
          Calificación
        </th>
      </tr>
    </table>
    <!-- Datos de veriserviciositems -->
    <% @veriservicio.veriserviciositems.where(clasificacion: pp.clasificacion).order(orden: :asc).each do |veriserviciositem| %>
      <div align="center">
        <table width="900" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Tahoma">
          <tr>
            <td style="text-align: left; font-family: Tahoma; padding: 3px; font-size: 12px;" colspan="3" width="75%">
              <%= veriserviciositem.descripcion %>
            </td>
            <td style="text-align: center; font-family: Tahoma; padding: 3px; font-size: 12px;" width="25%">
              <%= veriserviciositem.calificacion_descripcion rescue nil %>
            </td>
          </tr>

          <!-- Imágenes asociadas al veriserviciositem -->
          <% if veriserviciositem.veriserviciosiimagenes.present? %>
            <tr>
              <td style="background-color: #D6D6D6; text-align: left; font-family: Tahoma; padding: 5px; font-size: 11px;" colspan="7">
                Documentos Digitales <b>(<%= veriserviciositem.descripcion rescue nil %>)</b>
              </td>
            </tr>
            <% veriserviciositem.veriserviciosiimagenes.each_slice(4) do |imagenes| %>
              <tr>
                <% imagenes.each do |imagen| %>
                  <td width="25%" style="text-align: center; font-family: Tahoma; padding: 3px; font-size: 11px;">
                    <% url = imagen.veriimagen.url(:thumb) %>
                    <% clean_url = URI.parse(url).path %>
                    <% file_extension = File.extname(clean_url).delete('.').downcase %>

                    <% if %w[png jpeg jpg].include?(file_extension) %>
                      <img src="<%= base_url + url %>" width="100" height="100"/><br/>
                    <% else %>
                      <%= link_to url, base_url + url %>
                    <% end %>
                    <br/>
                    <p><b><%= imagen.descripcion rescue nil %></b></p>
                    <p><%= imagen.created_at.strftime("%d/%m/%Y %X") rescue nil %></p>
                  </td>
                <% end %>

                <% (4 - imagenes.size).times do %>
                  <td width="25%" style="text-align: center; font-family: Tahoma; padding: 3px; font-size: 11px;">
                    <!-- Celda vacía para alinear la tabla -->
                  </td>
                <% end %>
              </tr>
            <% end %>
          <% end %>

          <!-- Notas asociadas al veriserviciositem -->
          <% if veriserviciositem.veriserviciosinotas.present? %>
            <tr>
              <td style="text-align: center; font-family: Tahoma; padding: 5px; font-size: 11px;" colspan="7">
                Nota y/o Observación <b>(<%= veriserviciositem.descripcion rescue nil %>)</b>
              </td>
            </tr>
            <% veriserviciositem.veriserviciosinotas.each do |nota| %>
              <tr>
                <td style="text-align: justify; font-family: Tahoma; padding: 3px;font-size: 11px;" colspan="7">
                  <%= nota.observacion rescue nil %>
                </td>
              </tr>
            <% end %>
          <% end %>

          <!-- Compromisos asociados al veriserviciositem -->
          <% if veriserviciositem.veriserviciosicompromisos.present? %>
            <tr>
              <td style="background-color: #D6D6D6; text-align: left; font-family: Tahoma; padding: 5px; font-size: 11px;" colspan="7">
                Compromisos <b>(<%= veriserviciositem.descripcion rescue nil %>)</b>
              </td>
            </tr>
            <tr>
              <th width="15%" style="background-color: #D6D6D6; text-align: center; font-family: Tahoma; padding: 3px;font-size: 11px;">
                Fecha
              </th>
              <th width="15%" style="background-color: #D6D6D6; text-align: center; font-family: Tahoma; padding: 3px;font-size: 11px;">
                Estado
              </th>
              <th style="background-color: #D6D6D6; text-align: justify; font-family: Tahoma; padding: 3px;font-size: 11px;">
                Compromisos
              </th>
              <th width="40%" style="background-color: #D6D6D6; text-align: justify; font-family: Tahoma; padding: 3px;font-size: 11px;">
                Observación
              </th>
            </tr>
            <% veriserviciositem.veriserviciosicompromisos.each do |compromiso| %>
              <tr>
                <td style="text-align: center; font-family: Tahoma; padding: 3px;font-size: 11px;">
                  <%= compromiso.fecha rescue nil %>
                </td>
                <td style="text-align: center; font-family: Tahoma; padding: 3px;font-size: 11px;">
                  <%= compromiso.estado rescue nil %>
                </td>
                <td style="text-align: left; font-family: Tahoma; padding: 3px;font-size: 11px;">
                  <%= compromiso.compromiso rescue nil %>
                </td>
                <td style="text-align: justify; font-family: Tahoma; padding: 3px;font-size: 11px;">
                  <%= compromiso.observacion_estado rescue nil %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </table>
      </div>
    <% end %>

    <div align="center">
      <table width="900" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Tahoma">
        <tr>
          <th style="background-color: #D6D6D6; text-align: left; font-family: Tahoma; padding: 3px; font-size: 14px;" colspan="3" width="75%">
            TOTAL
          </th>
          <th style="background-color: #D6D6D6; text-align: center; font-family: Tahoma; padding: 3px; font-size: 14px;" width="25%">
            <%= @datoTotal.to_f rescue 0 %>
          </th>
        </tr>
      </table>
    </div><br/>
  <% end %>

  <% if @veriservicio.veriserviciosagendas.present? %><br/>
    <table width="900" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Tahoma">
      <tr>
        <th style="background-color: #CF0000; color: white; text-align: center; font-family: Tahoma; padding: 3px" colspan="2">
          Conclusiones
        </th>
      </tr>
      <tr>
        <th width="20%" style="background-color: #CF0000; color: white; text-align: center; font-family: Tahoma; padding: 3px">
          Fecha Agenda
        </th>
        <th style="background-color: #CF0000; color: white; text-align: left; font-family: Tahoma; padding: 3px">
          Detalle de la conclusión
        </th>
      </tr>
      <% @veriservicio.veriserviciosagendas.order("id desc").each do |veriserviciosagenda| %>
        <tr>
          <td style="text-align: center; font-family: Tahoma; padding: 3px;font-size: 11px; " width="20%"><%= veriserviciosagenda.fecha_reprogramacion rescue nil %></td>
          <td style="text-align: justify; font-family: Tahoma; padding: 3px;font-size: 11px; "><%= veriserviciosagenda.conclusion rescue nil %></td>
        </tr>
      <% end %>
    </table><br/><br/>
  <% end %>

  <table width="900" border="0" cellspacing="0" cellpadding="0" style="font-size: 12px; font-family: Tahoma">
    <% @veriserviciosagenda.veriserviciosusers.each_slice(2) do |firmas| %>
      <tr>
        <% firmas.each do |firma| %>
          <td width="50%" style="text-align: center; font-family: Tahoma; padding: 5px;font-size: 11px;">
            <div align="left">
              <strong>FIRMA DIGITAL</strong><br/>
              <b>Empleado:</b> <%= firma.user.nombre rescue nil %><br/>
              <b>CC:</b> <%= camponumerico2(firma.user.identificacion) rescue nil %><br/>
              <b>Firma Digital:</b> <%= firma.codigo_firma %><br/>
              <b>Fecha Firma:</b> <%= firma.codigo_fecha.strftime("%Y-%m-%d %X") rescue nil %><br/>
              * Este documento fue generado con firma electrónica y cuenta con plena validez jurídica, conforme a lo
              dispuesto en la Ley 527/99 y el decreto reglamentario 2364/12
            </div>
          </td>
        <% end %>
        <% (2 - firmas.size).times do %>
          <td width="50%" style="text-align: center; font-family: Tahoma; padding: 3px;font-size: 11px;">

          </td>
        <% end %>
      </tr>
    <% end %>
  </table>
</div>>