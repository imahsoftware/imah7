

<div class="box-header">
  <h3 class="box-title"><strong>Agenda</strong></h3>
  <div class="box-tools pull-right">
    <% if Veriserviciositem.where("veriservicio_id = #{@veriservicio.id} AND calificacion IS NOT NULL and calificacion IN (1,2,3)").present? and
      Veriserviciosuser.where("veriservicio_id = #{@veriservicio.id} and codigo_firma is not null and veriserviciosagenda_id in (select id from veriserviciosagendas where estado = 'PENDIENTE' and DATE_FORMAT(fecha_reprogramacion, '%Y-%m-%d') = DATE_FORMAT(now(), '%Y-%m-%d'))").count ==
        Veriserviciosuser.where("veriservicio_id = #{@veriservicio.id} and veriserviciosagenda_id in (select id from veriserviciosagendas where estado = 'PENDIENTE' and     DATE_FORMAT(fecha_reprogramacion, '%Y-%m-%d') = DATE_FORMAT(now(), '%Y-%m-%d'))").count
    %>
      <%= link_to new_veriservicio_veriserviciosagenda_path(@veriservicio), id: 'new_veriserviciosagenda_button', class: 'btn btn-sm btn-info', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
      <% end %>
    <% end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="veriserviciosagenda_form" class="collapse"></div>
  <div id="veriserviciosagendas">
    <% if @veriservicio.veriserviciosagendas.present? %>
      <%= render 'veriserviciosagendas/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %>
      </div>
    <% end %>
  </div>
</div>

