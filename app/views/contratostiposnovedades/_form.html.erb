<%= simple_form_for([@contrato, @contratostiposnovedad], remote: true) do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-6 col-lg-4"><%= f.input :tiposnovedad_id, collection: Tiposnovedad.where(["id not in (select tiposnovedad_id from contratostiposnovedades where contrato_id = #{@contrato.id})"]).order(:descripcion).collect {|p| [ p.descripcion, p.id ] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label:"Tipo de Novedad"%></div>
    </div>
    <div class="row">
      <div class="col-md-6">
        <% if @contratostiposnovedad.new_record? %>
          <%= button_tag "#{t :cancelar}", type: 'button', data: {target: '#contratostiposnovedad_form'}, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}", contrato_contratostiposnovedad_path(@contrato, @contratostiposnovedad), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
<br/>
