$("#tipospretencion_form").collapse("hide");

$("#tipospretencion_form").empty();

<% if @active_record.present? %>
	$("#tipospretencion_<%= @active_record.id %>").replaceWith("<%= j render 'tr', tipospretencion: @active_record %>");
<% end %>

$("#tipospretencion_<%= @tipospretencion.id %>").html("<td colspan='5'><%= j render 'form' %></td>");

$("#tipospretencion_<%= @tipospretencion.id %>").addClass("active_tipospretencion");
$(".datetimepicker").datetimepicker();
$(".select2").select2();

$(".tooltip").tooltip("hide");

$('[data-toggle="tooltip"]').tooltip();