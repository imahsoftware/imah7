<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
    <thead>
      <tr class="thcolor">
        <th width="10%"></th>
        <th width="10%" class="text-center">Clase</th>
        <th>Descripción</th>
        <th width="10%" class="text-center">Estado</th>
      </tr>
    </thead>
    <tbody id="tbody_tipospretenciones">
      <% @tipospretenciones.order("clase, descripcion asc").each do |tipospretencion| %>
        <%= render 'tipospretenciones/tr', tipospretencion: tipospretencion %>
      <% end %>
    </tbody>
  </table>
</div>