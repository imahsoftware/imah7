<tr id="contratosperdescuento_<%= contratosperdescuento.id %>">
  <td class="text-center">
    <% if is_auth_a("contratosperdescuento")%>
      <%= link_to edit_contratospersona_contratosperdescuento_path(@contratospersona, contratosperdescuento), remote: true, class: 'edit_contratosmodificacion_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
        <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
      <% end %>
    <% end %>
    <% if is_auth_e("contratosperdescuento")%>
      <%= link_to contratospersona_contratosperdescuento_path(@contratospersona, contratosperdescuento), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
         <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
      <% end %>
    <% end %>
    <button class="btn btn-xs btn-info"><span data-toggle="tooltip" data-html="true" data-original-title="<div align='left'><%= contratosperdescuento.user_nombre.html_safe rescue nil %></div>"><i class="fa fa-user" aria-hidden="true"></i></span></button>
  </td>
  <td align="right"><%=camponumerico contratosperdescuento.valor rescue nil %></td>
  <td align="center"><%= contratosperdescuento.termino_descuento rescue nil %></td>
  <td align="center"><%= contratosperdescuento.estado rescue nil %></td>
  <td align="center"><%= contratosperdescuento.tipo rescue nil %></td>
</tr>
