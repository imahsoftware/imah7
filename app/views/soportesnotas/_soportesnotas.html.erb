<div class="box-header">
  <h3 class="box-title"><strong>Notas</strong></h3>
  <div class="box-tools pull-right">
    <% if @soporte.estado == 'PENDIENTE' %>
    <%# if is_auth_c('soportesnota') %>
      <%= link_to new_soporte_soportesnota_path(@soporte), id: 'new_soportesnota_button', class: 'btn btn-sm btn-info', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
      <% end %>
    <%# end %>
    <% end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="soportesnota_form" class="collapse"></div>
  <div id="soportesnotas">
    <% if @soporte.soportesnotas.present? %>
      <%= render 'soportesnotas/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
    <% end %>
  </div>
</div>

