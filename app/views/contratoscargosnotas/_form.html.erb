<%= simple_form_for([@contratoscargo, @contratoscargosnota], remote: true) do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
        <%= f.input :observacion, collection: Iparametro.where(campo: 'epp').order(:descripcion).collect { |p| [p.descripcion.to_s, p.descripcion.to_s] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: 'Elemento de PP asociado' %></div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :cantidad %></div>
    </div>
    <div class="row">
      <div class="col-md-6">
        <% if @contratoscargosnota.new_record? %>
          <%= button_tag "#{t :cancelar}", type: 'button', data: { target: '#contratoscargosnota_form' }, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}", contratoscargo_contratoscargosnota_path(@contratoscargo, @contratoscargosnota), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
<br/>