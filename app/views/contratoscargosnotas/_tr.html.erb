<tr id="contratoscargosnota_<%=contratoscargosnota.id %>">
  <td class="text-center">
    <%= link_to contratoscargo_contratoscargosnota_path(@contratoscargo, contratoscargosnota), remote: true, method: :delete, data: {confirm: "#{t :elimina_confirma}", toggle: 'tooltip'}, title: "#{t :title_elimina}" do %>
      <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
    <% end %>
    <button class="btn btn-xs btn-info"><span data-toggle="tooltip" data-html="true" data-original-title="<div align='left'>
    <%= contratoscargosnota.created_at.strftime("%Y-%m-%d %X") rescue nil %> - <%= contratoscargosnota.user.username rescue nil %>
      <br/><%= contratoscargosnota.updated_at.strftime("%Y-%m-%d %X") rescue nil %> - <%= User.find(contratoscargosnota.user_anula).username rescue nil %>
    </div>"><i class="fa fa-user" aria-hidden="true"></i></span></button>
  </td>
  <td class="text-center" style="font-size: 11px;"><%= contratoscargosnota.created_at.strftime("%Y-%m-%d") rescue nil %></td>
  <td class="text-justify" style="font-size: 10px;"><%= contratoscargosnota.observacion rescue nil %></td>
  <td class="text-center" style="font-size: 10px;"><%= contratoscargosnota.cantidad rescue nil %></td>
</tr>
