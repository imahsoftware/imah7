<% if @valida %>
$("#otp<%= @contratosperpronota.id %>").modal("hide");
$("#firmado_check<%= @contratosperpronota.id %>").html(" <div> <b>Firmado:</b> <i class='fa fa-check text-success'></i> - <b>Fecha: </b><%= @contratosperpronota.codigo_fecha.strftime('%Y-%m-%d %X') rescue nil %></div>");
$("#remove_boton<%= @contratosperpronota.id %>").remove();
<% else %>
$("#mensaje<%= @contratosperpronota.id %>").replaceWith("<div class='row' id='mensaje'><div class='col-xs-12 col-sm-12 col-md-2 col-lg-2' style='text-align: center;width: 100%;margin-bottom: 30px;color: red;font-weight: 600;font-size: 20px;'>CODIGO NO VALIDO</div></div>");
<% end %>