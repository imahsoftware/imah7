$(".form-group").removeClass("has-error");
$(".form-group > .help-block.help-block-error").remove();
<% if @validaperdotacion %>
$('#mensaje_error<%= @contratosperdotacion.id %>').html("<div id='mensaje_error<%= @contratosperdotacion.id %>' style='background-color: #FFC300; color: red; padding: 8px; border-radius: 5px;'><b><i class='fa fa-star'></i></b> Al menos uno de los campos (zapatos, camisa, pantalón) debe ser obligatorio.</div>");
<% end %>
<% if @validacion == true %>
$("#error_visita").html("<%= j render 'visitas/mensaje_error' %>");
<% end %>

<% if object.errors.present? %>
<% object.errors.each do |attr, msg| %>
console.log(".<%= object.model_name.param_key %>_<%= attr %>")
$(".<%= object.model_name.param_key %>_<%= attr %>").addClass("has-error");
$(".<%= object.model_name.param_key %>_<%= attr %>").append("<span class='help-block help-block-error'><%= msg %></span>");
<% end %>
<% end %>
