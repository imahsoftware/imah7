<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html>
<head>
  <meta http-equiv="Content-Type" content="application/vnd.ms-excel" charset="UTF-8"/>
</head>
<body>


<table table width="100%" border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 16px; font-family: Tahoma; line-height: 150%;">
  <thead>
  <tr>
    <td rowspan="2" style="border:1px solid #CCCCCC; font-size: 16px; font-family: Tahoma;">
      <div align="center">
      <%= wicked_pdf_image_tag "#{image_url("logo_inicio_asear.png")}", size: "230x100" %>
      </div>
    </td>
    <td style="border:1px solid #CCCCCC; font-size: 16px; font-family: Tahoma;">
      <div align="center"><b>
        SISTEMA DE GESTIÓN DE SEGURIDAD Y SALUD
        EN EL TRABAJO</b>
      </div>
    </td>
    <td rowspan="2" style="border:1px solid #CCCCCC; font-size: 16px; font-family: Tahoma;">
      <div align="center">
        <b>Versión 7<br/>
          Febrero 2023</b>
      </div>

    </td>
  </tr>
  <tr>
    <td style="border:1px solid #CCCCCC; font-size: 16px; font-family: Tahoma;">
      <div align="center"><b> INDUCCIÓN PERSONAL NUEVO</b></div>
    </td>
  </tr>
  </thead>
</table>


<%= yield %>
</body>
</html>