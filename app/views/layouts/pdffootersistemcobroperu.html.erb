<html>
<head>
  <script>
      function number_pages() {
          var vars={};
          var x=document.location.search.substring(1).split('&');
          for(var i in x) {var z=x[i].split('=',2);vars[z[0]] = decodeURIComponent(z[1]);}
          var x=['frompage','topage','page','webpage','section','subsection','subsubsection'];
          for(var i in x) {
              var y = document.getElementsByClassName(x[i]);
              for(var j=0; j<y.length; ++j) y[j].textContent = vars[x[i]];
          }
      }
  </script>
</head>
<body onload="number_pages()" style="font-size: 8px;">


<div style="font-size: 9px; font-family: Tahoma; margin-left: 30px">
  Pagina <span class="page"></span> de <span class="topage"></span>
</div>
<div align="right" style="font-size: 9px; font-family: Tahoma; margin-right: 30px">
  Av. Paseo de la Republica 3755 3er. Piso – San Isidro<br/>
  Central: 619-1515<br/>
  www.systemcobro.pe<br/>
  Lima – Perú
</div>
</body>
</html>