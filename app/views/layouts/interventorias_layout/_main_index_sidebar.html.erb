<aside class="main-sidebar" style="margin-top: 40px;">
  <section class="sidebar">
    <%
      usr = @user
      estados = []

      # MI_CUENTA: si tiene contrato activo como contratista
      if @empleado.present? && Contratosperfecha
        .where(contratospersona_id: @empleado.id)
        .where("fecha_inicio <= CURDATE() AND fecha_fin IS NULL")
        .where(estado: 'ACTIVO')
        .exists?
        estados << 'MI_CUENTA'
      end

      if is_auth_c("interventoriabuscador")
        estados << 'BUSCADOR'
      end

      # SUPERVISOR: por permiso O por tener contratistas asignados vigentes
      if is_auth_c("interventoria") ||
         Contratosperuser.where(user_id: usr.id, fecha_fin: nil).exists?
        estados << 'SUPERVISOR'
      end

      if is_auth_c("interventoriagh")
        estados << 'TALENTO_HUMANO'
      end
      if is_auth_c("interventoriacont")
        estados << 'CONTABILIDAD'
      end
      if is_auth_c("interventoriatesoreria")
        estados << 'TESORERIA'
      end

      etapa_labels = {
        'MI_CUENTA'     => 'Cuenta de Cobro',
        'BUSCADOR'      => 'Buscador',
        'SUPERVISOR'    => 'Supervisor',
        'TALENTO_HUMANO'=> 'Talento Humano',
        'CONTABILIDAD'  => 'Contabilidad',
        'TESORERIA'     => 'Tesorería',
        'VALIDADOR'     => 'Validador'
      }
    %>

    <ul class="sidebar-menu" data-widget="tree">
      <li style="font-size: 12px !important;">
        <%= link_to root_path do %>
          <i class="fa fa-arrow-left text-success"></i> <span style="font-size: 12px !important;">Regresar</span>
        <% end %>
      </li>
      <li class="header"><%= I18n.t("menu") %></li>

      <%
        estados.each do |p|
          clase = usr.etapa.to_s == p ? "active" : ""
      %>
        <li class="<%= clase %>">
          <%= link_to etapar_interventorias_path(etapa: p) do %>
            <div style="font-size:12px; font-family: Tahoma;">
              <i class="fa fa-cog"></i> <%= etapa_labels[p] || p.capitalize %>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
</aside>
