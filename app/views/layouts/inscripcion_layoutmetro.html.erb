<!DOCTYPE html>
<html>
<head>
  <title><%= content_for?(:title) ? yield(:title) : 'App' %> | <%= ENV['NOMBRE_APLICACION'] %></title>
  <%= csrf_meta_tags %>
  <%= action_cable_meta_tag %>
  <script>
      console.log("🔥 current_user:", <%= current_user ? current_user.id : "null" %>);
      window.CURRENT_USER_ID = <%= current_user ? current_user.id : "null" %>;
  </script>
  <%= stylesheet_link_tag 'application', media: 'all' %>
  <%= javascript_include_tag 'application' %>
  <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
</head>
<%
  isadmin = is_admin
  user = User.find(isadmin)
%>
<body class="skin-red layout-top-nav" style="height: auto; min-height: 100%;">
<div class="wrapper" style="height: auto; min-height: 100%;">
  <header class="main-header">
    <nav class="navbar navbar-static-top">
      <div class="container">
        <div class="navbar-header">
          <%= link_to root_path, class: 'navbar-brand' do %>
            <b>Asear</b>
          <% end %>
        </div>
        <div class="collapse navbar-collapse pull-left" id="navbar-collapse">
          <ul class="nav navbar-nav">
          </ul>
        </div>
        <div class="navbar-custom-menu">
          <ul class="nav navbar-nav">
            <%# if Contratospersona.where("identificacion = '#{user.identificacion}'").first.present? %>
              <!-- <li>
                <%#= link_to abrir_datos_menus_path, remote: true, data: { toggle: 'tooltip' }, title: 'Actualizar Datos Basicos' do %>
                  <i class="fa fa-futbol-o"></i>
                <%# end %>
              </li> -->
            <%# end %>
            <li class="dropdown user user-menu">
              <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                <%= image_tag user.avatar.url(:medium), class: 'user-image', alt: 'User Image' %>
                <span class="hidden-xs"><%= user.username %></span>
              </a>
              <ul class="dropdown-menu">
                <li class="user-header">
                  <%= image_tag user.avatar.url(:medium), class: 'img-circle', alt: 'User Image' %>
                  <p>
                    <%= user.nombre rescue nil %>
                  </p>
                </li>
                <li class="user-footer">
                  <div class="pull-left">
                    <%= link_to edit_user_registration_path do %>
                      <button class="btn btn-default btn-flat">
                        <i class="fa fa-edit"> <b style="font-size: 11px;"><%= t :editar_perfil %></b></i></button>
                    <% end %>
                  </div>
                  <div class="pull-right">
                    <%= link_to logout_path, data: { confirm: '¿Esta seguro ' + "#{user.nombre}" + ' que quiere desconectarse?' } do %>
                      <button class="btn btn-default btn-flat">
                        <i class="fa fa-sign-in"> <b style="font-size: 11px;"><%= t :salir %></b></i></button>
                    <% end %>
                  </div>
                </li>
              </ul>
            </li>
          </ul>
        </div>

      </div>

    </nav>
  </header>

  <div class="content-wrapper" style="min-height: 355px;">
    <div class="container">
      <section class="content-header"><%= render 'layouts/flash_messages', flash: flash %></section>
      <section class="content"><%= yield %></section>
    </div>
  </div>

  <footer class="main-footer">
    <div class="container">
      Copyright &copy; 2019 - <%= Time.now.strftime("%Y") %> <b><%= ENV['DERECHOS_RESERVADOS'] %></b> | Todos los derechos reservados.
    </div>
  </footer>
</div>
<div class="modal fade" id="menu">
  <div class="modal-dialog modal-dialog-responsive" role="document">
    <div class="modal-content"></div>
  </div>
</div>


<div class="modal fade" id="abrir_datos">
  <div class="modal-dialog modal-dialog-responsive" role="document">
    <div class="modal-content">
    </div>
  </div>
</div>
</body>
</html>
