<%
  budget = @contratossolicitud.budget.to_s rescue nil
%>
<div class="box ">
  <div class="box-body">
    <div class="row">
      <div class="col-md-12">
        <legend>
          <%= link_to edit_contratossolicitud_path(id: @contratossolicitud.id), data: {toggle: 'tooltip'}, title: 'Regresar' do %>
            <i class="fa fa-arrow-left fa-fw text-success" aria-hidden="true"></i>
          <% end %>
          Información Contrato (<%= @contratossolicitud.contrato.empresa.identificacion rescue nil %>
          -<%= @contratossolicitud.contrato.empresa.digito rescue nil %> <%= @contratossolicitud.contrato.empresa.nombre rescue nil %>
          )
        </legend>
      </div>
    </div>
    <div class="row">
      <div class="col-md-12">
        <div class="table-responsive">
          <table class="table table-bordered table-condensed table-striped">
            <thead>
            <tr class="thcolor">
              <th width="15%" class="text-center">Nro Contrato</th>
              <th width="10%" class="text-center">Nro Solicitud</th>
              <th width="20%" class="text-center">Fecha creación</th>
              <th width="20%" class="text-center">Periodo</th>
              <th width="15%" class="text-center">Valor Total</th>
              <th width="20%" class="text-center">Estado Solicitud</th>
            </tr>
            </thead>
            <tbody id="tbody">
            <tr>
              <td class="text-center" style="font-size:12px;"><%= @contratossolicitud.contrato.nro_contrato rescue nil %></td>
              <td class="text-center" style="font-size:12px;"><%= @contratossolicitud.id rescue nil %></td>
              <td class="text-center" style="font-size:12px;"><%= @contratossolicitud.created_at.strftime("%Y-%m-%d %X") rescue nil %></td>
              <td class="text-center" style="font-size:12px;"><%= @contratossolicitud.periodo rescue nil %></td>
              <td class="text-center" style="font-size:12px;">
                <button class="btn btn-xs btn-info">
                  <strong>$ <%= camponumerico @contratossolicitud.contratossoldetalles.sum("total") rescue 0 %></strong>
                </button>
              </td>
              <td class="text-center" style="font-size:12px;"><%= @contratossolicitud.estado rescue nil %></td>
            </tr>
            </tbody>
          </table>
          <% if budget != 'OK' %>
              <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4>El valor acumulado del presupuesto junto con esta solicitud supera el Tope, por favor verifique!</div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
<%
  visualiza_iva = @contratossolicitud.contrato.visualiza_iva.to_s rescue nil
  dato = @contratossolicitud.datosol.to_s
  clase = ""
  if @contratossolicitud.etapa.to_s == 'A'
    clase = "Insumos"
  elsif @contratossolicitud.etapa.to_s == 'B'
    clase = "Equipos, Maquinaria"
  elsif @contratossolicitud.etapa.to_s == 'C'
    clase = "Otros servicios"
  end
%>
<% if visualiza_iva.to_s == 'SI'
     detalle = Contratossoldetalle.select("DISTINCT porc_iva, SUM(total) valortotal").where(["contratossolicitud_id = #{@contratossolicitud.id} AND cantidad > 0"]).group("porc_iva")
     if detalle.present?
%>
    <div class="row">
      <div class="col-md-9"></div>
      <div class="col-md-3">
        <div class="table-responsive">
          <table class="table table-bordered table-condensed table-striped">
            <thead>
            <tr class="thcolor">
              <th width="35%" class="text-center">Porc IVA</th>
              <th class="text-center">Total en la solicitud</th>
            </tr>
            </thead>
            <tbody id="tbody">
            <% detalle.each do |a| %>
              <tr>
                <td class="text-center" style="font-size:12px;"><%= a.porc_iva rescue nil%>%</td>
                <td class="text-center" style="font-size:12px;"><%= camponumerico a.valortotal rescue nil%></td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
<%   end
   end %>

<legend>
  Edición Avanzada de <%= clase.to_s %>
  <div class="box-tools pull-right">
    <%= link_to edit_contratossolicitud_path(id: @contratossolicitud.id), data: {toggle: 'tooltip'}, title: 'Regresar' do %>
      <button class="btn btn-xs btn-warning"><i class="fa fa-arrow-left fa-fw" aria-hidden="true"></i> Regresar a la
        solicitud
      </button>
    <% end %>
  </div>
</legend>
<div class="box ">
  <div class="box-body">
    <%= form_tag '/contratossoldetalles/update_individual', method: 'put' do %>
      <div class="grid-container">
        <% sedesactivas = Contratossede.where(["id in (select sede from sedesactivas where contrato_id = #{@contratossolicitud.contrato.id} and user_interventor = #{@contratossolicitud.user_id})"]).order(id: :asc) %>
        <div class="grid">
          <div class="grid-col grid-col--fixed-left" style=" min-width: 260px;">
            <div class="grid-item grid-item--header" style=" min-height: 60px;max-height: 260px; min-width: 260px; background: #394959; color: white; font-size: 10px; text-align: center; display: flex; align-items: center; justify-content: center;">
              <p><b>ITEM</b></p></div>
            <% for contratossoldetalle in @contratossoldetalles.select(["contratossoldetalles.*,
                                                                 (select presentacion from insumos where id = (select insumocce from contratosinsumos where id = contratossoldetalles.contratosinsumo_id)) presentacion"])
                                                               .includes([:contratosinsumo]).where(["#{dato.to_s}"]).order("id asc") %>
              <%= fields_for "contratossoldetalles[]", contratossoldetalle do |f| %>
                <div class="grid-item-producto">
                  <p style="font-size: 10px; padding: 5px;">
                    <% if contratossoldetalle.presentacion %>
                        <%= link_to fichatecnica_contratossoldetalles_path(contratossoldetalle_id: contratossoldetalle.id), data: { toggle: 'tooltip' }, title: 'Ficha', remote: true do %>
                          <i class="fa fa-life-ring text-red"></i>
                        <% end %>
                    <% end %> <%= contratossoldetalle.nombreinsumo %> <small> (VlrUnit: <%=camponumerico contratossoldetalle.precio_unitario rescue 0%>)</small>

                    <% if visualiza_iva.to_s == 'SI' %>(IVA <%= contratossoldetalle.porc_iva %>%)<% end %></p></div>
              <% end %>
            <% end %>
          </div>
          <div class="grid-col">
            <div class="grid-item grid-item--header" style="min-height: 60px; max-height: 260px; background: #394959; color: white; font-size: 10px; text-align: center; display: flex; align-items: center; justify-content: center;">
              <p><b>TOTAL</b></p></div>
            <% for contratossoldetalle in @contratossoldetalles.where(["#{dato.to_s}"]).order("id asc") %>
              <%= fields_for "contratossoldetalles[]", contratossoldetalle do |f| %>
                <div class="grid-item-producto" style="min-width: 0px !important; display: flex; align-items: center; justify-content: center;"><%= f.text_field :cantidad, {:class => "camposnumeros", :size => 6, :onFocus => "this.style.border='1px solid #f00'", :onBlur => "this.style.border='1px solid #bbb';", :style => "border: 1px solid rgb(214 214 214 / 79%); font-size: 10px; font-family: Tahoma; text-align: center;  width: 55px;height: 30px;border-radius: 2px;", :disabled => true} %></div>
              <% end %>
            <% end %>
          </div>
          <% sedesactivas.each do |a| %>
            <div class="grid-col">
              <div class="grid-item grid-item--header" style=" min-height: 60px;max-height: 260px;padding: 6px; background: #394959; color: white;  text-align: center; display: flex; align-items: center; justify-content: center;">
                <b style="font-size: 1rem;"><%= a.nombre rescue nil %></b></div>
              <% for contratossoldetalle in @contratossoldetalles.where(["#{dato.to_s}"]).order("id asc") %>
                <%= fields_for "contratossoldetalles[]", contratossoldetalle do |f| %>
                  <% datocampo = ":cantsede_" + a.ordensede.to_s %>
                  <div class="grid-item-producto" style="min-width: 0px !important; display: flex; align-items: center; justify-content: center;"><%= f.text_field eval(datocampo), {:class => "camposnumeros", :size => 5, :onFocus => "this.style.border='1px solid #f00'", :onBlur => "this.style.border='1px solid #bbb';", :style => "border: 1px solid rgb(214 214 214 / 79%); font-size: 11px; font-family: Tahoma; text-align: center; width: 55px;height: 30px;border-radius: 2px;"} %></div>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
      <table class="table table-bordered table-condensed table-striped">
        <thead class="thcolor">
        <th class="text-right">Valor total solicitado (<%= clase.to_s %>)</th>
        <th style="width:150px" class="text-right"><%= camponumerico @contratossoldetalles.where(["#{dato.to_s}"]).sum("total") rescue 0 %></th>
        </thead>
      </table>
      <div class="box-tools pull-right">
        <%= submit_tag "Guardar", :disable_with => "Guardando...", :class => "btn btn-sm btn-danger" %>
      </div>
    <% end %>
  </div>
</div>
<div class="modal fade" id="fichatecnica">
  <div class="modal-dialog modal-dialog-responsive" style="width: 80%" role="document">
    <div class="modal-content"></div>
  </div>
</div>


<style>

    .grid-container {
        display: grid; /* This is a (hacky) way to make the .grid element size to fit its content */
        overflow: auto;
        height: 500px;
        width: 100%;
    }

    .grid {
        display: flex;
        flex-wrap: nowrap;
    }

    .grid-col {
        width: 150px;
        min-width: 150px;
    }

    .grid-item--header {
        height: 100px;
        min-height: 100px;
        position: sticky;
        position: -webkit-sticky;
        background: white;
        top: 0;
    }

    .grid-col--fixed-left {
        position: sticky;
        left: 0;
        z-index: 9998;
        background: white;
    }

    .grid-col--fixed-right {
        position: sticky;
        right: 0;
        z-index: 9998;
        background: white;
    }

    .grid-item {
        height: 50px;
        border: 1px solid #EAEAEA;
    }

    .grid-item-producto {
        height: 50px;
        border: 1px solid #EAEAEA;
        min-width: 260px;
    }

    p {
        font-size: 10px;
    }
</style>

<script src="http://ie7-js.googlecode.com/svn/version/2.0(beta3)/IE8.js"></script>



