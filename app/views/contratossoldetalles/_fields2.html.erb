<div class="grid-col">
  <div class="grid-item grid-item--header">
    <p><%= fe rescue nil %></p>
  </div>
  <% ce.each do |a|
    dato = ":cantsede_"+a.ordensede.to_s
  %>
    <div class="grid-item">
      <p><%= f.text_field eval(dato), {:class => "camposnumeros", :size => 5, :onFocus => "this.style.border='1px solid #f00'",
                                       :onBlur => "this.style.border='1px solid #bbb';", :style => "font-size: 11px; font-family: Tahoma; text-align: center;"} %></p>
    </div>
  <% end %>
</div>