<div class="box-header">
  <h3 class="box-title"><strong>Fichas</strong></h3>
  <div class="box-tools pull-right">
      <%# if is_auth_c('insumosficha') %>
      <%= link_to new_insumo_insumosficha_path(@insumo), id: 'new_insumosficha_button', class: 'btn btn-sm btn-info', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
      <% end %>
      <%# end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="insumosficha_form" class="collapse"></div>
  <div id="insumosfichas">
    <% if @insumo.insumosfichas.present? %>
      <%= render 'insumosfichas/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %>
      </div>
    <% end %>
  </div>
</div>

