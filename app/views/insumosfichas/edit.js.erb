$("#insumosficha_form").collapse("hide");

$("#insumosficha_form").empty();

<% if @active_record.present? %>
	$("#insumosficha_<%= @active_record.id %>").replaceWith("<%= j render 'tr', insumosficha: @active_record %>");
<% end %>

$("#insumosficha_<%= @insumosficha.id %>").html("<td colspan='12'><%= j render 'form' %></td>");

$("#insumosficha_<%= @insumosficha.id %>").addClass("active_insumosficha");

$(".select2").select2();

$(".tooltip").tooltip("hide");

$('[data-toggle="tooltip"]').tooltip();
$(".datetimepicker").datetimepicker();
$('.datepicker').datepicker({
    dayNamesMin: [ "Dom", "Lun", "Mar", "Mie", "Jue", "Vie", "Sáb" ],
    monthNamesShort: [ "Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic" ],
    dateFormat: "yy-mm-dd",
    yearRange: '2000:2027',
    changeMonth: true,
    changeYear: true,
});