<%= simple_form_for @tarea do |f| %>
  <div class="box box-danger">
    <div class="box-header">
      <legend>
        <%= link_to tareas_path, data: { toggle: 'tooltip' }, title: 'Regresar' do %>
          <i class="fa fa-arrow-left fa-fw text-success" aria-hidden="true"></i>
        <% end %>
        Información del Week
        <div class="pull-right">
          <%= link_to clonar_tareas_path(id: @tarea.id), remote: true, data: { toggle: 'tooltip' }, title: "Clonar Week" do %>
            <button class="btn btn-xs btn-success"><i class="fa fa-clone"></i> Clonar Week</button>
          <% end %>
          <%= link_to informedat_datas_path(format: :xlsx, infgrupo_id: 85, tarea_id: @tarea.id), data: { toggle: 'tooltip' }, title: "Generar Reporte" do %>
            <button class="btn btn-xs btn-danger"><i class="fa fa-file-excel-o"></i> Excel</button>
          <% end %>
        </div>
      </legend>
    </div>
    <div class="box-body">
      <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
          <%= f.input :tema, input_html: { class: "uppercaseInput" }, label: "Tema" %>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :fecha_adjudicacion, as: :string, input_html: { class: 'datepicker', data: { date_options: { format: 'DD/MM/YYYY', ignoreReadonly: true } }, readonly: true }, label: "Fecha Base" %></div>
        <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :fecha, as: :string, input_html: { class: 'datepicker', data: { date_options: { format: 'DD/MM/YYYY', ignoreReadonly: true } }, readonly: true }, label: "Fecha Inicio Ejecucion" %></div>
        <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :estado, as: :select, collection: select_estado, input_html: { class: 'select2' } %></div>
      </div>
      <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-9">
          <%= f.input :objetivo, as: :text, input_html: { class: "uppercaseInput", :rows => 3 }, label: "Objetivo" %>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :fecha_adj, as: :string, input_html: { class: 'datepicker', data: { date_options: { format: 'DD/MM/YYYY', ignoreReadonly: true } }, readonly: true }, label: "Fecha Adjudicacion Contrato" %></div>
      </div>
    </div>
    <div class="box-footer">
      <div class="box-tools pull-right">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div><!-- /.box-tools -->
    </div>
  </div>
<% end %>
<% unless @tarea.new_record? %>
  <div class="row">
    <div class="col-xs-12">
      <div class="nav-tabs-custom">
        <ul class="nav nav-tabs">
          <li class="active"><a href="#fa-icons" data-toggle="tab"><i class="fa fa-question"></i> Actividades</a></li>
          <li class=""><a href="#fa-doc" data-toggle="tab"><i class="fa fa-file-pdf-o"></i> Documentos Digitales</a></li>
          <li class=""><a href="#fa-cargue" data-toggle="tab"><i class="fa fa-upload"></i> Cargue Masivo</a></li>
        </ul>
        <div class="tab-content">
          <div class="tab-pane active" id="fa-icons">
            <%= render "tareasactividades/tareasactividades" %>
          </div>
          <div class="tab-pane" id="fa-doc">
            <%= render "tareasdocs/tareasdocs" %>
          </div>
          <div class="tab-pane" id="fa-cargue">
            <%= render 'tareasactividades/cargue' %>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
