<div class="modal-content">
  <div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
      <span aria-hidden="true">×</span></button>
    <h4 class="modal-title"><%= @tareasactividad.descripcion rescue nil %></h4>
  </div>
  <%= simple_form_for([@tareasactividad, @tareasactdoc], remote: true) do |f| %>
    <%= hidden_field_tag :tareasactividad_id, @tareasactividad.id %>
    <div class="modal-body">
      <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
          <%= f.input :descripcion, label: "Descripción" %>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
          <%= f.input :documento_tarea, as: :file, label: 'Archivo a cargar' %>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-default pull-left" data-dismiss="modal">Close</button>
      <%= f.button :submit, "Guardar", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>




