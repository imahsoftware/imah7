<div class="box box-primary">
  <div class="box-header">
    <div class="box-header">
      <h3 class="box-title">Parametrización del Week</h3>
      <div class="pull-right">
        <% if is_auth_c('tarea')%>
          <%= link_to new_tarea_path, data: { toggle: 'tooltip' }, title: "Crear Nuevo Registro", class: 'btn btn-sm btn-primary pull-right' do %>
            <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
          <% end %>
        <% end %>
      </div>
    </div>
    <div class="row">
      <div class="col-md-12">
        <div class="table-responsive">
          <% if @tareas.present? %>
            <table class="table table-bordered table-condensed table-striped">
              <thead>
              <tr class="thcolor">
                <th width="8%"></th>
                <th width="5%" class="text-center">ID</th>
                <th width="35%" class="text-left">Tema</th>
                <th width="15%" class="text-center">Fecha Inicio</th>
                <th width="15%" class="text-center">Fecha Adjudicación</th>
                <th width="12%" class="text-center">Estado</th>
              </tr>
              </thead>
              <tbody>
              <% @tareas.each do |tarea| %>
                <tr id="tarea_<%= tarea.id %>">
                  <td class="text-center">
                    <%= link_to informedat_datas_path(format: :xlsx, infgrupo_id: 85, tarea_id: tarea.id), data: { toggle: 'tooltip' }, title: "Generar Reporte" do %>
                      <button class="btn btn-xs btn-danger"><i class="fa fa-file-excel-o"></i></button>
                    <% end %>
                    <%= link_to edit_tarea_path(tarea), class: 'edit_tarea_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
                      <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
                    <% end %>
                    <% if is_auth_e('tarea')%>
                      <%= link_to clonar_tareas_path(id: tarea.id), remote: true, data: { toggle: 'tooltip' }, title: "Clonar Week" do %>
                        <button class="btn btn-xs btn-success"><i class="fa fa-clone"></i></button>
                      <% end %>
                      <% if tarea.tareasactividades.where("observacion is not null").present? == false %>
                        <%= link_to tarea, remote: true, method: :delete, data: { confirm: 'Esta seguro?', toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
                          <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
                        <% end %>
                      <% end %>
                    <% end %>
                  </td>
                  <td class="text-center"><%= tarea.id rescue nil %></td>
                  <td class="text-left"><%= tarea.tema rescue nil %></td>
                  <td class="text-center"><%= tarea.fecha rescue nil %></td>
                  <td class="text-center"><%= tarea.fecha_adjudicacion rescue nil %></td>
                  <td class="text-center"><%= tarea.estado rescue nil %></td>
                </tr>
              <% end %>
              </tbody>
            </table>
          <% else %>
            <div class="alert alert-danger">
              <h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %></div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
