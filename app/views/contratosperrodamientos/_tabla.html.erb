<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
	  <thead class="thcolor">
      <tr>
        <td width="10%"></td>
        <th width="16%" class="text-right">Valor</th>
        <th width="16%" class="text-center">Aplicación</th>
        <th class="text-center">Estado</th>
      </tr>
    </thead>
	  <tbody id="tbody_contratosperrodamientos">
	    <% @contratospersona.contratosperrodamientos.order(id: :desc).each do |contratosperrodamiento| %>
	      <%= render 'contratosperrodamientos/tr', contratosperrodamiento: contratosperrodamiento %>
	    <% end %>
	  </tbody>
	</table>
</div>
