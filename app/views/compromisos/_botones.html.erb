<% if ['PENDIENTE'].include?(contratosperimagen.estado) %>
  <button type="button" class="btn btn-warning dropdown-toggle btn-xs" data-toggle="dropdown">
    Opciones <span class="caret"></span>
    <span class="sr-only">Toggle Dropdown</span>
  </button>
  <ul class="dropdown-menu" role="menu">
    <li>
      <%= link_to estado_compromisos_path(compromiso_id: @compromiso.id, estado: 'FINALIZADO', contratosperimagen_id: contratosperimagen.id), remote: true, class: 'edit_contrato_button', data: { toggle: 'tooltip' } do %>
        <div class="text-blue"><i class="fa fa-arrow-right"></i> Marcar como Finalizado</div>
      <% end %>
    </li>
    <li>
      <%= link_to estado_compromisos_path(compromiso_id: @compromiso.id, estado: 'RECHAZADO', contratosperimagen_id: contratosperimagen.id), remote: true, class: 'edit_contrato_button', data: { toggle: 'tooltip' } do %>
        <div class="text-blue"><i class="fa fa-arrow-right"></i> Marcar como Rechazado</div>
      <% end %>
    </li>
  </ul>
<% end %>