<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
    <thead class="thcolor">
    <tr>
      <td width="15%"></td>
      <td width="15%">Fecha Creación</td>
      <th class="text-left text-table">Lugar</th>
      <th class="text-center text-table" width="15%">Fecha y Hora</th>
      <th class="text-center text-table" width="10%">Estado</th>
    </tr>
    </thead>
    <tbody id="tbody_contratosperprocitaciones">
    <% @contratosperproceso.contratosperprocitaciones.order(id: :desc).each do |contratosperprocitacion| %>
      <%= render 'contratosperprocitaciones/tr', contratosperprocitacion: contratosperprocitacion %>
    <% end %>
    </tbody>
  </table>
</div>
