<style type="text/css">H1.SaltoDePagina { PAGE-BREAK-AFTER: always}</style>
<%
  isadmin = is_admin
  contratospersona = @contratosperfechas[0].contratospersona
  contador = 0
  empresas = Portafolio.where("id in (select distinct e.portafolio_id
                                   from   contratos c, contratosperfechas f, empresas e
                                   where  f.contratospersona_id = #{contratospersona.id}
                                   and    f.contrato_id = c.id
                                   and    c.empresa_id = e.id)")
  empresas.each do |e|
    contratosperfechas = Contratosperfecha.where("contratospersona_id = #{contratospersona.id} and laboro = 'SI'
                                                  and contrato_id in (select distinct c.id
                                                             from   contratos c, empresas e
                                                             where  c.id = contratosperfechas.contrato_id
                                                             and    c.empresa_id = e.id
                                                             and    e.portafolio_id = #{e.id})")
    portafolio = e
    @logo = portafolio.logo_empresa
    @logo_firma = portafolio.logo_firma
    contador = contador + 1
%>
  <% if contador > 1 %>
    <H1 class=SaltoDePagina>&nbsp;</H1>
  <% end %>
    <table width="100%">
      <tr>
        <td width="10%" style="font-family: Tahoma; text-align: center"><%= wicked_pdf_image_tag "#{image_url(@logo)}", size: "280x120" %></td>
        <td width="90%" style="font-family: Tahoma; text-align: center">&nbsp;</td>
      </tr>
    </table><br/>
    <div align="justify" style="font-size: 16px; font-family: Verdana, Geneva, sans-serif;">
      <br/>
      <div align="center"><strong>A QUIEN PUEDA INTERESAR</strong></div><br/>
      La empresa <%=portafolio.razon_social rescue nil %>, con Nit <%=portafolio.identificacion rescue nil %>-<%=portafolio.digito rescue nil %> y domicilio en la ciudad de Medellín <%=portafolio.direccion rescue nil %>, teléfono <%=portafolio.telefono_empresa rescue nil %> Ext 101.
      <br/><br/><br/>
      <div align="center"><strong>CERTIFICA QUE:</strong></div>
      <br/><br/>
      El (a) señor (a) <strong><%=contratospersona.nombre_completo rescue nil%></strong> identificado (a) con <%= contratospersona.tipo_identificacion rescue nil %> número <strong><%=camponumerico2(contratospersona.identificacion) rescue nil%></strong> desempeñó (a) los siguientes cargos.
      <br/><br/>
        <table width="100%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 10px; font-family: Verdana, Geneva, sans-serif;">
          <tr>
            <th width="30%" height="20" style="background: #E8E3E3;"><div align="left">CARGO</div></th>
            <th width="10%" style="background: #E8E3E3;">SALARIO</th>
            <th width="16%" height="20" style="background: #E8E3E3;">FECHA DE INICIO</th>
            <th width="17%" style="background: #E8E3E3;">FECHA DE TERMINACIÓN</th>
            <th width="17%" style="background: #E8E3E3;">TIPO DE CONTRATO</th>
            <th width="10%" style="background: #E8E3E3;">ESTADO</th>
          </tr>
      <% contratosperfechas.order("fecha_inicio desc").each do |a| %>
          <tr>
            <td height="20"><div align="left"><%=a.contratoscargo.perfil rescue nil %></div></td>
            <td><div align="center">$ <%=camponumerico2 a.salariofinal rescue nil %></div></td>
            <td height="20"><div align="center"><%=a.fecha_inicio.strftime("%d-%m-%Y") rescue nil %></div></td>
            <td><div align="center"><% if a.estado.to_s == 'INACTIVO' %><%=a.fecha_fin.strftime("%d-%m-%Y") rescue nil %><% else %>ACTIVO<% end %></div></td>
            <td><div align="center"><%=a.tipo_contrato rescue nil %></div></td>
            <td><div align="center"><%=a.estado rescue nil %></div></td>
          </tr>
      <% end  %>
        </table><br/><br/>
      Se expide el presente certificado a solicitud del interesado el <%=namedate(Time.now) rescue nil %>.
      <br/><br/>
      Para mayor información favor comunicarse telefónicamente al <%=portafolio.telefono_empresa rescue nil %> ext 101.
      <br/><br/><br/>
      Atentamente,
      <br/><br/><br/>

      <%= image_tag 'https://appasearesp.com/assets/firmasara-4f0e86197b50763806ad4427e300956f9efa4cae7f3439c18dc85f868811842a.png', style: 'position: relative;margin-bottom: -10px;;z-index: 0' %>
      <b style="font-size: 16px; font-family: Tahoma; margin-top: -30px;position: relative;z-index: 9999">
        <br/>SARA VANESA GALEANO HENAO<br/>
        TALENTO HUMANO<br/>
        <%=portafolio.razon_social rescue nil %><br/>
        TELEFONO: <%=portafolio.telefono_empresa rescue nil %> EXT 101<br/></b>
      <div align="justify" style="font-size: 10px; font-family: Tahoma;">FYH: <%=Time.now.strftime("%Y-%m-%d %X") rescue nil%>-<%=isadmin %></div>
    </div>
<% end %>





