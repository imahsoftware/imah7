<%
  @vcAutoCon = is_auth_c('empleadosconsulta')
  restringueCreacion = true
  if @contratospersona.contratosperalertas.where(estado: 'ACTIVO').present?
    restringueCreacion = false
  end
  if restringueCreacion == false
%>
  <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4>
    Esta persona presenta un bloqueo de contratación.
  </div>
<% end %>
<div class="box-header">
  <h3 class="box-title"><strong>Registro Contratos
    <%= link_to cartam_contratosperfechas_path(id: @contratospersona.id, format: :pdf), data: {toggle: 'tooltip'}, class: 'popup', title: 'Carta Laboral Completa en PDF' do %>
      <button class="btn btn-xs btn-info"><i class="fa fa-file-pdf-o"></i></button>
    <% end %>
  </strong></h3>
  <div class="box-tools pull-right">
    <% if is_auth_c('contratosperfecha') and restringueCreacion %>
      <%= link_to new_contratospersona_contratosperfecha_path(@contratospersona), id: 'new_contratosperfecha_button', class: 'btn btn-sm btn-warning', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
      <% end %>
    <% end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="contratosperfecha_form" class="collapse"></div>
  <div id="contratosperfechas">
    <% if @contratospersona.contratosperfechas.present? %>
      <%= render 'contratosperfechas/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
    <% end %>
  </div>
</div>
