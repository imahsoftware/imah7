$("#contratosperfecha_form").collapse("hide");

$("#contratosperfecha_form").empty();

<% if @active_record.present? %>
$("#contratosperfecha_<%= @active_record.id %>").replaceWith("<%= j render 'tr', contratosperfecha: @active_record %>");
<% end %>

$("#contratosperfecha_<%= @contratosperfecha.id %>").html("<td colspan='12'><%= j render 'form' %></td>");

$("#contratosperfecha_<%= @contratosperfecha.id %>").addClass("active_contratosperfecha");

$(".select2").select2();

$(".tooltip").tooltip("hide");

$('[data-toggle="tooltip"]').tooltip();
$(".datetimepicker").datetimepicker();
$('.datepicker').datepicker({
    dayNamesMin: ["Dom", "Lun", "Mar", "Mie", "Jue", "Vie", "Sáb"],
    monthNamesShort: ["Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"],
    dateFormat: "yy-mm-dd",
    yearRange: '2000:2027',
    changeMonth: true,
    changeYear: true,
});


$(function () {
    return $('.select2Contrato<%= @contratosperfecha.id %>').select2({
        minimumInputLength: 3,
        maximumInputLength: 20,
        placeholder: "[ Seleccionar Contrato... ]",
        ajax: {
            url: '/contratos/searchall.json',
            dataType: 'json',
            delay: 250,
            data: function (params) {
                return {
                    q: params.term,
                    page: params.page
                };
            },
            processResults: function (data) {
                return {
                    results: $.map(data, function (item) {
                        return {
                            text: item.name,
                            id: item.id
                        };
                    })
                };
            }
        }
    });
});