  <tr>
    <td>
      <table width="100%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
        <tr>
          <td colspan="2" height="25" style="background: #E8E3E3;"><strong>DATOS DEL ESCENARIO DE PRACTICA</strong></td>
        </tr>
        <tr>
          <td width="40%" height="25" style="background: #E8E3E3;"><strong>RAZÓN SOCIAL Y NIT: </strong></td>
          <td>&nbsp;<%= @portafolio.razon_social rescue nil %> - <%= @portafolio.identificacion rescue nil %>-<%= @portafolio.digito rescue nil %></td>
        </tr>
        <tr>
          <td height="25" style="background: #E8E3E3;"><strong>REPRESENTANTE LEGAL E IDENTIFICACIÓN: </strong></td>
