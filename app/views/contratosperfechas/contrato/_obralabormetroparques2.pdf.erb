        <tr>
          <td height="25" style="background: #E8E3E3;"><strong>Teléfono de contacto: </strong></td>
          <td>&nbsp;<%= @contratospersona.telefono rescue nil %> - <%=@contratospersona.movil rescue nil %></td>
        </tr>
        <tr>
          <td height="25" style="background: #E8E3E3;"><strong>Lugar y fecha de nacimiento: </strong></td>
