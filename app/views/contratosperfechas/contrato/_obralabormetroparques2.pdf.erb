  aplicaesptes = @contratosperfecha.contratoscargo.aplica_especialtes.to_s
%>
<style type="text/css">H1.SaltoDePagina {PAGE-BREAK-AFTER: always}</style>
<table width="100%">
  <tr>
    <td>
      <table width="100%" border="0">
        <tr>
          <td style="font-size: 14px; font-family: Tahoma; line-height:150%"><div align="center"><strong><div style="font-size: 18px; font-family: Tahoma;">CONTRATO POR OBRA O LABOR DETERMINADA</div></strong></div></td>
