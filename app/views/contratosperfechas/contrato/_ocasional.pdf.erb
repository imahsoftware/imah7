              </td>
              <td >&nbsp</td>
              <td height="50" style="background: #E8E3E3;">
                <% if @contratosperfecha.codigo_firma.present? %>
                  <div style="font-size: 9px;">
                    <%= @contratospersona.nombre_completo rescue nil %><br/>
                    <%=@contratospersona.tipo_identificacion rescue nil %> - <%= camponumerico2(@contratospersona.identificacion) rescue nil %><br/>
                    <b>Firma Digital:</b> <%= @contratosperfecha.codigo_firma %><br/>
                    <b>Fecha Firma:</b> <%= @contratosperfecha.fecha_firma %><br/>
                    <%= @contratospersona.direccion rescue nil %> - <%=Municipio.find(@contratospersona.municipio_ciudad).autobuscar rescue nil %><br/>
                    <%= @contratospersona.telefono rescue nil %> - <%=@contratospersona.movil rescue nil %><br/>
                    <%= @contratospersona.correo rescue nil %><br/>
                    * Este documento fue generado con firma electrónica y cuenta con plena validez jurídica,
                    conforme a lo dispuesto en la Ley 527/99 y el decreto reglamentario 2364/12
                  </div>
                <% else %>
                  <br/><br/><br/><br/>
                  <%= @contratospersona.nombre_completo rescue nil %><br/>
                  <%=@contratospersona.tipo_identificacion rescue nil %> - <%= camponumerico2(@contratospersona.identificacion) rescue nil %><br/>
                  <%= @contratospersona.direccion rescue nil %> - <%=Municipio.find(@contratospersona.municipio_ciudad).autobuscar rescue nil %><br/>
                  <%= @contratospersona.telefono rescue nil %> - <%=@contratospersona.movil rescue nil %><br/>
                  <%= @contratospersona.correo rescue nil %><br/>
                <% end %>
              </td>
            </tr>
          </table>
        </div>
      </td>
    </tr>
  </table>
</div>



