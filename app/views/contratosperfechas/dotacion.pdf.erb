<%
  pgh = Parametro.find(4) # Firma Gestion Humana
  contrato = object rescue nil
  vcFch = object0 rescue nil
  idPortafolio = Objeto.find_by_sql("select portafolio_id from empresas
                                     where id = (select empresa_id from contratos where id = #{contrato})")[0].portafolio_id rescue nil
  portafolio = Portafolio.find(idPortafolio)
  @logo_firma = portafolio.logo_firma
  @logo = portafolio.logo_empresa_assets
  @nombre_firma = portafolio.nombre_rep.to_s
  @nombre_empresa = portafolio.razon_social.to_s
  @identificacion = camponumerico2(portafolio.identificacion_rep.to_s)
  if vcFch == '-1'
    @contratosperfechas = Contratosperfecha.joins(:contratospersona)
                                           .where("contratosperfechas.contrato_id = #{contrato} AND contratosperfechas.codigo_firma IS NOT NULL AND contratosperfechas.dotacion = 'SI'")
  else
    @contratosperfechas = Contratosperfecha.joins(:contratospersona)
                                           .where("contratosperfechas.contrato_id = #{contrato} and date_format(contratosperfechas.fecha_inicio,'%Y-%m') = '#{vcFch}'
                                                   AND contratosperfechas.codigo_firma IS NOT NULL AND contratosperfechas.dotacion = 'SI'")
  end
  @contratosperfechas.each do |c|
    @contratosperfecha = c
    contratospersona = @contratosperfecha.contratospersona
%>
  <style type="text/css">H1.SaltoDePagina {PAGE-BREAK-AFTER: always}</style>
  <div align="center">
    <table width="85%">
      <tr>
        <td height="50px">
          <div align="right"><%= image_tag "#{@logo}", size: "280x120" %></div>
        </td>
      </tr>
      <tr>
        <td>
          <div align="justify" style="font-size: 16px; font-family: Verdana, Geneva, sans-serif;">
            <br/>
            Medellin, <%= namedate(@contratosperfecha.fecha_firma) rescue nil %>
            <br/><br/><br/>
            Señores<br/>
            <strong><%= @contratosperfecha.contrato.empresa.nombre rescue nil %></strong><br/>
            <br/><br/>
            <strong>ASUNTO:</strong> Entrega de dotación Y EPP
            <br/><br/>
            <table width="100%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
              <tr>
                <td width="40%" height="20" style="background: #E8E3E3;"><strong>NOMBRE DEL TRABAJADOR: </strong></td>
                <td>&nbsp;<%= contratospersona.nombre_completo rescue nil %></td>
              </tr>
              <tr>
                <td height="20" style="background: #E8E3E3;"><strong>IDENTIFICACION DEL TRABAJADOR: </strong></td>
                <td>&nbsp;<%= camponumerico2(contratospersona.identificacion) rescue nil %></td>
              </tr>
              <tr>
                <td height="20" style="background: #E8E3E3;"><strong>CARGO: </strong></td>
                <td>&nbsp;<%= @contratosperfecha.contratoscargo.perfil rescue nil %></td>
              </tr>
            </table>
            <br/>
            <table width="100%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
              <tr>
                <th height="20" style="background: #E8E3E3;">CAMISA</th>
                <th style="background: #E8E3E3;">PANTALON</th>
                <th style="background: #E8E3E3;">ZAPATOS</th>
              </tr>
              <tr>
                <td height="20">
                  <% if contratospersona.talla_camisa.to_s == 'NO APLICA' %>
                    <div align="center"><%= contratospersona.talla_camisa rescue nil %></div>
                  <% else %>
                    <div align="center"><%= contratospersona.cant_camisa rescue nil %> CAMISAS TALLA <%= contratospersona.talla_camisa rescue nil %></div>
                  <% end %>
                </td>
                <td>
                  <% if contratospersona.talla_pantalon.to_s == 'NO APLICA' %>
                    <div align="center"><%= contratospersona.talla_pantalon rescue nil %></div>
                  <% else %>
                    <div align="center"><%= contratospersona.cant_pantalon rescue nil %> PANTALONES TALLA <%= contratospersona.talla_pantalon rescue nil %></div>
                  <% end %>
                </td>
                <td>
                  <% if contratospersona.talla_zapatos.to_s == 'NO APLICA' %>
                    <div align="center"><%= contratospersona.talla_zapatos rescue nil %></div>
                  <% else %>
                    <div align="center"><%= contratospersona.zapatos rescue nil %> (<%= contratospersona.cant_zapatos rescue nil %> PARES TALLA <%= contratospersona.talla_zapatos rescue nil %>)</div>
                  <% end %>
                </td>
              </tr>
            </table>
            <br/>
            <% if Contratoscargosnota.where("contratoscargo_id = #{@contratosperfecha.contratoscargo_id}").present? %>
              <table width="100%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
                <tr>
                  <th colspan="2" height="20" style="background: #E8E3E3;">ENTREGA DE ELEMENTOS DE PROTECCION PERSONAL
                  </th>
                </tr>
                <tr>
                  <th height="20" width="80%" style="background: #E8E3E3;">ELEMENTO</th>
                  <th style="background: #E8E3E3;">CANTIDAD</th>
                </tr>
                <% Contratoscargosnota.where("contratoscargo_id = #{@contratosperfecha.contratoscargo_id}").each do |a| %>
                  <tr>
                    <td height="20">
                      <div align="left"><%= a.observacion %></div>
                    </td>
                    <td height="20">
                      <div align="center"><%= a.cantidad %></div>
                    </td>
                  </tr>
                <% end %>
              </table>
            <% else %>
              NO hay elementos de proteccion personal.
            <% end %>
            <% if contratospersona.requiere_carnet.to_s == 'SI' or contratospersona.requiere_carnet_cliente.to_s == 'SI' %>
              <br/>
              <table width="100%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
                <tr>
                  <th height="20" style="background: #E8E3E3;">ENTREGA DE CARNET</th>
                </tr>
                <tr>
                  <th height="20">1 CARNET</th>
                </tr>
              </table>
            <% end %>
            <br/><br/>
            Atentamente,
            <br/><br/>
            <table width="100%" border="0" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:0px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
              <tr>
                <td width="40%" height="30" ALIGN="center"><strong>&nbsp;</strong></td>
                <td>&nbsp;</td>
                <td width="55%" height="30" ALIGN="center"><strong>CONFIRMO RECIBIDO - EL TRABAJADOR</strong></td>
              </tr>
              <tr>
                <td height="50">
                  <% if @contratosperfecha.codigo_firma.present? %>
                    <%= image_tag 'https://appasearesp.com/assets/firmamanuela-07d77558a523eda2577eab4ee465d1e64ad8fdfddc5e1b69bf4609b943567891.png', style: 'position: relative;margin-bottom: -10px;;z-index: 0' %>
                    <%#= image_tag("#{image_url(@logo_firma)}", style: 'position: relative; margin-bottom: -8px; top: -13px; right: 10px; z-index: 0; width: 150px;') %>
                  <% else %>
                    <br/><br/><br/>
                  <%end %><br/>
                  <b style="font-size: 16px; font-family: Tahoma; margin-top: -30px;position: relative;z-index: 9999"><%= pgh.valor rescue nil %></b><br/>
                  Talento Humano<br/>
                  <%= portafolio.razon_social rescue nil %>
                </td>
                <td >&nbsp</td>
                <td height="50" style="background: #E8E3E3;">
                  <% if @contratosperfecha.codigo_firma.present? %>
                    <%= contratospersona.nombre_completo rescue nil %><br/>
                    <b>CC:</b> <%= camponumerico2(contratospersona.identificacion) rescue nil %><br/>
                    <b>FIRMA DIGITAL:</b> <%= @contratosperfecha.codigo_firma %><br/>
                    <b>FECHA FIRMA:</b> <%= @contratosperfecha.fecha_firma %><br/>
                    <b>CARGO:</b> <%= @contratosperfecha.contratoscargo.perfil rescue nil %><br/>
                    * Este documento fue generado con firma electrónica y cuenta con plena validez jurídica, conforme a lo dispuesto en la Ley 527/99 y el decreto reglamentario 2364/12
                  <% else %>
                    <br/><br/><br/><br/>
                    <%= contratospersona.nombre_completo rescue nil %><br/>
                    <b>CC:</b> <%= camponumerico2(contratospersona.identificacion) rescue nil %><br/>
                    <b>CARGO:</b> <%= @contratosperfecha.contratoscargo.perfil rescue nil %><br/>
                  <% end %>
                </td>
              </tr>
            </table>
          </div>
        </td>
      </tr>
    </table>
  </div>
  <H1 class=SaltoDePagina>&nbsp;</H1>
<% end %>