$(".alert_flash").fadeOut(300, function() {
	$(this).remove();
});

$("#contratosperfecha_<%= @contratosperfecha.id %>").replaceWith("<%= j render 'tr', contratosperfecha: @contratosperfecha %>");

$('[data-toggle="tooltip"]').tooltip();

$(".flash_messages").html("<%= j render 'layouts/flash_messages' %>");

setTimeout(function() {
	$(".alert_flash").fadeOut(300, function() {
		$(this).remove();
	});
}, 5000);
