<%= simple_form_for([@tarea, @tareasactividad], remote: true) do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-5 col-lg-6">
        <%= f.input :user_persona, collection: User.where(["tipoconsulta not in ('CANDIDATO','PERSONA','RECTOR') and activo = 'S'"]).order(:nombre).collect { |p| [p.nombrecompleto, p.id] }, input_html: { class: 'select2 clean' }, as: :select, include_blank: true, label: "Usuario" %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-1">
        <%= f.input :dias, input_html: { class: 'clean', class: "uppercaseInput" }, label: "Días" %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5">
        <%= f.input :descripcion, as: :text, input_html: { class: 'clean', :rows => 4} %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5">
        <%= f.input :nota, as: :text, input_html: { class: 'clean', :rows => 3 } %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
        <%= f.input :digital, as: :select, collection: select_sino, input_html: { data: { width: '100%' }, class: 'select2' }, label: "Requiere evidencia?" %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-1 col-lg-1">
        <%= f.input :item, input_html: { class: 'clean', class: "uppercaseInput" }, label: "Item - Orden" %>
      </div>
    </div>
    <div class="row">
      <div class="col-md-6">
        <% if @tareasactividad.new_record? %>
          <%= link_to "Cancelar", cancelar_tareasactividades_path, remote: true, class: 'cancel_button btn btn-flat btn-warning pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "Cancelar", tarea_tareasactividad_path(@tarea, @tareasactividad), class: 'btn btn-warning float-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "Guardar", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>

