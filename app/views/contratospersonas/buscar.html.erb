<div class="box ">
  <%= simple_form_for(Contratospersona.new, url: proceso_contratospersonas_path, :method => :get) do |f| %>
    <div class="box-header">
      <legend>Asignación / Retiro de supervisores</legend>
    </div>
    <div class="box-body">
      <div class="form-group">
        <div class="row">
          <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
            <label>Contrato</label>
            <select class="form-control select2ContratoIndex select2" style="width:100%;" name="ubicacion[contrato_id]" id="ubicacion_contrato_id">
              <option selected="selected" value="<%= f.object.contrato_id -%>">
                <%= "#{f.object.descripcion_contrato}" -%>
              </option>
            </select>
          </div>
          <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5">
            <%= f.input :contratosgrupo_id, as: :select, input_html: { class: 'select2' }, collection: [], prompt: 'Seleccione', label: 'Grupo', disabled: true %>
          </div>
          <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
            <%= f.input :user_interventor, collection: User.where(["tipoconsulta = 'SUPERVISOR' and activo = 'S' AND contratospersona_id IS NOT NULL"]).order(:nombre).collect {|p| [ p.nombrecompleto, p.id ] }, input_html: { class: 'select2' }, as: :select,  include_blank: true, label: "Supervisor" %>
          </div>
          <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
            <%= f.input :tipo_usuario, as: :select, collection: select_claseproceso, input_html: { class: 'select2' }, label: "Acción"%>
          </div>
          <div class="col-md-1">
            <%= button_tag type: 'submit', value: 'xlsx', name: 'format', class: 'btn btn-primary', style: 'margin-top: 24px;', data: { toggle: 'tooltip' } do %>
              <i class="fa fa-search" aria-hidden="true"></i>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>


