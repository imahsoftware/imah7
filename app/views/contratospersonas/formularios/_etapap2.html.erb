          <th width="10%" class="text-center text-table">TIPO</th>
          <th width="10%" class="text-center text-table">AÑO DE FINALIZACION</th>
          <th width="10%" class="text-center text-table">AÑOS CURSADO</th>
          <th width="20%" class="text-center text-table">TITULO OBTENIDO</th>
          <th width="20%" class="text-center text-table">NOMBRE DE LA INSTITUCION</th>
          <th width="20%" class="text-center text-table">CIUDAD</th>
        </tr>
        <tr>
          <th>Primaria</th>
          <th></th>
          <th>
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :est_primaria_anno_fin, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: false %></div>
          </th>
          <th>
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :est_primaria_anno_cur, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: false %></div>
          </th>
          <th>
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :est_primaria_titulo, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: false %></div>
          </th>
          <th>
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :est_primaria_institucion, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: false %></div>
          </th>
          <th>
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :est_primaria_ciudad, collection: Municipio.where("iddian_alegra is not null").order(:autobuscar).collect { |p| [p.autobuscar, p.id] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: false %></div>
          </th>
        </tr>
        <tr>
          <th>Bachillerato</th>
          <th>
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :est_bachiller_tipo, as: :select, collection: select_tipo_bachiller, input_html: { data: { width: '100%' }, class: 'select2' }, label: false %></div>
          <th>
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :est_bachiller_anno_fin, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: false %></div>
          </th>
          <th>
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :est_bachiller_anno_cur, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: false %></div>
          </th>
          <th>
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :est_bachiller_titulo, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: false %></div>
          </th>
          <th>
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :est_bachiller_institucion, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: false %></div>
          </th>
          <th>
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :est_bachiller_ciudad, collection: Municipio.where("iddian_alegra is not null").order(:autobuscar).collect { |p| [p.autobuscar, p.id] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: false %></div>
          </th>
        </tr>
        <tr>
          <th>Educación Superior</th>
          <th>
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
              <%= f.input :est_edu_superior_tipo, as: :select, collection: select_tipo_educacion, input_html: { data: { width: '100%' }, class: 'select2' }, label: false %>
            </div>
          </th>
          <th>
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :est_edu_superior_anno_fin, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: false %></div>
          </th>
          <th>
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :est_edu_superior_anno_cur, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: false %></div>
          </th>
          <th>
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :est_edu_superior_titulo, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: false %></div>
          </th>
          <th>
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :est_edu_superior_institucion, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: false %></div>
          </th>
          <th>
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :est_edu_superior_ciudad, collection: Municipio.where("iddian_alegra is not null").order(:autobuscar).collect { |p| [p.autobuscar, p.id] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: false %></div>
          </th>
        </tr>
        <tr>
          <th>Postgrado</th>
          <th></th>
          <th>
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :est_postgrado_anno_fin, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: false %></div>
          </th>
          <th>
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :est_postgrado_anno_cur, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: false %></div>
          </th>
          <th>
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :est_postgrado_titulo, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: false %></div>
          </th>
          <th>
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :est_postgrado_institucion, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: false %></div>
          </th>
          <th>
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12"><%= f.input :est_postgrado_ciudad, collection: Municipio.where("iddian_alegra is not null").order(:autobuscar).collect { |p| [p.autobuscar, p.id] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: false %></div>
          </th>
        </tr>
      </table>
      <table class="table table-bordered table-condensed table-striped">
        <tr>
          <th width="10%" class=" text-table">Otros: cursos, diplomados, seminarios</th>
          <th width="15%" class="text-left text-table">
            <%= f.input :est_otro_intensidad, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Intensidad horario" %>
          </th>
          <th width="30%" class="text-left text-table">
            <%= f.input :est_otro_nombre, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Nombre del programa" %>
          </th>
          <th width="30%" class="text-left text-table">
            <%= f.input :est_otro_institucion, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Institución" %>
          </th>
        </tr>
      </table>
      <table class="table table-bordered table-condensed table-striped">
        <tr>
          <th width="15%" class="text-left text-table">
            <%= f.input :est_estudia_actualmente, as: :select, collection: select_sino, input_html: { data: { width: '100%' }, class: 'select2' }, label: "¿Cursa estudios actualmente?" %>
          </th>
          <th width="15%" class="text-left text-table">
            <%= f.input :est_estudia_tipo, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "¿Que tipo de estudios?" %>
          </th>
          <th width="30%" class="text-left text-table">
            <%= f.input :est_estudia_duracion, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Duración (años, semestres, meses)" %>
          </th>
          <th width="30%" class="text-left text-table">
            <%= f.input :est_estudia_semestre, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Año / semestre que cursa" %>
          </th>
        </tr>
      </table>
      <table class="table table-bordered table-condensed table-striped">
        <tr>
          <th class="text-left text-table">
            <%= f.input :est_nombre_institucion, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Nombre de la institución" %>
          </th>
          <th width="15%" class="text-left text-table">
            <%= f.input :est_horario, as: :select, collection: select_horario_educacion, input_html: { data: { width: '100%' }, class: 'select2' }, label: "Horario" %>
          </th>
        </tr>
      </table>
    </div>
  </div>
  <div class="box-header">
    <legend>Experiencia Laboral<br/>
      <em><small style="font-size: 10px">
        FAVOR RELACIONAR LOS ULTIMOS TRES EMPLEOS QUE USTED HA DESEMPEÑADO, COMENZANDO POR EL ULTIMO O
