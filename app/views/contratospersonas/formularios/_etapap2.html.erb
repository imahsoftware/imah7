<%
  is_auth_a_contratospersona = is_auth_a('contratospersona')
%>
<%= simple_form_for(@contratospersona) do |f| %>
  <%= hidden_field_tag :etapap, params[:etapap], value: '2' %>
  <%= hidden_field_tag :etapa, params[:etapa], value: 'A' %>
  <div class="box-header">
    <legend>Información Familiar</legend>
  </div>
  <div class="box-body">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :nombre_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Nombre esposa(o) o compañera(o)" %></div>
      <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :ocupacion_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Profesión, ocupación u oficio" %></div>
      <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :empresa_trabaja_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Empresa donde trabaja" %></div>
    </div>
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :cargo_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Cargo actual" %></div>
      <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :direccion_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Dirección" %></div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :telefono_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Teléfono" %></div>
      <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :ciudad_familiar, collection: Municipio.where("iddian_alegra is not null").order(:autobuscar).collect { |p| [p.autobuscar, p.id] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: "Ciudad" %></div>
    </div>
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :nro_personas_depende_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Nro de personas que dependen económicamente del solicitante" %></div>
      <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :parentesto_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Parentesco" %></div>
      <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :edad_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Edades" %></div>
    </div>

    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :nombre_padre_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Nombre(s) padre(s)" %></div>
      <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :profesion_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Profesión, ocupación u oficio" %></div>
      <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :telefono_familiar2, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Teléfono" %></div>
    </div>
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :nombre_herm_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Nombre(s) hermano(s)" %></div>
      <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :profesion_herm_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Profesión, ocupación u oficio" %></div>
      <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :telefono_herm_familiar, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Teléfono" %></div>
    </div>
  </div>
  <div class="box-header">
    <legend>Educación y Aptitudes
    </legend>
  </div>
  <div class="box-body">
    <div class="row">
      <table class="table table-bordered table-condensed table-striped">
