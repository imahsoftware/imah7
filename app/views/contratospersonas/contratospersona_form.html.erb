<% if @contratospersona.etapa.to_s == "A" %>
  <%= render "form" %>
<% else %>
  <section class="content-header" style="margin-top: -25px; margin-left: -12px;"><h4>Información: <%= @contratospersona.autobuscar rescue nil%> <small>(Edad <%= @contratospersona.edad rescue nil%>)</small></h4></section>
  <div class="box box-danger">
    <div class="box-body">
      <% if @contratospersona.etapa.to_s == "B" %>
        <%= render 'contratosperexamenes/contratosperexamenes' %>
      <% elsif @contratospersona.etapa.to_s == "C" %>
        <%= render 'contratospergrupos/contratospergrupos' %>
      <% elsif @contratospersona.etapa.to_s == "D" %>
        <%= render 'contratosperestados/contratosperestados' %>
      <% elsif @contratospersona.etapa.to_s == "F" %>
        <%= render 'contratosperfechas/contratosperfechas' %>
      <% elsif @contratospersona.etapa.to_s == "G" %>
        <%= render 'contratosperembargos/contratosperembargos' %>
      <% elsif @contratospersona.etapa.to_s == "H" %>
        <%= render 'contratosperprestamos/contratosperprestamos' %>
      <% elsif @contratospersona.etapa.to_s == "I" %>
        <%= render 'contratosperrodamientos/contratosperrodamientos' %>
      <% elsif @contratospersona.etapa.to_s == "J" %>
        <%= render 'contratosperdescuentos/contratosperdescuentos' %>
      <% elsif @contratospersona.etapa.to_s == "K" %>
        <%= render 'contratospernovedades/contratospernovedades' %>
      <% elsif @contratospersona.etapa.to_s == "L" %>
        <%= render 'contratosperusers/contratosperusers' %>
      <% elsif @contratospersona.etapa.to_s == "M" %>
        <%= render 'contratosperimagenes/contratosperimagenes' %>
      <% elsif @contratospersona.etapa.to_s == "N" %>
        <%= render 'contratosperquejas/contratosperquejas' %>
      <% elsif @contratospersona.etapa.to_s == "O" %>
        <%= render 'contratospersugerencias/contratospersugerencias' %>
      <% elsif @contratospersona.etapa.to_s == "P" %>
        <%= render 'contratosperchequeos/contratosperchequeos' %>
      <% elsif @contratospersona.etapa.to_s == "Q" %>
        <%= render 'contratospernotas/contratospernotas' %>
      <% elsif @contratospersona.etapa.to_s == "R" %>
        <%= render 'contratosperalertas/contratosperalertas' %>
      <% elsif @contratospersona.etapa.to_s == "S" %>
        <%= render 'contratosperprocesos/contratosperprocesos' %>
      <% elsif @contratospersona.etapa.to_s == "W" %>
        <%= render 'contratospersonas/visitas_procesos' %>
      <% elsif @contratospersona.etapa.to_s == "Z" %>
        <%= render 'contratospersonas/dotacion_entregas' %>
      <% end %>
    </div>
  </div>
<% end %>

<div class="modal fade" id="abrircargue">
  <div class="modal-dialog modal-dialog-responsive" role="document">
    <div class="modal-content"></div>
  </div>
</div>