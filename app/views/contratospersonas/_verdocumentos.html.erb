<div class="modal-header">
  <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
  <h4 class="modal-title">Documentos<br/>
    <small><%= @contratosperfecha.contratospersona.autobuscar rescue nil %></small></h4>
</div>
<div class="modal-body">
  <div class="row">
    <div class="col-md-12">
      <table class="table table-bordered table-condensed table-striped">
        <thead>
        <tr class="thcolor">
          <th width="30%" class="text-left" style="font-size:10px;">Tipo</th>
          <th class="text-left" style="font-size:10px;">Soporte Digital</th>
        </tr>
        </thead>
        <tbody id="tbody">
        <% @contratosperfecha.contratosperfechasdocs.each do |contratosperfechasdoc| %>
          <tr>
            <td class="text-left" style="font-size:10px;"><%= contratosperfechasdoc.tipo rescue nil %></td>
            <td class="text-left" style="font-size:10px;">
              <%= link_to contratosperfechasdoc.soporte_digital.url(:original, false), data: { toggle: 'tooltip' }, title: "Ver Documento", onclick: 'window.open(this.href,"new_window","height=450,width=600,scrollbars=yes");return false;' do %>
                <%= contratosperfechasdoc.descripcion rescue nil %>
              <% end %>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>