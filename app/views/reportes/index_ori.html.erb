
<section class="content-header" style="margin-top: -55px; margin-left: -12px;"><h3>Reportes</h3></section>
<div class="box box-primary">
  <div class="box-body table-responsive">
    <table class="table table-striped table-bordered">
      <thead>
      <tr class="thcolor">
        <th width="30%">Nombre</th>
        <th>Parametros</th>
        <th width="10%">Opciones</th>
      </tr>
      </thead>
      <tbody>
      <% @infgrupos.each do |i| %>
        <tr>
          <td><%= i.nombre rescue nil %></td>
          <td></td>
          <td class="text-center"><%= link_to informe_datas_path(infgrupo_id: i.id, format: :xlsx) do %>
              <button class="btn btn-xs btn-info"><i class="fa fa-file-excel-o"></i> Generar</button>
            <% end -%>
          </td>
        </tr>
      <% end %>
      <%= form_tag informedat_datas_path(format: :xlsx), method: 'get' do %>
        <%= hidden_field_tag :infgrupo_id, '36' %>
        <tr>
          <td>Informe Novedades liquidadas</td>
          <td>
            <div class="form-group inline">
              <div class="row" style="margin-bottom: 5px">
                <div class="col-md-6">
                  <label>Año</label>
                  <%= select_tag 'ubicacion[anno]', options_for_select(select_anno4), {class: 'form-control select2 inline', data: { width: '60%' }, prompt: "#{t :seleccionar}"} %>
                </div>
                <div class="col-md-6">
                  <label>Mes</label>
                  <%= select_tag 'ubicacion[mes]', options_for_select(select_mes), {class: 'form-control select2 inline', data: { width: '70%' }, prompt: "#{t :seleccionar}"} %>
                </div>
                <br/><br/>
                <div class="col-md-12">
                  <label>Tipo de Novedad</label>
                  <%= select_tag 'ubicacion[tiposnovedad]', options_for_select(select_tiposnovedades.collect {|p| [p.descripcion, p.id]}), prompt: "#{t :seleccionar}", data: {width: '80%'}, class: 'form-control select2 inline' %>
                </div>
              </div>
            </div>
          </td>
          <td><div align="center"><%= button_tag "Generar", class: "btn btn-xs btn-danger" %></div></td>
        </tr>
      <% end %>
      <%= form_tag informedat_datas_path(format: :xlsx), method: 'get' do %>
        <%= hidden_field_tag :infgrupo_id, '37' %>
        <tr>
          <td>Informe Novedades Pendientes</td>
          <td>
            <div class="form-group inline">
              <div class="row" style="margin-bottom: 5px">
                <div class="col-md-6">
                  <label>Año</label>
                  <%= select_tag 'ubicacion[anno37]', options_for_select(select_anno4), {class: 'form-control select2 inline', data: { width: '60%' }, prompt: "#{t :seleccionar}"} %>
                </div>
                <div class="col-md-6">
                  <label>Mes</label>
                  <%= select_tag 'ubicacion[mes37]', options_for_select(select_mes), {class: 'form-control select2 inline', data: { width: '70%' }, prompt: "#{t :seleccionar}"} %>
                </div>
              </div>
            </div>
          </td>
          <td><div align="center"><%= button_tag "Generar", class: "btn btn-xs btn-danger" %></div></td>
        </tr>
      <% end %>
      <%= form_tag informedat_datas_path(format: :xlsx), method: 'get' do %>
        <%= hidden_field_tag :infgrupo_id, '39' %>
        <tr>
          <td>Informe Completo</td>
          <td>
            <div class="form-group inline">
              <div class="row" style="margin-bottom: 5px">
                <div class="col-md-6">
                  <label>Año</label>
                  <%= select_tag 'ubicacion[anno39]', options_for_select(select_anno4), {class: 'form-control select2 inline', data: { width: '60%' }, prompt: "#{t :seleccionar}"} %>
                </div>
                <div class="col-md-6">
                  <label>Mes</label>
                  <%= select_tag 'ubicacion[mes39]', options_for_select(select_mes), {class: 'form-control select2 inline', data: { width: '70%' }, prompt: "#{t :seleccionar}"} %>
                </div>
              </div>
            </div>
          </td>
          <td><div align="center"><%= button_tag "Generar", class: "btn btn-xs btn-danger" %></div></td>
        </tr>
      <% end %>
      <%= form_tag informedat_datas_path(format: :xlsx), method: 'get' do %>
        <%= hidden_field_tag :infgrupo_id, '41' %>
        <tr>
          <td>Informe Terminales por Periodo</td>
          <td>
            <div class="form-group inline">
              <div class="row" style="margin-bottom: 5px">
                <div class="col-md-6">
                  <label>Periodo</label><br/>
                  <%= select_tag 'ubicacion[periodosliquidacion_id]', options_from_collection_for_select(select_periodosliqvis, :id, :descripcion), prompt: '--Seleccionar--', data: { width: '100%' }, class: 'form-control select2' %>
                </div>
              </div>
            </div>
          </td>
          <td><div align="center"><%= button_tag "Generar", class: "btn btn-xs btn-danger" %></div></td>
        </tr>
      <% end %>
      <tr>
        <td>Deducciones Registradas</td>
        <td></td>
        <td class="text-center"><%= link_to informe_datas_path(infgrupo_id: 38, format: :xlsx) do %>
            <button class="btn btn-xs btn-danger">Generar</button>
          <% end -%>
        </td>
      </tr>
      <%= form_tag informedat_datas_path(format: :xlsx), method: 'get' do %>
        <%= hidden_field_tag :infgrupo_id, '47' %>
        <tr>
          <td>Informe Consolidado por periodo</td>
          <td>
            <div class="form-group inline">
              <div class="row" style="margin-bottom: 5px">
                <div class="col-md-6">
                  <label>Año</label>
                  <%= select_tag 'ubicacion[anno47]', options_for_select(select_anno4), {class: 'form-control select2 inline', data: { width: '60%' }, prompt: "#{t :seleccionar}"} %>
                </div>
                <div class="col-md-6">
                  <label>Mes</label>
                  <%= select_tag 'ubicacion[mes47]', options_for_select(select_mes), {class: 'form-control select2 inline', data: { width: '70%' }, prompt: "#{t :seleccionar}"} %>
                </div>
              </div>
              <div class="row" style="margin-bottom: 5px">
                <div class="col-md-12">
                  <label>Contrato</label><br/>
                  <%= select_tag 'ubicacion[contratoid]', options_for_select(select_contratos.collect {|p| [p.datos, p.id]}), prompt: "#{t :seleccionar}", data: {width: '80%'}, class: 'form-control select2 inline' %>
                </div>
              </div>
            </div>
          </td>
          <td><div align="center"><%= button_tag "Generar", class: "btn btn-xs btn-danger" %></div></td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
</div>