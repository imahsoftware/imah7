<%= simple_form_for([@formato, @formatosvariable], remote: true) do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
        <%= f.input :titulo,  input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" } %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
        <%= f.input :variable_id, collection: Variable.where("segmento = '#{@formato.segmento}'").order(:nombre).collect { |p| [p.descripcion_variable, p.id] }, input_html: { class: 'select2' }, as: :select, label: 'Variable', include_blank: true %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
        <%= f.input :orden, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" } %>
      </div>
    </div>
    <div class="row">
      <div class="col-md-6">
        <% if @formatosvariable.new_record? %>
          <%= button_tag "#{t :cancelar}", type: 'button', data: { target: '#formatosvariable_form' }, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}", formato_formatosvariable_path(@formato, @formatosvariable), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
<br/>