<div class="box-header">
  <h3 class="box-title"><strong></strong></h3>
  <div class="box-tools pull-right">
    <%# if is_auth_c('formatosvariable') %>
    <%= link_to new_formato_formatosvariable_path(@formato), id: 'new_formatosvariable_button', class: 'btn btn-sm btn-info', remote: true do %>
      <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
    <% end %>
    <%# end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="formatosvariable_form" class="collapse"></div>
  <div id="formatosvariables">
    <% if @formato.formatosvariables.present? %>
      <%= render 'formatosvariables/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %>
      </div>
    <% end %>
  </div>
</div>

