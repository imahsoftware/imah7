<div class="modal-header">
  <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
  <h3 class="modal-title"><strong>Carga Masiva <%=@archivo.datoid %></strong></h3>
</div>
<% if Contratossolicitud.where(contrato_id: @archivo.datoid).exists? == true %>
  <div class="alert alert-danger">
    <h4><i class="icon fa fa-info"></i> Atención!</h4>
    Este contrato ya tiene solicitudes de insumos, no es posible utilizar este proceso.
  </div>
  <br/>
<% else
     codigomigracion = 0
     clase = ""
     valuecargue = ""
     if @archivo.clase.to_s == 'INSUMO'
       codigomigracion = 3
       valuecargue = "migracionesinsumos"
     elsif @archivo.clase.to_s == 'OTROS'
       codigomigracion = 4
       valuecargue = "migracionesinsumosnocce"
     elsif @archivo.clase.to_s == 'SEDES'
       codigomigracion = 36
       valuecargue = "migracionessedes"
     end
%>
  <div class="row">
    <div class="col-md-8">
      <div class="box box-primary">
        <div class="box-body">
          <div class="table-responsive">
            <table class="table table-bordered table-condensed table-striped">
              <thead class="thcolor">
              <tr>
                <td colspan="4" class="text-center"><strong>Orden del archivo</strong></td>
              </tr>
              <tr style="font-size: 12px;">
                <td class="text-center" width="10%"><strong>Orden</strong></td>
                <td class="text-center"><strong>Encabezado</strong></td>
                <td class="text-center" width="20%"><strong>Detalle</strong></td>
              </tr>
              </thead>
              <tbody>
              <% Migracionescampo.where(["migracion_id = #{codigomigracion}"]).order("orden asc").each do |migracionescampo| %>
                <tr style="font-size: 12px;">
                  <td class="text-center"><%= migracionescampo.orden rescue nil %></td>
                  <td class="text-left"><%= migracionescampo.encabezado rescue nil %></td>
                  <td class="text-center"><%= migracionescampo.detalle rescue nil %></td>
                </tr>
              <% end %>
              </tbody>
            </table>
          </div>
          <div class="col-md-6" align="left" style="padding-left: 0px">
            <%= link_to headxls_datas_path(id: codigomigracion,format: :xlsx) do %>
              <button class="btn btn-xs btn-warning"><i class="fa fa-file-excel-o"></i> Estructura de Encabezados</button>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="box box-primary">
        <%= simple_form_for [@archivo], wrapper: :inline_form, html: { class: 'form-inline' } do |f| %>
          <%= f.hidden_field :migracion, value: valuecargue %>
          <%= f.hidden_field :datoid %>
          <%= f.hidden_field :clase %>
          <div class="box-header">
            <div class="alert alert-danger">
              <h4><i class="icon fa fa-info"></i> Atención!</h4>
              Recuerde que el archivo debe ser con extensión <strong>XLS</strong> o <strong>XLSX</strong>. <br/>DEBE tener encabezados <br/>DEBE ser en el orden establecido
            </div>
          </div>
          <div class="box-body">
            <div class="row">
              <div class="col-md-12">

                <div class="input-group">
                  <span class="input-group-btn">
                    <button id="fake-file-button-browse" type="button" class="btn btn-default">
                      <span class="glyphicon glyphicon-file"></span>
                    </button>
                  </span>
                  <%= f.input :documentos, as: :file, label: false, input_html: { id: 'files-input-upload', style: 'display:none', data: { toggle: 'tooltip' }, title: 'Seleccionar Archivo' } %>
                  <input type="text" id="rutaarchivo" disabled="disabled" placeholder="Nada Seleccionado" class="form-control" style="width: 187px">
                  <span class="input-group-btn">
                    <%= f.button :submit, "Cargar", class: "btn btn-primary", disabled: true, id: 'fake-file-button-upload', data: { toggle: 'tooltip', disable_with: "#{t :procesando}" }, title: 'Cargar Archivo' %>
                  </span>
                  <script type="text/javascript">
                      // Fake file upload
                      document.getElementById('fake-file-button-browse').addEventListener('click', function() {
                          document.getElementById('files-input-upload').click();
                      });

                      document.getElementById('files-input-upload').addEventListener('change', function() {
                          document.getElementById('rutaarchivo').value = this.value.replace(/C:\\fakepath\\/,'');
                          document.getElementById('fake-file-button-upload').removeAttribute('disabled');
                      });
                  </script>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>