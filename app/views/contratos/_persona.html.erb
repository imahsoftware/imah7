              <div class="col-md-12">
                <div class="table-responsive">
                  <table class="table table-bordered table-condensed table-striped">
                    <thead>
                    <tr class="thcolor">
                      <th width="10%" class="text-center"></th>
                      <th width="10%" class="text-center">Identificación</th>
                      <th width="40%" class="text-justify" style="font-size:12px;">Nombre</th>
                      <th width="25%" class="text-left">Ubicación</th>
                      <th width="15%" class="text-center">Fecha y Hora</th>
                    </tr>
                    </thead>
                    <tbody id="tbody">
                    <% @contratosperexamenesp.each do |p| %>
                      <tr>
                        <td class="text-center" style="font-size:12px;">
                          <%= link_to edit_contratospersona_path(p.contratospersona_id, etapa: 'B'), class: 'edit_contratospersona_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
                            <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
                          <% end %>
                          <% if vcCampoEstado %>
                            <%= link_to cambioestado_contratosperexamenes_path(id: p.id, estado: "APROBADO"), data: { toggle: 'tooltip', confirm: "Seguro que desea Aprobar?" }, title: 'Aprobar' do %>
                              <button class="btn btn-xs btn-info"><i class="fa fa-chrome"></i></button>
                            <% end %>
                            <%= link_to cambioestado_contratosperexamenes_path(id: p.id, estado: "RECHAZADO"), data: { toggle: 'tooltip', confirm: "Seguro que desea Rechazar?" }, title: 'Rechazar' do %>
                              <button class="btn btn-xs btn-danger"><i class="fa fa-chrome"></i></button>
                            <% end %>
                          <% end %>
                          <% if p.recordacion.to_s == "" %>
                            <%= link_to cambioestado_contratosperexamenes_path(id: p.id, estado: "RECORDATORIO"), data: { toggle: 'tooltip', confirm: "Seguro que desea marcar la recordacion?" }, title: 'LLamada realizada' do %>
                              <button class="btn btn-xs btn-info"><i class="fa fa-phone"></i></button>
                            <% end %>
                          <% end %>
                        </td>
                        <td class="text-center" style="font-size:12px;"><%= p.contratospersona.identificacion rescue nil %></td>
                        <td class="text-justify" style="font-size:12px;"><%= p.contratospersona.nombre_completo rescue nil %>
                          <small>(Edad <%= p.contratospersona.edad %>)</small>
                          <small><br/><strong>Oficio: </strong><%= p.contratospersona.oficio rescue nil %>
                            <br/><strong>Cargo: </strong><%= p.contratospersona.cargo rescue nil %>
                            <br/><%= p.descripcion rescue nil %>
                            <br/><%= p.contratospersona.telefono rescue nil %>
                            - <%= p.contratospersona.movil rescue nil %></small>
                        </td>
                        <td class="text-left" style="font-size:12px;"><%= p.direccion rescue nil %></td>
                        <td class="text-center" style="font-size:12px;"><%= p.fecha rescue nil %>
                          - <%= p.hora rescue nil %>
                          <% if p.recordacion.to_s != "" %> <br/><small>Recordación realizada
                          <i class="fa fa-phone"></i></small>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          <% else %>
            <div class="alert alert-danger">
              <h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %></div>
          <% end %>
