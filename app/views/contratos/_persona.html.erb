  #estados2 = ["8", "12", "9", "1", "2", "3", "4", "5", "6", "7", "10"]
%>
<div class="row">
  <div class="col-md-11">
    <legend>Información Personas
      <% if is_auth_c('dashseguimientocontrato') %>
      <% else %>
        <%#= link_to informe_datas_path(infgrupo_id: 20, portafolio_id: @contrato.id, format: :xlsx), data: { toggle: 'tooltip' }, title: 'Informe Personal' do %>
        <!--<button class="btn btn-xs btn-danger"><i class="fa fa-file-excel-o"></i> Contrato</button>-->
        <%#end %>
        <%= link_to informe_datas_path(infgrupo_id: 24, portafolio_id: @contrato.id, format: :xlsx), data: { toggle: 'tooltip' }, title: 'Informe Personal' do %>
          <button class="btn btn-xs btn-danger"><i class="fa fa-file-excel-o"></i> Contrato</button>
        <% end %>
        <%= link_to informe_datas_path(infgrupo_id: 21, portafolio_id: @contrato.id, format: :xlsx), data: { toggle: 'tooltip' }, title: 'Informe Examenes' do %>
          <button class="btn btn-xs btn-danger"><i class="fa fa-file-excel-o"></i> Examenes</button>
        <% end %>
        <%#= link_to new2_personastemporales_path(contrato_id: @contrato.id), remote: true, data: {toggle: 'tooltip'}, title: 'Crear persona rapida' do %>
        <!-- <button class="btn btn-xs btn-danger"><i class="fa fa-users"></i> </button> -->
        <%# end -%>
      <% end %>
    </legend>
  </div>
</div>
<div class="row">
  <div class="col-md-12">
    <div class="nav-tabs-custom">
      <ul class="nav nav-tabs">
        <%
          estados.each do |p|
            pos = estados.find_index(p)
            if @subetapa == estados2[pos]
              clase = "active"
            else
              clase = ""
            end
        %>
          <li class="<%= clase %>">
            <%= link_to edit_contrato_path(etapa: "P1", id: @contrato.id, subetapa: estados2[pos].to_s) do %>
              <i class="fa fa-search"></i> <span></span> <%= p.to_s %>
            <% end %>
          </li>
        <% end %>
      </ul>
      <div class="tab-content">
        <% if @subetapa == '1' %>
          <%= render "contratossecciones/contratossecciones" %>
        <% elsif @subetapa == '2' %>
          <% if @contratosperexamenesp.count.to_i > 0 %>
