<table class="table table-bordered table-condensed table-striped">
  <thead>
  <tr class="thcolor">
    <th width="10%"></th>
    <th class="font-size-text-tabla text-center" width="5%">ID</th>
    <th class="font-size-text-tabla">Descripción</th>
  </tr>
  </thead>
  <tbody id="tbody_encuestapreguntas">
  <% @encuesta.encuestapreguntas.order(id: :desc).each do |encuestapregunta| %>
