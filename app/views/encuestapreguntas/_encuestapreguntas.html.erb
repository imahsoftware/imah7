<div class="box-body paddin-body">
  <div class="row">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title"> Preguntas
            <div class="pull-right">
              <%= link_to new_encuesta_encuestapregunta_path(@encuesta), id: 'new_encuestapregunta_button', class: 'btn btn-sm btn-warning', remote: true do %>
                <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
              <% end %>
            </div>
          </h3>
        </div>

        <div class="card-body">
          <div id="encuestapregunta_form" class="collapse"></div>
          <div id="encuestapreguntas" style="margin-top: 10px;">
            <% if @encuesta.encuestapreguntas.any? %>
              <%= render 'encuestapreguntas/tabla' %>
            <% else %>
              <%= render 'layouts/procesos/alert_message' %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

