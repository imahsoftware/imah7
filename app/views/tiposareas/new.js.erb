<% if @active_record.present? %>
	$("#tiposarea_<%= @active_record.id %>").replaceWith("<%= j render 'tr', tiposarea: @active_record %>");
<% end %>
$("#tiposarea_form").html("<%= j render 'form' %>");
$(".datetimepicker").datetimepicker();
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
$("#tiposarea_form").collapse("show");
$(".select2").select2();