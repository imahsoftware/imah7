<tr id="tiposarea_<%= tiposarea.id %>">
  <% if is_auth_c('tiposarea') %>
  	<td class="text-center">
      <%= link_to edit_tiposarea_path(tiposarea), class: 'edit_tiposarea_button', remote: true, data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
         <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
      <% end %>
      <%= link_to tiposarea, remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
          <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
      <% end %>
    </td>
  <% end %>
  <td><%= tiposarea.id %></td>
  <td><%= tiposarea.descripcion %></td>
</tr>
