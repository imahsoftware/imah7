<div class="table-responsive">
  <table class="table table-bordered">
    <thead>
      <tr class="thcolor">
        <% if is_auth_c('tiposarea') %>
          <th width="10%"></th>
        <% end %>
        <th width="10%">ID</th>
        <th>Descripcion</th>
      </tr>
    </thead>
    <tbody id="tbody_tiposareas">
      <% @tiposareas.each do |tiposarea| %>
        <%= render 'tiposareas/tr', tiposarea: tiposarea %>
      <% end %>
    </tbody>
  </table>
</div>
