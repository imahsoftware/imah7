<% if @valida %>
$("#otp2<%= @contratosperinvatencion.id %>").modal("hide");
$("#firmado_check<%= @contratosperinvatencion.id %>").html(" <div><em> <b>Firmado:</b> <i class='fa fa-check text-success'></i> - <b>Fecha: </b><%= @contratosperinvatencion.codigo_fecha.strftime('%Y-%m-%d %X') rescue nil %> - <b>Usuario: </b><%= User.find(@contratosperinvatencion.user_firma).nombre rescue nil %></em></div>");
$("#remove_boton<%= @contratosperinvatencion.id %>").remove();
<% else %>
$("#mensaje<%= @contratosperinvatencion.id %>").replaceWith("<div class='row' id='mensaje<%= @contratosperinvatencion.id %>'><div class='col-xs-12 col-sm-12 col-md-2 col-lg-2' style='text-align: center;width: 100%;margin-bottom: 30px;color: red;font-weight: 600;font-size: 20px;'>CODIGO NO VALIDO</div></div>");
<% end %>