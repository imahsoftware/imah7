<div class="box-header">
  <h3 class="box-title"><strong>Inventario atendida por</strong></h3>
  <div class="box-tools pull-right">
    <%# if @contratosperinventario.finalizacion.blank? %>
    <% if @contratosperinventario.contratosperinvatenciones.blank? %>
      <%= link_to new_contratosperinventario_contratosperinvatencion_path(@contratosperinventario), id: 'new_contratosperinvatencion_button', class: 'btn btn-sm btn-info', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
      <% end %>
    <% end %>
    <%# end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="contratosperinvatencion_form" class="collapse"></div>
  <div id="contratosperinvatenciones">
    <% if @contratosperinventario.contratosperinvatenciones.present? %>
      <%= render 'contratosperinvatenciones/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
    <% end %>
  </div>
</div>

