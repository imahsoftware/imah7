<%= simple_form_for([@contrato, @contratosmodificacion], remote: true) do |f| %>
  <div class="bs-callout">
      <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :tipo_modificacion, as: :select, collection: select_tipomodificacion, input_html: { class: 'select2' } %></div>
        <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :fecha_modificacion, as: :string, input_html: { class: 'datepicker', data: {date_options: {format: 'DD/MM/YYYY', ignoreReadonly: true}}, readonly: true } %></div>
        <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :valor, as: :moneda %></div>
        <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :fecha_fin, as: :string, input_html: { class: 'datepicker', data: {date_options: {format: 'DD/MM/YYYY', ignoreReadonly: true}}, readonly: true } %></div>
      </div>
      <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
          <%= f.input :observacion, as: :text,:input_html => {:onchange => "javascript:this.value=this.value.toUpperCase();", :rows => 3 } %>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-md-6">
        <% if @contratosmodificacion.new_record? %>
          <%= button_tag "#{t :cancelar}", type: 'button', data: {target: '#contratosmodificacion_form'}, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}", contrato_contratosmodificacion_path(@contrato, @contratosmodificacion), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
<br/>