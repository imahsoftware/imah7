<div class="box-header">
  <h3 class="box-title"><strong>Adiciones - Modificaciones</strong></h3>
  <div class="box-tools pull-right">
    <%# if is_auth_c('contratosmodificacion') %>
      <%= link_to new_contrato_contratosmodificacion_path(@contrato), id: 'new_contratosmodificacion_button', class: 'btn btn-sm btn-warning', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
      <% end %>
    <%# end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="contratosmodificacion_form" class="collapse"></div>
  <div id="contratosmodificaciones">
    <% if @contrato.contratosmodificaciones.present? %>
      <%= render 'contratosmodificaciones/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
    <% end %>
  </div>
</div>

