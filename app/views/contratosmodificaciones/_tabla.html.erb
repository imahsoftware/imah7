<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
	  <thead class="thcolor">
      <tr>
        <td width="10%"></td>
        <th width="15%" class="text-left">Tipo de modificacion</th>
        <th class="text-right">Valor</th>
        <th class="text-center">Fecha Fin</th>
        <th class="text-left">Observacion</th>
      </tr>
    </thead>
	  <tbody id="tbody_contratosmodificaciones">
	    <% @contrato.contratosmodificaciones.order(id: :desc).each do |contratosmodificacion| %>
	      <%= render 'contratosmodificaciones/tr', contratosmodificacion: contratosmodificacion %>
	    <% end %>
	  </tbody>
	</table>
</div>