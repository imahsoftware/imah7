<tr id="eproveedoresimagen_<%= eproveedoresimagen.id %>">
  <td class="text-center">
    <%# if is_auth_e("eproveedoresimagen")%>
      <%= link_to eproveedor_eproveedoresimagen_path(@eproveedor, eproveedoresimagen), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
         <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
      <% end %>
    <%# end %>
    <%= link_to eproveedoresimagen.proveedor.url(:original, false), data: { toggle: 'tooltip' },title: "Ver Documento", onclick: 'window.open(this.href,"new_window","height=450,width=600,scrollbars=yes");return false;' do %>
      <button class="btn btn-xs btn-primary"><i class="fa fa-cloud-download"></i></button>
    <% end %>

  </td>
  <td align="left"><%= eproveedoresimagen.created_at.strftime("%Y-%m-%d %X") rescue nil %>
    <br/><small><%= eproveedoresimagen.user.nombre rescue nil %></small></td>
  <td align="left"><%= eproveedoresimagen.descripcion rescue nil %></td>
  <td align="left"><%= eproveedoresimagen.proveedor_file_name rescue nil %></td>
</tr>