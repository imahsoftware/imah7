$("#eproveedoresimagen_form").collapse("hide");

$("#eproveedoresimagen_form").empty();

<% if @active_record.present? %>
	$("#eproveedoresimagen_<%= @active_record.id %>").replaceWith("<%= j render 'tr', eproveedoresimagen: @active_record %>");
<% end %>

$("#eproveedoresimagen_<%= @eproveedoresimagen.id %>").html("<td colspan='12'><%= j render 'form' %></td>");

$("#eproveedoresimagen_<%= @eproveedoresimagen.id %>").addClass("active_eproveedoresimagen");

$(".select2").select2();

$(".tooltip").tooltip("hide");

$('[data-toggle="tooltip"]').tooltip();
$(".datetimepicker").datetimepicker();