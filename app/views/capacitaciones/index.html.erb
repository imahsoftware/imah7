<% isadmin = is_admin
   is_auth_e_capacitacion = is_auth_e('capacitacion')
   is_auth_c_capacitacion = is_auth_c('capacitacion')
   is_auth_c_capacitacionespecial = is_auth_c('capacitacionespecial')
%>
<div class="box box-primary">
  <div class="box-header">
    <div class="box-header">
      <h3 class="box-title">Parametrización de las Capacitaciones</h3>
      <div class="pull-right">
        <% if is_auth_c_capacitacion %>
          <%= link_to new_capacitacion_path, data: { toggle: 'tooltip' }, title: "Crear Nuevo Registro", class: 'btn btn-sm btn-primary pull-right' do %>
            <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
          <% end %>
        <% end %>
      </div>
    </div>
    <div class="row">
      <div class="col-md-12">
        <div class="table-responsive">
          <% if @capacitaciones.present? %>
            <table class="table table-bordered table-condensed table-striped">
              <thead>
              <tr class="thcolor">
                <th width="8%"></th>
                <th width="3%" class="text-center">ID</th>
                <th width="16%" class="text-left">Fecha de Registro</th>
                <th class="text-left">Descripción</th>
                <th width="15%" class="text-center">Fecha Limite</th>
                <th width="10%" class="text-center">Estado</th>
              </tr>
              </thead>
              <tbody>
              <% @capacitaciones.each do |capacitacion| %>
                <tr id="capacitacion_<%= capacitacion.id %>">
                  <td class="text-center">
                    <% if (is_auth_c_capacitacion and isadmin == capacitacion.user_id) or is_auth_c_capacitacionespecial %>
                      <%= link_to edit_capacitacion_path(capacitacion, subetapa: '1'), class: 'edit_capacitacion_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
                        <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
                      <% end %>
                      <% if is_auth_e_capacitacion and capacitacion.capaper.to_s != "X" %>
                        <%= link_to capacitacion, remote: true, method: :delete, data: { confirm: 'Esta seguro?', toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
                          <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
                        <% end %>
                      <% end %>
                      <%= link_to clonar_capacitaciones_path(id: capacitacion.id), remote: true, data: { toggle: 'tooltip', confirm: "Estas Seguro?"  }, title: "Clonar Capacitacion" do %>
                        <button class="btn btn-xs btn-success"><i class="fa fa-clone"></i></button>
                      <% end %>
                    <% end %>
                  </td>
                  <td class="text-center"><%= capacitacion.id rescue nil %></td>
                  <td class="text-left"><%= capacitacion.created_at.strftime("%Y-%m-%d %X") rescue nil %> <br/> <%=capacitacion.nombreusuario rescue nil %></td>
                  <td class="text-left"><%= capacitacion.descripcion rescue nil %></td>
                  <td class="text-center"><%= capacitacion.fecha_limite rescue nil %></td>
                  <td class="text-center"><%= capacitacion.estado rescue nil %></td>
                </tr>
              <% end %>
              </tbody>
            </table>
          <% else %>
            <div class="alert alert-danger">
              <h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %></div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
