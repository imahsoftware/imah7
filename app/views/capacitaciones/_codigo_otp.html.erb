<div class="col-xs-12">
  <div class="callout callout-danger">
    <h4>Info!</h4>
    <p>Con el objetivo de completar tu capacitación, recibirás un mensaje de texto en tu teléfono celular con un código
      que deberás ingresar para finalizar el proceso.</p>
  </div>
  <div class="box-body" style="margin-right: 10px;">
    <%= form_tag ws_otp_capacitaciones_path(contrato_id: @contrato.id, contratoscapapersona_id: @contratoscapapersona.id, capacitacion_id: @capacitacion.id), remote: true, method: :post, class: 'form-inline' do %>
      <%= render 'menus/input_otp' %>
      <div class="row" id="mensaje<%= @capacitacion.id %>">
        <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2 text-center"></div>
      </div>
      <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 text-center">
          <%= button_tag type: 'submit', :disable_with => "Validando...", class: 'btn btn-primary', style: "height: 60px; border-radius: 5px; background-color: #d73925 !important; border-color: #d73925;" do %>
            Verificar Codigo <%#= @codigo rescue nil %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>