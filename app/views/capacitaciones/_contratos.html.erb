<div class="box-body paddin-body">
  <div class="row">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title"> Contratos</h3>
        </div>
        <div class="card-body">
          <div id="capacitacionevaluacion_form" class="collapse"></div>
          <div id="capacitacionevaluaciones" style="margin-top: 10px;">
            <% if Contratoscapacitacion.where("capacitacion_id = #{@capacitacion.id}").any? %>
              <table class="table table-bordered table-condensed table-striped">
                <thead>
                <tr class="thcolor">
                  <td width="10%"></td>
                  <th class="text-left" width="30%">Capacitación</th>
                  <th class="text-left" width="30%">>Supervisor</th>
                  <th class="text-left" width="15%">Fecha Limite</th>
                  <th class="text-left" width="15%">Fecha Real</th>
                </tr>
                </thead>
                <tbody id="tbody_capacitacionevaluaciones">
                <% Contratoscapacitacion.where("capacitacion_id = #{@capacitacion.id}").order(id: :desc).each do |contratoscapacitacion| %>
                  <tr id="contratoscapacitacion_<%= contratoscapacitacion.id %>">
                    <td class="text-center">
                      <%= link_to show_detalle_contratos_path(contratoscapacitacion_id: contratoscapacitacion.id, contrato_id: contratoscapacitacion.contrato_id) do %>
                        <button class="btn btn-xs btn-danger"><i class="fa fa-users"></i></button>
                      <% end %>
                    </td>
                    <td align="left"><%= contratoscapacitacion.capacitacion.descripcion rescue nil %></td>
                    <td align="left"><%= User.find(contratoscapacitacion.user_supervisor).nombre rescue nil %></td>
                    <td align="left"><%= contratoscapacitacion.fecha_programacion rescue nil %></td>
                    <td align="left"><%= contratoscapacitacion.fecha_real rescue nil %></td>
                  </tr>

                  <div class="modal fade" id="abrir_detalle<%= contratoscapacitacion.id %>">
                    <div class="modal-dialog modal-dialog-responsive" role="document">
                      <div class="modal-content">
                      </div>
                    </div>
                  </div>

                <% end %>
                </tbody>
              </table>
            <% else %>
              <%= render 'layouts/procesos/alert_message' %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
