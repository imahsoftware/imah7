$("#contratosimagen_form").collapse("hide");

$("#contratosimagen_form").empty();

<% if @active_record.present? %>
	$("#contratosimagen_<%= @active_record.id %>").replaceWith("<%= j render 'tr', contratosimagen: @active_record %>");
<% end %>

$("#contratosimagen_<%= @contratosimagen.id %>").html("<td colspan='12'><%= j render 'form' %></td>");

$("#contratosimagen_<%= @contratosimagen.id %>").addClass("active_contratosimagen");

$(".select2").select2();

$(".tooltip").tooltip("hide");

$('[data-toggle="tooltip"]').tooltip();
$(".datetimepicker").datetimepicker();