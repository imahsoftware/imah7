<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
	  <thead class="thcolor">
      <tr>
        <td width="10%"></td>
        <th width="20%" class="text-left">Fecha</th>
        <th width="25%" class="text-left">Tipo de Imagen</th>
        <th class="text-left">Imagen</th>
      </tr>
    </thead>
	  <tbody id="tbody_contratosimagenes">
	    <% @contrato.contratosimagenes.order(id: :desc).each do |contratosimagen| %>
	      <%= render 'contratosimagenes/tr', contratosimagen: contratosimagen %>
	    <% end %>
	  </tbody>
	</table>
</div>