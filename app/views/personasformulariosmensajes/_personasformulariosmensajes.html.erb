
<div class="box-body paddin-body">
  <div class="row">
    <div class="col-md-12">
      <div class="card">
        <div class="card-body">
          <div id="personasformulariosmensajes" style="margin-top: 10px;">
            <% if @personasformulario.personasformulariosmensajes.any? %>
              <table class="table table-bordered table-condensed table-striped">
                <thead>
                <tr class="thcolor">
                  <th width="5%" class="text-center text-table">ID</th>
                  <th width="15%" class="text-left text-table">Fecha</th>
                  <th width="15%" class="text-left text-table">Tipo</th>
                  <th width="10%" class="text-center text-table">Estado</th>
                  <th width="20%" class="text-left text-table">Registro</th>
                  <th class="text-left text-table">Respuesta</th>
                </tr>
                </thead>
                <tbody id="tbody_personasformulariosdocs">
                <% @personasformulario.personasformulariosmensajes.order(id: :desc).each do |personasformulariosmensaje| %>
                  <tr>
                    <td class="text-center"><%= personasformulariosmensaje.id rescue nil %></td>
                    <td class="text-left"><%= personasformulariosmensaje.created_at.strftime('%Y-%m-%d %X') rescue nil %></td>
                    <td class="text-left"><%= personasformulariosmensaje.tipo rescue nil %></td>
                    <td class="text-center"><%= personasformulariosmensaje.estado rescue nil %></td>
                    <td class="text-left"><%= personasformulariosmensaje.registro rescue nil %></td>
                    <td class="text-left"><%= personasformulariosmensaje.body rescue nil %></td>
                  </tr>
                <% end %>
                </tbody>
              </table>
            <% else %>
              <%= render 'layouts/procesos/alert_message' %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

