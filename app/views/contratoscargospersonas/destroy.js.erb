$(".alert_flash").fadeOut(300, function() {
    $(this).remove();
});

<% if @contratoscargo.contratoscargospersonas.count == 0 %>
$("#contratoscargospersonas").html("<div class='alert alert-danger'><h4><i class='icon fa fa-info'></i> <%=t :atencion%></h4><%=t :atencion_msj%><span></div>");
<% else %>
$("#contratoscargospersona_<%= @contratoscargospersona.id %>").remove();
<% end %>

$(".flash_messages").html("<%= j render 'layouts/flash_messages' %>");

setTimeout(function() {
    $(".alert_flash").fadeOut(300, function() {
        $(this).remove();
    });
}, 5000);

$('.tooltip').tooltip('hide');



