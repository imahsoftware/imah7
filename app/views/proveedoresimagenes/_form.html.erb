<%= simple_form_for([@proveedor, @proveedoresimagen], remote: true) do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
        <%= f.input :tiposimagen_id, collection: Tiposimagen.where(clase: 'PROVEEDOR').order(:descripcion).collect {|p| [ p.descripcion, p.id ] }, input_html: { class: 'select2' }, as: :select, include_blank: true%>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
        <%= f.input :prodocumentos, as: :file, label: 'Archivo a cargar' %>
      </div>
    </div><br/>
    <div class="row">
      <div class="col-md-6">
        <% if @proveedoresimagen.new_record? %>
          <%= button_tag "#{t :cancelar}", type: 'button', data: {target: '#proveedoresimagen_form'}, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}", proveedor_proveedoresimagen_path(@proveedor, @proveedoresimagen), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
<br/>