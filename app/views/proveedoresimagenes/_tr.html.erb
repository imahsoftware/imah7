<tr id="proveedoresimagen_<%= proveedoresimagen.id %>">
  <td class="text-center">
    <%# if is_auth_e("proveedoresimagen")%>
      <%= link_to proveedor_proveedoresimagen_path(@proveedor, proveedoresimagen), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
         <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
      <% end %>
    <%# end %>
    <%= link_to proveedoresimagen.prodocumentos.url(:original, false), data: { toggle: 'tooltip' },title: "Ver Documento", onclick: 'window.open(this.href,"new_window","height=450,width=600,scrollbars=yes");return false;' do %>
      <button class="btn btn-xs btn-primary"><i class="fa fa-cloud-download"></i></button>
    <% end %>

  </td>
  <td align="left"><%= proveedoresimagen.created_at.strftime("%Y-%m-%d %X") rescue nil %>
    <br/><small><%= proveedoresimagen.user.nombre rescue nil %></small></td>
  <td align="left"><%= proveedoresimagen.tiposimagen.descripcion rescue nil %></td>
  <td align="left"><%= proveedoresimagen.prodocumentos_file_name rescue nil %></td>
</tr>