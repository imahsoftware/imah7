<div class="box-header">
  <h3 class="box-title"><strong>Documentos Digitales</strong></h3>
  <div class="box-tools pull-right">
    <%# if is_auth_c('proveedoresimagen') %>
      <%= link_to new_proveedor_proveedoresimagen_path(@proveedor), id: 'new_proveedoresimagen_button', class: 'btn btn-sm btn-info', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
      <% end %>
    <%# end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="proveedoresimagen_form" class="collapse"></div>
  <div id="proveedoresimagenes">
    <% if @proveedor.proveedoresimagenes.present? %>
      <%= render 'proveedoresimagenes/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
    <% end %>
  </div>
</div>

