<%= simple_form_for(@contratosperfcontrol) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.input :contratosperfecha_id %>
    <%= f.input :fecha %>
    <%= f.input :estado %>
    <%= f.input :contratospervacacion_id %>
  </div>

  <div class="form-actions">
    <%= f.button :submit %>
  </div>
<% end %>
