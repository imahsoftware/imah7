<div class="box-header">
  <h3 class="box-title"><strong>Documentos Digitales</strong></h3>
  <div class="box-tools pull-right">
      <%# if is_auth_c('contratossoleppsdoc') %>
      <%= link_to new_contratossolepp_contratossoleppsdoc_path(@contratossolepp), id: 'new_contratossoleppsdoc_button', class: 'btn btn-sm btn-info', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
      <% end %>
      <%# end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="contratossoleppsdoc_form" class="collapse"></div>
  <div id="contratossoleppsdocs">
    <% if @contratossolepp.contratossoleppsdocs.present? %>
      <%= render 'contratossoleppsdocs/tabla' %>
    <% else %>
      <div class="alert alert-danger"><i class="icon fa fa-info"></i> <%= t :atencion %> - <%= t :atencion_msj %></div>
    <% end %>
  </div>
</div>

