        <th width="40%" class="text-left">Capacitación, divulgación</th>
        <th width="40%" class="text-left">Manera de hacer conocer las quejas</th>
      </tr>
    </thead>
	  <tbody id="tbody_contratospersugerencias">
	    <% @contratospersona.contratospersugerencias.order(id: :desc).each do |contratospersugerencia| %>
