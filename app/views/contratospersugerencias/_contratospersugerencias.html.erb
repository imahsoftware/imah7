<div class="box-header">
  <h3 class="box-title"><strong>Sugerencias</strong></h3>
  <div class="box-tools pull-right">
    <%# if is_auth_c('contratospersugerencia') %>
      <%= link_to new_contratospersona_contratospersugerencia_path(@contratospersona), id: 'new_contratospersugerencia_button', class: 'btn btn-sm btn-warning', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
      <% end %>
    <%# end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="contratospersugerencia_form" class="collapse"></div>
  <div id="contratospersugerencias">
    <% if @contratospersona.contratospersugerencias.present? %>
      <%= render 'contratospersugerencias/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
    <% end %>
  </div>
</div>
