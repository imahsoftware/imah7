<%= simple_form_for @veriservicio do |f| %>
  <div class="box box-danger">
    <div class="box-header">
      <legend>
        <%= link_to veriservicios_path, data: { toggle: 'tooltip' }, title: 'Regresar' do %>
          <i class="fa fa-arrow-left fa-fw text-success" aria-hidden="true"></i>
        <% end %>
        Información Verificación
        <% unless @veriservicio.new_record? %>
          <div class="pull-right">
            <%= @veriservicio.estado_color %>
          </div>
        <% end %>
      </legend>
    </div>

    <div class="box-body">
      <% unless @veriservicio.new_record? %>
        <div id="mostrar_boton_cierre" style="margin-top: -20px; display: <%= @evaluador ? 'block' : 'none' %>;">
          <%
            if ['PENDIENTE'].include?(@veriservicio.estado_proceso) and
              Veriserviciosagenda.where("DATE_FORMAT(fecha_reprogramacion, '%Y-%m-%d') = DATE_FORMAT(now(), '%Y-%m-%d') and estado = 'FINALIZADO'").present? and
              Veriserviciositem.where("veriservicio_id = #{@veriservicio.id} AND calificacion IS NOT NULL and calificacion not in (1,2,3)").present?
          %>
            <div style="padding: 10px; background-color: orange; color: black; border-radius: 5px;font-size: 14px;">
              <b><i class="fa fa-info-circle"></i> Para completar la verificación, haga clic en el siguiente botón.</b> <%= link_to verificacion_veriservicios_path(id: @veriservicio.id), remote: true, data: { toggle: 'tooltip', confirm: "Seguro que desea Cerrar la verficiación" }, title: "Verificar Proceso" do %>
                <button class="btn btn-xs btn-success"><i class="fa fa-check"></i> Cerrar Verificación</button>
              <% end %>
            </div>
          <% end %>
          <%
            if ['EN PROCESO'].include?(@veriservicio.estado_proceso) and
              Veriserviciosagenda.where("DATE_FORMAT(fecha_reprogramacion, '%Y-%m-%d') = DATE_FORMAT(now(), '%Y-%m-%d') and estado = 'FINALIZADO'").present? and
              !Veriserviciosuser.where("veriservicio_id = #{@veriservicio.id} AND codigo_firma IS NULL").present?
          %>
            <div style="padding: 10px; background-color: orange; color: black; border-radius: 5px;font-size: 14px;">
              <b><i class="fa fa-info-circle"></i> Para completar la verificación, haga clic en el siguiente botón.</b> <%= link_to verificacion_veriservicios_path(id: @veriservicio.id), remote: true, data: { toggle: 'tooltip', confirm: "Seguro que desea Cerrar la verficiación" }, title: "Verificar Proceso" do %>
                <button class="btn btn-xs btn-success"><i class="fa fa-check"></i> Cerrar Verificación</button>
              <% end %>
            </div>
          <% end %>
        </div>
        <br/>
      <% end %>

      <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
          <% unless @veriservicio.new_record? %>
            <%= f.input :contrato_id, collection: is_select_contratos_activos.collect { |p| [p.datos.to_s, p.id] }, input_html: { class: 'select2', style: "width: 100%" }, as: :select, include_blank: true, label: 'Contrato', disabled: true %>
          <% else %>
            <%= f.input :contrato_id, collection: is_select_contratos_activos_verificacion.collect { |p| [p.datos.to_s, p.id] }, input_html: { class: 'select2', style: "width: 100%" }, as: :select, include_blank: true, label: 'Contrato' %>
          <% end %>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
          <% unless @veriservicio.new_record? %>
            <%= f.input :contratossede_id, collection: @veriservicio.contrato.contratossedes.collect { |p| [p.nombre.to_s, p.id] }, input_html: { class: 'select2', style: "width: 100%" }, as: :select, include_blank: true, label: 'Sede', disabled: true %>
          <% else %>
            <%= f.input :contratossede_id, as: :select, collection: [].collect { |p| [p.descripcion, p.id] }, prompt: '-- Seleccione --', label: 'Sedes', disabled: true, input_html: { data: { width: '100%' }, class: 'clean select2' } %>
          <% end %>
        </div>
      </div>
      <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
          <%= f.input :objetivo, as: :text, :input_html => { :onchange => "javascript:this.value=this.value.toUpperCase();", :rows => 2 } %>
        </div>
      </div>
    </div>
    <div class="box-footer">
      <div class="box-tools pull-right">
        <% if @veriservicio.new_record? %>
          <%= f.button :submit, t(:guardar), class: "btn btn-danger pull-right" %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
<% unless @veriservicio.new_record? %>
  <div class="row">
    <div class="col-xs-12">
      <div class="nav-tabs-custom">
        <ul class="nav nav-tabs">
          <li class="<%= @etapa == 'A' ? 'active' : '' %>">
            <%= link_to edit_veriservicio_path(id: @veriservicio.id, etapa: "A") do %>
              <i class="fa fa-sticky-note-o"></i> Items
            <% end %>
          </li>
          <li class="<%= @etapa == 'C' ? 'active' : '' %>">
            <%= link_to edit_veriservicio_path(id: @veriservicio.id, etapa: "C") do %>
              <i class="fa fa-calendar"></i> Agendas
            <% end %>
          </li>
        </ul>
        <div class="tab-content">
          <% if @etapa == 'A' %>
            <%= render "veriserviciositems/veriserviciositems" %>
          <% end %>
          <% if @etapa == 'C' %>
            <%= render "veriserviciosagendas/veriserviciosagendas" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
