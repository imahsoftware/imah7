<div class="box-header">
  <h3 class="box-title"><strong>Asistentes</strong></h3>
  <div class="box-tools pull-right">
    <% if @visita.finalizacion.blank? %>
      <%= link_to new_visita_visitasasistente_path(@visita), id: 'new_visitasasistente_button', class: 'btn btn-sm btn-info', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
      <% end %>
    <% end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="visitasasistente_form" class="collapse"></div>
  <div id="visitasasistentes">
    <% if @visita.visitasasistentes.present? %>
      <%= render 'visitasasistentes/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %>
      </div>
    <% end %>
  </div>
</div>

