<tr id="visitasasistente_<%= visitasasistente.id %>">
  <td class="text-center">
    <% if visitasasistente.visita.finalizacion.blank? %>
      <%= link_to visita_visitasasistente_path(@visita, visitasasistente), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
        <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
      <% end %>
    <% end %>
  </td>
  <td align="left" class="text-table"><%= visitasasistente.created_at.strftime("%Y-%m-%d %X") rescue nil %>
    <br/><small><%= visitasasistente.user.nombre rescue nil %></small></td>
  <td align="left" class="text-table"><%= visitasasistente.nombre rescue nil %></td>
  <td align="left" class="text-table"><%= visitasasistente.cargo rescue nil %></td>
  <td align="left" class="text-table"><%= visitasasistente.email rescue nil %></td>
</tr>
