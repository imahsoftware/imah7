<%= simple_form_for([@visita, @visitasasistente], remote: true) do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
        <%= f.input :nombre, input_html: {:onchange => "javascript:this.value=this.value.toUpperCase();"} %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
        <%= f.input :cargo, input_html: {:onchange => "javascript:this.value=this.value.toUpperCase();"} %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
        <%= f.input :email, input_html: {:onchange => "javascript:this.value=this.value.toUpperCase();"} %>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <% if @visitasasistente.new_record? %>
          <%= button_tag "#{t :cancelar}", type: 'button', data: {target: '#visitasasistente_form'}, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}", visita_visitasasistente_path(@visita, @visitasasistente), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
<br/>