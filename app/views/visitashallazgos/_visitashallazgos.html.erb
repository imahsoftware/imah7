<div class="box-header">
  <h3 class="box-title"><strong>Hallazgos</strong></h3>
  <div class="box-tools pull-right">
    <% if @visita.finalizacion.blank? %>
      <%# if is_auth_c('visitashallazgo') %>
      <%= link_to captura_visitashallazgos_path(visita_id: @visita.id), class: 'btn btn-sm btn-warning' do %>
        <i class="fa fa-camera"> </i> <span>Capturar Imagen</span>
      <% end %>

      <%= link_to new_visita_visitashallazgo_path(@visita), id: 'new_visitashallazgo_button', class: 'btn btn-sm btn-info', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
      <% end %>
      <%# end %>
    <% end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="visitashallazgo_form" class="collapse"></div>
  <div id="visitashallazgos">
    <% if @visita.visitashallazgos.present? %>
      <%= render 'visitashallazgos/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %>
      </div>
    <% end %>
  </div>
</div>

