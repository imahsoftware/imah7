<tr id="visitashallazgo_<%= visitashallazgo.id %>">
  <td class="text-center">
    <% if visitashallazgo.visita.finalizacion.blank? %>
      <%= link_to visita_visitashallazgo_path(@visita, visitashallazgo), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
        <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
      <% end %>
    <% end %>
  </td>
  <td align="left" class="text-table"><%= visitashallazgo.created_at.strftime("%Y-%m-%d %X") rescue nil %>
    <br/><small><%= visitashallazgo.user.nombre rescue nil %></small></td>
  <td align="left" class="text-table">
    <%= visitashallazgo.tipo rescue nil %>
  </td>
  <td align="left" class="text-table">
    <%= link_to visitashallazgo.docvisitashallazgo.url(:original, false), data: { toggle: 'tooltip' }, title: "Ver Documento", onclick: 'window.open(this.href,"new_window","height=450,width=600,scrollbars=yes");return false;' do %>
      <i class="fa fa-cloud-download"></i> <%= visitashallazgo.docvisitashallazgo_file_name rescue nil %>
    <% end %>
  </td>
</tr>
