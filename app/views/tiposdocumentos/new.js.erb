<% if @active_record.present? %>
	$("#tiposdocumento_<%= @active_record.id %>").replaceWith("<%= j render 'tr', tiposdocumento: @active_record %>");
<% end %>
$("#tiposdocumento_form").html("<%= j render 'form' %>");
$(".datetimepicker").datetimepicker();
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
$("#tiposdocumento_form").collapse("show");
$(".select2").select2();