<p id="notice"><%= notice %></p>

<h1>Contratosprosedes</h1>

<table>
  <thead>
    <tr>
      <th>Contratosproyecto</th>
      <th>User</th>
      <th>Contratossede</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @contratosprosedes.each do |contratosprosede| %>
      <tr>
        <td><%= contratosprosede.contratosproyecto %></td>
        <td><%= contratosprosede.user %></td>
        <td><%= contratosprosede.contratossede %></td>
        <td><%= link_to 'Show', contratosprosede %></td>
        <td><%= link_to 'Edit', edit_contratosprosede_path(contratosprosede) %></td>
        <td><%= link_to 'Destroy', contratosprosede, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Contratosprosede', new_contratosprosede_path %>
