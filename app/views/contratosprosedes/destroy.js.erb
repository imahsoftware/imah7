$(".alert_flash").fadeOut(300, function() {
	$(this).remove();
});

<% if @contratosproyecto.contratosprosedes.count.to_i == 0 %>
	$("#contratosprosedes<%= @contratosproyecto.id %>").html("<div class='alert alert-warning'><h4><i class='icon fa fa-info'></i> <%=t :atencion%></h4><%=t :atencion_msj%><span></div>");
	$("#contratosproyectodelete_<%= @contratosproyecto.id %>").show();
<% else %>
	$("#contratosprosede_<%= @contratosprosede.id %>").remove();
<% end %>




$(".flash_messages").html("<%= j render 'layouts/flash_messages' %>");

setTimeout(function() {
	$(".alert_flash").fadeOut(300, function() {
		$(this).remove();
	});
}, 5000);

$('.tooltip').tooltip('hide');
