$("#contratosprosede_form<%= @contratosproyecto.id %>").collapse("hide");

$("#contratosprosede_form<%= @contratosproyecto.id %>").empty();

<% if @active_record.present? %>
	$("#contratosprosede_<%= @active_record.id %>").replaceWith("<%= j render 'tr', contratosprosede: @active_record %>");
<% end %>

$("#contratosprosede_<%= @contratosprosede.id %>").html("<td colspan='7'><%= j render 'form' %></td>");

$("#contratosprosede_<%= @contratosprosede.id %>").addClass("active_contratosproyectostiposdocumento");

$(".select2").select2();

$(".tooltip").tooltip("hide");

$('[data-toggle="tooltip"]').tooltip();
