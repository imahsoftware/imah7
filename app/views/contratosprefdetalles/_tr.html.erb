<tr id="contratosprefdetalle_<%= contratosprefdetalle.id %>">
  <td class="text-center">
    <% if @contratosprefactura.estado.to_s =='PENDIENTE' or @contratosprefactura.estado.to_s == 'RECHAZADA' %>
    <%# if @contrato.contratosusers.exists?(empresasprefdetalle_id: contratosprefdetalle.empresasprefdetalle_id) == false and @contrato.contratoscargos.exists?(empresasprefdetalle_id: contratosprefdetalle.empresasprefdetalle_id) == false  %>
      <%= link_to edit_contratosprefactura_contratosprefdetalle_path(@contratosprefactura, contratosprefdetalle), remote: true, class: 'edit_contratosmodificacion_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
        <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
      <% end %>
       <%# if is_auth_e("contratosprefdetalle")%>
        <%= link_to contratosprefactura_contratosprefdetalle_path(@contratosprefactura, contratosprefdetalle), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
           <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
        <% end %>
    <% end %>
    <button class="btn btn-xs btn-info"><span data-toggle="tooltip" data-html="true" data-original-title="<div align='left'><%= contratosprefdetalle.user_nombre.html_safe rescue nil %><%= contratosprefdetalle.user_actnombre.html_safe rescue nil %></div>"><i class="fa fa-user" aria-hidden="true"></i></span></button>
  </td>
  <td align="justify"><%= contratosprefdetalle.nombredetalle rescue nil %>
  <% if contratosprefdetalle.contratossolicitud_id %>
      <br/><br/><strong>Solicitud: </strong>
      <%= link_to contratossolicitud_path(id: contratosprefdetalle.contratossolicitud_id), data: {toggle: 'tooltip'}, class: 'popup', title: 'Ver solicitud ' do %>
        <i class="fa fa-clone"></i>
      <% end %>
      <%= link_to visualizar_contratossolicitudes_path(id: contratosprefdetalle.contratossolicitud_id, format: :pdf), data: {toggle: 'tooltip'}, title: 'Solicitud por Sedes ' do %>
        <i class="fa fa-file-pdf-o"></i>
      <% end %>
      <%=contratosprefdetalle.contratossolicitud.namebyprefact %>
  <% end %>
  </td>
  <td align="center"><small><%= camponumerico contratosprefdetalle.cantidad rescue nil %></small></td>
  <td align="right"><small><%= camponumerico contratosprefdetalle.valor_unitario rescue nil %></small></td>
  <td align="center"><small><%= camponumerico contratosprefdetalle.iva rescue nil %></small></td>
  <td align="right"><small><%= camponumerico contratosprefdetalle.subtotal rescue nil %></small></td>
  <td align="right"><small><%= camponumerico contratosprefdetalle.valor_iva rescue nil %></small></td>
  <td align="right"><small><%= camponumerico contratosprefdetalle.total rescue nil %></small></td>
</tr>
