<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
	  <thead class="thcolor">
      <tr>
        <td width="10%"></td>
        <th class="text-left">DETALLE</th>
        <th width="4%" class="text-center">CANT</th>
        <th width="10%" class="text-center">VLR UNIT</th>
        <th width="5%" class="text-center">IVA %</th>
        <th width="10%" class="text-center">SUBTOTAL</th>
        <th width="5%" class="text-center">VLR IVA</th>
        <th width="10%" class="text-right">VLR TOTAL</th>
      </tr>
    </thead>
	  <tbody id="tbody_contratosprefdetalles">
      <% @contratosprefactura.contratosprefdetalles.order(id: :asc).each do |contratosprefdetalle| %>
	      <%= render 'contratosprefdetalles/tr', contratosprefdetalle: contratosprefdetalle %>
	    <% end %>
	  </tbody>
    <tr>
      <th class="thcolor text-center" colspan="5">Totales</th>
      <th class="thcolor text-right"><div id="idSubtotal<%= @contratosprefactura.id %>"><%=camponumerico @contratosprefactura.contratosprefdetalles.sum("subtotal") rescue 0 %></div></th>
      <th class="thcolor text-right"><div id="idValor_iva<%= @contratosprefactura.id %>"><%= camponumerico @contratosprefactura.contratosprefdetalles.sum("valor_iva") rescue 0 %></div></th>
      <th class="thcolor text-right"><div id="idValor_total<%= @contratosprefactura.id %>"><%= camponumerico @contratosprefactura.contratosprefdetalles.sum("total") rescue 0 %></div></th>
    </tr>
	</table>
</div>
