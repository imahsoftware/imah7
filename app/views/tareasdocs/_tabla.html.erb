<table class="table table-bordered table-condensed table-striped">
  <thead>
  <tr class="thcolor">
    <th width="5%"></th>
    <th class="font-size-text-tabla text-center text-table" width="5%">ID</th>
    <th class="font-size-text-tabla text-table">Descripción</th>
    <th class="font-size-text-tabla text-table" width="50%">Documento</th>
  </tr>
  </thead>
  <tbody id="tbody_tareasdocs">
  <% @tarea.tareasdocs.order(id: :desc).each do |tareasdoc| %>
    <%= render 'tareasdocs/tr', tareasdoc: tareasdoc %>
  <% end %>
  </tbody>
</table>