<%= simple_form_for([@portafolio, @portafoliospersona], remote: true) do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-md-12">
          <%= f.input :persona_id, as: :select, collection: Persona.where(["id not in (select persona_id from portafoliospersonas)"]).order("autobuscar asc").collect { |p| [p.autobuscar.to_s, p.id] }, input_html: {data: {width: '100%'}, class: 'select2', include_blank: true}, label: false %></div></div>
    </div>
    <div class="row">
      <div class="col-md-6">
        <% if @portafoliospersona.new_record? %>
          <%= button_tag "#{t :cancelar}", type: 'button', data: { target: '#portafoliospersona_form' }, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}", portafolio_portafoliospersona_path(@portafolio, @portafoliospersona), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
