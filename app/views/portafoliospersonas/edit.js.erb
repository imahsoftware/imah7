$("#portafoliospersona_form").collapse("hide");

$("#portafoliospersona_form").empty();

<% if @active_record.present? %>
	$("#portafoliospersona_<%= @active_record.id %>").replaceWith("<%= j render 'tr', portafoliospersona: @active_record %>");
