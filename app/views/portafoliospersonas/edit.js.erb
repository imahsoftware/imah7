$("#portafoliospersona_<%= @portafoliospersona.id %>").html("<td colspan='7'><%= j render 'form' %></td>");

$("#portafoliospersona_<%= @portafoliospersona.id %>").addClass("active_portafoliospersona");

$(".select2").select2();

$(".tooltip").tooltip("hide");

$('[data-toggle="tooltip"]').tooltip();
