<tr id="portafoliospersona_<%= portafoliospersona.id %>">
  <td class="text-center">
    <%# if is_auth_a("portafoliospersona")%>
      <%= link_to edit_portafolio_portafoliospersona_path(@portafolio, portafoliospersona), remote: true, class: 'edit_portafoliospersona_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
         <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
      <% end %>
    <%# end %>
    <%# if is_auth_e("portafoliospersona")%>
      <%= link_to portafolio_portafoliospersona_path(@portafolio, portafoliospersona), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
         <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
      <% end %>
    <%# end %>
  </td>
  <td class="text-left"><%= portafoliospersona.persona.autobuscar rescue 0 %></td>
</tr>
