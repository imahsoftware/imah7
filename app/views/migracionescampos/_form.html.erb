<%= simple_form_for(@migracionescampo) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.association :migracion %>
    <%= f.input :orden %>
    <%= f.input :encabezado %>
    <%= f.input :campo %>
    <%= f.input :tipo %>
  </div>

  <div class="form-actions">
    <%= f.button :submit %>
  </div>
<% end %>
