<p id="notice"><%= notice %></p>

<h1>Migracionescampos</h1>

<table>
  <thead>
    <tr>
      <th>Migracion</th>
      <th>Orden</th>
      <th>Encabezado</th>
      <th>Campo</th>
      <th>Tipo</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @migracionescampos.each do |migracionescampo| %>
      <tr>
        <td><%= migracionescampo.migracion %></td>
        <td><%= migracionescampo.orden %></td>
        <td><%= migracionescampo.encabezado %></td>
        <td><%= migracionescampo.campo %></td>
        <td><%= migracionescampo.tipo %></td>
        <td><%= link_to 'Show', migracionescampo %></td>
        <td><%= link_to 'Edit', edit_migracionescampo_path(migracionescampo) %></td>
        <td><%= link_to 'Destroy', migracionescampo, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Migracionescampo', new_migracionescampo_path %>
