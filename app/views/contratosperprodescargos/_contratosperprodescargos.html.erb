<div class="box-header">
  <h3 class="box-title"><strong>Descargos </strong>
    <%#= link_to procesos_pdf_contratosperprocesos_path(contratosperproceso_id: @contratosperproceso.id, format: :pdf, proceso: 'DESCARGO'), data: { toggle: 'tooltip' }, class: 'popup', title: 'Descargos' do %>
    <!-- <button class="btn btn-xs btn-info"><i class="fa fa-file-pdf-o"></i></button> -->
    <%# end %>
    <div style="display: flex;
      align-items: flex-end;">
      <% if @contratosperproceso.contratosperprodescargos.present? %>
        <% if @contratosperproceso.codigo_firma_descargo.blank? %>
          <div id="remove_boton_descargo_1<%= @contratosperproceso.id %>">
            <%= link_to otp_contratosperprodescargos_path(id: @contratosperproceso.id), remote: true, data: { toggle: 'tooltip' }, title: 'Firmar Documento' do %>
              <button class="btn btn-xs btn-success"><i class="fa fa-paint-brush"></i></button>
            <% end %>
          </div>
        <% end %>
        <% if @contratosperproceso.codigo_firma_user_descargo.blank? %>
          <div style="margin-left: 10px;" id="remove_boton_descargo_4<%= @contratosperproceso.id %>">
            <%= link_to otp2_contratosperprodescargos_path(id: @contratosperproceso.id), remote: true, data: { toggle: 'tooltip' }, title: 'Firmar Documento Usuario' do %>
              <button class="btn btn-xs btn-warning"><i class="fa fa-pencil"></i></button>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <% if Contratosperprodoc.where("id_proceso = #{@contratosperproceso.id} and proceso = 'DESCARGOS'").present? %>
        <div style="margin-left: 10px;" >
          <%= link_to Contratosperprodoc.where("id_proceso = #{@contratosperproceso.id} and proceso = 'DESCARGOS'").last.docproceso.url(:original, false), data: { toggle: 'tooltip' }, title: 'Ver Documento Firmado', onclick: 'window.open(this.href,"new_window","height=450,width=600,scrollbars=yes");return false;' do %>
            <button class="btn btn-xs btn-primary"><i class="fa fa-file-pdf-o"></i></button>
          <% end %>
        </div>
      <% end %>
    </div>
    <div id="firmado_check<%= @contratosperproceso.id %>"></div>
    <% if @contratosperproceso.codigo_firma_descargo.present? %>
      <div class="pull-left" style="margin-top: 10px;">
        <b>Firmado:</b> <i class="fa fa-check text-success"></i> -
        <b>Fecha: </b><%= @contratosperproceso.codigo_fecha_descargo.strftime("%Y-%m-%d %X") rescue nil %> -
        <b>Usuario: </b> <%= User.find(@contratosperproceso.user_descargo).nombre rescue nil %>
      </div>
    <% end %>
  </h3>
  <div class="box-tools pull-right" id="remove_boton_descargo_2<%= @contratosperproceso.id %>">
    <% if @contratosperproceso.codigo_firma_descargo.blank? %>
      <%= link_to new_contratosperproceso_contratosperprodescargo_path(@contratosperproceso), id: 'new_contratosperprodescargo_button', class: 'btn btn-sm btn-warning', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
      <% end %>
    <% end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="contratosperprodescargo_form" class="collapse"></div>
  <div id="contratosperprodescargos">
    <% if @contratosperproceso.contratosperprodescargos.present? %>
      <%= render 'contratosperprodescargos/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %>
      </div>
    <% end %>
  </div>
</div>

<div class="modal fade" id="otp<%= @contratosperproceso.id rescue nil %>">
  <div class="modal-dialog" style="width: 900px;">
    <div class="modal-content">
    </div>
  </div>
</div>

<div class="modal fade" id="otp2<%= @contratosperproceso.id rescue nil %>">
  <div class="modal-dialog" style="width: 900px;">
    <div class="modal-content">
    </div>
  </div>
</div>
