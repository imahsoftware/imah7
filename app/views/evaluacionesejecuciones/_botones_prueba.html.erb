<% if Evaluacionescontrato.where("evaluacion_id = #{p.evaluacion_id} and user_responsable = #{user_responsable_id}").first.estado.to_i == 0 %>
  <%= render 'evaluacionesejecuciones/estado_evaluacion_prueba', p: p %>
  <ul class="dropdown-menu" role="menu">
    <li>
      <%= link_to cargar_evaluacionesejecuciones_path(id: p.id), remote: true do %>
        <i class="fa fa-file-pdf-o text-red"></i> Agregar documentos
      <% end %>
    </li>
    <li>
      <%= link_to finalizar_prueba_evaluacionesejecuciones_path(id: p.id, estado: '1', user_responsable_id: user_responsable_id, contratosperfecha_id: contratosperfecha_id), remote: true do %>
        <i class="fa fa-check"></i> Deficiente
      <% end %>
    </li>
    <li>
      <%= link_to finalizar_prueba_evaluacionesejecuciones_path(id: p.id, estado: '2', user_responsable_id: user_responsable_id, contratosperfecha_id: contratosperfecha_id), remote: true do %>
        <i class="fa fa-check"></i> Regular
      <% end %>
    </li>
    <li>
      <%= link_to finalizar_prueba_evaluacionesejecuciones_path(id: p.id, estado: '3', user_responsable_id: user_responsable_id, contratosperfecha_id: contratosperfecha_id), remote: true do %>
        <i class="fa fa-check"></i> Bueno
      <% end %>
    </li>
    <li>
      <%= link_to finalizar_prueba_evaluacionesejecuciones_path(id: p.id, estado: '4', user_responsable_id: user_responsable_id, contratosperfecha_id: contratosperfecha_id), remote: true do %>
        <i class="fa fa-check"></i> Excelente
      <% end %>
    </li>
  </ul>
<% else %>
  <%= p.estado_prueba rescue nil %>
<% end %>
