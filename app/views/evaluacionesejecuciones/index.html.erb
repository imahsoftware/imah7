<p id="notice"><%= notice %></p>

<h1>Evaluacionesejecuciones</h1>

<table>
  <thead>
    <tr>
      <th>Evaluacionescontrato</th>
      <th>Evaluacion</th>
      <th>Evalacionesdetalle</th>
      <th>Estado</th>
      <th>User</th>
      <th>Resultado</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @evaluacionesejecuciones.each do |evaluacionesejecucion| %>
      <tr>
        <td><%= evaluacionesejecucion.evaluacionescontrato %></td>
        <td><%= evaluacionesejecucion.evaluacion %></td>
        <td><%= evaluacionesejecucion.evalacionesdetalle %></td>
        <td><%= evaluacionesejecucion.estado %></td>
        <td><%= evaluacionesejecucion.user %></td>
        <td><%= evaluacionesejecucion.resultado %></td>
        <td><%= link_to 'Show', evaluacionesejecucion %></td>
        <td><%= link_to 'Edit', edit_evaluacionesejecucion_path(evaluacionesejecucion) %></td>
        <td><%= link_to 'Destroy', evaluacionesejecucion, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Evaluacionesejecucion', new_evaluacionesejecucion_path %>
