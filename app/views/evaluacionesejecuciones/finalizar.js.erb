$('#botones<%= @evaluacionesejecucion.id %>').html("<%= j render 'evaluacionesejecuciones/botones', p: @evaluacionesejecucion, user_responsable_id: @user_responsable %>");
$('#estado_evaluacion<%= @evaluacionesejecucion.id %>').html("<%= j render 'evaluacionesejecuciones/estado_evaluacion', p: @evaluacionesejecucion %>");
$('#input_registro_data<%= @evaluacionesejecucion.id %>').html("<%= j render 'evaluacionesejecuciones/input_registro', p: @evaluacionesejecucion %>")
$('#resultado<%= @evaluacionesejecucion.id %>').html("<%= @evaluacionesejecucion.resultado rescue nil %>");

<% if ['1.0','0.5', '0'].include?(@estado) and @evaluacionesejecucion.resultado.blank? %>
$('#mensaje_error<%= @evaluacionesejecucion.id %>').html("<%= j render 'evaluacionesejecuciones/mensaje_error', p: @evaluacionesejecucion %>");
<% else %>
$('#usuario_marca<%= @evaluacionesejecucion.id %><%= @user_responsable %>').html("<%= j render 'evaluacionesejecuciones/datos_user', p: @evaluacionesejecucion, user_responsable_id: @user_responsable %>");
$('#mensaje_error<%= @evaluacionesejecucion.id %>').html("");
<% end %>