$("#tiposentidad_form").collapse("hide");

$("#tiposentidad_form").empty();

<% if @active_record.present? %>
	$("#tiposentidad_<%= @active_record.id %>").replaceWith("<%= j render 'tr', tiposentidad: @active_record %>");
<% end %>

$("#tiposentidad_<%= @tiposentidad.id %>").html("<td colspan='6'><%= j render 'form' %></td>");

$("#tiposentidad_<%= @tiposentidad.id %>").addClass("active_tiposentidad");
$(".datetimepicker").datetimepicker();
$(".select2").select2();

$(".tooltip").tooltip("hide");

$('[data-toggle="tooltip"]').tooltip();
$(".datetimepicker").datetimepicker();
$('.datepicker').datepicker({
    dayNamesMin: [ "Dom", "Lun", "Mar", "Mie", "Jue", "Vie", "Sáb" ],
    monthNamesShort: [ "Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic" ],
    dateFormat: "yy-mm-dd",
    yearRange: '2000:2027',
    changeMonth: true,
    changeYear: true,
});

