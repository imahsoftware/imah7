<div class="box box-primary">
  <div class="box-header">
    <legend>Tipos de Entidades</legend>
    <div class="box-tools pull-right">
      <% if is_auth_c('tiposentidad') %>
        <%= link_to new_tiposentidad_path, remote: true, class: 'btn btn-sm btn-info' do %>
          <i class="fa fa-plus-square"> </i> <span>Nuevo</span>
        <% end %>&nbsp;&nbsp;
      <% end %>
    </div>
  </div>
  <div class="flash_messages"></div>
  <div class="box-body">
    <div id="tiposentidad_form" class="collapse"></div>
    <div id="tiposentidades">
      <% if @tiposentidades.present? %>
        <% @is_auth_c_tiposentidad = is_auth_c('tiposentidad') %>
        <%= render 'tiposentidades/tabla' %>
      <% else %>
        <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
      <% end %>
    </div>
  </div>
</div>