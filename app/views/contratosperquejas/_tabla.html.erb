<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
	  <thead class="thcolor">
      <tr>
        <td width="10%"></td>
        <th width="10%" class="text-left">Fecha</th>
        <th class="text-left">Conducta de Acoso</th>
        <th width="10%" class="text-center">Interes de Conciliar</th>
      </tr>
    </thead>
	  <tbody id="tbody_contratosperquejas">
	    <% @contratospersona.contratosperquejas.order(id: :desc).each do |contratosperqueja| %>
	      <%= render 'contratosperquejas/tr', contratosperqueja: contratosperqueja %>
	    <% end %>
	  </tbody>
	</table>
</div>
