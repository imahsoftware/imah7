$("#contratosperprodoc_form").collapse("hide");

$("#contratosperprodoc_form").empty();

<% if @active_record.present? %>
	$("#contratosperprodoc_<%= @active_record.id %>").replaceWith("<%= j render 'tr', contratosperprodoc: @active_record %>");
<% end %>

$("#contratosperprodoc_<%= @contratosperprodoc.id %>").html("<td colspan='12'><%= j render 'form' %></td>");

$("#contratosperprodoc_<%= @contratosperprodoc.id %>").addClass("active_contratosperprodoc");

$(".select2").select2();

$(".tooltip").tooltip("hide");

$('[data-toggle="tooltip"]').tooltip();
$(".datetimepicker").datetimepicker();
$('.datepicker').datepicker({
    dayNamesMin: [ "Dom", "Lun", "Mar", "Mie", "Jue", "Vie", "Sáb" ],
    monthNamesShort: [ "Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic" ],
    dateFormat: "yy-mm-dd",
    yearRange: '2000:2027',
    changeMonth: true,
    changeYear: true,
});

$('.uppercaseInput').keyup(function () {
    $(this).val($(this).val().toUpperCase());
});