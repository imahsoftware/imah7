$(".alert_flash").fadeOut(300, function () {
    $(this).remove();
});
<% if @ruta == 'PROCESO' %>
	$("#adddocumento2<%= @contratosperproceso.id %>").modal("hide");
	$('#mostrar_documento<%= @contratosperproceso.id %>').html("<%= j render 'contratosperprocesos/documentos_cargados', contratosperproceso: @contratosperproceso %>")

<% else %>
	<% if @contratosperproceso.contratosperprodocs.count == 1 %>
	$("#contratosperprodocs").html("<%= j render 'tabla' %>");
	<% else %>
	$("#tbody_contratosperprodocs").prepend("<%= j render 'tr', contratosperprodoc: @contratosperprodoc %>");
	<% end %>
<% end %>


$(".clean").val("").trigger('change');

$("#contratosperprodoc_form").collapse("hide");

$('[data-toggle="tooltip"]').tooltip();

$(".flash_messages").html("<%= j render 'layouts/flash_messages' %>");

$(".form-group").removeClass("has-error");
$(".form-group > .help-block.help-block-error").remove();

setTimeout(function () {
    $(".alert_flash").fadeOut(300, function () {
        $(this).remove();
    });
}, 5000);
