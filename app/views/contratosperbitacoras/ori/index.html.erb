<p id="notice"><%= notice %></p>

<h1>Contratosperbitacoras</h1>

<table>
  <thead>
    <tr>
      <th>Contratospersona</th>
      <th>Estado</th>
      <th>User</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @contratosperbitacoras.each do |contratosperbitacora| %>
      <tr>
        <td><%= contratosperbitacora.contratospersona %></td>
        <td><%= contratosperbitacora.estado %></td>
        <td><%= contratosperbitacora.user %></td>
        <td><%= link_to 'Show', contratosperbitacora %></td>
        <td><%= link_to 'Edit', edit_contratosperbitacora_path(contratosperbitacora) %></td>
        <td><%= link_to 'Destroy', contratosperbitacora, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Contratosperbitacora', new_contratosperbitacora_path %>
