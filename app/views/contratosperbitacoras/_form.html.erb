<%= simple_form_for([@contratospersona, @contratosperbitacora], remote: true) do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6"><%= f.input :descripcion, as: :text,:input_html => {:onchange => "javascript:this.value=this.value.toUpperCase();", :rows => 2 }, label: "Descripción del examen requerido" %></div>
      <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :estado, as: :select, collection: select_estado, input_html: { class: 'select2' } %></div>
    </div>
    <div class="row">
      <div class="col-md-6">
        <% if @contratosperbitacora.new_record? %>
          <%= button_tag "#{t :cancelar}", type: 'button', data: {target: '#contratosperbitacora_form'}, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}", contratospersona_contratosperbitacora_path(@contratospersona, @contratosperbitacora), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
<br/>
