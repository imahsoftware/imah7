<tr id="contratosperbitacora_<%= contratosperbitacora.id %>">
  <td class="text-center">
    <%# if is_auth_e("contratosperbitacora")%>
    <%= link_to edit_contratospersona_contratosperbitacora_path(@contratospersona, contratosperbitacora), remote: true, class: 'edit_contratosmodificacion_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
      <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
    <% end %>
      <%= link_to contratospersona_contratosperbitacora_path(@contratospersona, contratosperbitacora), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
         <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
      <% end %>
    <%# end %>
    <button class="btn btn-xs btn-info"><span data-toggle="tooltip" data-html="true" data-original-title="<div align='left'><%= contratosperbitacora.user_nombre.html_safe rescue nil %><%= contratosperbitacora.user_actnombre.html_safe rescue nil %></div>"><i class="fa fa-user" aria-hidden="true"></i></span></button>
  </td>
  <td align="left"><%= contratosperbitacora.descripcion rescue nil %></td>
  <td align="center"><%= contratosperbitacora.estado rescue nil %></td>

</tr>

