$("#centroscosto_form").collapse("hide");

$("#centroscosto_form").empty();

<% if @active_record.present? %>
	$("#centroscosto_<%= @active_record.id %>").replaceWith("<%= j render 'tr', centroscosto: @active_record %>");
<% end %>

$("#centroscosto_<%= @centroscosto.id %>").html("<td colspan='5'><%= j render 'form' %></td>");

$("#centroscosto_<%= @centroscosto.id %>").addClass("active_centroscosto");
$(".datetimepicker").datetimepicker();
$(".select2").select2();

$(".tooltip").tooltip("hide");

$('[data-toggle="tooltip"]').tooltip();