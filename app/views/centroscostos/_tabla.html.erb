<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
    <thead>
      <tr class="thcolor">
        <% if is_auth_c('centroscosto') %>
          <th width="10%"></th>
        <% end %>
        <th width="10%">ID</th>
        <th>Codigo</th>
        <th>Descripción</th>
      </tr>
    </thead>
    <tbody id="tbody_centroscostos">
      <% @centroscostos.each do |centroscosto| %>
        <%= render 'centroscostos/tr', centroscosto: centroscosto %>
      <% end %>
    </tbody>
  </table>
</div>