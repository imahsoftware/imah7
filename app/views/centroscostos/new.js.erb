<% if @active_record.present? %>
	$("#centroscosto_<%= @active_record.id %>").replaceWith("<%= j render 'tr', centroscosto: @active_record %>");
<% end %>
$("#centroscosto_form").html("<%= j render 'form' %>");
$(".datetimepicker").datetimepicker();
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
$("#centroscosto_form").collapse("show");
$(".select2").select2();