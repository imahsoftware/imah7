<% if @valida == true %>
$("#menu_firma<%= @contratosperproceso.id %>").removeClass('hide');
$("#abogado<%= @contratosperproceso.id %>").addClass('hide');
<% if @contratosperproceso.firma_abogado.present? %>
$('#estado_firma_abogado<%= @contratosperproceso.id %>').remove();
var divValue = <%= @div %>;
var htmlContent = '<div class="col-xs-12 col-sm-12 col-md-' + divValue + ' col-lg-' + divValue + ' text-center" id="check_firma_abogado<%= @contratosperproceso.id %>"><%= image_tag @contratosperproceso.firma_abogado_doc.url(:thumb) %><br/><div stye="text-aling: center">Supervisor</div></div>';
$('#check_firma_abogado<%= @contratosperproceso.id %>').html(htmlContent);
<% end %>
<% end %>