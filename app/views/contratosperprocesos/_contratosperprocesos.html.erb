<div class="row" id="codigo_otp<%= @contratospersona.id %>"></div>
<div id="pro_proceso<%= @contratospersona.id %>">
  <div class="box-header">
    <h3 class="box-title"><strong>Procesos</strong></h3>
    <div class="box-tools pull-right">
      <%# if is_auth_c('contratosperproceso') %>
      <%= link_to new_contratospersona_contratosperproceso_path(@contratospersona), id: 'new_contratosperproceso_button', class: 'btn btn-sm btn-warning', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
      <% end %>
      <%# end %>
    </div>
  </div>
  <% if !Contratosperfecha.where(contratospersona_id: @contratospersona.id, estado: 'ACTIVO').exists? %>
    <div class="alert alert-danger"><b><%= t :atencion %></b> NO hay un contrato activo.</div>
    <br/><br/>
  <% end %>
  <div class="box-body">
    <div class="flash_messages"></div>
    <div id="contratosperproceso_form" class="collapse"></div>
    <div id="contratosperprocesos">
      <% if @contratospersona.contratosperprocesos.where("estado != 'NO PROCEDE'").present? %>
        <%= render 'contratosperprocesos/tabla' %>
      <% else %>
        <div class="alert alert-danger">
          <h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %></div>
      <% end %>
    </div>
  </div>
</div>
