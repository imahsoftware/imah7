<% base_url = Rails.env.production? ? 'https://appasearesp.com' : 'http://localhost:3000' %>
<div align="center">
  <table table width="95%" border="0" cellpadding="0" cellspacing="0">
    <tr>
      <td>
        <table table width="100%" border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 16px; font-family: Tahoma; line-height: 150%;">
          <tr>
            <td style="border:1px solid #CCCCCC; font-size: 16px; font-family: Tahoma; text-align: center" width="35%" rowspan="3"><%= image_tag "#{@logo}", size: "280x120" %></td>
            <td style="border:1px solid #CCCCCC; font-size: 16px; font-family: Tahoma; text-align: center">
              <b><%= @porta.razon_social rescue nil %></b></td>
          </tr>
          <tr>
            <td style="border:1px solid #CCCCCC; font-size: 16px; font-family: Tahoma; text-align: center">
              <b>PROCESO DE RECURSO HUMANO</b></td>
          </tr>
          <tr>
            <td style="border:1px solid #CCCCCC; font-size: 16px; font-family: Tahoma; text-align: center">
              <b>PROCESO DISCIPLINARIO</b></td>
          </tr>
        </table>
        <br/>
        <table width="100%">
          <tr>
            <td>
              <div align="justify" style="font-size: 14px; font-family: Tahoma;">
                <br/>
                Medellin, <%= namedate(Time.now) rescue nil %>
                <br/><br/><br/><br/>
                Señor(a)<br/>
                <b><%= @contratosperproceso.contratospersona.nombre_completo rescue nil %></b><br/>
                <b><%= camponumerico2 @contratosperproceso.contratospersona.identificacion rescue nil %></b><br/>
                <b><%= @contratosperproceso.contratospersona.direccion rescue nil %></b><br/>
                <b><%= @contratosperproceso.contratospersona.correo rescue nil %></b><br/>
                <b><%= @porta.razon_social rescue nil %></b><br/>
                <br/><br/>
                <strong>ASUNTO:</strong> NOTIFICACION SANCION
                <br/><br/>
                <div align="justify" style="font-size: 14px; font-family: Tahoma;">
                  <% if @contratosperproceso.contratosperprodescargos.present?  %>
                    Después de analizados los descargos realizados el <%= namedate(@contratosperproceso.contratosperprodescargos.first.created_at.strftime("%d-%m-%Y").to_date) rescue nil %>
                    y vencido el termino para presentar alegatos de conclusión, se aplica la sanción
                    <b><%= @contratosperprosancion.sancion rescue nil %></b> por violar el Reglamento Interno de Trabajo&nbsp;<b><%= @contratosperprosancion.reglamento rescue nil %></b>
                  <% else %>
                    Despues de realizar el Acta de No Comparecencia y vencido el termino para presentar alegatos de conclusión, se aplica la sanción
                    <b><%= @contratosperprosancion.sancion rescue nil %></b> <% if @contratosperprosancion.desvinculacion.to_s == 'SI' %> a partir del
                      <strong><%= namedate(@contratosperprosancion.fecha_desvinculacion.strftime("%d-%m-%Y").to_date) rescue nil %></strong> <% end %>
                      por violar el Reglamento Interno de Trabajo&nbsp;<b><%= @contratosperprosancion.reglamento rescue nil %></b>
                  <% end %>
                  <br/><br/>
                  Atentamente;
                </div>
                <br/><br/>
                <table width="100%" border="0" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:0px 0px 0px 0px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
                  <tr>
                    <td width="49%" height="30" ALIGN="center"><strong>ABOGADO (A)</strong></td>
                    <td>&nbsp;</td>
                    <td width="49%" height="30" ALIGN="center"><strong>EMPLEADO</strong></td>
                  </tr>
                  <tr>
                    <td height="50" style="background: #E8E3E3;">
                      <% if @contratosperprosancion.codigo_firma.present? %>
                        <strong><%= @contratosperprosancion.user.nombre rescue nil %><br/>
                          <%= @porta.razon_social rescue nil %><br/></strong>
                        <b>FIRMA DIGITAL:</b> <%= @contratosperprosancion.codigo_firma %><br/>
                        <b>FECHA FIRMA:</b> <%= @contratosperprosancion.codigo_fecha.strftime("%d-%m-%Y %X") rescue nil %><br/>
                        <small>* Este documento fue generado con firma electrónica y cuenta con plena validez jurídica,
                          conforme a lo dispuesto en la Ley 527/99 y el decreto reglamentario 2364/12</small>
                      <% end %>
                    </td>
                    <td>&nbsp;</td>
                    <td>
                      <% if @contratosperprosancion.codigo_firma_empleado.present? %>
                        <strong><%= @contratosperproceso.contratospersona.nombre_completo rescue nil %><br/>
                          C.C <%= camponumerico @contratosperproceso.contratospersona.identificacion rescue nil %><br/></strong>
                        <b>FIRMA DIGITAL:</b> <%= @contratosperprosancion.codigo_firma_empleado %><br/>
                        <b>FECHA FIRMA:</b> <%= @contratosperprosancion.codigo_fecha_empleado.strftime("%d-%m-%Y %X") rescue nil %><br/>
                        <small>* Este documento fue generado con firma electrónica y cuenta con plena validez jurídica, conforme a lo dispuesto en la Ley 527/99 y el decreto reglamentario 2364/12</small>
                      <% else %>
                        <br/>_________________________________________<br/>
                        <%= @contratosperproceso.contratospersona.nombre_completo rescue nil %>
                        <br/>C.C <%= camponumerico @contratosperproceso.contratospersona.identificacion rescue nil %>
                      <% end %>
                    </td>
                  </tr>
                </table>

                <% if ['APERTURA DE PROCESO', 'LLAMADO DE ATENCION'].include?(@contratosperproceso.clase) %>
                  <% if @contratosperproceso.user_testigo1.present? || @contratosperproceso.user_testigo2.present? %>
                    <br/><br/>
                    <p style="font-size: 14px; font-family: Tahoma;">EN CASO DE SER NECESARIO</p>
                    <table width="100%" border="0" cellpadding="0" cellspacing="0">
                      <tr valign="top">
                        <% if @contratosperproceso.user_testigo1.present? %>
                          <td style="font-size: 14px; font-family: Tahoma;" width="45%">
                            <% if @contratosperproceso.user_testigo1.present? %>
                              <% if @contratosperproceso.firma_testigo1_doc_file_name.present? %>
                                <img src="<%= base_url + @contratosperproceso.firma_testigo1_doc.url(:thumb) %>" width="170" height="70"/><br/>
                                __________________________________<br/>
                              <% end %>
                              <%= User.find(@contratosperproceso.user_testigo1).nombre rescue nil %><br/>
                              <b>Cedula:</b> <%= User.find(@contratosperproceso.user_testigo1).identificacion rescue nil %>
                              <br/>
                              <b>Testigo</b>
                            <% end %>
                          </td>
                          <td>&nbsp;</td>
                        <% end %>
                        <% if @contratosperproceso.user_testigo2.present? %>
                          <td style="font-size: 14px; font-family: Tahoma;" width="45%">
                            <% if @contratosperproceso.user_testigo2.present? %>
                              <% if @contratosperproceso.firma_testigo2_doc_file_name.present? %>
                                <img src="<%= base_url + @contratosperproceso.firma_testigo2_doc.url(:thumb) %>" width="170" height="70"/><br/>
                                __________________________________<br/>
                              <% end %>
                              <%= User.find(@contratosperproceso.user_testigo2).nombre rescue nil %><br/>
                              <b>Cedula:</b> <%= User.find(@contratosperproceso.user_testigo2).identificacion rescue nil %>
                              <br/>
                              <b>Testigo</b>
                            <% end %>
                          </td>
                        <% end %>
                      </tr>
                    </table>
                  <% end %>
                <% end %>


              </div>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</div>