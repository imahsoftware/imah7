<div class="col-xs-12">
  <div class="callout callout-danger">
    <h4>Información!</h4>
    <p>
      Con el fin de concluir el proceso, se te enviara un mensaje de texto a tu teléfono celular con un código que
      deberás introducir para finalizar.</p>
  </div>
  <div class="box-body" style="margin-right: 10px;">
    <%= form_tag ws_otp_contratosperprocesos_path(contratosperproceso_id: @contratosperproceso.id, contratospersona_id: @contratospersona.id), remote: true, method: :post, class: 'form-inline' do %>
      <%= render 'menus/input_otp' %>
      <div class="row" id="mensaje<%= @contratospersona.id %>">
        <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2 text-center"></div>
      </div>
      <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 text-center">
          <%= button_tag type: 'submit', :disable_with => "Validando...", class: 'btn btn-primary', style: "height: 60px; border-radius: 5px; background-color: #d73925 !important; border-color: #d73925;" do %>
            Verificar Codigo
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>