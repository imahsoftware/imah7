<%= simple_form_for @tiposimagen, remote: true do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5">
        <%= f.input :descripcion, :input_html => {:onChange => "javascript:this.value=this.value.toUpperCase();"} %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
        <%= f.input :clase, as: :select, collection: select_claseimagen, input_html: { class: 'select2' } %>
      </div>

    </div>
    <div class="row">
      <div class="col-md-6">
        <% if @tiposimagen.new_record? %>
          <%= button_tag "#{t :cancelar}", type: 'button', data: { target: '#tiposimagen_form' }, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}", tiposimagen_path(@tiposimagen), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
<br/>
