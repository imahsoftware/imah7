<%= simple_form_for(@contratossolimagen) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.association :contratossolicitud %>
    <%= f.association :user %>
    <%= f.input :descripcion %>
    <%= f.input :solimagenes %>
  </div>

  <div class="form-actions">
    <%= f.button :submit %>
  </div>
<% end %>
