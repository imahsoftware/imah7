<div class="box-header">
  <h3 class="box-title"><strong>Sedes</strong></h3>
  <div class="box-tools pull-right">
    <%# if is_auth_c('empresassede') %>
      <%= link_to new_empresa_empresassede_path(@empresa), id: 'new_empresassede_button', class: 'btn btn-sm btn-info', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
      <% end %>
    <%# end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="empresassede_form" class="collapse"></div>
  <div id="empresassedes">
    <% if @empresa.empresassedes.present? %>
      <%= render 'empresassedes/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
    <% end %>
  </div>
</div>

