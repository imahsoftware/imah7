<%= simple_form_for(@migracionesrodamiento) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.association :user %>
    <%= f.association :archivo %>
    <%= f.input :estado %>
    <%= f.input :contrato_id %>
    <%= f.input :periodosliquidacion_id %>
    <%= f.input :identificacion %>
    <%= f.input :nombre %>
    <%= f.input :detalle %>
    <%= f.input :valor_dia %>
    <%= f.input :nro_dias %>
    <%= f.input :valor_total %>
  </div>

  <div class="form-actions">
    <%= f.button :submit %>
  </div>
<% end %>
