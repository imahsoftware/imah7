<p id="notice"><%= notice %></p>

<h1>Portafoliosconfiguraciones</h1>

<table>
  <thead>
    <tr>
      <th>Portafolio</th>
      <th>Descripcion</th>
      <th>Valor</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @portafoliosconfiguraciones.each do |portafoliosconfiguracion| %>
      <tr>
        <td><%= portafoliosconfiguracion.portafolio %></td>
        <td><%= portafoliosconfiguracion.descripcion %></td>
        <td><%= portafoliosconfiguracion.valor %></td>
        <td><%= link_to 'Show', portafoliosconfiguracion %></td>
        <td><%= link_to 'Edit', edit_portafoliosconfiguracion_path(portafoliosconfiguracion) %></td>
        <td><%= link_to 'Destroy', portafoliosconfiguracion, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Portafoliosconfiguracion', new_portafoliosconfiguracion_path %>
