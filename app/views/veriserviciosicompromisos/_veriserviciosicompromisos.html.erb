<div class="box-header">
  <h3 class="box-title"><strong>Compromisos</strong></h3>
  <div class="box-tools pull-right">
    <%= link_to new_veriserviciositem_veriserviciosicompromiso_path(@veriserviciositem), id: 'new_veriserviciosicompromiso_button', class: 'btn btn-sm btn-info', remote: true do %>
      <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
    <% end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="veriserviciosicompromiso_form" class="collapse"></div>
  <div id="veriserviciosicompromisos">
    <% if @veriserviciositem.veriserviciosicompromisos.present? %>
      <%= render 'veriserviciosicompromisos/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %>
      </div>
    <% end %>
  </div>
</div>

