<tr id="contratosmaquinaria_<%= contratosmaquinaria.id %>">
  <td class="text-center">
    <% if is_auth_e("contratosmaquinaria")%>
      <%= link_to edit_contrato_contratosmaquinaria_path(@contrato, contratosmaquinaria), remote: true, class: 'edit_contratosmodificacion_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
        <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
      <% end %>
    <% end %>
    <% if is_auth_e("contratosmaquinaria2")%>
    <% #if Contratossoldetalle.exists?(contratosmaquinaria_id: contratosmaquinaria.id) == false %>
      <%= link_to contrato_contratosmaquinaria_path(@contrato, contratosmaquinaria), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
         <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
      <% end %>
    <% end %>
    <button class="btn btn-xs btn-info"><span data-toggle="tooltip" data-html="true" data-original-title="<div align='left'><%= contratosmaquinaria.user_nombre.html_safe rescue nil %><%= contratosmaquinaria.user_actnombre.html_safe rescue nil %></div>"><i class="fa fa-user" aria-hidden="true"></i></span></button>
  </td>
  <td align="left"><%= contratosmaquinaria.insumo.insumodetalle rescue nil %>
  <br/><small><%= contratosmaquinaria.insumo.especificacion rescue nil %></small></td>
  <td align="center"><%= camponumerico contratosmaquinaria.cantidad_mensual rescue nil %></td>
  <td align="right"><%= camponumerico contratosmaquinaria.total rescue nil %></td>
</tr>

