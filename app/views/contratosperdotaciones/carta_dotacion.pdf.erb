
<%
  data = object1 rescue nil
  if data.present?
    @contratosperdotacion = Contratosperdotacion.find(data) rescue nil
    @contratosperfecha = @contratosperdotacion.contratosperfecha rescue nil
  end
  contratospersona = @contratosperdotacion.contratospersona rescue nil
  portafolio = Portafolio.find(@contratosperdotacion.contrato.empresa.portafolio_id)
  @logo = portafolio.logo_empresa_assets
%>
<div align="center">
  <table width="85%">
    <tr>
      <td height="50px">
        <div align="right"><%= image_tag "#{@logo}", size: "280x120" %></div>
      </td>
    </tr>
    <tr>
      <td>
        <div align="justify" style="font-size: 16px; font-family: Verdana, Geneva, sans-serif;">
          <br/>
          Medellin, <%= namedate(@contratosperdotacion.updated_at) rescue nil %>
          <br/><br/><br/>
          Señores<br/>
          <strong><%= @contratosperfecha.contrato.empresa.nombre rescue nil %></strong><br/>
          <br/><br/>
          <strong>ASUNTO:</strong> Entrega de dotación
          <br/><br/>
          <table width="100%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
            <tr>
              <td width="40%" height="20" style="background: #E8E3E3; font-family: Tahoma"><strong>NOMBRE DEL TRABAJADOR: </strong></td>
              <td>&nbsp;<%= contratospersona.nombre_completo rescue nil %></td>
            </tr>
            <tr>
              <td height="20" style="background: #E8E3E3; font-family: Tahoma"><strong>IDENTIFICACION DEL TRABAJADOR: </strong></td>
              <td>&nbsp;<%= camponumerico2(contratospersona.identificacion) rescue nil %></td>
            </tr>
            <tr>
              <td height="20" style="background: #E8E3E3; font-family: Tahoma"><strong>CARGO: </strong></td>
              <td>&nbsp;<%= @contratosperfecha.contratoscargo.perfil rescue nil %></td>
            </tr>
          </table>
          <br/>
          <table width="100%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
            <tr>
              <th style="background: #E8E3E3; font-family: Tahoma">PANTALON</th>
              <th height="20" style="background: #E8E3E3; font-family: Tahoma">CAMISA</th>
              <th style="background: #E8E3E3; font-family: Tahoma">ZAPATOS</th>
            </tr>
            <tr>
              <td style="padding: 5px; font-family: Tahoma">
                <div align="center">
                  <% if contratospersona.cant_pantalon.to_i == 0 or contratospersona.talla_pantalon.to_s == 'NO APLICA'%>NO APLICA<% else %>
                    1 PANTALON TALLA <%= contratospersona.talla_pantalon rescue nil %>
                    <% if @contratosperdotacion.pantalon == 'SI' %>
                      <br/><b>ENTREGADO</b>
                    <% else %>
                      <br/><b>PENDIENTE</b>
                    <% end %>
                  <% end %>
                </div>
              </td><td height="20" style="padding: 5px; font-family: Tahoma">
                <div align="center">
                  <% if contratospersona.cant_camisa.to_i == 0 or contratospersona.talla_camisa.to_s == 'NO APLICA'%>NO APLICA<% else %>
                    1 CAMISA TALLA <%= contratospersona.talla_camisa rescue nil %>
                    <% if @contratosperdotacion.camisa == 'SI' %>
                      <br/><b>ENTREGADO</b>
                    <% else %>
                      <br/><b>PENDIENTE</b>
                    <% end %>
                  <% end %>
                </div>
              </td>
              <td style="padding: 5px; font-family: Tahoma">
                <div align="center">
                  <% if contratospersona.cant_zapatos.to_i == 0 or contratospersona.talla_zapatos.to_s == 'NO APLICA'%>NO APLICA<% else %>
                    <%= contratospersona.zapatos rescue nil %> (1 PAR TALLA <%= contratospersona.talla_zapatos rescue nil %>)
                    <% if @contratosperdotacion.zapatos == 'SI' %>
                      <br/><b>ENTREGADO</b>
                    <% else %>
                      <br/><b>PENDIENTE</b>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          </table>
          <br/>
          <% if @contratosperdotacion.contratosperdotadicionales.present? %>
            <legend style="padding: 5px; font-family: Tahoma"><b>Elementos Adicionales</b></legend>
            <table width="100%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
              <tr>
                <th height="20" style="background: #E8E3E3; font-family: Tahoma; text-align: left">ELEMENTO</th>
                <th width="20%" style="background: #E8E3E3; font-family: Tahoma">CANTIDAD</th>
              </tr>
              <% @contratosperdotacion.contratosperdotadicionales.each do |contratosperdotadicional| %>
                <tr>
                  <td height="20" style="padding: 5px; font-family: Tahoma">
                    <%= contratosperdotadicional.elemento rescue nil %>
                  </td>
                  <td style="padding: 5px; text-align: center">
                    <%= contratosperdotadicional.cantidad rescue nil %>
                  </td>
                </tr>
              <% end %>
            </table>
          <% end %>

          <br/><br/><br/>
          Atentamente,
          <br/><br/><br/>
          <table width="100%" border="0" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:0px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
            <tr>
              <td width="40%" height="30" ALIGN="center"><strong>&nbsp;</strong></td>
              <td>&nbsp;</td>
              <td width="55%" height="30" ALIGN="center"><strong>CONFIRMO RECIBIDO - EL TRABAJADOR</strong></td>
            </tr>
            <tr>
              <td height="50" style="background: #E8E3E3; font-family: Tahoma; padding: 10px;">
                <% if @contratosperdotacion.codigo_entrega.present? %>
                <%= @contratosperdotacion.user.nombre rescue nil %><br/>
                <b>FIRMA DIGITAL:</b> <%= @contratosperdotacion.codigo_entrega rescue nil %><br/>
                <b>FECHA FIRMA:</b> <%= @contratosperdotacion.fecha_entrega rescue nil %><br/><br/>
                <% else %>
                  <b>PENDIENTE DE FIRMAR</b><br/>
                <% end %>
                * Este documento fue generado con firma electrónica y cuenta con plena validez jurídica, conforme a lo
                dispuesto en la Ley 527/99 y el decreto reglamentario 2364/12
              </td>
              <td>&nbsp</td>
              <td height="50" style="background: #E8E3E3; font-family: Tahoma; padding: 10px;">
                <% if @contratosperdotacion.codigo_firma.present? %>
                  <%= contratospersona.nombre_completo rescue nil %><br/>
                  <b>CC:</b> <%= camponumerico2(contratospersona.identificacion) rescue nil %><br/>
                  <b>FIRMA DIGITAL:</b> <%= @contratosperdotacion.codigo_firma rescue nil %><br/>
                  <b>FECHA FIRMA:</b> <%= @contratosperdotacion.codigo_fecha rescue nil %><br/>
                  <b>CARGO:</b> <%= @contratosperfecha.contratoscargo.perfil rescue nil %><br/><br/>
                  * Este documento fue generado con firma electrónica y cuenta con plena validez jurídica, conforme a lo
                  dispuesto en la Ley 527/99 y el decreto reglamentario 2364/12
                <% else %>
                  <br/><br/><br/>
                  <b>PENDIENTE DE FIRMAR</b><br/>
                  <%= contratospersona.nombre_completo rescue nil %><br/>
                  <b>CC:</b> <%= camponumerico2(contratospersona.identificacion) rescue nil %><br/>
                  <b>CARGO:</b> <%= @contratosperfecha.contratoscargo.perfil rescue nil %><br/>
                <% end %>
              </td>
            </tr>
          </table>
        </div>
      </td>
    </tr>
  </table>
</div>