<div class="box-body paddin-body">
  <div class="row">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title"> Evaluados (Supervisores y otros) (<%= @evaluacion.evaluacionescontratos.count.to_i rescue nil %>)
            <% if @evaluacion.estado == 'PENDIENTE' and @evaluacion.tipo == 'EVALUACION DESEMPENO' %>
              <%= link_to incluirtodos_evaluaciones_path(evaluacion_id: @evaluacion.id, clase: 'I'), data: { toggle: 'tooltip', confirm: "Estas Seguro que desea incluirlos todos?" }, title: "Cargar todos los supervisores" do %>
                <button class="btn btn-xs btn-success"><i class="fa fa-check"></i> Incluir Todos</button>
              <% end %>
              - <%= link_to incluirtodos_evaluaciones_path(evaluacion_id: @evaluacion.id, clase: 'E'), data: { toggle: 'tooltip', confirm: "Estas Seguro que desea eliminar todos los que no tengan procesos?" }, title: "Eliminar todos los registrados" do %>
                <button class="btn btn-xs btn-danger"><i class="fa fa-check"></i> Eliminar Todos</button>
              <% end %>
            <% end %>
            <div class="pull-right">
              <% if @evaluacion.estado == 'PENDIENTE' and @evaluacion.tipo == 'EVALUACION DESEMPENO' %>
                <%= link_to new_evaluacion_evaluacionescontrato_path(@evaluacion), id: 'new_evaluacionescontrato_button', class: 'btn btn-sm btn-warning', remote: true do %>
                  <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
                <% end %>
              <% end %>
            </div>
          </h3>
        </div>

        <div class="card-body">
          <div id="evaluacionescontrato_form" class="collapse"></div>
          <div id="evaluacionescontratos" style="margin-top: 10px;">
            <% if @evaluacion.evaluacionescontratos.any? %>
              <%= render 'evaluacionescontratos/tabla' %>
            <% else %>
              <%= render 'layouts/procesos/alert_message' %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

