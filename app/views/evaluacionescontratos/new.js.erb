<% if @active_record.present? %>
	$("#evaluacionescontrato_<%= @active_record.id %>").replaceWith("<%= j render 'tr', evaluacionescontrato: @active_record %>");
<% end %>

$("#evaluacionescontrato_form").html("<%= j render 'form' %>");
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
$("#evaluacionescontrato_form").collapse("show");

// Selector normal
$(document).ready(function () {
    $('.js-searchable').select2({
        allowClear: true,
        width: '100%',
        placeholder: '-- Seleccionar --'
    });
});

/// Calendario
$(".datetimepicker").datetimepicker({
    showClear: true
});


/// Convierte texto en mayuscula
$('.uppercaseInput').keyup(function () {
    $(this).val($(this).val().toUpperCase());
});

$(".select2").select2();



$(function () {
    return $('.select2Ciudad').select2({
        minimumInputLength: 3,
        maximumInputLength: 20,
        placeholder: "[ Seleccionar Ciudad... ]",
        ajax: {
            url: '/evaluaciones/search.json',
            dataType: 'json',
            delay: 250,
            data: function (params) {
                return {
                    q: params.term,
                    page: params.page
                };
            },
            processResults: function (data) {
                return {
                    results: $.map(data, function (item) {
                        return {
                            text: item.name,
                            id: item.id
                        };
                    })
                };
            }
        }
    });
});
$('.wysihtml5').wysihtml5();

$('.datepicker').datepicker({
    dayNamesMin: [ "Dom", "Lun", "Mar", "Mie", "Jue", "Vie", "Sáb" ],
    monthNamesShort: [ "Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic" ],
    dateFormat: "yy-mm-dd",
    yearRange: '2000:2027',
    changeMonth: true,
    changeYear: true,
});