$("#otp<%= @evaluacion.id %> .modal-content").html('<%= j render "evaluacionescontratos/otp" %>');
$("#otp<%= @evaluacion.id %> ").modal();

$(".alert_flash").fadeOut(1000, function() {
    $(this).remove();
});

