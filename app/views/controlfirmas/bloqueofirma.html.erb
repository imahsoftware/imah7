

<legend style="margin-top: -19px;">Hola que tal !!!! <%=@userbloqueo.nombre rescue nil %></legend>
<div class="alert alert-danger">Hasta que no se completen los siguientes procesos no puedes ingresar al sistema... si ya lo hicieron pulsa <%= link_to root_path do %>Aqui<% end %> para verificar nuevamente...</div>
<% if @contratossinfirmar.present? %>
  <div class="box box-danger">
    <div class="box-body">
      <legend>Contratos sin Firmar !!!! (<%=@contratossinfirmar_cantidad rescue nil %>)</legend>
      <% if @contratossinfirmar.present? %>
          <table class="table table-bordered table-condensed table-striped">
            <thead>
            <tr class="thcolor">
              <th width="25%" class="text-left">Empresa</th>
              <th width="40%" class="text-left">Colaborador</th>
              <th class="text-center">Movil</th>
              <th width="20%" class="text-center">Fecha Inicio Contrato</th>
            </tr>
            </thead>
            <tbody>
            <% @contratossinfirmar.each do |a| %>
                <tr>
                  <td class="text-left" style="font-size:10px;"><%=a.nombre rescue nil %></td>
                  <td class="text-left" style="font-size:10px;"><%=a.nombre_completo rescue nil %></td>
                  <td class="text-center" style="font-size:10px;"><%=a.movil rescue nil %></td>
                  <td class="text-center" style="font-size:10px;"><%=a.fecha_inicio rescue nil %></td>
                </tr>
            <% end %>
            </tbody>
          </table>
      <% else %>
        <div class="alert alert-success">Ufff No hay,, que bien!</div>
      <% end %>
    </div>
  </div>
<% end %>

<% if @docsinfirmar.present? %>
  <div class="box box-info">
    <div class="box-body">
      <legend>Documentos sin Firmar !!!! (<%=@docsinfirmar_cantidad rescue nil %>)</legend>
      <% if @docsinfirmar.present? %>
