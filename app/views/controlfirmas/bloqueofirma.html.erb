              <td class="text-left" style="font-size:10px;"><%=a.nombre rescue nil %></td>
              <td class="text-left" style="font-size:10px;"><%=a.nombre_completo rescue nil %></td>
              <td class="text-center" style="font-size:10px;"><%=a.tipo_documento rescue nil %></td>
              <td class="text-center" style="font-size:10px;"><%=a.movil rescue nil %></td>
              <td class="text-center" style="font-size:10px;"><%=a.fecha_solicitud_firma.strftime("%Y-%m-%d %X") rescue nil %></td>
            </tr>
          <% end %>
          </tbody>
        </table>
