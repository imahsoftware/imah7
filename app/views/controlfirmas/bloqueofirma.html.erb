<% end %>

<% if @compromisos.present? %>
  <div class="box box-info">
    <div class="box-body">
      <legend>Compromisos de Contratacion No Atendidos !!!! (Muchos!!!)
        <% if [4998,15910,4561,10430].include?(@userbloqueo.id) %>
          <%= link_to informe_datas_path(infgrupo_id: 102, portafolio_id: 'PENDIENTE', format: :xlsx), data: { toggle: 'tooltip' }, title: "Informe Compromisos" do %>
            <button class="btn btn-xs btn-info"><i class="fa fa-file-excel-o"></i> Generar Informe
            </button>
          <% end %>
        <% end %>
      </legend>
        <table class="table table-bordered table-condensed table-striped">
          <thead>
          <tr class="thcolor">
            <td width="5%" ></td>
            <th width="20%" class="text-left">Empresa</th>
            <th width="25%" class="text-left">Colaborador</th>
            <th class="text-center">Documento Pendiente</th>
            <th class="text-center">Movil</th>
            <th width="20%" class="text-center">Fecha Solicitud</th>
          </tr>
          </thead>
          <tbody>
          <% @compromisos.each do |a| %>
            <tr>
              <td>
                <% if a.imagen.to_s == 'X' %>
                  <%= link_to ver_documentos_compromisos_path(compromiso_id: a.id), remote: true, data: { toggle: 'tooltip' }, title: "Ver Documentos del Compromiso" do %>
                    <button class="btn btn-xs btn-success"><i class="fa fa-file-pdf-o"></i></button>
                  <% end %>
                <% end %>
              </td>
              <td class="text-left" style="font-size:10px;"><%=a.nombre rescue nil %></td>
              <td class="text-left" style="font-size:10px;"><%=a.nombre_completo rescue nil %></td>
              <td class="text-center" style="font-size:10px;"><%=a.tipo_documento rescue nil %></td>
              <td class="text-center" style="font-size:10px;"><%=a.movil rescue nil %></td>
              <td class="text-center" style="font-size:10px;"><%=a.fecha_solicitud_firma.strftime("%Y-%m-%d") rescue nil %></td>
            </tr>
          <% end %>
          </tbody>
        </table>
    </div>
  </div>
<% end %>

