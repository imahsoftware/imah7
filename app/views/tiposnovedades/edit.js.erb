$("#tiposnovedad_form").collapse("hide");

$("#tiposnovedad_form").empty();

<% if @active_record.present? %>
	$("#tiposnovedad_<%= @active_record.id %>").replaceWith("<%= j render 'tr', tiposnovedad: @active_record %>");
<% end %>

$("#tiposnovedad_<%= @tiposnovedad.id %>").html("<td colspan='12'><%= j render 'form' %></td>");

$("#tiposnovedad_<%= @tiposnovedad.id %>").addClass("active_tiposnovedad");
$(".datetimepicker").datetimepicker();
$(".select2").select2();

$(".tooltip").tooltip("hide");

$('[data-toggle="tooltip"]').tooltip();