<%= simple_form_for @tiposnovedad, remote: true do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
        <%= f.input :codigo, :input_html => {:onChange => "javascript:this.value=this.value.toUpperCase();"} %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
        <%= f.input :descripcion, :input_html => {:onChange => "javascript:this.value=this.value.toUpperCase();"} %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
        <%= f.input :tipo, as: :select, collection: select_tiponovedad, input_html: { class: 'select2' } %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
        <%= f.input :estado, as: :select, collection: select_estado, input_html: { class: 'select2' } %>
      </div>
    </div>
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
        <%= f.input :porcentaje, :input_html => {:onChange => "javascript:this.value=this.value.toUpperCase();"} %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
        <%= f.input :multiplica, as: :select, collection: select_sino, input_html: { class: 'select2' }, label: "Dias por horas?" %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3">
        <%= f.input :incluye_vacaciones, as: :select, collection: select_sino, input_html: { class: 'select2' }, label: "Incluye para vacaciones?" %>
      </div>
    </div>
    <legend>Aportes en linea</legend>
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <%= f.input :tiposnaporte_id, collection: Tiposnaporte.order(:descripcion).collect {|p| [ p.descripcionampliada, p.id ] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: "Tipo de novedad Aportes en Linea"%>
      </div>
    </div>
    <div class="row">
      <div class="col-md-6">
        <% if @tiposnovedad.new_record? %>
          <%= button_tag "#{t :cancelar}", type: 'button', data: { target: '#tiposnovedad_form' }, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}", tiposnovedad_path(@tiposnovedad), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
<br/>