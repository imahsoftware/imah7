<%= simple_form_for(@formato) do |f| %>
  <div class="box box-danger">
    <div class="box-header">
      <legend>
        <%= link_to formatos_path, data: { toggle: 'tooltip' }, title: 'Regresar' do %>
          <i class="fa fa-arrow-left fa-fw text-success" aria-hidden="true"></i>
        <% end %>
        Información Básica del Formato
      </legend>
    </div>
    <div class="box-body">
      <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
          <%= f.input :nombre, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: 'Nombre' %>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
          <%= f.input :leyenda, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: 'Texto Encabezado Generacion' %>
        </div>
      </div>
      <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
          <%= f.input :segmento, collection: Iparametro.where("campo = 'segmento_formato'").order(:descripcion).collect { |p| [p.descripcion.to_s, p.descripcion.to_s] }, input_html: { class: 'select2' }, as: :select, include_blank: true %>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :estado, as: :select, collection: select_estado, input_html: { class: 'select2' } %></div>
        <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
          <%= f.input :contratosperfecha_id, collection: Contratosperfecha.includes([:contratospersona]).order("id desc").limit(59).collect {|p| [ p.contratospersona.autobuscar, p.id ] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: 'Prueba testing'%>
        </div>
      </div>
    </div>
    <div class="box-footer">
      <div class="box-tools pull-left">
        <% if Iparametrosformato.find_by(formato_id: @formato.id).present? %>
          <small>** Asociado al tipo de contrato:
          <% Iparametrosformato.where(formato_id: @formato.id).each do |a| %>
            <%=a.iparametro.descripcion.to_s rescue nil %>,&nbsp;
            <% end %></small>
        <% end %>
      </div>
      <div class="box-tools pull-right">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div><!-- /.box-tools -->
    </div>
  </div>
<% end %>
