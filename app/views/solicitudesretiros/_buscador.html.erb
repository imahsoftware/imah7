<div style="font-size: 3rem"><b>Buscador de liquidaciones</b></div>
<div style="padding: 10px;">
  <div class="box-header">
    <%= form_tag search_solicitudesretiros_path, method: :post, remote: true do %>
      <div class="row">
        <div class="col-xs-12 col-ms-7 col-md-3 col-lg-3"></div>
        <div class="col-xs-12 col-ms-7 col-md-4 col-lg-4"><b style="color: red;">*</b>
          <b>Identificacion / Nombre del Empleado</b><br/>
          <div class="form-group input-group" style="padding-bottom: 10px;">
            <span class="input-group-addon"><i class="fa fa-user-secret"></i></span>
            <%= text_field_tag :dato, params[:dato], class: 'form-control uppercaseInput', autocomplete: 'off', style: "width: 100%", placeholder: 'Identificacion / Nombre' %>
          </div>
        </div>
        <div class="col-xs-12 col-ms-7 col-md-5 col-lg-5" style="padding-top: 20px;">
          <%= button_tag type: 'submit', class: 'btn btn-primary', data: { toggle: 'tooltip' }, title: 'Buscar' do %>
            <i class="fa fa-search" aria-hidden="true"></i> Buscar
          <% end %>
        </div>
        <div class="col-xs-12 col-ms-7 col-md-1 col-lg-1"></div>
      </div>
    <% end %>
    <div id="buscador2"></div>
  </div>
</div>