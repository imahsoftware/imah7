$(".alert_flash").fadeOut(300, function () {
    $(this).remove();
});
<% if @ruta == 'X' and @visitascompromiso.obs_atencion.present? %>
window.location.href = '<%= visitas_path %>';
<% else %>
$("#visitascompromiso_<%= @visitascompromiso.id %>").replaceWith("<%= j render 'tr', visitascompromiso: @visitascompromiso %>");
<% end %>


$('[data-toggle="tooltip"]').tooltip();

$(".flash_messages").html("<%= j render 'layouts/flash_messages' %>");

setTimeout(function () {
    $(".alert_flash").fadeOut(300, function () {
        $(this).remove();
    });
}, 5000);
