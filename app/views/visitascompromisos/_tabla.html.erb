<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
	  <thead class="thcolor">
      <tr>
        <td width="10%"></td>
        <th width="15%" class="text-left text-table">Fecha</th>
        <th class="text-center text-table" width="12%">Fecha Compromiso</th>
				<th class="text-center text-table" width="10%">Estado</th>
				<th class="text-left text-table">Compromiso</th>
      </tr>
    </thead>
	  <tbody id="tbody_visitascompromisos">
	    <% @visita.visitascompromisos.order(id: :desc).each do |visitascompromiso| %>
	      <%= render 'visitascompromisos/tr', visitascompromiso: visitascompromiso %>
	    <% end %>
	  </tbody>
	</table>
</div>



