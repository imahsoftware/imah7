$("#visitascompromiso_form").collapse("hide");

$("#visitascompromiso_form").empty();

<% if @active_record.present? %>
	$("#visitascompromiso_<%= @active_record.id %>").replaceWith("<%= j render 'tr', visitascompromiso: @active_record %>");
<% end %>

$("#visitascompromiso_<%= @visitascompromiso.id %>").html("<td colspan='12'><%= j render 'form' %></td>");

$("#visitascompromiso_<%= @visitascompromiso.id %>").addClass("active_visitascompromiso");

$(".select2").select2();

$(".tooltip").tooltip("hide");

$('[data-toggle="tooltip"]').tooltip();
$(".datetimepicker").datetimepicker();
$('.datepicker').datepicker({
    dayNamesMin: [ "Dom", "Lun", "Mar", "Mie", "Jue", "Vie", "Sáb" ],
    monthNamesShort: [ "Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic" ],
    dateFormat: "yy-mm-dd",
    yearRange: '2000:2027',
    changeMonth: true,
    changeYear: true,
});