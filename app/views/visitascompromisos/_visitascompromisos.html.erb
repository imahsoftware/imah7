<div class="box-header">
  <h3 class="box-title"><strong>Compromisos</strong></h3>
  <div class="box-tools pull-right">
    <% if @visita.finalizacion.blank? %>
    <%# if is_auth_c('visitascompromiso') %>
      <%= link_to new_visita_visitascompromiso_path(@visita), id: 'new_visitascompromiso_button', class: 'btn btn-sm btn-info', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
      <% end %>
    <%# end %>
    <% end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="visitascompromiso_form" class="collapse"></div>
  <div id="visitascompromisos">
    <% if @visita.visitascompromisos.present? %>
      <%= render 'visitascompromisos/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
    <% end %>
  </div>
</div>

