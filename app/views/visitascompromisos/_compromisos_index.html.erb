<% if userVisita.visitascompromisos.where("estado = 'PENDIENTE'").present? %>
  <table class="table table-bordered table-condensed table-striped">
    <thead class="thcolor">
    <tr>
      <td width="5%"></td>
      <th width="12%" class="text-center text-table">Fecha Inicio Visita</th>
      <th class="text-left text-table" width="35%">Empresa - Contrato</th>
      <th class="text-left text-table">Compromiso</th>
    </tr>
    </thead>
    <tbody id="tbody_visitascompromisos">
    <% userVisita.visitascompromisos.where("estado = 'PENDIENTE'").order(id: :desc).each do |visitascompromiso| %>
      <tr id="visitascompromiso_<%= visitascompromiso.id %>">
        <td class="text-center">
          <%= link_to compromisos_visitascompromisos_path(id: visitascompromiso.id, identnombre: identnombre, nro_contrato: nro_contrato, userVisita: userVisita), remote: true, data: { toggle: 'tooltip' }, title: "Cerrar Proceso de Compromiso" do %>
            <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
          <% end %>
          <%= link_to documento_visitascompromisos_path(id: visitascompromiso.id), remote: true, data: { toggle: 'tooltip' }, title: "Cargar Documentos Digitales" do %>
            <button class="btn btn-xs btn-primary"><i class="fa fa-file-pdf-o"></i></button>
          <% end %>
        </td>
        <td align="center" class="text-table"><%= visitascompromiso.visita.created_at.strftime("%d/%m/%Y %X") rescue nil %></td>
        <td align="left" class="text-table"><%= visitascompromiso.visita.identnombre rescue nil %> <br/><strong>Contrato
          Nro: </strong><%= visitascompromiso.visita.nro_contrato rescue nil %></td>
        <td align="left" class="text-table"><%= visitascompromiso.compromiso rescue nil %>
          <% if visitascompromiso.visitasdocs.present? %>
            <div style="padding: 10px">
              <em><b><i class="fa fa-file-pdf-o"></i> Documentos Digitales</b></em>
              <hr style="margin: 4px;">
              <table class="table table-bordered table-condensed table-striped">
                <thead class="thcolor">
                <tr>
                  <td width="5%"></td>
                  <th width="25%" class="text-left text-table">Tipo</th>
                  <th class="text-left text-table">Documentos</th>
                </tr>
                </thead>
                <tbody id="tbody_visitasdocs">
                <% visitascompromiso.visitasdocs.order(id: :desc).each do |visitasdoc| %>
                  <tr id="visitasdoc_<%= visitasdoc.id %>">
                    <td class="text-center">
                      <% if visitasdoc.visita.finalizacion.blank? %>
                        <% if ['ANTES', 'DESPUES'].exclude?(visitasdoc.tipo) %>
                          <%= link_to visita_visitasdoc_path(visitasdoc.visita, visitasdoc), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
                            <i class="fa fa-trash text-red"></i>
                          <% end %>
                        <% end %>
                      <% end %>
                    </td>

                    <td align="left" class="text-table">
                      <%= visitasdoc.tipo_descripcion rescue nil %>
                    </td>
                    <td align="left" class="text-table">
                      <%= link_to visitasdoc.docvisita.url(:original, false), data: { toggle: 'tooltip' }, title: "Ver Documento", onclick: 'window.open(this.href,"new_window","height=450,width=600,scrollbars=yes");return false;' do %>
                        <i class="fa fa-cloud-download"></i> <%= visitasdoc.docvisita_file_name rescue nil %>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
                </tbody>
              </table>
            </div>
          <% end %>
        </td>
      </tr>
      <div class="modal fade" id="compromisos<%= visitascompromiso.id %>">
        <div class="modal-dialog modal-dialog-responsive" role="document">
          <div class="modal-content"></div>
        </div>
      </div>
      <div class="modal fade" id="documentos<%= visitascompromiso.id %>">
        <div class="modal-dialog modal-dialog-responsive" role="document">
          <div class="modal-content"></div>
        </div>
      </div>
    <% end %>
    </tbody>
  </table>
<% else %>
  <div class="alert alert-warning">
    <h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %>
  </div>
<% end %>