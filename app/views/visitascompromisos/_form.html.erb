<%= simple_form_for([@visita, @visitascompromiso], remote: true) do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :fecha, as: :string, input_html: { class: 'datepicker', data: {date_options: {format: 'DD/MM/YYYY', ignoreReadonly: true}}, readonly: true } %></div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :estado, as: :select, collection: select_estadoCompromiso, input_html: { class: 'select2' } %></div>
      <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
        <%= f.input :compromiso, as: :text, input_html: {:onchange => "javascript:this.value=this.value.toUpperCase();"} %>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <% if @visitascompromiso.new_record? %>
          <%= button_tag "#{t :cancelar}", type: 'button', data: {target: '#visitascompromiso_form'}, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}", visita_visitascompromiso_path(@visita, @visitascompromiso), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
<br/>