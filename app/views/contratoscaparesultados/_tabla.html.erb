<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
	  <thead class="thcolor">
      <tr>
        <td width="5%"></td>
        <th class="text-left">Fecha</th>
        <th width="80%" class="text-justify">Usuario Asignado</th>
      </tr>
    </thead>
	  <tbody id="tbody_contratoscaparesultados">
	    <% @contratoscapacitacion.capacitacion.contratoscaparesultados.where("ruta = 'B'").order(id: :desc).each do |contratoscaparesultado| %>
	      <%= render 'contratoscaparesultados/tr', contratoscaparesultado: contratoscaparesultado %>
	    <% end %>
	  </tbody>
	</table>
</div>
