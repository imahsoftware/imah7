<%= simple_form_for([@contrato, @contratosprefcredito], remote: true) do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-6 col-lg-4"><%= f.input :contratosprefactura_id, collection: @contrato.contratosprefacturas.where(["estado = 'APROBADO' and saldo > 0"]).order(:id).collect {|p| [ p.detalleprefa, p.id ] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: "Factura"%></div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :fecha, as: :string, input_html: { class: 'datepicker', data: {date_options: {format: 'DD/MM/YYYY', ignoreReadonly: true}}, readonly: true } %></div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :valor, as: :moneda %></div>
      <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
        <%= f.input :observacion, as: :text,:input_html => {:onchange => "javascript:this.value=this.value.toUpperCase();", :rows => 2 } %>
      </div>
    </div>
    <div class="row">
      <div class="col-md-6">
        <% if @contratosprefcredito.new_record? %>
          <%= button_tag "#{t :cancelar}", type: 'button', data: {target: '#contratosprefcredito_form'}, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}", contrato_contratosprefcredito_path(@contrato, @contratosprefcredito), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
<br/>
