<tr id="veriserviciosinota_<%= veriserviciosinota.id %>">
  <td class="text-center">
    <%= link_to veriserviciositem_veriserviciosinota_path(@veriserviciositem, veriserviciosinota), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
      <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
    <% end %>
  </td>
  <td align="left" class="text-table"><%= veriserviciosinota.created_at.strftime("%Y-%m-%d %X") rescue nil %><br/>
    <%= veriserviciosinota.user.nombre rescue nil %></td>
  <td align="left" class="text-table"><%= veriserviciosinota.observacion rescue nil %></td>
</tr>
