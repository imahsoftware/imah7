<%
  unless @portafolio.present?
    @portafolio = portafolio
   end
%>

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Document</title>
  <style>
      .center {
          text-align: center;
      }
  </style>
</head>
<body class="center">
<br/>
<div align="center">
  <table width="80%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
    <tr>
      <th width="50%" align="center" style="padding: 5px; font-size: 10px; font-family: Tahoma;">
        Revisado por:<br/>
        <%=@portafolio.revisado_informe.to_s rescue nil %> (<%=@portafolio.razon_social.to_s rescue nil %>)
      </th>
      <th align="center" style="padding: 5px; font-size: 10px; font-family: Tahoma;">
        Aprobado por:<br/>
        <%=@portafolio.aprobado_informe.to_s rescue nil %> (<%=@portafolio.razon_social.to_s rescue nil %>)
      </th>
    </tr>
  </table>
</div>
</body>
</html>
