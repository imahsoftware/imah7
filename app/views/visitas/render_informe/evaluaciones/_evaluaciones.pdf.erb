<br/>
<table width="100%" border="0" cellpadding="0" cellspacing="0" style="font-size: 10px; font-family: Tahoma;" id="sample">
  <tr>
    <th style="font-size: 12px; font-family: Tahoma;">
      <div align="left">EVALUACIONES DE DESEMPEÑO EN EL PERIODO <%= @mes rescue nil %> - <b>Total: (<%= @evaluaciones.count rescue 0 %>)</b></div>
    </th>
  </tr>
</table>
<hr>
<% if @evaluaciones.present? %>
  <table width="100%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
    <tr>
      <th width="30%" style="background: #E8E3E3; padding: 5px; font-size: 10px; font-family: Tahoma;"><div align="left"><strong>Empleado</strong></div></th>
      <th width="15%" style="background: #E8E3E3; padding: 5px; font-size: 10px; font-family: Tahoma;"><div align="left"><strong>Fecha Evaluación</strong></div></th>
    </tr>
    <% @evaluaciones.each do |evaluacion| %>
      <tr>
        <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px; padding: 3px;"><%= User.(evaluacion.user_responsable).nombre rescue nil %></td>
        <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px; padding: 3px;"> <%= evaluacion.created_at.strftime("%d/%m/%Y") rescue nil %></td>
      </tr>
    <% end %>
  </table>
<% else %>
  <div align="left" style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px;">No hay
    informacion
  </div>
<% end %>