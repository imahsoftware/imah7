<br/>
<table width="100%" border="0" cellpadding="0" cellspacing="0" style="font-size: 10px; font-family: Tahoma;" id="sample">
  <tr>
    <th style="font-size: 12px; font-family: Tahoma;">
      <div align="left">REGISTRO DE ATENCIÓN</div>
    </th>
  </tr>
</table>
<hr>
<% if @atenciones.present? %>
  <table width="100%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
    <tr>
      <td width="15%" style="background: #E8E3E3; padding: 5px; font-size: 10px; font-family: Tahoma;"><strong>Fecha Registro</strong></td>
      <td width="30%" style="background: #E8E3E3; padding: 5px; font-size: 10px; font-family: Tahoma;"><strong>Visita</strong></td>
      <td width="30%" style="background: #E8E3E3; padding: 5px; font-size: 10px; font-family: Tahoma;"><div align="center"><strong>Datos del Usuario</strong></div></td>
      <td style="background: #E8E3E3; padding: 5px; font-size: 10px; font-family: Tahoma;"><div align="center"><strong>Cargo</strong></div></td>
      <td style="background: #E8E3E3; padding: 5px; font-size: 10px; font-family: Tahoma;"><div align="center"><strong>Celular</strong></div></td>
    </tr>
    <% @atenciones.each do |atencion| %>
      <tr>
        <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px; padding: 3px;"><div align="center"><%= atencion.created_at.strftime("%d/%m/%Y %X") rescue nil %></div></td>
        <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px; padding: 3px;">
          <b>Contrato:</b> <%= atencion.visita.contrato.empresa.identnombre rescue nil %><%= atencion.visita.contrato.nro_contrato rescue nil %><br/>
          <b>Visita:</b> <%= atencion.visita.descripcion rescue nil %><br/>
          <b>Fecha Inicio: </b> <%= atencion.visita.created_at.strftime("%d/%m/%Y %X") rescue nil %><br/>
          <b>Fecha Fin: </b> <%= atencion.visita.finalizacion.strftime("%d/%m/%Y %X") rescue nil %>
        </td>
        <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px; padding: 3px;"><%= atencion.identificacion rescue nil %> - <%= atencion.nombre rescue nil %></td>
        <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px; padding: 3px;"><%= atencion.cargo rescue nil %></td>
        <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px; padding: 3px;"><%= atencion.celular rescue nil %></td>
      </tr>
    <% end %>
  </table>
<% else %>
  <div align="left" style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px;">No hay
    informacion
  </div>
<% end %>