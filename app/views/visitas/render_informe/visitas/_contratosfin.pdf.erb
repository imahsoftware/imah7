<br/>
<table width="100%" border="0" cellpadding="0" cellspacing="0" style="font-size: 10px; font-family: Tahoma;" id="sample">
  <tr>
    <th style="font-size: 12px; font-family: Tahoma;">
      <div align="left">CONTRATOS QUE FINALIZARON EN EL MES <%= @mes rescue nil %> - <b>Total: (<%= @contratosterminados.count rescue 0 %>)</b></div>
    </th>
  </tr>
</table>
<hr>
<% if @contratosterminados.present? %>
  <table width="100%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
    <tr>
      <th width="30%" style="background: #E8E3E3; padding: 5px; font-size: 10px; font-family: Tahoma;"><div align="left"><strong>Empleado</strong></div></th>
      <th  style="background: #E8E3E3; padding: 5px; font-size: 10px; font-family: Tahoma;"><div align="left">Empresa - Contrato</div></th>
      <th width="15%" style="background: #E8E3E3; padding: 5px; font-size: 10px; font-family: Tahoma;"><div align="left"><strong>Fecha Fin</strong></div></th>
    </tr>
    <% @contratosterminados.each do |contratosterminado| %>
      <tr>
        <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px; padding: 3px;"><%= contratosterminado.contratospersona.autobuscar rescue nil %></td>
        <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px; padding: 3px;"><div align="left"><%= contratosterminado.contrato.empresa.identnombre rescue nil %><%= contratosterminado.contrato.nro_contrato rescue nil %></div></td>
        <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px; padding: 3px;"> <%= contratosterminado.fecha_fin.strftime("%d/%m/%Y") rescue nil %></td>
      </tr>
    <% end %>
  </table>
<% else %>
  <div align="left" style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px;">No hay
    informacion
  </div>
<% end %>