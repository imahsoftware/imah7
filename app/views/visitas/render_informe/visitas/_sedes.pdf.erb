<br/>
<table width="100%" border="0" cellpadding="0" cellspacing="0" style="font-size: 10px; font-family: Tahoma;" id="sample">
  <tr>
    <th style="font-size: 12px; font-family: Tahoma;">
      <div align="left">INFORMACIÓN DE LAS SEDES</div>
    </th>
  </tr>
</table>
<hr>
<% if @sedes.present? %>
  <table width="100%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
    <tr>
      <td width="15%" style="background: #E8E3E3; padding: 5px; font-size: 10px; font-family: Tahoma;"><div align="center"><strong>Fecha Registro</strong></div></td>
      <td width="35%" style="background: #E8E3E3; padding: 5px; font-size: 10px; font-family: Tahoma;"><strong>Visita</strong></td>
      <td width="40%" style="background: #E8E3E3; padding: 5px; font-size: 10px; font-family: Tahoma;"><div align="center"><strong>Sede</strong></div></td>
    </tr>
    <% @sedes.each do |sede| %>
      <tr>
        <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px; padding: 3px;"><div align="center"><%= sede.created_at.strftime("%d/%m/%Y %X") rescue nil %></div></td>
        <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px; padding: 3px;">
          <b>Contrato:</b> <%= sede.visita.contrato.empresa.identnombre rescue nil %><%= sede.visita.contrato.nro_contrato rescue nil %><br/>
          <b>Visita:</b> <%= sede.visita.descripcion rescue nil %><br/>
          <b>Fecha Inicio: </b> <%= sede.visita.created_at.strftime("%d/%m/%Y %X") rescue nil %><br/>
          <b>Fecha Fin: </b> <%= sede.visita.finalizacion.strftime("%d/%m/%Y %X") rescue nil %>
        </td>
        <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px; padding: 3px;">
          <div align="left"><%= sede.contratossede.nombre rescue nil %>
            <small>(<%= sede.contratossede.municipio rescue nil %>
              - <%= sede.contratossede.departamento rescue nil %>)</small></div>
        </td>
      </tr>
    <% end %>
  </table>
<% else %>
  <div align="left" style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px;">No hay
    informacion
  </div>
<% end %>