<% if Userspermiso.where("user_id = #{user.id} and objeto_id in (144,150,151)").present? %>
  <b><em><%= user.nombre rescue nil %></em></b>
<% else %>
  <%= user.nombre rescue nil %>
<% end %>
<% if Userspermiso.where("user_id = #{user.id} and objeto_id = 144").present? %>
  <%= link_to excepcion_visitas_path(user_id: user.id, permiso: true, clase: 'A'), remote: true, data: { toggle: 'tooltip' }, title: "Excluido de Atención" do %>
    <i class="fa fa-check-circle text-green"></i>
  <% end %>
<% else %>
  <%= link_to excepcion_visitas_path(user_id: user.id, permiso: false, clase: 'A'), remote: true, data: { toggle: 'tooltip' }, title: "No Excluir de Atención" do %>
    <i class="fa fa-check-circle text-red"></i>
  <% end %>
<% end %>

<% if Userspermiso.where("user_id = #{user.id} and objeto_id = 150").present? %>
  <%= link_to excepcion_visitas_path(user_id: user.id, clase: 'T'), remote: true, data: { toggle: 'tooltip' }, title: "Desactivar Teletrabajo" do %>
    <i class="fa fa-home text-green"></i>
  <% end %>
<% else %>
  <%= link_to excepcion_visitas_path(user_id: user.id, clase: 'T'), remote: true, data: { toggle: 'tooltip' }, title: "Activar Teletrabajo" do %>
    <i class="fa fa-home text-red"></i>
  <% end %>
<% end %>

<% if Userspermiso.where("user_id = #{user.id} and objeto_id = 151").present? %>
  <%= link_to excepcion_visitas_path(user_id: user.id, clase: 'R'), remote: true, data: { toggle: 'tooltip' }, title: "Desactivar Brigada de Aseo" do %>
    <i class="fa fa-life-bouy text-green"></i>
  <% end %>
<% else %>
  <%= link_to excepcion_visitas_path(user_id: user.id, clase: 'R'), remote: true, data: { toggle: 'tooltip' }, title: "Activar Brigada de Aseo" do %>
    <i class="fa fa-life-bouy text-red"></i>
  <% end %>
<% end %>
