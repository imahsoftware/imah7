        font-size: 18px;
        font-family: Tahoma;
        text-align: center;
    }

    .encabezado_izq {
        font-size: 16px;
        font-family: Tahoma;
        text-align: left;
    }
    .encabezado_center {
        font-size: 16px;
        font-family: Tahoma;
        text-align: center;
    }

    .encabezado_izq2 {
        font-size: 14px;
        font-family: Tahoma;
        text-align: left;
    }

    .encabezado_contrato {
        padding: 5px;
        text-align: left;
        font-size: 10px;
        font-family: Tahoma;
    }

    .relleno_encabezado_contrato {
        background: #E8E3E3;
    }

    .parrafo {
        font-size: 14px;
        font-family: Tahoma;
        text-align: justify;
    }

    .encabezado_tabla {
        background: #d73925;
        color: white;
        padding: 5px;
        font-size: 10px;
        font-family: Tahoma;
    }

    .alineacion_izq {
        text-align: left;
    }

    .alineacion_center {
        text-align: center;
    }


</style>



