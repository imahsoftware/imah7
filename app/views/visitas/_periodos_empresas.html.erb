<div>
  <%= form_tag request.path, method: :get, class: 'form-inline' do %>
    <div class="box-body">
      <div class="form-group">
        <%= label_tag :autobuscar, 'Identificación - Nombre' %><br/>
        <%= text_field_tag :autobuscar, params[:autobuscar],class: 'form-control',style: 'width: 200px',autocomplete: 'off' %>
      </div>
      <div class="form-group">
        <%= button_tag type: 'submit', class: 'btn btn-primary', style: 'margin-top: 24px;', data: { toggle: 'tooltip' }, title: 'Buscar' do %>
          <i class="fa fa-search" aria-hidden="true"></i>
        <% end %>
      </div>
    </div>
  <% end %>
</div><br/>
<table class="table table-bordered table-condensed table-striped">
  <tr class="thcolor">
    <th class="text-left">Empresas</th>
  </tr>
  <% @empresas.each do |empresa| %>
    <tr>
      <td class="text-table text-left">
        <div id="abrir<%= empresa.id %>" class="pull-left">
          <%= link_to periodos_contrato_visitas_path(ruta: 'ABRIR', empresa_id: empresa.id), style: "color: black;", remote: true do %>
            <i data-toggle="tooltip" style="color:green;" data-original-title="Pulsa aqui para ver detalle de las firmas"></i>
            <%= empresa.autobuscar rescue nil %>
          <% end %>
        </div>
        <div id="cerrar<%= empresa.id %>" class="pull-left hide">
          <%= link_to periodos_contrato_visitas_path(ruta: 'CERRAR', empresa_id: empresa.id.to_s), style: "color: black;", remote: true do %>
            <i data-toggle="tooltip" style="color:green;" data-original-title="Pulsa aqui para ver detalle de las firmas"></i>
            <em><i class="fa fa-star text-red"></i> <%= empresa.autobuscar rescue nil %></em>
          <% end %>
        </div>
      </td>
    </tr>
    <tr id="tr_show<%= empresa.id %>" class="hidden">
      <td colspan="2">
        <div id="abrir_detalle<%= empresa.id %>"></div>
      </td>
    </tr>
  <% end %>
</table>
