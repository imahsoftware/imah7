<div class="row">
  <div class="col-md-6">
    <div class="box box-solid">
      <div class="box-header with-border">
        <i class="fa fa-map-marker"></i>
        <h3 class="box-title">Visita</h3>
      </div>

      <div class="box-body">
        <dl>
          <dt><b>Fecha Inicio Visita</b></dt>
          <dd><%= @visita.created_at.strftime("%d/%m/%Y %X") rescue nil %></dd>
          <dt><b>Usuario</b></dt>
          <dd><%= @visita.user.nombre rescue nil %></dd>
          <dt><b>Contrato</b></dt>
          <dd>
            <%= @visita.contrato.empresa.identnombre rescue nil %><%= @visita.contrato.nro_contrato rescue nil %>
            <br/><small><strong>Objetivo de la Visita: </strong><%= @visita.descripcion rescue nil %></small>
            <div class="modal fade" id="consolidado<%= @visita.id %>">
              <div class="modal-dialog" style="width: 80%">
                <div class="modal-content">
                  <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span>
                    </button>
                    <h4 class="modal-title">Consolidado Georreferenciación -
                      <small><%= @visita.user.nombre rescue nil %></small></h4>
                  </div>
                  <br/>
                </div>
              </div>
            </div>
          </dd>
        </dl>
      </div>
    </div>
  </div>
</div>