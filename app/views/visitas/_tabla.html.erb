<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
    <thead>
      <tr class="thcolor">
        <th class="text-center" style='font-size: 11px;' width="10%" ></th>
        <th width="20%" style='font-size: 11px;'>Descripción</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="tbody_visitas">
      <% @visitas.order(created_at: :desc).each do |visita| %>
	      <%= render 'visitas/tr', visita: visita %>
	    <% end %>
    </tbody>
  </table>
</div>

