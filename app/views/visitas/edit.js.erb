$("#visita_form").collapse("hide");

$("#visita_form").empty();

<% if @active_record.present? %>
	$("#visita_<%= @active_record.id %>").replaceWith("<%= j render 'tr', visita: @active_record %>");
<% end %>

$("#visita_<%= @visita.id %>").html("<td colspan='7'><%= j render 'form' %></td>");

$("#visita_<%= @visita.id %>").addClass("active_visita");

$(".select2").select2();

$(".tooltip").tooltip("hide");

$('[data-toggle="tooltip"]').tooltip();
