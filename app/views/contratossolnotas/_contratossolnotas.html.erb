<div class="box-header">
  <h3 class="box-title"><strong>Observaciones</strong></h3>
  <div class="box-tools pull-right">
      <%= link_to new_contratossolicitud_contratossolnota_path(@contratossolicitud), id: 'new_contratossolnota_button', class: 'btn btn-sm btn-warning', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
      <% end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="contratossolnota_form" class="collapse"></div>
  <div id="contratossolnotas">
    <% if @contratossolicitud.contratossolnotas.order("created_at desc").present? %>
      <%= render 'contratossolnotas/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
    <% end %>
  </div>
</div>
