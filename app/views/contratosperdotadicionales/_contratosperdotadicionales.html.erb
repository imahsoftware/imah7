<div class="box-header">
  <h3 class="modal-title">
    <legend>Elementos Adicionales</legend>
  </h3>
  <% if ['PENDIENTE', 'ENTREGADO'].include?(@contratosperdotacion.estado) %>
    <div class="box-tools pull-right">
      <%= link_to new_contratosperdotacion_contratosperdotadicional_path(@contratosperdotacion), id: 'new_contratosperdotadicional_button', class: 'btn btn-sm btn-warning', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
      <% end %>
    </div>
  <% end %>
</div>
<div class="box-body">
  <div id="contratosperdotadicional_form" class="collapse"></div>
  <div id="contratosperdotadicionales">
    <% if @contratosperdotacion.contratosperdotadicionales.present? %>
      <%= render 'contratosperdotadicionales/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %>
      </div>
    <% end %>
  </div>
</div>

