$(".alert_flash").fadeOut(300, function() {
	$(this).remove();
});

$("#contratosotro_<%= @contratosotro.id %>").replaceWith("<%= j render 'tr', contratosotro: @contratosotro %>");

$('[data-toggle="tooltip"]').tooltip();

$(".flash_messages").html("<%= j render 'layouts/flash_messages' %>");

setTimeout(function() {
	$(".alert_flash").fadeOut(300, function() {
		$(this).remove();
	});
}, 5000);
