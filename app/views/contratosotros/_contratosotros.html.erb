<div class="box-header">
  <h3 class="box-title"><strong>Otros Servicios</strong></h3>
  <div class="box-tools pull-right">
    <%# if is_auth_c('contratosotro') %>
      <%= link_to new_contrato_contratosotro_path(@contrato.id), id: 'new_contratosotro_button', class: 'btn btn-sm btn-warning', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
      <% end %>
    <%# end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="contratosotro_form" class="collapse"></div>
  <div id="contratosotros">
    <% if @contrato.contratosotros.present? %>
      <%= render 'contratosotros/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
    <% end %>
  </div>
</div>
