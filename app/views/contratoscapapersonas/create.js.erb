$(".alert_flash").fadeOut(300, function() {
	$(this).remove();
});

<% if @contratoscapacitacion.contratoscapapersonas.where("ruta = 'B' and estado_evaluacion = 'PENDIENTE'").count == 1 %>
	$("#contratoscapapersonas").html("<%= j render 'tabla' %>");
<% else %>
	$("#tbody_contratoscapapersonas").prepend("<%= j render 'tr', contratoscapapersona: @contratoscapapersona %>");
<% end %>

$(".clean").val("").trigger('change');

$("#contratoscapapersona_form").collapse("hide");

$('[data-toggle="tooltip"]').tooltip();

$(".flash_messages").html("<%= j render 'layouts/flash_messages' %>");

$(".form-group").removeClass("has-error");
$(".form-group > .help-block.help-block-error").remove();

setTimeout(function() {
	$(".alert_flash").fadeOut(300, function() {
		$(this).remove();
	});
}, 5000);
