<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Arial', 'Helvetica', sans-serif;
      font-size: 11pt;
      color: #333;
    }

    /* Header Principal */
    .header-container {
      width: 100%;
      margin-bottom: 30px;
    }

    /* Barra superior roja/coral */
    .header-top-bar {
      width: 100%;
      height: 12px;
      background: linear-gradient(90deg, #E57373 0%, #E57373 70%, #5C7A9E 70%, #5C7A9E 100%);
      margin: 0;
      padding: 0;
    }

    /* Contenedor del logo y título */
    .header-content {
      width: 100%;
      display: table;
      padding: 20px 0;
      border-bottom: 2px solid #E57373;
    }

    .header-left {
      display: table-cell;
      width: 60%;
      vertical-align: middle;
      padding-left: 20px;
    }

    .header-right {
      display: table-cell;
      width: 40%;
      vertical-align: middle;
      text-align: right;
      padding-right: 20px;
    }

    /* Título del documento */
    .document-title {
      font-size: 22pt;
      font-weight: bold;
      color: #2c3e50;
      margin: 0;
      padding: 0;
    }

    .document-subtitle {
      font-size: 12pt;
      color: #7f8c8d;
      margin-top: 5px;
    }

    /* Logo */
    .logo-img {
      max-width: 250px;
      height: auto;
    }

    /* Información adicional del header */
    .header-info {
      margin-top: 15px;
      padding: 10px 20px;
      background-color: #f8f9fa;
      border-left: 4px solid #E57373;
    }

    .info-row {
      display: table;
      width: 100%;
      margin-bottom: 5px;
    }

    .info-label {
      display: table-cell;
      width: 150px;
      font-weight: bold;
      color: #5C7A9E;
    }

    .info-value {
      display: table-cell;
      color: #333;
    }

    /* Contenido del documento */
    .content {
      padding: 20px;
    }

    /* Tabla de datos */
    table.data-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
      font-size: 10pt;
    }

    table.data-table th {
      background-color: #5C7A9E;
      color: white;
      padding: 10px;
      text-align: left;
      font-weight: bold;
      border: 1px solid #ddd;
    }

    table.data-table td {
      padding: 8px;
      border: 1px solid #ddd;
    }

    table.data-table tr:nth-child(even) {
      background-color: #f9f9f9;
    }

    table.data-table tr:hover {
      background-color: #f1f1f1;
    }

    /* Footer */
    .footer {
      position: fixed;
      bottom: 0;
      width: 100%;
      padding: 15px 20px;
      border-top: 2px solid #E57373;
      font-size: 9pt;
      color: #666;
    }

    .footer-bar {
      height: 8px;
      background: linear-gradient(90deg, #E57373 0%, #E57373 70%, #5C7A9E 70%, #5C7A9E 100%);
      margin-top: 10px;
    }
  </style>
</head>
<body>

jkjkljlkjlkjlk
</body>
</html>
