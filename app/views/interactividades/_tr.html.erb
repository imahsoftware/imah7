<%# app/views/interactividades/_tr.html.erb %>
<%
  estado         = @interventoria.estado.to_s
  editable       = @interventoria.editable?
  bloqueada      = interactividad.bloqueado.to_s == 'SI'
  con_obs        = interactividad.interactobservaciones.exists?
  con_imgs       = interactividad.interactimagenes.exists?
  tiene_dev      = interactividad.desarrollo.present?
  modo_compacto  = local_assigns[:solo_lectura_modo] || false

  puede_editar = editable && !bloqueada &&
                 !%w[APROBADO APROBADOGH APROBADOCONT APROBADOFINAL
                     REVISION REVISIONFINALGH REVISIONFINALINT].include?(estado)

  puede_subir  = editable && !bloqueada &&
                 !%w[APROBADO APROBADOGH].include?(estado) &&
                 !(estado == 'RECHAZADO' && !con_obs)

  supervisor_persona = @interventoria.contratosperfecha&.contratospersona
  es_supervisor_ss   = interactividad.actividad.to_s.upcase.include?('SEGURIDAD SOCIAL') &&
                       supervisor_persona.present? &&
                       usuario_actual&.identificacion.to_s == supervisor_persona.identificacion.to_s
%>

<tr id="interactividad_<%= interactividad.id %>">

  <%# ── COL 1: Número ────────────────────────────────────────────────────── %>
  <td class="ia-col-nro">
    <span class="ia-nro-circulo"><%= interactividad.consecutivo %></span>
  </td>

  <%# ── COL 2: Botones (solo si no es modo compacto) ────────────────────── %>
  <% unless modo_compacto %>
    <td class="ia-col-btn">
      <% if puede_subir %>
        <%= link_to cargue_documentos_interactividades_path(interactividad_id: interactividad.id),
                    remote: true,
                    class: 'btn btn-xs btn-warning',
                    title: 'Cargar Soporte Digital',
                    data: { toggle: 'tooltip', placement: 'right' } do %>
          <i class="fa fa-upload"></i>
        <% end %>
      <% end %>
      <% if es_supervisor_ss && editable && !bloqueada %>
        <%= link_to cargue_observaciones_interactividades_path(interactividad_id: interactividad.id),
                    remote: true,
                    class: 'btn btn-xs btn-success',
                    title: 'Cargar Observación',
                    data: { toggle: 'tooltip', placement: 'right' } do %>
          <i class="fa fa-sticky-note"></i>
        <% end %>
      <% end %>
    </td>
  <% end %>

  <%# ── COL 3: Actividad ──────────────────────────────────────────────────── %>
  <td>
    <div class="ia-act-nombre">
      <% if tiene_dev %>
        <i class="fa fa-check-circle" style="color:#27ae60; margin-right:5px;" title="Actividad desarrollada"></i>
      <% end %>
      <%= interactividad.actividad %>
    </div>

    <%# Observaciones colapsables %>
    <% if con_obs %>
      <div class="ia-obs-toggle" onclick="toggleObservaciones(<%= interactividad.id %>)">
        <i class="fa fa-sticky-note"></i>
        Ver observaciones (<%= interactividad.interactobservaciones.count %>)
      </div>
      <div id="observaciones_<%= interactividad.id %>" style="display:none;">
        <% interactividad.interactobservaciones.each do |obs| %>
          <div class="ia-obs-item">
            <%= obs.try(:observaciones) || obs.try(:obs) %>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# Preview desarrollo para estados finales %>
    <% if %w[PREPARAFINAL RECHAZADOFINALGH RECHAZADOFINALINT].include?(estado) && tiene_dev %>
      <div class="ia-dev-txt" id="desarrollo_preview_<%= interactividad.id %>"
           style="margin-top:8px; padding:6px 10px; background:#f7f9fc; border-left:3px solid #3c8dbc;">
        <small style="font-size:10px; text-transform:uppercase; color:#888; display:block; margin-bottom:3px;">
          <strong>Desarrollo registrado</strong>
        </small>
        <%= interactividad.desarrollo.gsub("\n", "<br>").html_safe %>
      </div>
    <% end %>

    <%# Soportes digitales %>
    <% if con_imgs %>
      <div class="ia-soporte-wrap">
        <div class="ia-soporte-header">
          <i class="fa fa-paperclip"></i> Soporte Digital
        </div>
        <% interactividad.interactimagenes.each do |img| %>
          <div class="ia-soporte-row">
            <span class="ia-soporte-nombre">
              <i class="fa fa-file-o" style="color:#888; margin-right:4px;"></i>
              <%= img.descripcion.to_s.upcase %>
              <span style="color:#bbb; margin:0 4px;">—</span>
              <%= img.interactividad_file_name.to_s.upcase %>
            </span>
            <span class="ia-soporte-acciones">
              <%= link_to img.interactividad.url(:original, false),
                          title: 'Ver documento',
                          data: { toggle: 'tooltip' },
                          onclick: 'window.open(this.href,"nw","height=600,width=830,scrollbars=yes");return false',
                          class: 'btn btn-xs btn-default' do %>
                <i class="fa fa-eye" style="color:#3c8dbc;"></i> Ver
              <% end %>
              <% unless %w[REVISION APROBADO APROBADOGH APROBADOCONT].include?(estado) %>
                <%= link_to interactividad_interactimagen_path(interactividad, img),
                            method: :delete,
                            data: { confirm: '¿Eliminar este documento?', toggle: 'tooltip' },
                            title: 'Eliminar',
                            class: 'btn btn-xs btn-danger' do %>
                  <i class="fa fa-trash"></i>
                <% end %>
              <% end %>
            </span>
          </div>
        <% end %>
      </div>
    <% end %>

  </td>

  <%# ── COL 4: Desarrollo ─────────────────────────────────────────────────── %>
  <% unless modo_compacto %>
    <td class="ia-col-dev">
      <% if puede_editar %>
        <textarea id="note<%= interactividad.id %>"
                  class="ia-textarea"
                  rows="4"
                  data-interactividad-id="<%= interactividad.id %>"
        ><%= interactividad.desarrollo %></textarea>
        <script>initDesarrolloTextarea(<%= interactividad.id %>);</script>
      <% elsif tiene_dev %>
        <div class="ia-dev-txt">
          <%= interactividad.desarrollo.gsub("\n", "<br>").html_safe %>
        </div>
      <% else %>
        <span class="ia-dev-vacio">Sin desarrollo</span>
      <% end %>
    </td>
  <% end %>

</tr>

<%# Modales %>
<% if editable %>
  <div class="modal fade" id="cargar_documento<%= interactividad.id %>">
    <div class="modal-dialog" role="document" style="width:70%;">
      <div class="modal-content"></div>
    </div>
  </div>
  <div class="modal fade" id="cargar_observacion<%= interactividad.id %>">
    <div class="modal-dialog" role="document" style="width:70%;">
      <div class="modal-content"></div>
    </div>
  </div>
<% end %>
