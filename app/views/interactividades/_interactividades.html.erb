<%# app/views/interactividades/_interactividades.html.erb %>
<%# Vista principal de obligaciones — un solo render para todos los estados %>

<%# ── JS compartido: autosize + autoguardado (una sola vez, no por fila) ──── %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/autosize.js/4.0.2/autosize.min.js"></script>
<script>
    // Convierte textarea a mayúsculas y guarda con debounce
    var saveTimers = {};
    function initDesarrolloTextarea(id) {
        var el = document.getElementById('note' + id);
        if (!el) return;
        autosize(el);
        el.addEventListener('input', function() {
            this.value = this.value.toUpperCase();
            var interactividadId = this.getAttribute('data-interactividad-id');
            clearTimeout(saveTimers[interactividadId]);
            saveTimers[interactividadId] = setTimeout(function() {
                $.ajax({
                    url: '/interactividades/update_observation',
                    type: 'POST',
                    data: {
                        id: interactividadId,
                        desarrollo: el.value,
                        interventoria_id: '<%= @interventoria.id %>'
                    },
                    success: function(data) {
                        // Actualizar div de preview si existe (para PREPARAFINAL)
                        var preview = $('#desarrollo_preview_' + interactividadId);
                        if (preview.length && data.desarrollo) {
                            preview.html(data.desarrollo.replace(/\n/g, '<br/>'));
                        }
                    }
                });
            }, 800); // debounce 800ms — no spamea el servidor
        });
    }

    function toggleObservaciones(id) {
        $('#observaciones_' + id).toggle();
    }

    $(document).ready(function() {
        $('[data-toggle="tooltip"]').tooltip();
    });
</script>

<style>
    .ia-textarea { overflow: hidden; resize: none; box-sizing: border-box; width: 100%; border-radius: 0; }
    .ia-obs-badge { cursor: pointer; }
    .ia-desarrollo-preview { word-wrap: break-word; white-space: normal; overflow-wrap: break-word; }
</style>

<%# ── LÍNEA DE TIEMPO DEL ESTADO ACTUAL ──────────────────────────────────── %>
<%
  estado_actual = @interventoria.estado.to_s
  pasos = [
    { estado: 'PENDIENTE',         icono: 'fa-clock-o',       color: '#bdc3c7', label: 'Pendiente envío' },
    { estado: 'REVISION',          icono: 'fa-paper-plane',   color: '#f39c12', label: 'En revisión' },
    { estado: 'RECHAZADO',         icono: 'fa-times-circle',  color: '#e74c3c', label: 'Rechazado' },
    { estado: 'APROBADO',          icono: 'fa-check-circle',  color: '#27ae60', label: 'Aprobado supervisor' },
    { estado: 'REVISIONFINALGH',   icono: 'fa-shield',        color: '#3c8dbc', label: 'Revisión SGSST' },
    { estado: 'RECHAZADOGH',       icono: 'fa-times-circle',  color: '#e74c3c', label: 'Rechazado SGSST' },
    { estado: 'APROBADOGH',        icono: 'fa-thumbs-up',     color: '#3c8dbc', label: 'Aprobado SGSST' },
    { estado: 'APROBADOCONT',      icono: 'fa-money',         color: '#00a65a', label: 'Contabilizado' },
  ]
  # Índice del estado actual en el flujo principal (ignorar rechazos para el progreso)
  flujo_principal = %w[PENDIENTE REVISION APROBADO REVISIONFINALGH APROBADOGH APROBADOCONT]
  idx_actual = flujo_principal.index(estado_actual) || -1
%>

<div class="box box-default box-solid" style="margin-bottom: 12px;">
  <div class="box-header with-border" style="padding: 8px 15px;">
    <h4 class="box-title" style="font-size: 13px;">
      <i class="fa fa-map-signs"></i> Estado actual del informe:
      <strong style="color: #3c8dbc; margin-left: 5px;"><%= estado_actual %></strong>
      &nbsp;—&nbsp;
      <small>
        Periodo: <strong><%= Interventoria::MESES[@interventoria.mes.to_i] %> <%= @interventoria.anno %></strong>
        &nbsp;|&nbsp;
        Contrato: <strong><%= @interventoria.contrato&.nro_contrato %></strong>
      </small>
    </h4>
  </div>
  <div class="box-body" style="padding: 14px 15px 10px;">
    <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 0; font-size: 11px;">
      <% pasos.each_with_index do |paso, i| %>
        <%
          es_actual   = paso[:estado] == estado_actual
          es_rechazo  = paso[:estado].start_with?('RECHAZADO')
          en_flujo    = flujo_principal.index(paso[:estado])
          completado  = en_flujo && idx_actual > en_flujo
          color_circulo = if es_actual
                            paso[:color]
                          elsif completado
                            '#27ae60'
                          else
                            '#dde1e7'
                          end
          color_texto = es_actual ? '#333' : (completado ? '#27ae60' : '#aaa')
          borde_actual = es_actual ? "3px solid #{paso[:color]}" : 'none'
        %>
        <div style="text-align: center; min-width: 75px; <%= es_rechazo && !es_actual ? 'opacity:0.4;' : '' %>">
          <div style="width: 36px; height: 36px; border-radius: 50%;
                      background: <%= color_circulo %>; color: #fff;
                      display: flex; align-items: center; justify-content: center;
                      margin: 0 auto 4px; font-size: 15px;
                      box-shadow: <%= es_actual ? "0 0 0 3px #{paso[:color]}44" : 'none' %>;">
            <% if completado %>
              <i class="fa fa-check"></i>
            <% else %>
              <i class="fa <%= paso[:icono] %>"></i>
            <% end %>
          </div>
          <span style="color: <%= color_texto %>; font-weight: <%= es_actual ? '700' : '400' %>;">
            <%= paso[:label] %>
          </span>
        </div>
        <% unless i == pasos.size - 1 %>
          <div style="flex: 1; min-width: 10px; height: 2px;
                      background: <%= completado ? '#27ae60' : '#dde1e7' %>;
                      margin: 0 2px; margin-bottom: 18px;"></div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<%# ── MENSAJE DE ESTADO ────────────────────────────────────────────────────── %>
<% if @interventoria.editable? %>
  <%
    sin_desarrollo = @interventoria.interactividades.where("desarrollo IS NULL OR desarrollo = ''").count
    total          = @interventoria.interactividades.count
    estado         = @interventoria.estado.to_s
  %>
  <% if sin_desarrollo > 0 %>
    <div class="ic-alert ic-alert-warning">
      <i class="fa fa-exclamation-triangle"></i>
      <div>Tiene <strong><%= total %></strong> obligaciones registradas, de las cuales
        <strong><%= sin_desarrollo %></strong> no tienen desarrollo diligenciado.</div>
    </div>
  <% elsif estado == 'RECHAZADO' %>
    <div class="ic-alert ic-alert-danger">
      <i class="fa fa-times-circle"></i>
      <div>El informe fue rechazado por el interventor. Verifique y complemente las actividades.</div>
    </div>
  <% elsif estado == 'RECHAZADOGH' %>
    <div class="ic-alert ic-alert-danger">
      <i class="fa fa-times-circle"></i>
      <div>El informe fue rechazado por Gestión Humana. Verifique y complemente las actividades.</div>
    </div>
  <% elsif total > 0 %>
    <div class="ic-alert ic-alert-success">
      <i class="fa fa-check-circle"></i>
      <div>Tiene <strong><%= total %></strong> obligaciones registradas y todas están debidamente diligenciadas.</div>
    </div>
  <% end %>
<% end %>

<%# ── CUERPO PRINCIPAL ─────────────────────────────────────────────────────── %>
<div class="box box-primary">
  <div class="flash_messages"></div>
  <div class="box-body">

    <div class="box-header with-border" style="padding-bottom: 0;">
      <h3 class="box-title">
        <i class="fa fa-list-ul"></i> Obligaciones del Contrato
      </h3>
      <%# Botón nuevo — solo en estados editables normales %>
      <% if @interventoria.editable? &&
            !%w[RECHAZADOGH APROBADOGH PREPARAFINAL RECHAZADOFINALGH RECHAZADOFINALINT
                REVISIONFINALGH REVISIONFINALINT].include?(@interventoria.estado.to_s) &&
            is_auth_c("interventoriasactividades") %>
        <div class="box-tools pull-right">
          <%= link_to new_interventoria_interactividad_path(@interventoria),
                      remote: true,
                      class: 'btn btn-sm btn-success',
                      title: 'Nueva obligación' do %>
            <i class="fa fa-plus"></i> Nueva
          <% end %>
        </div>
      <% end %>
    </div>

    <div id="interactividad_form" class="collapse" style="padding: 10px 0;"></div>

    <div id="interactividades" style="margin-top: 10px;">
      <% if @interventoria.interactividades.any? %>
        <%= render 'interactividades/tabla', usuario_actual: User.find_by(id: is_admin) %>
      <% else %>
        <div class="alert alert-warning">
          <i class="fa fa-info-circle"></i>
          No hay obligaciones registradas para este informe.
          <% if @interventoria.editable? && !@interventoria.bloqueado? %>
            &nbsp;
            <%= link_to recargar_actividades_interventoria_path(@interventoria),
                        method: :post,
                        data: { confirm: '¿Recargar las actividades del cargo asignado?' },
                        class: 'btn btn-xs btn-warning' do %>
              <i class="fa fa-refresh"></i> Recargar actividades
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

  </div><%# /box-body %>
</div><%# /box %>
