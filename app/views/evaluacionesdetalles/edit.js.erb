<% if @active_record.present? %>
	$("#evaluacionesdetalle_<%= @active_record.id %>").replaceWith("<%= j render 'tr', evaluacionesdetalle: @active_record %>");
<% end %>

$("#evaluacionesdetalle_<%= @evaluacionesdetalle.id %>").html("<td colspan='12'><%= j render 'form' %></td>");
$("#evaluacionesdetalle_<%= @evaluacionesdetalle.id %>").addClass("active_evaluacionesdetalle");
$("#evaluacionesdetalle_form").empty();
$("#evaluacionesdetalle_form").collapse("hide");
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();

// Selector normal
$(document).ready(function () {
    $('.js-searchable').select2({
        allowClear: true,
        width: '100%',
        placeholder: '-- Seleccionar --'
    });
});

/// Calendario

$(".datetimepicker").datetimepicker({
    showClear: true
});


/// Convierte texto en mayuscula
$('.uppercaseInput').keyup(function () {
    $(this).val($(this).val().toUpperCase());
});

$(".select2").select2();

$(function () {
    return $('.select2Ciudad').select2({
        minimumInputLength: 3,
        maximumInputLength: 20,
        placeholder: "[ Seleccionar Ciudad... ]",
        ajax: {
            url: '/evaluaciones/search.json',
            dataType: 'json',
            delay: 250,
            data: function (params) {
                return {
                    q: params.term,
                    page: params.page
                };
            },
            processResults: function (data) {
                return {
                    results: $.map(data, function (item) {
                        return {
                            text: item.name,
                            id: item.id
                        };
                    })
                };
            }
        }
    });
});
$('.wysihtml5').wysihtml5();