<% if @evaluacion.evaluacionesdetalles.present? %>
	$("#evaluacionesdetalles").html("<%= j render 'tabla' %>");
<% else %>
	$("#tbody_evaluacionesdetalles").prepend("<%= j render 'tr', evaluacionesdetalle: @evaluacionesdetalle %>");
<% end %>

$(".clean").val("").trigger('change');
$('[data-toggle="tooltip"]').tooltip();
$( ":input" ).removeClass("is-invalid");
$("[for='inputError']").remove();
$("#evaluacionesdetalle_form").collapse("hide");