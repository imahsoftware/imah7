<div class="box-body paddin-body">
  <div class="row">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title"> Detalles
            <div class="pull-right">
              <%= link_to new_evaluacion_evaluacionesdetalle_path(@evaluacion), id: 'new_evaluacionesdetalle_button', class: 'btn btn-sm btn-warning', remote: true do %>
                <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
              <% end %>
            </div>
          </h3>
        </div>

        <div class="card-body">
          <div id="evaluacionesdetalle_form" class="collapse"></div>
          <div id="evaluacionesdetalles" style="margin-top: 10px;">
            <% if @evaluacion.evaluacionesdetalles.any? %>
              <%= render 'evaluacionesdetalles/tabla' %>
            <% else %>
              <%= render 'layouts/procesos/alert_message' %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

