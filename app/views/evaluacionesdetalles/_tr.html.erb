<tr id="evaluacionesdetalle_<%= evaluacionesdetalle.id %>">
  <td class="text-center">
    <% if evaluacionesdetalle.evaluacion.estado == 'PENDIENTE' %>
      <%= link_to evaluacion_evaluacionesdetalle_path(@evaluacion, evaluacionesdetalle), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
        <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
      <% end %>
      <%= link_to edit_evaluacion_evaluacionesdetalle_path(@evaluacion, evaluacionesdetalle), remote: true, class: 'edit_contratosmodificacion_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
        <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
      <% end %>
    <% end %>
    <button class="btn btn-xs btn-info">
      <span data-toggle="tooltip" data-html="true" data-original-title="<div align='left'><%= evaluacionesdetalle.user_nombre.html_safe rescue nil %> - ID: <%= evaluacionesdetalle.id rescue nil %></div>"><i class="fa fa-user" aria-hidden="true"></i></span>
    </button>
  </td>
  <td class="font-size-text-tabla text-table text-center"><%= evaluacionesdetalle.clase rescue nil %>
    <% if @evaluacion.tipo == 'EVALUACION DESEMPENO' %>
      <span data-toggle="tooltip" data-html="true" data-original-title="<div align='left'><%= evaluacionesdetalle.actividadesnombre.html_safe rescue nil %></div>"><i class="fa fa-commenting" aria-hidden="true"></i></span>
    <% else %>
      <span data-toggle="tooltip" data-html="true" data-original-title="<div align='left'><%= evaluacionesdetalle.actividadesnombreperiodo.html_safe rescue nil %></div>"><i class="fa fa-commenting" aria-hidden="true"></i></span>
    <% end %>
  </td>
  <td class="font-size-text-tabla text-table text-justify"><%= evaluacionesdetalle.actividad rescue nil %></td>
  <td class="font-size-text-tabla text-table text-center"><%= evaluacionesdetalle.requieredoc rescue nil %></td>
  <td class="font-size-text-tabla text-table text-justify"><%= evaluacionesdetalle.observacion rescue nil %></td>
</tr>