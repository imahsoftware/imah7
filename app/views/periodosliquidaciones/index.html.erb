<div class="box box-primary">
  <div class="box-header">
    <legend>Periodos de liquidación</legend>
  </div>
  <div class="flash_messages"></div>
  <div class="box-body">
    <div id="periodosliquidacion_form" class="collapse"></div>
    <div id="periodosliquidaciones">
      <% if @periodosliquidaciones.present? %>
        <% @is_auth_c_periodosliquidacion = is_auth_c('periodosliquidacion') %>
        <%= render 'periodosliquidaciones/tabla' %>
      <% else %>
        <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
      <% end %>
    </div>
  </div>
</div>