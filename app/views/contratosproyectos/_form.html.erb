<%= simple_form_for([@contrato, @contratosproyecto], remote: true) do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-10 col-lg-10">
        <%= f.input :descripcion, input_html: {:onchange => "javascript:this.value=this.value.toUpperCase();"}, label: "Nombre del proyecto" %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :valor, as: :moneda %></div>
    </div>
    <div class="row">
      <div class="col-md-6">
        <% if @contratosproyecto.new_record? %>
          <%= button_tag "#{t :cancelar}", type: 'button', data: {target: '#contratosproyecto_form'}, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}", contrato_contratosproyecto_path(@contrato, @contratosproyecto), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
<br/>
