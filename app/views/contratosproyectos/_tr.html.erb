<tr id="contratosproyecto_<%= contratosproyecto.id %>">
  <td class="text-center">
    <%# if @contrato.contratosusers.exists?(empresassede_id: contratosproyecto.empresassede_id) == false and @contrato.contratoscargos.exists?(empresassede_id: contratosproyecto.empresassede_id) == false  %>
    <%= link_to edit_contrato_contratosproyecto_path(@contrato, contratosproyecto), remote: true, class: 'edit_contratosmodificacion_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
      <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
    <% end %>
    <%# if is_auth_e("contratosproyecto")%>
    <small id="contratosproyectodelete_<%= contratosproyecto.id %>">
      <% if !contratosproyecto.contratosprosedes.present? %>
        <%= link_to contrato_contratosproyecto_path(@contrato, contratosproyecto), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
          <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
        <% end %>
      <% end %>
    </small>
    <%= link_to abrirsedes_contratosproyectos_path(contrato_id: @contrato.id, id: contratosproyecto.id), remote: true, data: { toggle: 'tooltip' }, title: "Agregar Sedes" do %>
      <button class="btn btn-xs btn-success"><i class="fa fa-home"></i></button>
    <% end %>
    <%# end %>
    <button class="btn btn-xs btn-info">
      <span data-toggle="tooltip" data-html="true" data-original-title="<div align='left'><%= contratosproyecto.user_nombre.html_safe rescue nil %><%= contratosproyecto.user_actnombre.html_safe rescue nil %></div>"><i class="fa fa-user" aria-hidden="true"></i></span>
    </button>
  </td>
  <td align="left"><%= contratosproyecto.descripcion rescue nil %>
    <% if contratosproyecto.contratosprosedes.present? %>
      <a href="javascript:void(0);" onclick="SINO('demo_<%=contratosproyecto.id%>')"><br/>
        <i class="fa fa-arrow-circle-down" data-toggle="tooltip" style="color:red;" data-original-title="Pulsa aqui para ver los archivos planos"></i>
        Sedes Asociadas (<%= contratosproyecto.contratosprosedes.count rescue 0 %>)
      </a>
    <% end %>
    <div id="demo_<%= contratosproyecto.id %>" style="display:none;"><br/>
      <table class="table table-bordered table-condensed table-striped">
        <thead>
        <tr class="thcolor">
          <th class="text-left" style="font-size:12px;">Sedes</th>
        </tr>
        </thead>
        <tbody id="tbody">
        <% contratosproyecto.contratosprosedes.includes([:contratossede]).each do |p| %>
          <tr>
            <td style="font-size: 10px;"><%= p.contratossede.nombre %></td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  </td>
  <td align="right"><%= camponumerico contratosproyecto.valor rescue nil %></td>
  <td align="right"><%= camponumerico contratosproyecto.usado rescue nil %></td>
  <td align="right"><%= camponumerico contratosproyecto.saldo rescue nil %></td>
</tr>

<div class="modal fade" id="modalsede<%= contratosproyecto.id %>">
  <div class="modal-dialog modal-dialog-responsive" role="document">
    <div class="modal-content"></div>
  </div>
</div>