<div class="box-header">
  <h3 class="box-title"><strong>Proyectos Asociados al contrato
    <%= link_to recalcular_contratosproyectos_path(id: @contrato.id), data: {toggle: 'tooltip', confirm: "Seguro que desea recalcular los valores de los proyectos?"}, title: 'Recalcular' do %>
      <button class="btn btn-xs btn-info"><i class="fa fa-arrow-right fa-fw" aria-hidden="true"></i> <strong>Recalcular</strong></button>
    <% end %>
  </strong></h3>
  <div class="box-tools pull-right">
    <%# if is_auth_c('contratosproyecto') %>
      <%= link_to new_contrato_contratosproyecto_path(@contrato), id: 'new_contratosproyecto_button', class: 'btn btn-sm btn-warning', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
      <% end %>
    <%# end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="contratosproyecto_form" class="collapse"></div>
  <div id="contratosproyectos">
    <% if @contrato.contratosproyectos.present? %>
      <%= render 'contratosproyectos/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
    <% end %>
  </div>
</div>

