<%= simple_form_for(@contratosactnota) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.association :contratosactividad %>
    <%= f.association :contratossede %>
    <%= f.association :user %>
    <%= f.input :nota %>
  </div>

  <div class="form-actions">
    <%= f.button :submit %>
  </div>
<% end %>
