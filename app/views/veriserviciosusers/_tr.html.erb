<tr id="veriserviciosuser_<%= veriserviciosuser.id %>">
  <td class="text-center">
    <% if veriserviciosuser.codigo_firma.blank? %>
      <%= link_to edit_veriservicio_veriserviciosuser_path(@veriservicio, veriserviciosuser), remote: true, class: 'edit_veriserviciosuser_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
        <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
      <% end %>
      <%= link_to veriservicio_veriserviciosuser_path(@veriservicio, veriserviciosuser), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
        <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
      <% end %>
    <% end %>
  </td>
  <td align="left" class="text-table"><%= veriserviciosuser.created_at.strftime("%Y-%m-%d %X") rescue nil %></td>
  <td align="left" class="text-table"><%= veriserviciosuser.user.nombrecompleto rescue nil %></td>
</tr>
