<div class="box-header" id="moda-agenda<%= @veriserviciosagenda.id %>">
  <h3 class="box-title"><strong>Usuarios</strong></h3>
  <div class="box-tools pull-right">
    <% if ['PENDIENTE', 'EN PROCESO'].include?(@veriservicio.estado_proceso) and Time.now.to_date <= @veriserviciosagenda.fecha_reprogramacion.to_date %>
      <%= link_to new_veriservicio_veriserviciosuser_path(@veriservicio, veriserviciosagenda_id: @veriserviciosagenda.id), id: 'new_veriserviciosuser_button', class: 'btn btn-sm btn-info', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
      <% end %>
    <% end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="veriserviciosuser_form" class="collapse"></div>
  <div id="veriserviciosusers">
    <% if @veriservicio.veriserviciosusers.present? %>
      <%= render 'veriserviciosusers/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %>
      </div>
    <% end %>
  </div>
</div>

