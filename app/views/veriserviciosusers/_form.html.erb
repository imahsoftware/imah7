<%= simple_form_for([@veriservicio, @veriserviciosuser], remote: true) do |f| %>
  <%= hidden_field_tag :veriserviciosagenda_id, params[:veriserviciosagenda_id], value: @veriserviciosagenda.id %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-md-12">
        <%= f.input :user_id, collection: User.where(["tipoconsulta not in ('PERSONA','CANDIDATO', 'RECTOR', 'METRO') and activo = 'S'"]).order(:nombre).collect {|p| [ p.nombrecompleto, p.id ] }, input_html: { class: 'select2 clean', style: "width: 100%" }, as: :select,  include_blank: true, label: "Supervisor" %>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <% if @veriserviciosuser.new_record? %>
          <%= button_tag "#{t :cancelar}", type: 'button', data: { target: '#veriserviciosuser_form' }, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}", veriservicio_veriserviciosuser_path(@veriservicio, @veriserviciosuser), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
<br/>