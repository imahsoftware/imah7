<div class="box-header">
  <h3 class="box-title"><strong>Egresos Directos
    <%= link_to egresod_eproveedores_path(eproveedor_id: @eproveedor.id), data: {toggle: 'tooltip', confirm: "Seguro que desea generar el Egreso?"}, title: 'Generar Egreso' do %>
      <button class="btn btn-xs btn-danger">Generar Egreso</button>
    <% end %></strong></h3>
  <div class="box-tools pull-right">
    <%= link_to new_eproveedor_eproveedorestemegreso_path(@eproveedor), id: 'new_eproveedorestemegreso_button', class: 'btn btn-sm btn-warning', remote: true do %>
      <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
    <% end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="eproveedorestemegreso_form" class="collapse"></div>
  <div id="eproveedorestemegresos">
    <% if @eproveedor.eproveedorestemegresos.where(estado: nil).present? %>
      <%= render 'eproveedorestemegresos/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
    <% end %>
  </div>
</div>

