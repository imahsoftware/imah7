<tr id="eproveedorestemegreso_<%= eproveedorestemegreso.id %>">
  <td class="text-center">
      <%= link_to edit_eproveedor_eproveedorestemegreso_path(@eproveedor, eproveedorestemegreso), remote: true, class: 'edit_eproveedorsmodificacion_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
        <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
      <% end %>
      <%= link_to eproveedor_eproveedorestemegreso_path(@eproveedor, eproveedorestemegreso), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
         <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
      <% end %>
    <button class="btn btn-xs btn-info"><span data-toggle="tooltip" data-html="true" data-original-title="<div align='left'><%= eproveedorestemegreso.user_nombre.html_safe rescue nil %><%= eproveedorestemegreso.user_actnombre.html_safe rescue nil %></div>"><i class="fa fa-user" aria-hidden="true"></i></span></button>
  </td>
  <td align="center"><%= eproveedorestemegreso.fecha %></td>
  <td align="left" style="font-size:11px;"><strong><%= eproveedorestemegreso.portafolio.nombre rescue nil %></strong></td>
  <td align="justify"><%= eproveedorestemegreso.concepto %></td>
  <td align="center"><%= eproveedorestemegreso.forma_pago %></td>
  <td align="right"><%= camponumerico eproveedorestemegreso.total %></td>
</tr>



