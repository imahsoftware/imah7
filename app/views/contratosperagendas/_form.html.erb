<%= simple_form_for(@contratosperagenda) do |f| %>
  <%= f.hidden_field :contratospersona_id %>
  <div class="box box-danger">
    <div class="box-header">
      <legend>
        <%= link_to root_path, title: 'Regresar' do %>
          <i class="fa fa-arrow-left fa-fw text-success" aria-hidden="true"></i>
        <% end %>
        Información Agenda contrato (<%= @contratosperagenda.contratospersona.identificacion rescue nil %>-<%=@contratosperagenda.contratospersona.nombre_completo rescue nil %>)
      </legend>
    </div>
    <div class="box-body">
      <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :fecha, as: :string, input_html: { class: 'datepicker', data: {date_options: {format: 'DD/MM/YYYY', ignoreReadonly: true}}, readonly: true } %></div>
        <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :hora %></div>
      </div>
    </div>
    <div class="box-footer">
      <div class="box-tools pull-right">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div><!-- /.box-tools -->
    </div>
  </div>
<% end %>
