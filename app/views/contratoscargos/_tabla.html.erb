<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
	  <thead class="thcolor">
      <tr>
        <td width="10%"></td>
        <th class="text-left">Cargo</th>
        <th width="10%" class="text-center">Salario</th>
        <th width="9%" class="text-center">Total Hab.</th>
        <th width="9%" class="text-center">Adición</th>
        <th width="9%" class="text-center">Asignados</th>
        <th width="9%" class="text-center">Rechazados</th>
        <th width="9%" class="text-center">Disponible</th>
      </tr>
    </thead>
	  <tbody id="tbody_contratoscargos">
	    <%
        @is_auth_a_contratoscargo = is_auth_a("contratoscargo")
        @is_auth_e_contratoscargo = is_auth_e("contratoscargo")
        @contrato.contratoscargos.includes([:user]).select("contratoscargos.*,
                                          (select count(9) from contratosperfechas where contratoscargo_id = contratoscargos.id and estado ='ACTIVO') cantregistrada1,
                                          (select distinct 'X' from contratosperfechas where contratoscargo_id = contratoscargos.id) existecontrato")
                                 .order(id: :desc).each do |contratoscargo| %>
	      <%= render 'contratoscargos/tr', contratoscargo: contratoscargo %>
	    <% end %>
	  </tbody>
    <% asignados = Contratosperfecha.where("contratoscargo_id in (select id from contratoscargos where contrato_id = #{@contrato.id})
                                            and estado ='ACTIVO'
                                            AND (fecha_fin IS NULL OR fecha_fin >= NOW())
                                            AND  id NOT IN (SELECT DISTINCT contratosperfecha_id FROM solicitudesretiros WHERE IFNULL(user_aprobacion,0) > 0)").count.to_i rescue 0
       cantidad = @contrato.contratoscargos.sum("cantidad") rescue 0
       cant_add = @contrato.contratoscargos.sum("cant_add") rescue 0
    %>
    <tr class="thcolor">
      <th colspan="3" class="text-right">TOTALES</th>
      <th class="text-center"><%=camponumerico2 cantidad rescue nil %></th>
      <th class="text-center"><%=camponumerico2 cant_add rescue nil %></th>
      <th class="text-center"><%=camponumerico2 asignados rescue nil %></th>
      <th class="text-center"><%=camponumerico2 0 rescue nil %></th>
      <th class="text-center"><%=camponumerico2 (cantidad + cant_add) - asignados  rescue nil %></th>
    </tr>
	</table>
</div>
<div class="modal fade" id="actividad"><div class="modal-dialog" style='width: 90%;'><div class="modal-content" style='width: 90%;'></div></div></div>
<div class="modal fade" id="cargosnota"><div class="modal-dialog" style='width: 90%;'><div class="modal-content" style='width: 90%;'></div></div></div>
<div class="modal fade" id="actividades"><div class="modal-dialog" style='width: 90%;'><div class="modal-content" style='width: 90%;'></div></div></div>