<p id="notice"><%= notice %></p>

<h1>Migracionesexamenes</h1>

<table>
  <thead>
    <tr>
      <th>Personasformulario</th>
      <th>User</th>
      <th>Archivo</th>
      <th>Descripcion</th>
      <th>Direccion</th>
      <th>Recomendaciones</th>
      <th>Fecha</th>
      <th>Hora</th>
      <th>Estado</th>
      <th>Observacion eps</th>
      <th>Estado cargue</th>
      <th>Error</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @migracionesexamenes.each do |migracionesexamen| %>
      <tr>
        <td><%= migracionesexamen.personasformulario_id %></td>
        <td><%= migracionesexamen.user_id %></td>
        <td><%= migracionesexamen.archivo_id %></td>
        <td><%= migracionesexamen.descripcion %></td>
        <td><%= migracionesexamen.direccion %></td>
        <td><%= migracionesexamen.recomendaciones %></td>
        <td><%= migracionesexamen.fecha %></td>
        <td><%= migracionesexamen.hora %></td>
        <td><%= migracionesexamen.estado %></td>
        <td><%= migracionesexamen.observacion_eps %></td>
        <td><%= migracionesexamen.estado_cargue %></td>
        <td><%= migracionesexamen.error %></td>
        <td><%= link_to 'Show', migracionesexamen %></td>
        <td><%= link_to 'Edit', edit_migracionesexamen_path(migracionesexamen) %></td>
        <td><%= link_to 'Destroy', migracionesexamen, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

