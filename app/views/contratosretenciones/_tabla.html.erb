<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
	  <thead class="thcolor">
      <tr>
        <td width="10%"></td>
        <th class="text-left">Descripción de la retencion</th>
        <th width="10%" class="text-center">Estado</th>
      </tr>
    </thead>
	  <tbody id="tbody_contratosretenciones">
	    <% @contrato.contratosretenciones.includes([:tipospretencion]).order(id: :desc).each do |contratosretencion| %>
	      <%= render 'contratosretenciones/tr', contratosretencion: contratosretencion %>
	    <% end %>
	  </tbody>
	</table>
</div>
