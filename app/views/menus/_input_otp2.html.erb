<div class="row">
  <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2 text-center">
    <%= text_field_tag :nr7, params[:nr7], { class: "form-control2 input7 campo_otp", maxlength: "1", oninput: "if(this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);", onkeyup: "moveToNext(this, 'nr8')" } %>
    <div align="center">
      <label class='keys7'></label>
    </div>
