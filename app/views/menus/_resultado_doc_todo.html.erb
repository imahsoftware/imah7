<% if @controlfirmas.present? %>
  <div class="box-body">
    <table class="table table-bordered table-condensed table-striped">
      <thead>
      <tr class="thcolor">
        <th class="text-left" width="30%">Empleado</th>
        <th class="text-left" width="30%">Contrato</th>
        <th class="text-left" width="15%">Fecha Firma</th>
        <th class="text-left">Tipo Documento</th>
      </tr>
      </thead>
      <tbody>
      <% @controlfirmas.where("estado = '#{@p.downcase.to_s}'").each do |c| %>
        <%= render 'menus/tr_doc_todo', c: c, p: p %>
      <% end %>
      </tbody>
    </table>
    <div class="box-tools pull-right">
      <%= will_paginate @controlfirmas, :param_name => "doc_#{@p.downcase.to_s}", renderer: BootstrapPagination::Rails %>
    </div><!-- /.box-tools -->
  </div>
<% else %>
  <div class="alert alert-danger">
    <h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %> </div>
<% end %>