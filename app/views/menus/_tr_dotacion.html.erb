<tr id="tr_dotacion_check<%= contratosperfecha.id %><%= p %>">
  <td class="text-center text-table-10">
    <% if contratosperfecha.val_dotacion == 'PENDIENTE' %>
      <%= link_to entregar_dotacion_contratosperfechas_path(id: contratosperfecha.id, ruta: p), remote: true, data: { toggle: 'tooltip' }, title: 'Marcar como Entregado' do %>
        <button class="btn btn-xs btn-info"><i class="fa fa-check"></i></button>
      <% end %>
    <% end %>
  </td>
  <td align="left" class="text-table-10">
    <%= contratosperfecha.contratospersona.autobuscar rescue nil %>
    <br/>
    <%= link_to carta_dotacion_contratosperfechas_path(id: contratosperfecha.id, format: :pdf), data: { toggle: 'tooltip' }, class: 'popup', title: 'Carta Entrega de Dotación' do %>
      <i class="fa fa-file-pdf-o"></i> Carta Entrega de Dotación
    <% end %>
    <% if contratosperfecha.codigo_firma.present? %>
      <br/> <small style="color: red"><i class="fa fa-check"></i> Contrato Firmado </small><br/>
    <% end %>
  </td>
  <td align="left" class="text-table-10">
    <small><%= contratosperfecha.contrato.empresa.identnombre rescue nil %> - <strong>Nro Contrato : </strong><%= contratosperfecha.contrato.nro_contrato rescue nil %>
      <br/><strong>Cargo : </strong><%= contratosperfecha.contratoscargo.perfil rescue nil %>
      <br/><strong>Grupo Nomina : </strong><%= contratosperfecha.contratosgrupo.descripcion rescue nil %>
      <% if contratosperfecha.contratosseccion_id.present? %>
        <br/><strong>Sección : </strong><%= contratosperfecha.contratosseccion.descripcion2 rescue nil %>
      <% end %>
      <br/><strong>Dirección : </strong><%= contratosperfecha.contratospersona.direcciontelefono rescue nil %>
    </small>
  </td>
  <td align="center" class="text-table-10">
    <%= contratosperfecha.contratospersona.talla_pantalon rescue nil %> -
    <b>(<%= contratosperfecha.contratospersona.cant_pantalon rescue 0 %>)</b>
  </td>
  <td align="center" class="text-table-10">
    <%= contratosperfecha.contratospersona.talla_camisa rescue nil %> -
    <b>(<%= contratosperfecha.contratospersona.cant_camisa rescue 0 %>)</b>
  </td>
  <td align="center" class="text-table-10">
    <%= contratosperfecha.contratospersona.talla_zapatos rescue nil %> -
    <b>(<%= contratosperfecha.contratospersona.cant_zapatos rescue 0 %>)</b>
  </td>
  <td align="center" class="text-table-10">
    <div class="tiptext">
      <div class="description">
        <% if Contratoscargosnota.where("contratoscargo_id = #{contratosperfecha.contratoscargo_id}").present? %>
          <table width="100%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
            <tr>
              <th height="20" width="80%" style="background: #E8E3E3; padding: 5px;" class="text-table-10"> ELEMENTO</th>
              <th style="background: #E8E3E3; padding: 5px;" class="text-table-10">CANTIDAD</th>
            </tr>
            <% Contratoscargosnota.where("contratoscargo_id = #{contratosperfecha.contratoscargo_id}").each do |a| %>
              <tr>
                <td height="20" style=" padding: 5px;">
                  <div align="left" class="text-table-10"><%= a.observacion %></div>
                </td>
                <td height="20" style=" padding: 5px;">
                  <div align="center" class="text-table-10"><%= a.cantidad %></div>
                </td>
              </tr>
            <% end %>
          </table>
        <% else %>
          NO hay elementos de proteccion personal.
        <% end %>
      </div>
      <i class='fa fa-info'></i>
    </div>
  </td>
</tr>