<div class="modal-header">
  <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
  <h4 class="modal-title">Documentos Inscripción
    <br/>
    <small><%= @contratosperfecha.contratospersona.autobuscar rescue nil %></small></h4>
</div>

<div class="modal-body">
  <div class="row">
    <div class="col-md-12">
      <table class="table table-bordered table-condensed table-striped">
        <thead class="thcolor">
        <tr>
          <td width="40%" class="text-left">Tipo</td>
          <th class="text-left">Documento Digital</th>
        </tr>
        </thead>
        <tbody>
        <% Personasformulariosdoc.includes([:parcargosdoc]).where("estado = 'APROBADO' and personasformulario_id = #{@contratosperfecha.personasformulario_id}").each do |personasformulariosdoc| %>
        <tr>
          <td class="text-left text-table"><%= personasformulariosdoc.parcargosdoc.descripcion rescue nil %></td>
          <td class="text-left text-table">
            <% if personasformulariosdoc.soporte_digital_file_name.present? %>
              <%= link_to personasformulariosdoc.soporte_digital.url(:original, false), data: { toggle: 'tooltip' }, title: "Ver Documento", onclick: 'window.open(this.href,"new_window","height=450,width=600,scrollbars=yes");return false;' do %>
                <i class="fa fa-cloud-download"></i> <%= personasformulariosdoc.soporte_digital_file_name rescue nil %>
              <% end %>
              <% if personasformulariosdoc.observacion.present? %>
                <div class="text-justify text-red">
                  <small><b>Observacion: </b> <%= personasformulariosdoc.observacion rescue nil %></small>
                </div>
              <% end %>
            <% end %>
          </td>
        </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>