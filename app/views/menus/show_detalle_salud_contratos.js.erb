<% if @ruta == 'ABRIR' %>
$("#abrir_detalle_salud<%= @contratosperfecha.id %><%= @estado %>").html('<%= j render "abrir_detalle_salud", contratosperfechasdocs: @contratosperfechasdocs, contratosperfecha: @contratosperfecha  %>');
$("#abrir<%= @contratosperfecha.id %><%= @estado %>").addClass("hide");
$("#cerrar<%= @contratosperfecha.id %><%= @estado %>").removeClass("hide");
<% else %>
$("#abrir<%= @contratosperfecha.id %><%= @estado %>").removeClass("hide");
$("#cerrar<%= @contratosperfecha.id %><%= @estado %>").addClass("hide");
$("#abrir_detalle_salud<%= @contratosperfecha.id %><%= @estado %>").html(null);
<% end %>

$(function(){
    $('.pagination a').attr('data-remote', 'true')
});