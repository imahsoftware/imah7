<% if @ruta == 'ABRIR' %>
$("#abrir_detalle_compromiso<%= @fecha %>").html('<%= j render "menus/abrir_detalle_compromiso" %>');
$("#abrir_compromiso<%= @fecha %>").addClass("hide");
$("#cerrar_compromiso<%= @fecha %>").removeClass("hide");
$("#tr_show_compromiso<%= @fecha %>").removeClass("hidden");
<% else %>
$("#abrir_compromiso<%= @fecha %>").removeClass("hide");
$("#cerrar_compromiso<%= @fecha %>").addClass("hide");
$("#abrir_detalle_compromiso<%= @fecha %>").html(null);
$("#tr_show_compromiso<%= @fecha %>").addClass("hidden");
<% end %>
$(function(){
    $('.pagination a').attr('data-remote', 'true')
});