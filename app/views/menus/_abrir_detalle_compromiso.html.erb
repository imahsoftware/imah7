                  </div>
                </div>
              <% end %>
              </tbody>
            </table>
          <% else %>
            <div class="alert alert-danger">
              <h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %></div>
          <% end %>
        </div>

        <div class="tab-pane" id="finalizado<%= @fechaparams %>">
