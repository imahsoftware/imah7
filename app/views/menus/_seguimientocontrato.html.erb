                          <tr class="thcolor">
                            <th width="10%" class="text-center"></th>
                            <th width="10%" class="text-center">Identificación</th>
                            <th width="40%" class="text-justify" style="font-size:12px;">Nombre</th>
                            <th width="25%" class="text-left">Ubicación</th>
                            <th width="15%" class="text-center">Fecha y Hora</th>
                          </tr>
                          </thead>
                          <tbody id="tbody">
                          <% @contratosperexamenesp.each do |p| %>
                            <tr>
                              <td class="text-center" style="font-size:12px;">
                                <%= link_to edit_contratospersona_path(p.contratospersona_id, etapa: 'B'), class: 'edit_contratospersona_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
                                  <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
                                <% end %>
                                <% if p.recordacion.to_s == "" %>
                                  <%= link_to cambioestado_contratosperexamenes_path(id: p.id, estado: "RECORDATORIOE"), data: {toggle: 'tooltip', confirm: "Seguro que desea marcar la recordacion?"}, title: 'LLamada realizada' do %>
                                    <button class="btn btn-xs btn-info"><i class="fa fa-phone"></i></button>
                                  <% end %>
                                <% end %>
                              </td>
                              <td class="text-center" style="font-size:12px;"><%= p.contratospersona.identificacion rescue nil%></td>
                              <td class="text-justify" style="font-size:12px;"><%= p.contratospersona.nombre_completo rescue nil%> <small>(Edad <%=p.contratospersona.edad%>)</small>
                                <small><br/><strong>Cargo: </strong><%= p.contratospersona.cargo rescue nil%>
                                  <br/><strong>Telefonos: </strong><%= p.contratospersona.tele rescue nil%>
                                  <% if p.recomendaciones %><br/><strong>Recomendacion: <%= p.recomendaciones rescue nil %></strong><% end %>
                                </small>
                              </td>
                              <td class="text-left" style="font-size:12px;"><%= p.direccion rescue nil%>
                                <br/><strong><small><%= p.descripcion rescue nil%></small></strong>
                                <% if p.observacion_llamada %><br/><small><strong>Nota: <%= p.observacion_llamada rescue nil %></strong></small><% end %>
                              </td>
                              <td class="text-center" style="font-size:12px;"><%= p.fecha rescue nil%> - <%= p.hora rescue nil%>
                                <% if p.recordacion.to_s != "" %> <br/><small>Recordación realizada <i class="fa fa-phone"></i></small><% end %>
                              </td>
                            </tr>
                          <% end %>
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                <% else %>
                  <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
