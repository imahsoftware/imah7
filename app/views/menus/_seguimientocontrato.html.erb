<%
  apoyo = is_auth_c('dashseguimientoapoyo')
  if apoyo %>
  <legend style="margin-top: -19px;">DashBoard Solicitudes</legend>
  <div class="row">
    <div class="col-md-12">
      <div class="nav-tabs-custom">
        <ul class="nav nav-tabs">
          <li class="active"><a href="#pendientes1" data-toggle="tab" aria-expanded="true"><i class="fa fa-thumbs-o-up"></i> Pendientes </a></li>
        </ul>
        <div class="tab-content">
          <div class="tab-pane active" id="pendientes1">

            <% @users.each do |u|
                @contratosperexamenesp = Contratosperexamen.where("estado = 'PENDIENTE' and contratospersona_id in (select id from contratospersonas where user_asignado = #{u.id})
                                                                   and contratospersona_id not in (select distinct contratospersona_id from contratosperestados)").order("created_at desc")
                positivas = Contratosperexamen.where("recordacion is not null and estado = 'PENDIENTE' and contratospersona_id in (select id from contratospersonas where user_asignado = #{u.id})
                                                                   and contratospersona_id not in (select distinct contratospersona_id from contratosperestados)").count
                negativas = Contratosperexamen.where("recordacion is null and estado = 'PENDIENTE' and contratospersona_id in (select id from contratospersonas where user_asignado = #{u.id})
                                                                   and contratospersona_id not in (select distinct contratospersona_id from contratosperestados)").count
            %>
                <div id="personasobligacion_<%= u.id %>" class="box box-info collapsed-box">
                  <div class="box-header with-border">
                    <div class="row">
                      <div class="col-md-12">
                        <span class="btn btn-box-tool" data-widget="collapse">
                          <i class="fa fa-plus"></i>
                            <h3 class="box-title"><%= u.nombre rescue nil %>
                              <label class='label label-warning'><i class="fa fa-phone"></i> <%=positivas rescue 0%></label>
                              <label class='label label-danger'><i class="fa fa-phone"></i> <%=negativas rescue 0%></label>
                            </h3>
                        </span>
                      </div>
                    </div>
                  </div>
                  <div class="box-body">
                    <div class="row">
                      <div class="col-md-12">
                        <div class="table-responsive">
                          <table class="table table-bordered table-condensed table-striped">
                            <thead>
                            <tr class="thcolor">
                              <th width="10%" class="text-center"></th>
                              <th width="10%" class="text-center">Identificación</th>
                              <th width="35%" class="text-justify">Nombre</th>
                              <th width="30%" class="text-left">Examen</th>
                              <th width="15%" class="text-center">Fecha y Hora</th>
                            </tr>
                            </thead>
                            <tbody id="tbody">
                            <% @contratosperexamenesp.each do |p| %>
                              <tr>
                                <td class="text-center" style="font-size:12px;">
                                  <%= link_to edit_contratospersona_path(p.contratospersona_id, etapa: 'B'), class: 'edit_contratospersona_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
                                    <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
                                  <% end %>
                                  <% if p.recordacion.to_s == "" %>
                                    <%= link_to cambioestado_contratosperexamenes_path(id: p.id, estado: "RECORDATORIO"), data: {toggle: 'tooltip', confirm: "Seguro que desea marcar la recordacion?"}, title: 'LLamada realizada' do %>
                                      <button class="btn btn-xs btn-info"><i class="fa fa-phone"></i></button>
                                    <% end %>
                                  <% end %>
                                </td>
                                <td class="text-center" style="font-size:12px;"><%= p.contratospersona.identificacion rescue nil%></td>
                                <td class="text-justify" style="font-size:12px;"><strong><%= p.contratospersona.nombre_completo rescue nil%> </strong><small>(Edad <%=p.contratospersona.edad%>)</small>
                                  <small><br/><strong>Cargo: </strong><%= p.contratospersona.cargo rescue nil%>
                                    <br/><strong>Telefonos: </strong><%= p.contratospersona.tele rescue nil%></small>
                                </td>
                                <td class="text-left" style="font-size:12px;"><%= p.direccion rescue nil%>
                                  <br/><strong><small><%= p.descripcion rescue nil%></small></strong>
                                </td>
                                <td class="text-center" style="font-size:12px;"><%= p.fecha rescue nil%> - <%= p.hora rescue nil%>
                                  <% if p.recordacion.to_s != "" %> <br/><small class="text-blue">Recordación realizada <i class="fa fa-phone"></i></small><% end %>
                                  <% if p.contratospersona.contrato_fecha.to_s != "" %>
                                    <br/><small>Cita Contrato: <%= p.contrato_fecha rescue nil%> - <%= p.contrato_hora rescue nil%></small>
                                  <% end %>
                                </td>
                              </tr>
                            <% end %>
                            </tbody>
                          </table>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
            <% end %>
