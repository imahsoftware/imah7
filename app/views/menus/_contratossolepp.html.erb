<br/><br/>
<% acceso = is_auth_c("marcarestados") %>
<table class="table table-bordered table-condensed table-striped">
  <thead>
  <tr class="thcolor">
    <th width="5%" class="text-center" style="font-size:11px;"></th>
    <th width="13%" class="text-center" style="font-size:11px;">Fecha</th>
    <th width="5%" class="text-center" style="font-size:11px;">Nro.</th>
    <th width="35%" class="text-left" style="font-size:11px;">Empresa</th>
    <th class="text-left" style="font-size:11px;">Solicitante</th>
    <th class="text-center" style="font-size:11px;">Fecha Entrega</th>
  </tr>
  </thead>
  <tbody id="tbody">
  <% solicitudes.each do |p| %>
    <tr>
      <td class="text-center" style="font-size:12px;">
        <div class="btn-group" id="botones<%= p.id %>">
          <button type="button" class="btn btn-warning dropdown-toggle btn-xs" data-toggle="dropdown">
            Opciones <span class="caret"></span>
            <span class="sr-only">Toggle Dropdown</span>
          </button>
          <ul class="dropdown-menu" role="menu">
            <li>
              <%= link_to edit_contrato_path(id: p.contrato_id, etapa: 'A'), class: 'edit_contrato_button', data: { toggle: 'tooltip' } do %>
                <div class="text-blue"><i class="fa fa-file-o"></i> Ir al contrato</div>
              <% end %>
            </li>
            <% if p.estado.to_s != 'PENDIENTE' %>
              <li>
                <%= link_to rotulo_contratossolepps_path(id: p.id), data: { toggle: 'tooltip' }, class: 'popup_rotulo' do %>
                  <div class="text-blue"><i class="fa fa-file-o"></i> Generar Rotulo</div>
                <% end %>
              </li>
            <% end %>
            <li>
              <%= link_to complementar_contratossolepps_path(id: p.id, etapa: 'A'), class: 'edit_contratossolepp_button',  data: { toggle: 'tooltip' } do %>
                <div class="text-orange"><i class="fa fa-edit"></i> Editar solicitud</div>
              <% end %>
            </li>
            <li>
              <%= link_to ver_contratossolepps_path(id: p.id), data: { toggle: 'tooltip' }, class: 'popup' do %>
                <div class="text-blue"><i class="fa fa-clone"></i> Ver solicitud</div>
              <% end %>
            </li>
            <% if acceso
                 if p.estado.to_s == 'ENVIADO' %>
                <li>
                  <%= link_to estado_contratossolepps_path(id: p.id, estado: "PENDIENTE"), remote: true, data: { toggle: 'tooltip', confirm: "Seguro que desea reversar a PENDIENTE?" } do %>
                    <div class="text-blue"><i class="fa fa-arrow-left" aria-hidden="true"></i> Marcar PENDIENTE</div>
                  <% end %>
                </li>
                <li>
                  <%= link_to estado_contratossolepps_path(id: p.id, estado: "APROBADO"), remote: true, data: { toggle: 'tooltip', confirm: "Seguro que desea marcar EN PROCESO?" } do %>
                    <div class="text-blue"><i class="fa fa-arrow-right" aria-hidden="true"></i> Marcar APROBADO</div>
                  <% end %>
                </li>
                <li>
                  <%= link_to estado_contratossolepps_path(id: p.id, estado: "RECHAZADO"), remote: true, data: { toggle: 'tooltip', confirm: "Seguro que desea marcar EN PROCESO?" } do %>
                    <div class="text-blue"><i class="fa fa-arrow-left" aria-hidden="true"></i> Marcar RECHAZADO</div>
                  <% end %>
                </li>
                <li>
                  <%= link_to contratossolepp_path(id: p.id), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
                    <div class="text-blue"><i class="fa fa-trash"></i> Eliminar</div>
                  <% end %>
                </li>
              <% elsif p.estado.to_s == 'PENDIENTE' %>
                <li>
                  <%= link_to estado_contratossolepps_path(id: p.id, estado: "ENVIADO"), remote: true, data: { toggle: 'tooltip', confirm: "Seguro que desea marcar ENVIADO?" } do %>
                    <div class="text-blue"><i class="fa fa-arrow-right" aria-hidden="true"></i> Marcar ENVIADO</div>
                  <% end %>
                </li>
                <li>
                  <%= link_to contratossolepp_path(id: p.id), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
                    <div class="text-blue"><i class="fa fa-trash"></i> Eliminar</div>
                  <% end %>
                </li>
              <% elsif p.estado.to_s == 'APROBADO' %>
                <li>
                  <%= link_to estado_contratossolepps_path(id: p.id, estado: "DESPACHADO"), remote: true, data: { toggle: 'tooltip', confirm: "Seguro que desea reversar a ENVIADO?" } do %>
                    <div class="text-blue"><i class="fa fa-arrow-right" aria-hidden="true"></i> Marcar DESPACHADO</div>
                  <% end %>
                </li>
                <li>
                  <%= link_to estado_contratossolepps_path(id: p.id, estado: "ENVIADO"), remote: true, data: { toggle: 'tooltip', confirm: "Seguro que desea marcar ENVIADO?" } do %>
                    <div class="text-blue"><i class="fa fa-arrow-left" aria-hidden="true"></i> Marcar ENVIADO</div>
                  <% end %>
                </li>
              <% elsif p.estado.to_s == 'DESPACHADO'
                   if p.contratossoleppsatenciones.where("codigo_firma is not null").present? %>
                  <li>
                    <%= link_to estado_contratossolepps_path(id: p.id, estado: "ENTREGADO"), remote: true, data: { toggle: 'tooltip', confirm: "Seguro que desea marcar ENTREGADO?" } do %>
                      <div class="text-blue"><i class="fa fa-truck" aria-hidden="true"></i> Marcar Como Entregado</div>
                    <% end %>
                    <%#= link_to otp_contratossolepps_path(id: p.id), remote: true, data: { toggle: 'tooltip', confirm: "Seguro que desea marcar Entregado?" } do %>
                  </li>
                <% end %>
                  <li>
                    <%= link_to estado_contratossolepps_path(id: p.id, estado: "RECHAZADO"), remote: true, data: { toggle: 'tooltip', confirm: "Seguro que desea marcar EN PROCESO?" } do %>
                      <div class="text-blue"><i class="fa fa-arrow-left" aria-hidden="true"></i> Marcar RECHAZADO</div>
                    <% end %>
                  </li>
              <% end %>
            <% end %>
          </ul>
        </div>
      </td>
      <td class="text-center" style="font-size:12px;"><%= p.created_at.strftime("%Y-%m-%d %X") rescue nil %></td>
      <td class="text-center" style="font-size:12px;"><%= p.id rescue nil %></td>
      <td class="text-left" style="font-size:12px;"><%= p.identnombre rescue nil %> <small>(<%= p.nro_contrato rescue nil %>)</small></td>
      <td class="text-left" style="font-size:12px;"><small><%= p.usernombre.html_safe rescue nil %></small>
        <% if p.estado.to_s == 'DESPACHADOS' and p.fecha_despacho.to_s != "" %>
          <br/><small class="text-red"><strong>Fecha despacho: <%= p.fecha_despacho.strftime("%Y-%m-%d") rescue nil %></strong></small>
        <% end %>
        <% if p.estado.to_s == 'PENDIENTE' and p.solicitud_aprobacion.to_s != "" %>
          <br/><small class="text-red"><strong>Solicitud de aprobación <%=p.solicitud_aprobacion.strftime("%Y-%m-%d") rescue nil %></strong></small>
        <% end %>
      </td>
      <td class="text-center" style="font-size:12px;"><%= p.codigo_fecha.strftime("%Y-%m-%d") rescue nil %></td>
    </tr>
    <div class="modal fade" id="otp<%= p.id %>">
      <div class="modal-dialog modal-dialog-responsive" role="document">
        <div class="modal-content">
        </div>
      </div>
    </div>
  <% end %>
  </tbody>
</table>
