<div class="box-body">
  <legend style="margin-top: -19px;">Evaluación de documentos</legend>
  <% usr = @usr %>
  <div class="row">
    <div class="col-md-12">
      <div class="nav-tabs-custom">
        <ul class="nav nav-tabs">
          <%
            ["PENDIENTE", "APROBADO", "RECHAZADO"].each do |e|
              if usr.etapa.to_s == "EVAL_#{e}"
                clase = "active"
              else
                clase = ""
              end
          %>
            <li class="<%= clase %>">
              <%= link_to etapar_menus_path(etapa: "EVAL_#{e}") do %>
                <i class="fa fa-adn"></i> <%= e %>
              <% end %>
            </li>
          <% end %>
        </ul>
        <div class="tab-content">
          <%
            ["PENDIENTE", "APROBADO", "RECHAZADO"].each do |e|
              if usr.etapa.to_s == "EVAL_#{e}"
          %>
              <div class="box-body">
                <div class="row">
                  <div class="col-xs-12">
                    <div class="row" style="margin-top: -10px;">
                      <div class="col-md-4">
                        <%= form_tag searchevalua_documento_menus_path(estado: e), remote: true, method: :get do %>
                          <div class="form-group input-group" style="padding-bottom: 10px;">
                            <span class="input-group-addon"><i class="fa fa-users"></i></span>
                            <%= text_field_tag :autobuscar, params[:autobuscar], class: 'form-control uppercaseInput', autocomplete: 'off', style: "width: 100%", placeholder: 'Identificación, Nombre o Apellido' %>
                            <span class="input-group-btn">
                              <%= button_tag type: 'submit', class: 'btn btn-primary', data: { toggle: 'tooltip' }, title: 'Buscar' do %>
                                <i class="fa fa-search" aria-hidden="true"></i>
                              <% end %>
                            </span>
                          </div>
                        <% end %>
                      </div>
                    </div>
                    <div id="resultado_evalua_todo<%= e.downcase %>"></div>
                  </div>
                  <br/><br/>
                  <div id="evalua_documento<%= e.downcase.to_s %>">
                    <% if @contratosperimagenes.present? %>
                      <table class="table table-bordered table-condensed table-striped">
                        <thead>
                        <tr class="thcolor">
                          <th class="text-left text-table" >Empleado</th>
                          <th width="18%" class="text-left  text-table">Observación Usuario</th>
                          <th width="28%" class="text-left  text-table">Observación Supervisor</th>
                          <th width=8%" class="text-center  text-table"></th>
                        </tr>
                        </thead>
                        <tbody>
                        <% @contratosperimagenes.each do |p| %>
                          <tr id="tr_documento<%= p.id %>">
                            <td class="text-left" style="font-size:11px;">
                              <span data-toggle="tooltip" data-html="true" data-original-title="<div align='left'><%= p.user_nombre.html_safe rescue nil %></div>"><i class="fa fa-user" aria-hidden="true"></i></span>
                              <strong><%= p.contratospersona.identificacion rescue nil %> <%= p.contratospersona.nombre_completo rescue nil %></strong>
                              <br/><%= link_to p.personasimagen.url(:original, false), data: { toggle: 'tooltip' }, title: "Ver Documento", onclick: 'window.open(this.href,"new_window","height=450,width=600,scrollbars=yes");return false;' do %>
                                <i class="fa fa-cloud-download"></i> <%= p.descripcion rescue nil %>
                              <% end %><br/>
                            <small><%= p.contratosperfecha.contrato.empresa.identnombre rescue nil %> -  <strong>Nro Contrato : </strong><%= p.contratosperfecha.contrato.nro_contrato rescue nil %>
                              <br/><strong>Cargo : </strong><%= p.contratosperfecha.contratoscargo.perfil rescue nil %> - <strong>Grupo Nomina : </strong><%= p.contratosperfecha.contratosgrupo.descripcion rescue nil %>
                              <% if Contratosperfecha.find(p.contratosperfecha_id).contratosseccion_id.present? %>
                                <br/><strong>Sección : </strong><%= p.contratosperfecha.contratosseccion.descripcion2 rescue nil %>
                              <% end %>
                            </small>
                            </td>
                            <td class="text-left text-table" style="font-size:11px;">
                              <%= p.observacion_documento rescue nil %>
                            </td>
                            <td class="text-center text-table">
                              <%= simple_form_for p, :url => update_observacion_contratosperimagenes_path(id: p.id), id: "target#{p.id}", :method => :post, remote: true do |f| %>
                                <div class="row">
                                  <% if e == 'PENDIENTE' %>
                                    <div class="col-md-12 text-center">
                                      <%= f.input :observacion_aprobacion, as: :text, :input_html => { id: "observacion#{p.id}", :onchange => "javascript:this.value=this.value.toUpperCase();", :rows => 2 }, label: false %>
                                      <div id="mensaje_error<%= p.id %>"></div>
                                    </div>
                                  <% else %>
                                    <div class="col-md-12 text-left text-table">
                                      <%= p.observacion_aprobacion rescue nil %>
                                    </div>
                                  <% end %>
                                </div>
                              <% end %>
                              <script type="text/javascript" charset="utf-8">
                                  $('#observacion<%= p.id %>').change(function () {
                                      $('#observacion<%= p.id %>').submit();
                                  });
                              </script>
                            </td>
                            <td class="text-center" style="font-size:11px;">
                              <% if p.estado == 'PENDIENTE' %>
                                <%= link_to decision_contratosperimagenes_path(id: p.id, estado: 'APROBADO'), remote: true, data: { confirm: "Esta Seguro?", toggle: 'tooltip' }, title: "Aprobar Documento" do %>
                                  <button class="btn btn-xs btn-success"><i class="fa fa-check"></i></button>
                                <% end %>
                                <%= link_to decision_contratosperimagenes_path(id: p.id, estado: 'RECHAZADO'), remote: true, data: { confirm: "Esta Seguro?", toggle: 'tooltip' }, title: "Rechazar Documento" do %>
                                  <button class="btn btn-xs btn-danger"><i class="fa fa-close"></i></button>
                                <% end %>
                              <% end %>
                            </td>
                          </tr>
                        <% end %>
                        </tbody>
                      </table>
                      <div class="box-tools pull-right">
                        <%= will_paginate @contratosperimagenes, :param_name => "eval_#{e.downcase.to_s}", remote: true, renderer: BootstrapPagination::Rails %>
                      </div><!-- /.box-tools -->
                    <% else %>
                      <div class="alert alert-danger">
                        <h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %></div>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>