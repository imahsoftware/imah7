<section class="content-header" style="padding: 0px 15px 0 15px !important; margin-top: -10px;">
  <h1 style="font-size: 20px;">DashBoard Compromisos
    <div class="pull-right">
      <b class="text-red">PENDIENTES</b> <i class="fa fa-certificate text-red"></i> &nbsp;
      <b class="text-blue">RECHAZADOS</b> <i class="fa fa-certificate text-blue"></i> &nbsp;
      <b class="text-green">FINALIZADOS</b> <i class="fa fa-certificate text-green"></i>
    </div>
  </h1>
</section>
<br/>

<div class="box">
  <div class="box-body">
    <div class="col-xs-12">
      <div class="pull-right">
        <%= link_to informe_datas_path(infgrupo_id: 102, portafolio_id: 'PENDIENTE', format: :xlsx), data: { toggle: 'tooltip' }, title: "Informe Compromisos" do %>
          <button class="btn btn-xs btn-info"><i class="fa fa-file-excel-o"></i> Generar Informe
          </button>
        <% end %>
      </div>
      <table class="table table-bordered table-condensed table-striped">
        <thead>
        <tr class="thcolor">
          <th class="text-left">Fecha</th>
        </tr>
        </thead>
        <tbody>
        <% @fechas.each do |fecha|%>
          <tr>
            <td>
              <div id="abrir_compromiso<%= fecha.periodo %>" class="pull-left">
                <%= link_to show_detalle_compromiso_menus_path(fecha: fecha.periodo, ruta: 'ABRIR'), remote: true do %>
                  <i class="fa fa-arrow-circle-down" data-toggle="tooltip" style="color:green;" data-original-title="Pulsa aquí para Ver Empleados"></i>
                  <% if fecha.periodo == Time.now.strftime('%Y-%m') %>
                    <i class="text-red fa fa-star"></i> <%= fecha.periodo %>
                  <% else %>
                    <%= fecha.periodo %>
                  <% end %>
                <% end %>
              </div>
              <div id="cerrar_compromiso<%= fecha.periodo %>" class="pull-left hide">
                <%= link_to show_detalle_compromiso_menus_path(fecha: fecha.periodo, ruta: 'CERRAR'), remote: true do %>
                  <i class="fa fa-arrow-circle-up" data-toggle="tooltip" style="color:red;" data-original-title="Pulsa aquí para Ver Empleados"></i>
                  <% if fecha.periodo == Time.now.strftime('%Y-%m') %>
                    <i class="text-red fa fa-star"></i> <%= fecha.periodo %>
                  <% else %>
                    <%= fecha.periodo %>
                  <% end %>
                <% end %>
              </div>
              <div class="pull-right">
                <b class="text-red"><%= fecha.cnt_pendientes rescue nil %></b>
                <i class="fa fa-certificate text-red"></i> &nbsp;
                <b class="text-blue"><%= fecha.cnt_rechazados rescue nil %></b>
                <i class="fa fa-certificate text-orange"></i> &nbsp;
                <b class="text-green"><%= fecha.cnt_finalizados rescue nil %></b>
                <i class="fa fa-certificate text-green"></i>
              </div>
            </td>
          </tr>
          <tr id="tr_show_compromiso<%= fecha.periodo %>" class="hidden">
            <td>
              <div id="abrir_detalle_compromiso<%= fecha.periodo %>" style="padding-left: 30px; padding-right: 30px;"></div>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
