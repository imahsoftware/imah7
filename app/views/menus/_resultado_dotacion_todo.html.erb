<% if @contratosprefechasdotacion_todo.present? %>
  <div class="box-body">
    <table class="table table-bordered table-condensed table-striped">
      <thead>
      <tr class="thcolor">
        <th class="text-left" width="5%"></th>
        <th class="text-left" width="25%">Empleado</th>
        <th class="text-left">Contrato</th>
        <th class="text-center" width="10%">Pantalon</th>
        <th class="text-center" width="10%">Camisa</th>
        <th class="text-center" width="10%">Zapatos</th>
        <th class="text-center" width="5%">EPP</th>
      </tr>
      </thead>
      <tbody>
      <% @contratosprefechasdotacion_todo.each do |contratosperfecha| %>
        <%= render 'menus/tr_dotacion', contratosperfecha: contratosperfecha, p: @p %>
      <% end %>
      </tbody>
    </table>
    <div class="box-tools pull-right">
      <%= will_paginate @contratosprefechasdotacion_todo, :param_name => "dota_#{@p.downcase.to_s}", renderer: BootstrapPagination::Rails %>
    </div><!-- /.box-tools -->
  </div>
<% else %>
  <div class="alert alert-danger">
    <h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %> </div>
<% end %>