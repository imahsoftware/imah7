<% if @ruta == 'ABRIR' %>
$("#abrir_detalle_docfirma<%= @contrato.id %><%= @estado_car %>").html('<%= j render "menus/abrir_detalle_docfirma_contrato", contrato: @contrato, contratosprefechasdocfirma: @contratosprefechasdocfirma, p: @p %>');
$("#abrir_docfirma<%= @contrato.id %><%= @estado_car %>").addClass("hide");
$("#cerrar_docfirma<%= @contrato.id %><%= @estado_car %>").removeClass("hide");
$("#tr_show_docfirma<%= @contrato.id %><%= @estado_car %>").removeClass("hidden");
<% else %>
$("#abrir_docfirma<%= @contrato.id %><%= @estado_car %>").removeClass("hide");
$("#cerrar_docfirma<%= @contrato.id %><%= @estado_car %>").addClass("hide");
$("#abrir_detalle_docfirma<%= @contrato.id %><%= @estado_car %>").html(null);
$("#tr_show_docfirma<%= @contrato.id %><%= @estado_car %>").addClass("hidden");
<% end %>
$(function(){
    $('.pagination a').attr('data-remote', 'true')
});