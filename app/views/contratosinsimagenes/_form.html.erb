<%= simple_form_for([@contratosinsimagen], remote: true) do |f| %>
  <%= f.hidden_field :contratosinsumo_id %>
  <div class="modal-header">
    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
    <h3 class="modal-title"><strong><%= @contratosinsimagen.new_record? ? 'Agregar' : 'Editar' %> imagen</strong></h3>
  </div>
  <div class="modal-body">
    <div class="row">
      <div class="col-md-12">
        <%= f.input :insumosimagen, as: :file, label: 'Archivo a cargar' %>
        <p class="help-block">Formatos permitidos: JPG, PNG</p>
      </div>
    </div>
  </div>
  <div class="modal-footer">
    <button type="button" class="pull-left btn btn-flat btn-default" data-dismiss="modal"><%=t :cancelar%></button>
    <div class="box-tools pull-right">
      <%= f.button :submit, 'Aceptar', class: 'btn btn-flat btn-primary' %>
    </div><!-- /.box-tools -->
  </div><!-- box-footer -->
<% end %>
