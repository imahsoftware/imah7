<table class="table table-bordered table-responsive table-striped">
  <thead>
  <tr class="thcolor">
  <tr class="thcolor">
    <th class="text-left text-table" width="5%"></th>
    <th class="text-left text-table" width="15%">Fecha</th>
    <th class="text-left text-table" width="20%">Tipo</th>
    <th class="text-center text-table" width="10%">Estado</th>
    <th class="text-center text-table" width="15%">Fecha Atención</th>
    <th class="text-left text-table">Observación</th>
  </tr>
  </thead>
  <tbody>
  <tbody id="tbody_empresas">
<% @soportes.each do |p| %>
  <tr>
    <td class="text-table text-center">
      <%= link_to edit_soporte_path(p), class: 'edit_cuenta_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
        <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
      <% end %>
    </td>
    <td class="text-table"><%= p.created_at.strftime("%Y-%m-%d %X") %><br/>
      <%= p.user.nombre rescue nil %></td>
    <td class="text-table"><%= p.tipo %></td>
    <td class="text-table text-center"><%= p.estado %></td>
    <td class="text-table text-center"><%= p.fecha_atencion.strftime("%Y-%m-%d %X") rescue nil %></td>
    <td class="text-table"><%= p.observacion %>
      <% if p.docsoporte_file_name.present? %><br/>
        <%= link_to p.docsoporte.url(:original, false), data: { toggle: 'tooltip' }, title: 'Ver Imagen', onclick: 'window.open(this.href,"new_window","height=450,width=600,scrollbars=yes");return false;' do %>
          <i class="fa fa-cloud-download text-danger"></i> <%= p.docsoporte_file_name rescue nil %>
        <% end %>
      <% end %>
    </td>
  </tr>
<% end %>
  </tbody>
</table>

<div class="box-tools pull-right">
  <%= will_paginate @soportes, :previous_label => '&laquo; Anterior', :next_label => 'Siguiente &raquo;', renderer: BootstrapPagination::Rails  %>
</div><!-- /.box-tools -->

<script>
    $(function(){
        $('.pagination a').attr('data-remote', 'true')
    });
</script>

