$(".alert_flash").fadeOut(300, function() {
	$(this).remove();
});

$("#contratosperalerta_<%= @contratosperalerta.id %>").replaceWith("<%= j render 'tr', contratosperalerta: @contratosperalerta %>");

$('[data-toggle="tooltip"]').tooltip();

$(".flash_messages").html("<%= j render 'layouts/flash_messages' %>");

setTimeout(function() {
	$(".alert_flash").fadeOut(300, function() {
		$(this).remove();
	});
}, 5000);
