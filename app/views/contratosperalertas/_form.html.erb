<%= simple_form_for([@contratospersona, @contratosperalerta], remote: true) do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :fecha, as: :string, input_html: { class: 'datepicker', data: {date_options: {format: 'DD/MM/YYYY', ignoreReadonly: true}}, readonly: true } %></div>
      <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8"><%= f.input :observacion, as: :text,:input_html => {:onchange => "javascript:this.value=this.value.toUpperCase();", :rows => 2 }, label: "Alerta" %></div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :estado, as: :select, collection: select_estado, input_html: { class: 'select2' } %></div>
      <% if is_auth_e("contratosperalertaconf") %>
      <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :confidencial, as: :select, collection: select_sino, input_html: { class: 'select2' } %></div>
      <% end %>
    </div>
    <div class="row">
      <div class="col-md-6">
        <% if @contratosperalerta.new_record? %>
          <%= button_tag "#{t :cancelar}", type: 'button', data: {target: '#contratosperalerta_form'}, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}", contratospersona_contratosperalerta_path(@contratospersona, @contratosperalerta), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
<br/>
