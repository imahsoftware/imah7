<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
	  <thead class="thcolor">
      <tr>
        <td width="10%"></td>
        <th class="text-left" width="15%">Fecha</th>
		<th class="text-left">Observación</th>
		<th class="text-left" width="15%">Estado</th>
      </tr>
    </thead>
	  <tbody id="tbody_contratosperalertas">
<%
    conf = @contratospersona.contratosperalertas.where("confidencial = 'NO'").order(id: :desc)
    if is_auth_e("contratosperalertaconf")
      conf = @contratospersona.contratosperalertas.order(id: :desc)
    end
%>
		<% conf.each do |contratosperalerta| %>
	      <%= render 'contratosperalertas/tr', contratosperalerta: contratosperalerta %>
	    <% end %>
	  </tbody>
	</table>
</div>
