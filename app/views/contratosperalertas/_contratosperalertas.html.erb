<div class="box-header">
  <h3 class="box-title"><strong>Alertas</strong></h3>
  <div class="box-tools pull-right">
    <%# if is_auth_c('contratosperalerta') %>
      <%= link_to new_contratospersona_contratosperalerta_path(@contratospersona), id: 'new_contratosperalerta_button', class: 'btn btn-sm btn-warning', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
      <% end %>
    <%# end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="contratosperalerta_form" class="collapse"></div>
  <div id="contratosperalertas">
<%
    conf = @contratospersona.contratosperalertas.where("confidencial = 'NO'")
    if is_auth_e("contratosperalertaconf")
      conf = @contratospersona.contratosperalertas
    end
%>
    <% if conf.present? %>
      <%= render 'contratosperalertas/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
    <% end %>
  </div>
</div>
