<div class="box-header">
  <h3 class="box-title"><strong>Inventario General</strong></h3>
  <div class="box-tools pull-right">
    <% if @contratossolicitud.estado.to_s == 'PENDIENTE' %>
      <%= link_to new_contratossolicitud_contratossolotro_path(@contratossolicitud), id: 'new_contratossolotro_button', class: 'btn btn-sm btn-warning', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
      <% end %>
    <% end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="contratossolotro_form" class="collapse"></div>
  <div id="contratossolotros">
    <% if @contratossolicitud.contratossolotros.order("created_at desc").present? %>
      <%= render 'contratossolotros/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
    <% end %>
  </div>
</div>
