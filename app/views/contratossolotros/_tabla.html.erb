<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
	  <thead class="thcolor">
      <tr>
        <td width="10%"></td>
        <th class="text-left">Bien o Servicio</th>
        <th width="5%" class="text-center">Cant.</th>
        <th width="10%" class="text-right">Vlr Unitario</th>
        <th width="15%" class="text-right">Total</th>
      </tr>
    </thead>
	  <tbody id="tbody_contratossolotros">
	    <% @contratossolicitud.contratossolotros.order(id: :desc).each do |contratossolotro| %>
	      <%= render 'contratossolotros/tr', contratossolotro: contratossolotro %>
	    <% end %>
	  </tbody>
    <tr class="thcolor">
      <td colspan="4" class="text-right">Valor total solicitado</th>
      <th width="10%" class="text-right"><%= camponumerico @contratossolicitud.contratossolotros.sum("total") rescue 0%></th>
    </tr>
	</table>
</div>
