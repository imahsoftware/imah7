<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
    <thead>
      <tr class="thcolor">
        <% if is_auth_c('tiposmevaluacion') %>
          <th width="8%"></th>
        <% end %>
        <th>Nodo</th>
        <th>Item</th>
        <th>Detalle</th>
        <th>Rta 1</th>
        <th>Rta 2</th>
        <th>Rta 3</th>
        <th>Clase</th>
      </tr>
    </thead>
    <tbody id="tbody_tiposmevaluaciones">
      <% @tiposmevaluaciones.order("tipo").each do |tiposmevaluacion| %>
        <%= render 'tiposmevaluaciones/tr', tiposmevaluacion: tiposmevaluacion %>
      <% end %>
    </tbody>
  </table>
</div>