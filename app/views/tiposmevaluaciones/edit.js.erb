$("#tiposmevaluacion_form").collapse("hide");

$("#tiposmevaluacion_form").empty();

<% if @active_record.present? %>
	$("#tiposmevaluacion_<%= @active_record.id %>").replaceWith("<%= j render 'tr', tiposmevaluacion: @active_record %>");
<% end %>

$("#tiposmevaluacion_<%= @tiposmevaluacion.id %>").html("<td colspan='12'><%= j render 'form' %></td>");

$("#tiposmevaluacion_<%= @tiposmevaluacion.id %>").addClass("active_tiposmevaluacion");
$(".select2").select2();
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
$(".datetimepicker").datetimepicker();
$('.datepicker').datepicker({
    dayNamesMin: [ "Dom", "Lun", "Mar", "Mie", "Jue", "Vie", "Sáb" ],
    monthNamesShort: [ "Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic" ],
    dateFormat: "yy-mm-dd",
    yearRange: '2000:2027',
    changeMonth: true,
    changeYear: true,
});