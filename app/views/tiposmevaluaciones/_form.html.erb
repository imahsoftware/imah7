<%= simple_form_for @tiposmevaluacion, remote: true do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :tipo, as: :select, collection: select_act_tipo, input_html: { data: { width: '100%' }, class: 'select2'}, label: "Nodo"%></div>
      <div class="col-xs-12 col-sm-12 col-md-5 col-lg-3"><%= f.input :descripcion, as: :select, collection: select_act_item, input_html: { data: { width: '100%' }, class: 'select2'}, label: "Item"%></div>
      <div class="col-xs-12 col-sm-12 col-md-5 col-lg-7"><%= f.input :detalle, input_html: { class: 'clean' } %></div>
    </div>
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :valor1, input_html: { class: 'clean' }, label: "Resultado 1" %></div>
      <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :valor2, input_html: { class: 'clean' }, label: "Resultado 2"%></div>
      <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :valor3, input_html: { class: 'clean' }, label: "Resultado 3" %></div>
      <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :clase, as: :select, collection: select_clasee, input_html: { data: { width: '100%' }, class: 'select2'}%></div></div>
    </div>
    <div class="row">
      <div class="col-md-6">
        <% if @tiposmevaluacion.new_record? %>
          <%= button_tag "#{t :cancelar}", type: 'button', data: { target: '#tiposmevaluacion_form' }, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}", tiposmevaluacion_path(@tiposmevaluacion), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
<br/>
