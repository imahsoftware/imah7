<div class="box-header">
  <h3 class="box-title"><strong>Detalles</strong>
    <% Contratosperinvacta.where("contratosperinventario_id = #{@contratosperinventario.id} and estado = 'FINALIZADO'").each do |contratosperinvacta| %>
      <%= link_to acta_contratosperinventarios_path(contratosperinvacta_id: contratosperinvacta.id, format: :pdf), data: {toggle: 'tooltip'}, class: 'popup',title: "Acta #{contratosperinvacta.consecutivo_acta}" do %>
        <button class="btn btn-xs btn-warning"><i class="fa fa-file-pdf-o"></i></button>
      <% end %>
    <% end %>
  </h3>
  <div class="box-tools pull-right">
    <% if @contratosperinventario.codigo_crea_firma.blank? and @contratosperinventario.codigo_firma.blank? and @contratosperinventario.contratosperinvatenciones.where("codigo_firma is not null").blank? %>
      <%= link_to new_contratosperinventario_contratosperinvdetalle_path(@contratosperinventario), id: 'new_contratosperinvdetalle_button', class: 'btn btn-sm btn-warning', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
      <% end %>
    <% end %>
    <%# end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="contratosperinvdetalle_form" class="collapse"></div>
  <div id="contratosperinvdetalles">
    <% if @contratosperinventario.contratosperinvdetalles.present? %>
      <%= render 'contratosperinvdetalles/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %>
      </div>
    <% end %>
  </div>
</div>
