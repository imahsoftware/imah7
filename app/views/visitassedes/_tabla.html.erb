<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
	  <thead class="thcolor">
      <tr>
        <td width="10%"></td>
        <th width="20%" class="text-left text-table">Fecha</th>
        <th class="text-left text-table">Sede</th>
				<th width="15%" class="text-left text-table">Viaticos</th>
      </tr>
    </thead>
	  <tbody id="tbody_visitassedes">
	    <% @visita.visitassedes.order(id: :desc).each do |visitassede| %>
	      <%= render 'visitassedes/tr', visitassede: visitassede %>
	    <% end %>
	  </tbody>
	</table>
</div>



