<div class="box-header">
  <h3 class="box-title"><strong>Supervisores</strong></h3>
  <div class="box-tools pull-right">
    <% if is_auth_c('contratosperuser') %>
      <%= link_to new_contratospersona_contratosperuser_path(@contratospersona), id: 'new_contratosperuser_button', class: 'btn btn-sm btn-warning', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
      <% end %>
    <% end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="contratosperuser_form" class="collapse"></div>
  <div id="contratosperusers">
    <% if @contratospersona.contratosperusers.present? %>
      <%= render 'contratosperusers/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
    <% end %>
  </div>
</div>
