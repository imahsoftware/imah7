<%= simple_form_for([@user, @migracionesuser], remote: true) do |f|   %>
  <div class="row">
    <% if @migracionesuser.id %>
        <div class="col-md-6"><%= f.input :migracion_id, collection: Migracion.where("publicado in ('SI','SO','EP')").order('nombre').collect {|p| [ p.nombre, p.id ] }, input_html: { class: 'select2' }, label: 'Permiso' %></div>
    <% else %>
        <div class="col-md-6"><%= f.input :migracion_id, collection: Migracion.where(["publicado in ('SI','SO','EP') and id not in (select migracion_id from migracionesusers where user_id = #{@user.id})"]).collect {|p| [ p.nombre, p.id ] }, input_html: { multiple: true, class: 'select2' }, label: 'Permiso' %></div>
    <% end %>
  </div>
  <div class="row">
    <div class="col-md-6">
      <% if @migracionesuser.new_record? %>
        <%= button_tag "#{t :cancelar}", type: 'button', data: { target: '#migracionesuser_form' }, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
      <% else %>
        <%= link_to "#{t :cancelar}", user_migracionesuser_path(@user, @migracionesuser), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
      <% end %>
    </div>
    <div class="col-md-6">
      <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
    </div>
  </div>
<% end %>
