<% if @active_record.present? %>
	$("#migracionesuser_<%= @active_record.id %>").replaceWith("<%= j render 'tr', migracionesuser: @active_record %>");
<% end %>
$("#migracionesuser_form").html("<%= j render 'form' %>");
$(".datetimepicker").datetimepicker();
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
$("#migracionesuser_form").collapse("show");
$(".select2").select2();
