<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
	  <thead>
	    <tr class="thcolor">
				<th width="10%"></th>
        <th width="40%">Proceso</th>
				<th>Tipo</th>
	    </tr>
	  </thead>
	  <tbody id="tbody_migracionesusers">
	    <% @user.migracionesusers.includes([:migracion]).order(updated_at: :desc).each do |migracionesuser| %>
	      <%= render 'migracionesusers/tr', migracionesuser: migracionesuser %>
	    <% end %>
	  </tbody>
	</table>
</div>
