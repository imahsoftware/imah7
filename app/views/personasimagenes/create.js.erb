$(".alert_flash").fadeOut(300, function() {
	$(this).remove();
});

<% if @persona.personasimagenes.count == 1 %>
	$("#personasimagenes").html("<%= j render 'tabla' %>");
<% else %>
	$("#tbody_personasimagenes").prepend("<%= j render 'tr', personasimagen: @personasimagen %>");
<% end %>

$(".clean").val("").trigger('change');

$("#personasimagen_form").collapse("hide");

$('[data-toggle="tooltip"]').tooltip();

$(".flash_messages").html("<%= j render 'layouts/flash_messages' %>");

$(".form-group").removeClass("has-error");
$(".form-group > .help-block.help-block-error").remove();

setTimeout(function() {
	$(".alert_flash").fadeOut(300, function() {
		$(this).remove();
	});
}, 5000);
