<%= simple_form_for([@persona, @personasimagen], remote: true) do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
        <%= f.input :documentos, as: :file, label: 'Archivo a cargar' %>
      </div>
    </div>
    <div class="row">
      <div class="col-md-6">
        <% if @personasimagen.new_record? %>
          <%= button_tag "#{t :cancelar}", type: 'button', data: {target: '#personasimagen_form'}, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}", persona_personasimagen_path(@persona, @personasimagen), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
