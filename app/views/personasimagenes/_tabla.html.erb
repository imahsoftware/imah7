<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
	  <thead class="thcolor">
      <tr>
        <td width="10%"></td>
        <th width="15%" class="text-left">Fecha</th>
        <th class="text-left">Imagen</th>
      </tr>
    </thead>
	  <tbody id="tbody_personasimagenes">
	    <% @persona.personasimagenes.order(id: :desc).each do |personasimagen| %>
	      <%= render 'personasimagenes/tr', personasimagen: personasimagen %>
	    <% end %>
	  </tbody>
	</table>
</div>