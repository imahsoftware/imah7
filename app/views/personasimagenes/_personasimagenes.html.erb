<div class="box-header">
  <h3 class="box-title"><strong>Documentos Digitales</strong></h3>
  <div class="box-tools pull-right">
    <%# if is_auth_c('personasimagen') %>
      <%= link_to new_persona_personasimagen_path(@persona), id: 'new_personasimagen_button', class: 'btn btn-sm btn-info', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
      <% end %>
    <%# end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="personasimagen_form" class="collapse"></div>
  <div id="personasimagenes">
    <% if @persona.personasimagenes.present? %>
      <%= render 'personasimagenes/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
    <% end %>
  </div>
</div>

