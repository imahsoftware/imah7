<%= simple_form_for([@contratossolepp, @contratossoleppsatencion], remote: true) do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
        <%= f.input :nombre, :input_html => {:onChange => "javascript:this.value=this.value.toUpperCase();"} %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
        <%= f.input :identificacion, :input_html => {:onChange => "javascript:this.value=this.value.toUpperCase();"} %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
        <%= f.input :cargo, :input_html => {:onChange => "javascript:this.value=this.value.toUpperCase();"} %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
        <%= f.input :celular, :input_html => {:onChange => "javascript:this.value=this.value.toUpperCase();"} %>
      </div>
    </div>
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
        <%= f.input :email, :input_html => {:onChange => "javascript:this.value=this.value.toUpperCase();"} %>
      </div>
    </div>
    <div class="row">
      <div class="col-md-6">
        <% if @contratossoleppsatencion.new_record? %>
          <%= button_tag "#{t :cancelar}", type: 'button', data: {target: '#contratossoleppsatencion_form'}, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}", contratossolepp_contratossoleppsatencion_path(@contratossolepp, @contratossoleppsatencion), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
<br/>