<%= simple_form_for([@contrato, @contratospago], remote: true) do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-6 col-lg-5">
        <% if @contratospago.new_record? %>
          <%= f.input :contratosprefactura_id, collection: @contrato.contratosprefacturas.where(["estado = 'APROBADO' and saldo > 0"]).order(:id).collect {|p| [ p.detalleprefa, p.id ] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: "Factura"%>
        <% else %>
          <%= f.input :contratosprefactura_id, collection: @contrato.contratosprefacturas.where(["id = #{@contratospago.contratosprefactura_id}"]).order(:id).collect {|p| [ p.detalleprefa, p.id ] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: "Factura"%>
        <% end %>
          </div>
      <div class="col-xs-12 col-sm-12 col-md-6 col-lg-3"><%= f.input :tiposcuenta_id, collection: Tiposcuenta.order(:entidad).collect {|p| [ p.entidad, p.id ] }, input_html: { class: 'select2' }, as: :select, include_blank: true%></div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :fecha_pago, as: :string, input_html: { class: 'datepicker', data: {date_options: {format: 'DD/MM/YYYY', ignoreReadonly: true}}, readonly: true } %></div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :valor, as: :moneda %></div>
    </div>
    <legend>Retenciones</legend>
    <% con = 0
       datos = @contrato.contratosretenciones.order(id: :asc)
       datos.each do |a|
         dato = ":rete_"+a.tipospretencion_id.to_s
         con = con + 1
    %>
      <% if con == 1 %><div class="row"><% end %>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
        <label style="font-size: 10px; font-family: Verdana, Geneva, sans-serif;"><%=a.tipospretencion.detalle.to_s %></label><%= f.input eval(dato), as: :moneda, label:false %> <br/>
      </div>
      <% if con == 6 %></div><% con = 0 end %>
    <% end %>
    <% if con != 6 %></div><% con = 0 end %>

    <div class="row">
      <div class="col-md-6">
        <% if @contratospago.new_record? %>
          <%= button_tag "#{t :cancelar}", type: 'button', data: {target: '#contratospago_form'}, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}", contrato_contratospago_path(@contrato, @contratospago), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
<br/>
