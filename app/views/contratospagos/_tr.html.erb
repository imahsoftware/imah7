<tr id="contratospago_<%= contratospago.id %>">
  <td class="text-center">
    <% if is_auth_e("contratospago")%>
      <%= link_to edit_contrato_contratospago_path(@contrato, contratospago), remote: true, class: 'edit_contratosmodificacion_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
        <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
      <% end %>
      <%= link_to contrato_contratospago_path(@contrato, contratospago), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
         <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
      <% end %>
    <% end %>
    <%= link_to visualizar_contratospagos_path(id: contratospago.id), data: {toggle: 'tooltip'}, class: 'popup', title: 'Ver Recibo ' do %>
      <button class="btn btn-xs btn-info"><i class="fa fa-clone"></i></button>
    <% end %>
    <%# end %>
    <button class="btn btn-xs btn-info"><span data-toggle="tooltip" data-html="true" data-original-title="<div align='left'><%= contratospago.user_nombre.html_safe rescue nil %><%= contratospago.user_actnombre.html_safe rescue nil %></div>"><i class="fa fa-user" aria-hidden="true"></i></span></button>
  </td>
  <td align="center"><%= contratospago.contratosprefactura_id rescue nil %></td>
  <td align="center"><%= contratospago.contratosprefactura.siigo_nro rescue nil %></td>
  <td align="center"><%= contratospago.contratosprefactura.created_at.strftime("%Y-%m-%d")  rescue nil %></td>
  <td align="center"><%= contratospago.consecutivo rescue nil %></td>
  <td align="center"><%= contratospago.fecha_pago.strftime("%Y-%m-%d") rescue nil %></td>
  <td align="left"><%= contratospago.tiposcuenta.entidad rescue nil %></td>
  <td align="right"><%= camponumerico contratospago.valor rescue nil %></td>
  <td align="right"><%= camponumerico contratospago.valor_retencion rescue nil %></td>
  <td align="right"><%= camponumerico contratospago.totalgeneral rescue nil %></td>
</tr>
