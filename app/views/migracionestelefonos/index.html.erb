<p id="notice"><%= notice %></p>

<h1>Migracionestelefonos</h1>

<table>
  <thead>
    <tr>
      <th>User</th>
      <th>Archivo</th>
      <th>Estado</th>
      <th>Identificacion</th>
      <th>Telefono</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @migracionestelefonos.each do |migracionestelefono| %>
      <tr>
        <td><%= migracionestelefono.user %></td>
        <td><%= migracionestelefono.archivo %></td>
        <td><%= migracionestelefono.estado %></td>
        <td><%= migracionestelefono.identificacion %></td>
        <td><%= migracionestelefono.telefono %></td>
        <td><%= link_to 'Show', migracionestelefono %></td>
        <td><%= link_to 'Edit', edit_migracionestelefono_path(migracionestelefono) %></td>
        <td><%= link_to 'Destroy', migracionestelefono, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Migracionestelefono', new_migracionestelefono_path %>
