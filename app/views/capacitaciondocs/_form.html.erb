<%= simple_form_for([@capacitacion, @capacitaciondoc], remote: true) do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
        <%= f.input :tipo, as: :select, collection: select_tipo_capacitaciondocs, input_html: { class: 'select2', style: "width: 100%" }, label: "Tipo" %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5">
        <%= f.input :descripcion, label: "Descripción" %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5">
        <%= f.input :capacitaciondoc, as: :file, label: 'Archivo a cargar' %>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <% if @capacitaciondoc.new_record? %>
          <%= link_to "Cancelar", cancelar_capacitaciondocs_path, remote: true, class: 'cancel_button btn btn-flat btn-warning pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "Cancelar", capacitacion_capacitaciondoc_path(@capacitacion, @capacitaciondoc), class: 'btn btn-warning float-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "Guardar", class: "btn btn-danger pull-right"%>
      </div>
    </div>
  </div>
<% end %>

