<div class="box-header">
  <h3 class="box-title"><strong>Documentos Digitales</strong></h3>
  <div class="box-tools pull-right">
    <% if is_auth_c('capacitacion') %>
      <%= link_to new_capacitacion_capacitaciondoc_path(@capacitacion), id: 'new_capacitaciondoc_button', class: 'btn btn-sm btn-warning', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
      <% end %>
    <% end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="capacitaciondoc_form" class="collapse"></div>
  <div id="capacitaciondocs" style="margin-top: 10px;">
    <% if @capacitacion.capacitaciondocs.any? %>
      <%= render 'capacitaciondocs/tabla' %>
    <% else %>
      <%= render 'layouts/procesos/alert_message' %>
    <% end %>
  </div>
</div>
