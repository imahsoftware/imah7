<div class="row">
  <div class="col-md-1"></div>
  <div class="col-md-10">
    <table class="table table-bordered table-condensed table-striped">
      <tr class="thcolor">
        <th class="text-table text-table-10 text-center">Empresa - Nro Contrato</th>
        <th class="text-table text-table-10 text-center" width="20%">Cargo</th>
        <th class="text-table text-table-10 text-center" width="25%">Grupo de Nomina</th>
      </tr>

      <tr>
        <td align="left" class="text-table-10"><%= @contratosperfecha.contrato.empresa.identnombre rescue nil %> (<%= @contratosperfecha.contrato.nro_contrato rescue nil %>) </td>
        <td align="center" class="text-table-10"><%= @contratosperfecha.contratoscargo.perfil rescue nil %></td>
        <td align="center" class="text-table-10"><%= @contratosperfecha.contratosgrupo.descripcion rescue nil %> - <small>(<%= @contratosperfecha.contratosgrupo.termino rescue nil %>)</small></td>
      </tr>
    </table>
  </div>
  <div class="col-md-1"></div>
</div>

