                        <th width="20%"></th>
                        <th width="5%" class="text-center text-table">ID</th>
                        <th class="text-left text-table">Tema</th>
                        <th class="text-center text-table">Fecha Limite</th>
                        <th width="15%" class="text-center text-table">Estado</th>
                      </tr>
                      </thead>
                      <tbody>
                      <% @evaluaciones.each do |evaluacion| %>
                        <tr id="evaluacion_<%= evaluacion.id %>">
                          <td class="text-center text-table">
                            <%= link_to edit_evaluacion_path(evaluacion), class: 'edit_evaluacion_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
                              <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
                            <% end %>
                            <%= link_to informepdf_evaluaciones_path(id: evaluacion.id, format: :pdf), class: 'popup', data: { toggle: 'tooltip' }, title: "Generar Seguimiento" do %>
                              <button class="btn btn-xs btn-info"><i class="fa fa-file-pdf-o"></i></button>
                            <% end %>
                            <%= link_to informedat_datas_path(format: :xlsx, infgrupo_id: 90, evaluacion_id: evaluacion.id), data: { toggle: 'tooltip' }, title: "Generar Reporte" do %>
                              <button class="btn btn-xs btn-danger"><i class="fa fa-file-excel-o"></i></button>
                            <% end %>
                            <% if is_auth_e_evaluacion %>
                              <% if isadmin == evaluacion.user_id or is_auth_e_clonarevaluacion %>
                                <%= link_to clonar_evaluaciones_path(id: evaluacion.id), remote: true, data: { confirm: 'Esta seguro?', toggle: 'tooltip' }, title: "Clonar Evaluacion" do %>
                                  <button class="btn btn-xs btn-success"><i class="fa fa-clone"></i></button>
                                <% end %>
                              <% end %>
                              <%= link_to ver_grafica_general_evaluaciones_path(id: evaluacion.id), remote: true do %>
                                <button class="btn btn-xs btn-danger"><i class="fa fa-pie-chart"></i></button>
                              <% end %>
                              <%= link_to ver_grafica_clases_evaluaciones_path(id: evaluacion.id), remote: true do %>
                                <button class="btn btn-xs btn-warning"><i class="fa fa-bar-chart"></i></button>
                              <% end %>
                              <%= link_to ver_grafica_usuarios_evaluaciones_path(id: evaluacion.id), remote: true do %>
                                <button class="btn btn-xs btn-primary"><i class="fa fa-bar-chart"></i></button>
                              <% end %>
                              <% if Evaluacionesejecucion.where(evaluacion_id: evaluacion.id).present? == false %>
                                <%= link_to evaluacion, remote: true, method: :delete, data: { confirm: 'Esta seguro?', toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
                                  <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
                                <% end %>
