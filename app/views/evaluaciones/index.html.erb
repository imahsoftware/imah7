                            <% end %>
                            <button class="btn btn-xs btn-info">
                              <span data-toggle="tooltip" data-html="true" data-original-title="<div align='left'><%= evaluacion.user_nombre.html_safe rescue nil %></div>"><i class="fa fa-user" aria-hidden="true"></i></span>
                            </button>
                          </td>
                          <td class="text-center text-table"><%= evaluacion.id rescue nil %></td>
                          <td class="text-left text-table"><%= evaluacion.tema rescue nil %></td>
                          <td class="text-center text-table"><%= evaluacion.fecha_limite.strftime("%Y-%m-%d") rescue nil %></td>
                          <td class="text-center text-table"><%= evaluacion.estado rescue nil %></td>
                        </tr>
                        <div class="modal fade" id="grafica<%= evaluacion.id %>">
                          <div class="modal-dialog modal-dialog-responsive" role="document">
                            <div class="modal-content"></div>
                          </div>
                        </div>

                        <div class="modal fade" id="grafica_gestion<%= evaluacion.id %>">
                          <div class="modal-dialog modal-dialog-responsive" role="document">
                            <div class="modal-content"></div>
                          </div>
                        </div>

                        <div class="modal fade" id="grafica_usuarios<%= evaluacion.id %>">
                          <div class="modal-dialog modal-dialog-responsive" role="document">
                            <div class="modal-content"></div>
                          </div>
                        </div>
                      <% end %>
                      </tbody>
                    </table>

                  <% else %>
                    <div class="alert alert-danger">
                      <h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %></div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>





