<% isadmin = is_admin
   is_auth_e_evaluacion = is_auth_e('evaluacion')
   is_auth_e_clonarevaluacion = is_auth_e('clonarevaluacion')
%>

<div class="row">
  <div class="col-xs-12">
    <div class="nav-tabs-custom">
      <ul class="nav nav-tabs">
        <li class="<%= @etapa == 'A' ? 'active' : '' %>">
          <%= link_to evaluaciones_path(etapa: 'A') do %>
            Evaluación de desempeño
          <% end %>
        </li>
        <li class="<%= @etapa == 'B' ? 'active' : '' %>">
          <%= link_to evaluaciones_path(etapa: 'B') do %>
            Evaluación periodo de prueba
          <% end %>
        </li>
      </ul>
      <div class="tab-content">

        <% if @etapa == 'A' %>

          <div class="box-header">
            <div class="box-header">
              <h3 class="box-title">Evaluación de desempeño supervisores</h3>
              <div class="pull-right">
                <% if is_auth_c('evaluacion') %>
                  <%= link_to new_evaluacion_path(tipo: 'EVALUACION DESEMPENO'), data: { toggle: 'tooltip' }, title: "Crear Nuevo Registro", class: 'btn btn-sm btn-primary pull-right' do %>
                    <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
                  <% end %>
                <% end %>
              </div>
            </div>
            <div class="row">
              <div class="col-md-12">
                <div class="table-responsive">
                  <% if @evaluaciones.present? %>
                    <table class="table table-bordered table-condensed table-striped">
                      <thead>
                      <tr class="thcolor">
                        <th width="20%"></th>
                        <th width="5%" class="text-center text-table">ID</th>
                        <th class="text-left text-table">Tema</th>
                        <th class="text-center text-table">Fecha Limite</th>
                        <th width="15%" class="text-center text-table">Estado</th>
                      </tr>
                      </thead>
                      <tbody>
                      <% @evaluaciones.each do |evaluacion| %>
                        <tr id="evaluacion_<%= evaluacion.id %>">
                          <td class="text-center text-table">
                            <%= link_to edit_evaluacion_path(evaluacion), class: 'edit_evaluacion_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
                              <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
                            <% end %>
                            <%= link_to informepdf_evaluaciones_path(id: evaluacion.id, format: :pdf), class: 'popup', data: { toggle: 'tooltip' }, title: "Generar Seguimiento" do %>
                              <button class="btn btn-xs btn-info"><i class="fa fa-file-pdf-o"></i></button>
                            <% end %>
                            <%= link_to informedat_datas_path(format: :xlsx, infgrupo_id: 90, evaluacion_id: evaluacion.id), data: { toggle: 'tooltip' }, title: "Generar Reporte" do %>
                              <button class="btn btn-xs btn-danger"><i class="fa fa-file-excel-o"></i></button>
                            <% end %>
                            <% if is_auth_e_evaluacion %>
                              <% if isadmin == evaluacion.user_id or is_auth_e_clonarevaluacion %>
                                <%= link_to clonar_evaluaciones_path(id: evaluacion.id), remote: true, data: { confirm: 'Esta seguro?', toggle: 'tooltip' }, title: "Clonar Evaluacion" do %>
                                  <button class="btn btn-xs btn-success"><i class="fa fa-clone"></i></button>
                                <% end %>
                              <% end %>
                              <%= link_to ver_grafica_general_evaluaciones_path(id: evaluacion.id), remote: true do %>
                                <button class="btn btn-xs btn-danger"><i class="fa fa-pie-chart"></i></button>
                              <% end %>
                              <%= link_to ver_grafica_clases_evaluaciones_path(id: evaluacion.id), remote: true do %>
                                <button class="btn btn-xs btn-warning"><i class="fa fa-bar-chart"></i></button>
                              <% end %>
                              <%= link_to ver_grafica_usuarios_evaluaciones_path(id: evaluacion.id), remote: true do %>
                                <button class="btn btn-xs btn-primary"><i class="fa fa-bar-chart"></i></button>
                              <% end %>
                              <% if Evaluacionesejecucion.where(evaluacion_id: evaluacion.id).present? == false %>
                                <%= link_to evaluacion, remote: true, method: :delete, data: { confirm: 'Esta seguro?', toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
                                  <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
                                <% end %>
                              <% end %>
                            <% end %>
                            <button class="btn btn-xs btn-info">
                              <span data-toggle="tooltip" data-html="true" data-original-title="<div align='left'><%= evaluacion.user_nombre.html_safe rescue nil %></div>"><i class="fa fa-user" aria-hidden="true"></i></span>
                            </button>
                          </td>
                          <td class="text-center text-table"><%= evaluacion.id rescue nil %></td>
                          <td class="text-left text-table"><%= evaluacion.tema rescue nil %></td>
                          <td class="text-center text-table"><%= evaluacion.fecha_limite.strftime("%Y-%m-%d") rescue nil %></td>
                          <td class="text-center text-table"><%= evaluacion.estado rescue nil %></td>
                        </tr>
                        <div class="modal fade" id="grafica<%= evaluacion.id %>">
                          <div class="modal-dialog modal-dialog-responsive" role="document">
                            <div class="modal-content"></div>
                          </div>
                        </div>

                        <div class="modal fade" id="grafica_gestion<%= evaluacion.id %>">
                          <div class="modal-dialog modal-dialog-responsive" role="document">
                            <div class="modal-content"></div>
                          </div>
                        </div>

                        <div class="modal fade" id="grafica_usuarios<%= evaluacion.id %>">
                          <div class="modal-dialog modal-dialog-responsive" role="document">
                            <div class="modal-content"></div>
                          </div>
                        </div>
                      <% end %>
                      </tbody>
                    </table>

                  <% else %>
                    <div class="alert alert-danger">
                      <h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %></div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>


        <% if @etapa == 'B' %>

          <div class="box-header">
            <div class="box-header">
              <h3 class="box-title">Evaluación periodo de prueba</h3>
              <div class="pull-right">
                <% if is_auth_c('evaluacion') %>
