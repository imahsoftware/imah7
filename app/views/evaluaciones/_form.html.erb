<%= simple_form_for @evaluacion do |f| %>
  <%= f.hidden_field :tipo, value: @evaluacion.tipo %>
  <div class="box box-danger">
    <div class="box-header">
      <legend>
        <%= link_to evaluaciones_path, data: { toggle: 'tooltip' }, title: 'Regresar' do %>
          <i class="fa fa-arrow-left fa-fw text-success" aria-hidden="true"></i>
        <% end %>
        Proceso (<% unless @evaluacion.new_record? %> <%= @evaluacion.tipo.capitalize rescue nil %><% else %> <%= @tipo.capitalize rescue nil %><% end %>)
        <div class="pull-right">
          <%= link_to informepdf_evaluaciones_path(id: @evaluacion.id, format: :pdf),  class: 'popup',data: { toggle: 'tooltip' }, title: "Generar Seguimiento" do %>
            <button class="btn btn-xs btn-info"><i class="fa fa-file-pdf-o"></i></button>
          <% end %>
        </div>
      </legend>
    </div>
    <div class="box-body">
      <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
          <%= f.input :tema, input_html: { class: "uppercaseInput" }, label: "Tema" %>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
          <%= f.input :fecha_limite, as: :string, input_html: { class: 'datepicker', data: { date_options: { format: 'DD/MM/YYYY', ignoreReadonly: true } }, readonly: true } %>
        </div>
        <% unless @evaluacion.new_record? %>
          <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
            <%= f.input :estado, collection: Iparametro.where(campo: 'evaluacion_estado').order(:descripcion).collect { |p| [p.descripcion, p.descripcion] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: "Estado" %>
          </div>
        <% end %>
        <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
          <%= f.input :calificacion, input_html: { class: "uppercaseInput" }, label: "Calificación" %>
        </div>
      </div>
      <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
          <%= f.input :objetivo, as: :text, input_html: { class: "uppercaseInput" }, label: "Objetivo" %>
        </div>
      </div>
    </div>
    <div class="box-footer">
      <div class="box-tools pull-right">
        <% unless @evaluacion.new_record? %>
          <% if @evaluacion.estado == 'PENDIENTE' or is_auth_a('actualiza_fecha_limite')  %>
            <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
          <% end %>
        <% else %>
          <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>s
        <% end %>
      </div><!-- /.box-tools -->
    </div>
  </div>
<% end %>
<% unless @evaluacion.new_record? %>
  <div class="row">
    <div class="col-xs-12">
      <div class="nav-tabs-custom">
        <ul class="nav nav-tabs">
          <li class="<%= @etapa == 'A' ? 'active' : '' %>">
            <%= link_to edit_evaluacion_path(etapa: 'A', id: @evaluacion.id), data: { toggle: 'tooltip' }, title: "Detalles" do %>
              <i class="fa fa-sticky-note"></i> Detalles
            <% end %>
          </li>
          <li class="<%= @etapa == 'B' ? 'active' : '' %>">
            <%= link_to edit_evaluacion_path(etapa: 'B', id: @evaluacion.id), data: { toggle: 'tooltip' }, title: "Contratos" do %>
              <i class="fa fa-users"></i> Usuarios
            <% end %>
          </li>
        </ul>
        <div class="tab-content">
          <% if @etapa == 'A' %>
            <%= render "evaluacionesdetalles/evaluacionesdetalles" %>
          <% end %>
          <% if @etapa == 'B' %>
            <%= render "evaluacionescontratos/evaluacionescontratos" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
