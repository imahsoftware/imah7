$(".alert_flash").fadeOut(1000, function() {
	$(this).remove();
});

<% if Iparametrosformato.where("iparametro_id = #{@iparametro.id}").count == 1 %>
	$("#iparametrosformatos").html("<%= j render 'tabla' %>");
<% else %>
	$("#tbody_iparametrosformatos").prepend("<%= j render 'tr', iparametrosformato: @iparametrosformato %>");
<% end %>

$(".clean").val("").trigger('change');

$('[data-toggle="tooltip"]').tooltip();

$(".flash_messages").html("<%= j render 'layouts/flash_messages' %>");

$(".form-group").removeClass("has-error");
$(".form-group > .help-block.help-block-error").remove();

setTimeout(function() {
	$(".alert_flash").fadeOut(1000, function() {
		$(this).remove();
	});
}, 5000);
