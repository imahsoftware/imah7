$("#iparametrosformato_form").collapse("hide");

$("#iparametrosformato_form").empty();

<% if @active_record.present? %>
	$("#iparametrosformato_<%= @active_record.id %>").replaceWith("<%= j render 'tr', iparametrosformato: @active_record %>");
<% end %>

$("#iparametrosformato_<%= @iparametrosformato.id %>").html("<td colspan='5'><%= j render 'form' %></td>");

$("#iparametrosformato_<%= @iparametrosformato.id %>").addClass("active_iparametrosformato");
$(".datetimepicker").datetimepicker();
$(".select2").select2();

$(".tooltip").tooltip("hide");

$('[data-toggle="tooltip"]').tooltip();