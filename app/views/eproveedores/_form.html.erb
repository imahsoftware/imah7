<%= simple_form_for(@eproveedor) do |f| %>
  <%#= f.hidden_field :contrato_id %>
  <script>
      window.onload = function() {
          var myInput = document.getElementById('bloquear');
          myInput.onpaste = function(e) {
              e.preventDefault();
              alert("esta acción está prohibida");
          }

          myInput.oncopy = function(e) {
              e.preventDefault();
              alert("esta acción está prohibida");
          }
      }

      function justNumbers(e) {
          var keynum = window.event ? window.event.keyCode : e.which;
          if ((keynum == 8) || (keynum == 46))
              return true;

          return /\d/.test(String.fromCharCode(keynum));
      }

      function habcampo() {

      }

      $("#ide").keyup(function () {
          var  ta = $("#ide");
          letras = ta.val().replace('//g',"");
          ta.val(letras);
      });

  </script>

  <div class="box box-danger">
    <div class="box-header">
      <legend>Información Proveedor</legend>
    </div>
    <div class="box-body">
      <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :tipodoc, collection: Iparametro.where(campo: 'tipo_identificacion_proveedor').order(:descripcion).collect {|p| [ p.descripcion, p.descripcion ] }, input_html: { class: 'select2' }, as: :select, include_blank: true%></div>
        <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :identificacion, id: "ide", input_html: {onkeypress: "return justNumbers(event);", maxlength: 15} %></div>
        <div class="col-xs-12 col-sm-12 col-md-1 col-lg-1"><%= f.input :digito, id: "id2", input_html: {onkeypress: "return justNumbers(event);", maxlength: 1} %></div>
        <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7"><%= f.input :nombre, input_html: {:onchange => "javascript:this.value=this.value.toUpperCase();"}, label: "Nombre o Razón Social" %></div>
      </div>
      <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :apellido, input_html: {:onchange => "javascript:this.value=this.value.toUpperCase();"} %></div>
        <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5"><%= f.input :direccion, input_html: {:onchange => "javascript:this.value=this.value.toUpperCase();"} %></div>
        <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :email, input_html: {:onchange => "javascript:this.value=this.value.toUpperCase();"} %></div>
      </div>
      <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :telefono, as: :integer  %></div>
        <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :celular, as: :integer  %></div>
        <div class="col-xs-12 col-sm-12 col-md-3 col-lg-2"><%= f.input :clasificacion, as: :select, collection: select_proveedor, input_html: { data: { width: '100%' }, class: 'select2'}, label: "Clasificación"%></div>
        <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :autorretenedor2, as: :select, collection: select_sino, input_html: { data: { width: '100%' }, class: 'select2'}, label: "ReteIVA"%></div>
        <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :retefuente, as: :select, collection: select_sino, input_html: { data: { width: '100%' }, class: 'select2'}, label: "Retefuente"%></div>
        <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :autorretenedor3, as: :select, collection: select_sino, input_html: { data: { width: '100%' }, class: 'select2'}, label: "Autorretenedor de Cree"%></div>
      </div>
      <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :declarante, as: :select, collection: select_sino, input_html: { data: { width: '100%' }, class: 'select2'}, label: "Declarante"%></div>
        <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :responsableiva, as: :select, collection: select_sino, input_html: { data: { width: '100%' }, class: 'select2'}, label: "Responsable de IVA"%></div>
        <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5"><%= f.input :municipio_id, collection: Municipio.order(:autobuscar).collect {|p| [ p.autobuscar, p.id ] }, input_html: { class: 'select2' }, as: :select, include_blank: true%></div>
      </div>
      <legend>Datos Bancarios</legend>
      <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :banco, collection: Iparametro.where(campo: 'banco').order(:descripcion).collect { |p| [p.descripcion.to_s, p.descripcion.to_s] }, input_html: { class: 'select2' }, as: :select, include_blank: true %></div>
        <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :tipo_cuenta, collection: Iparametro.where(campo: 'tipo_cuenta').order(:descripcion).collect { |p| [p.descripcion.to_s, p.descripcion.to_s] }, input_html: { class: 'select2' }, as: :select, include_blank: true %></div>
        <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :cuenta_bancolombia, label: "Nro Cuenta bancaria" %></div>
      </div>
    </div>
    <div class="box-footer">
      <div class="box-tools pull-left"><strong>ID Proveedor: <%=@eproveedor.id rescue nil %></strong>
      </div>
        <div class="box-tools pull-right">
          <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
        </div><!-- /.box-tools -->
    </div>
  </div>
<% end %>

