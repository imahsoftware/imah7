<%= simple_form_for([@proveedor, @proveedorescontacto], remote: true) do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
        <%= f.input :nombre, input_html: {:onchange => "javascript:this.value=this.value.toUpperCase();"} %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
        <%= f.input :telefono, input_html: {:onchange => "javascript:this.value=this.value.toUpperCase();"} %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
        <%= f.input :email, input_html: {:onchange => "javascript:this.value=this.value.toUpperCase();"} %>
      </div>
    </div>
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">
        <%= f.input :cargo, input_html: {:onchange => "javascript:this.value=this.value.toUpperCase();"} %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
        <%= f.input :estado, as: :select, collection: select_estado, input_html: { class: 'select2' } %>
      </div>
    </div>
    <div class="row">
      <div class="col-md-6">
        <% if @proveedorescontacto.new_record? %>
          <%= button_tag "#{t :cancelar}", type: 'button', data: {target: '#proveedorescontacto_form'}, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}", proveedor_proveedorescontacto_path(@proveedor, @proveedorescontacto), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
<br/>