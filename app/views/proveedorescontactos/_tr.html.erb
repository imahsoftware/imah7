<tr id="proveedorescontacto_<%= proveedorescontacto.id %>">
  <td class="text-center">
    <%# if is_auth_e("proveedorescontacto")%>
    <%= link_to edit_proveedor_proveedorescontacto_path(@proveedor, proveedorescontacto), remote: true, class: 'edit_proveedorescontacto_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
      <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
    <% end %>
      <%= link_to proveedor_proveedorescontacto_path(@proveedor, proveedorescontacto), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
         <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
      <% end %>
  </td>
  <td align="left"><%= proveedorescontacto.created_at.strftime("%Y-%m-%d %X") rescue nil %>
    <br/><small><%= proveedorescontacto.user.nombre rescue nil %></small></td>
  <td align="left"><%= proveedorescontacto.nombre rescue nil %></td>
  <td align="left"><%= proveedorescontacto.telefono rescue nil %></td>
  <td align="left"><%= proveedorescontacto.email rescue nil %></td>
</tr>
