<div class="col-md-12">
  <div class="box box-default">
    <div class="box-header with-border">
      <i class="fa fa-warning"></i>
      <h3 class="box-title">
        <%= link_to contratospersonas_path, data: { toggle: 'tooltip' }, title: 'Regresar' do %>
          <i class="fa fa-arrow-left fa-fw text-success" aria-hidden="true"></i>
        <% end %>
        Devolución de Inventario - Consecutivo <%= Contratosperinvacta.where("contratosperinventario_id = #{@contratosperinventario.id} and estado = 'PENDIENTE'").first.consecutivo_acta rescue nil %></h3>

    </div>
    <div class="box-body">
      <div class="bs-callout">
        <table class="table table-striped table-responsive table-bordered">
          <thead>
          <tr class="thcolor">
            <th width="15%" class="text-table">FECHA</th>
            <th class="text-table">EMPLEADO</th>
            <th width="45%" class="text-table">CONTRATO</th>
            <th width="10%" class="text-table text-center">ESTADO</th>
          </tr>
          </thead>
          <tr>
            <td class="text-table text-left">
              <%= @contratosperinventario.user.nombre %><br/>
              <%= @contratosperinventario.created_at.strftime("%d/%m/%Y %X") rescue nil %>
            </td>
            <td class="text-table">
              <%= @contratosperinventario.contratospersona.autobuscar rescue nil %>
            </td>
            <td class="text-table">
              <div align="justify">
                <strong>Nro Contrato : </strong><%= @contratosperinventario.contratospersona.contrato.nro_contrato rescue nil %> -
                <strong>Grupo : </strong><%= @contratosperinventario.contratosperfecha.contratosgrupo.descripcion rescue nil %>
                <small>(<%= @contratosperinventario.contratosperfecha.contratosgrupo.termino rescue nil %>)</small>
                <br/><strong>Cargo : </strong><%= @contratosperinventario.contratosperfecha.contratoscargo.perfil rescue nil %>
              </div>
            </td>
            <td class="text-table text-center">
              <%= @contratosperinventario.estado rescue nil %>
            </td>
          </tr>
        </table>
      </div>
      <br/>

      <div class="row">
        <div class="col-xs-12">
          <div class="nav-tabs-custom">
            <ul class="nav nav-tabs">
              <li class="<%= @etapa == 'A' ? 'active' : '' %>">
                <%= link_to complemento_contratosperinventarios_path(id: @contratosperinventario.id, etapa: 'A'), data: { toggle: 'tooltip' } do %>
                  <i class="fa fa-sticky-note"></i> Detalles de la Devolución
                <% end %>
              </li>
            </ul>
            <% if Contratosperinvacta.where(contratosperinventario_id: @contratosperinventario.id, estado: 'PENDIENTE').present? %>
              <div class="pull-right" style="position: relative; bottom: 30px;right: 30px">
                <%= link_to cerrar_acta_contratosperinventarios_path(id: @contratosperinventario.id), data: { toggle: 'tooltip', confirm: "Estas Seguro?" }, title: "Cerrar Acta" do %>
                  <button class="btn btn-xs btn-success"><i class="fa fa-check-circle-o"></i> Cerrar Devolución</button>
                <% end %>
              </div>
            <% end %>
            <div class="tab-content">
              <% if @etapa == 'A' %>
                <div class="active"><%= render 'contratosperinvdetalles/contratosperinvdetalles_devolucion' %></div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>