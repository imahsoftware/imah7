<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
	  <thead class="thcolor">
      <tr>
        <td width="13%"></td>
				<th  class="text-table">Empleado</th>
				<th width="60%" class="text-table">Contrato</th>
				<th width="10%" class="text-table text-center">Estado</th>
      </tr>
    </thead>
	  <tbody id="tbody_contratosperinventarios">
	    <% @contratospersona.contratosperinventarios.order(id: :desc).each do |contratosperinventario| %>
	      <%= render 'contratosperinventarios/tr', contratosperinventario: contratosperinventario %>
	    <% end %>
	  </tbody>
	</table>
</div>
