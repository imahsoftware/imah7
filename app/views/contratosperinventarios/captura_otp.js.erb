<% if @valida %>
$("#otp<%= @contratosperinventario.id %>").modal("hide");
$("#firmado_check<%= @contratosperinventario.id %>").html(" <div><em> <b>Firmado:</b> <i class='fa fa-check text-success'></i> - <b>Fecha: </b><%= @contratosperinventario.fecha_firma.strftime('%Y-%m-%d %X') rescue nil %> - <b>Usuario: </b><%= @contratosperinventario.contratospersona.nombre rescue nil %></em></div>");
$("#remove_boton<%= @contratosperinventario.id %>").remove();
<% else %>
$("#mensaje<%= @contratosperinventario.id %>").replaceWith("<div class='row' id='mensaje'><div class='col-xs-12 col-sm-12 col-md-2 col-lg-2' style='text-align: center;width: 100%;margin-bottom: 30px;color: red;font-weight: 600;font-size: 20px;'>CODIGO NO VALIDO</div></div>");
<% end %>