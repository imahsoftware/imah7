<style type="text/css">H1.SaltoDePagina { PAGE-BREAK-AFTER: always}</style>
<%

  isadmin = is_admin
  @contratosperinventarios.each do |contratosperinventario|
    @contratospersona = contratosperinventario.contratospersona
    @contratosperfecha = contratosperinventario.contratosperfecha
    @contratosperinvdetalles = contratosperinventario.contratosperinvdetalles
    portafolio = Portafolio.find(@contratosperfecha.contrato.empresa.portafolio_id)
    @logo_firma = portafolio.logo_firma
    @logo = portafolio.logo_empresa_assets
    @nombre_firma = portafolio.nombre_rep.to_s
    @nombre_empresa = portafolio.razon_social.to_s
    @identificacion = camponumerico2(portafolio.identificacion_rep.to_s)

%>
  <div align="center">
    <table width="850" border="0" cellspacing="0" cellpadding="1">
      <tr>
        <td valign="center">
          <table width="100%">
            <tr>
              <td>
                <div align="center">
                  <%= wicked_pdf_image_tag "#{image_url(@logo)}", size: "230x100" %>
                </div>
              </td>
              <td style="font-size: 18px; font-family: Tahoma;">
                <div align="center">
                  <b>INVENTARIO</b>
                </div>
              </td>
            </tr>
            <tr>
              <td colspan="2" width="80%">
                <table width="100%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
                  <tr>
                    <td height="30" style="background: #E8E3E3; padding: 5px; font-size: 10px; font-family: Tahoma;">
                      <strong>FECHA REGISTRO </strong></td>
                    <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px; padding: 3px;">&nbsp;<%= contratosperinventario.created_at.strftime("%Y-%m-%d %X") rescue nil %></td>
                  </tr>
                  <tr>
                    <td height="30" style="background: #E8E3E3; padding: 5px; font-size: 10px; font-family: Tahoma;">
                      <strong>EMPLEADO </strong></td>
                    <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px; padding: 3px;">&nbsp;<%= @contratosperfecha.contratospersona.identificacion rescue nil %> <%= @contratosperfecha.contratospersona.nombre_completo rescue nil %></td>
                  </tr>
                  <tr>
                    <td height="30" style="background: #E8E3E3; padding: 5px; font-size: 10px; font-family: Tahoma;">
                      <strong>CARGO </strong></td>
                    <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px; padding: 3px;">&nbsp;<%= @contratosperfecha.contratoscargo.perfil rescue nil %></td>
                  </tr>
                  <tr>
                    <td height="30" style="background: #E8E3E3; padding: 5px; font-size: 10px; font-family: Tahoma;">
                      <strong>CONTRATO </strong></td>
                    <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px; padding: 3px;">&nbsp;
                      <b>Nro Contrato: </b><%= @contratospersona.contrato.nro_contrato rescue nil %> -
                      <b>Grupo:</b> <%= contratosperinventario.contratosperfecha.contratosgrupo.descripcion rescue nil %>
                      <small>(<%= @contratosperfecha.contratosgrupo.termino rescue nil %>)</small></td>
                  </tr>
                  <tr>
                    <td height="30" style="background: #E8E3E3; padding: 5px; font-size: 10px; font-family: Tahoma;">
                      <strong>ESTADO </strong></td>
                    <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px; padding: 3px;">&nbsp;<%= contratosperinventario.estado rescue nil %></td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
          <br/>
          <table width="100%" border="0" cellpadding="0" cellspacing="0" style="font-size: 10px; font-family: Tahoma;" id="sample">
            <tr>
              <th style="font-size: 12px; font-family: Tahoma;">
                <div align="left">DETALLE DEL INVENTARIO</div>
              </th>
            </tr>
          </table>
          <hr>
          <% if @contratosperinvdetalles.present? %>
            <table width="100%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
              <tr>
                <td width="30%" style="background: #E8E3E3; padding: 5px; font-size: 10px; font-family: Tahoma;">
                  <strong>ITEM</strong></td>
                <td width="15%" style="background: #E8E3E3; padding: 5px; font-size: 10px; font-family: Tahoma;">
                  <div align="center"><strong>PLACA</strong></div>
                </td>
                <td style="background: #E8E3E3; padding: 5px; font-size: 10px; font-family: Tahoma;">
                  <div align="left"><strong>OBSERVACIÓN</strong></div>
                </td>
                <td width="20%" style="background: #E8E3E3; padding: 5px; font-size: 10px; font-family: Tahoma;">
                  <div align="center"><strong>IMAGEN</strong></div>
                </td>
              </tr>
              <% @contratosperinvdetalles.each do |contratosperinvdetalle| %>
                <tr>
                  <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px; padding: 3px;"><%= contratosperinvdetalle.item rescue nil %></td>
                  <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px; padding: 3px;">
                    <div align="center"><%= contratosperinvdetalle.nro_placa rescue nil %></div>
                  </td>
                  <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px; padding: 3px;">
                    <div align="left"><%= contratosperinvdetalle.observaciones rescue nil %></div>
                  </td>

                  <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px; padding: 3px;">
                    <table width="100%">
                      <% contratosperinvdetalle.contratosperdetallesdocs.each_slice(2) do |slice| %>
                        <tr>
                          <% slice.each do |contratosperdetallesdoc| %>
                            <td width="50%">
                              <div align="center">
                                <%= wicked_pdf_image_tag image_url(contratosperdetallesdoc.invdetalle_doc.url(:thumb)) %>
                              </div>
                            </td>
                          <% end %>
                          <% (2 - slice.size).times do %>
                            <td width="20%"></td>
                          <% end %>
                        </tr>
                      <% end %>
                    </table>


                  </td>
                </tr>
              <% end %>
            </table>
          <% else %>
            <div align="left" style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px;">No
              hay
              informacion
            </div>
          <% end %>
          <br/>


          <br/>
          <div style="background-color: #ffffff; font-family: Tahoma; font-size: 10px;">
            <table width="100%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
              <tr>
                <td width="33%" style="background: #E8E3E3; padding: 5px; font-size: 10px; font-family: Tahoma;">
                  <div align="center"><strong>EMPLEADO</strong></div>
                </td>
                <td width="33%" style="background: #E8E3E3; padding: 5px; font-size: 10px; font-family: Tahoma;">
                  <div align="center"><strong>SUPERVISOR</strong></div>
                </td>
                <td width="33%" style="background: #E8E3E3; padding: 5px; font-size: 10px; font-family: Tahoma;">
                  <div align="center"><strong>ATENCIÓN</strong></div>
                </td>
              </tr>
              <tr>
                <td valign="top" style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px; padding: 3px;">

                  <% if contratosperinventario.codigo_firma.present? %>
                    <%= @contratosperfecha.contratospersona.nombre_completo rescue nil %><br/>
                    <b>CC:</b> <%= camponumerico2(@contratosperfecha.contratospersona.identificacion) rescue nil %><br/>
                    <b>Cargo:</b> <%= @contratosperfecha.contratoscargo.perfil rescue nil %><br/>
                    <b>Firma Digital:</b> <%= contratosperinventario.codigo_firma rescue nil %><br/>
                    <b>Fecha Firma:</b> <%= contratosperinventario.fecha_firma.strftime("%Y-%m-%d %X") rescue nil %>
                    <br/><br/>
                  <% else %>
                    <%= @contratosperfecha.contratospersona.nombre_completo rescue nil %><br/>
                    <b>CC:</b> <%= camponumerico2(@contratosperfecha.contratospersona.identificacion) rescue nil %><br/>
                    <b>PENDIENTE POR FIRMAR</b>
                  <% end %>

                </td>
                <td valign="top" style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px; padding: 3px;">
                  <% if contratosperinventario.codigo_firma.present? %>
                    <%= contratosperinventario.user.nombre rescue nil %><br/>
                    <b>CC:</b> <%= camponumerico2(contratosperinventario.user.identificacion) rescue nil %><br/>
                    <b>Firma Digital:</b> <%= contratosperinventario.codigo_crea_firma rescue nil %><br/>
                    <b>Fecha
                      Firma:</b> <%= contratosperinventario.fecha_crea_firma.strftime("%Y-%m-%d %X") rescue nil %>
                    <br/><br/>
                  <% else %>
                    <%= contratosperinventario.user.nombre rescue nil %><br/>
                    <b>CC:</b> <%= camponumerico2(contratosperinventario.user.identificacion) rescue nil %><br/>
                    <b>PENDIENTE POR FIRMAR</b>
                  <% end %>
                </td>
                <td valign="top" style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma; padding: 3px; padding: 3px;">
                  <% if contratosperinventario.contratosperinvatenciones.last.present? %>
                    <%= contratosperinventario.contratosperinvatenciones.last.nombre rescue nil %><br/>
                    <b>CC:</b> <%= camponumerico2(contratosperinventario.contratosperinvatenciones.last.identificacion) rescue nil %>
                    <br/>
                    <b>Cargo:</b> <%= camponumerico2(contratosperinventario.contratosperinvatenciones.last.cargo) rescue nil %>
                    <br/>
                    <b>Firma
                      Digital:</b> <%= contratosperinventario.contratosperinvatenciones.last.codigo_firma rescue nil %>
                    <br/>
                    <b>Fecha
                      Firma:</b> <%= contratosperinventario.contratosperinvatenciones.last.codigo_fecha.strftime("%Y-%m-%d %X") rescue nil %>
                    <br/><br/>
                  <% else %>
                    <b>PENDIENTE POR FIRMAR</b>
                  <% end %>
                </td>

              </tr>
            </table>
            <br/>
            <small style="font-size: 9px;">* Este documento fue generado con firma electrónica y cuenta con plena
              validez
              jurídica, conforme a lo dispuesto en la Ley 527/99 y el decreto reglamentario 2364/12</small>
          </div>
          <br/>
          <div align="justify" style="font-size: 10px; font-family: Tahoma;">FYH: <%= Time.now.strftime("%Y-%m-%d %X") rescue nil %>
            - <%= User.find(isadmin).nombre rescue nil %>
          </div>
        </td>
      </tr>
    </table>
  </div>
  <H1 class=SaltoDePagina>&nbsp;</H1>
<% end %>


