<% if @contratosgrupos.present? %>
  $('#contratospernomina_contratosgrupo_id').empty();
  $('#contratospernomina_contratosgrupo_id').append('<option selected>Seleccione</option>');
<% @contratosgrupos.each do |contratosgrupo| %>
  $('#contratospernomina_contratosgrupo_id').append('<option value="<%= contratosgrupo.id %>"><%= contratosgrupo.descripcion %></option>');
<% end %>
  $('#contratospernomina_contratosgrupo_id').prop('disabled', false);
<% else %>
  $('#contratospernomina_contratosgrupo_id').empty();
  $('#contratospernomina_contratosgrupo_id').append('<option selected>Seleccione</option>');
  $('#contratospernomina_contratosgrupo_id').prop('disabled', true);
<% end %>

