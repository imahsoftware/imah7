<div class="modal-header">
  <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
  <h4 class="modal-title">Detalle envio nomina electronica</h4>
</div>
<div class="modal-body" style='width: 100%;'>
  <div class="row">
    <div class="col-md-12" style="width: 99%;">
      <div class="table-responsive">
        <% Contratospernomina.joins(:contrato, :contratosgrupo)
                             .select("distinct contratospernominas.contrato_id, contratos.nro_contrato,
                                                          (select distinct 'X' from contratosprenimagenes where contrato_id = contratospernominas.contrato_id and contratosgrupo_id = contratospernominas.contratosgrupo_id) existedoc,
                                                          (select autobuscar from empresas where id = contratos.empresa_id) identnombre, contratospernominas.contratosgrupo_id, contratosgrupos.descripcion, contratospernominas.estado, count(9) cantidad, sum(contratospernominas.total) total")
                             .where(["contratospernominas.periodosliquidacion_id = #{@periodosliquidacion_id}
                                        and contratospernominas.contrato_id = #{@contrato_id}
                                        and contratospernominas.contratosgrupo_id = #{@contratosgrupo_id}"])
                             .group("contratospernominas.contrato_id, contratospernominas.contratosgrupo_id, contratospernominas.estado, contratos.empresa_id")
                             .order("contratospernominas.id desc").each do |a| %>

        <table class="table table-bordered table-condensed table-striped">
          <tr>
            <th width="30%" class="thcolor text-left">Empresa</th>
            <td class="text-left" style="font-size:11px;"><%= a.identnombre rescue nil%></td>
          </tr>
          <tr>
            <th class="thcolor text-left">Grupo - Contrato</th>
            <td class="text-left" style="font-size:10px;"><%= a.descripcion rescue nil%> <em><strong>(<%= a.nro_contrato rescue nil%>)</strong></em></td>
          </tr>
          <tr>
            <th class="thcolor text-left">Valor Total</th>
            <td class="text-left" style="font-size:10px;"><%=camponumerico a.total rescue nil%> (<%= camponumerico2 a.cantidad rescue nil%>)</td>
          </tr>
          <tr>
            <th class="thcolor text-left">Estado</th>
            <td class="text-left" style="font-size:10px;"><strong><%if a.estado.to_s == 'CONSOLIDADO' %><small class="text-red"><%= a.estado rescue nil%></small><%else %><small class="text-blue"><%= a.estado rescue nil%></small><%end %></strong></td>
          </tr>
        </table>
          <table class="table table-bordered table-condensed table-striped">
            <tr class="thcolor">
              <th width="35%" class="text-left">Empleado</th>
              <th class="text-left">AlegraId</th>
              <th class="text-left">Status Alegra</th>
              <th class="text-left">Status Dian</th>
            </tr>
            <% @contratospernominas.each do |b| %>
              <tr>
                <td class="text-left" style="font-size:11px;"><%=b.autobuscar %></td>
                <td class="text-left" style="font-size:11px;"><%=b.alegra_id %></td>
                <td class="text-left" style="font-size:11px;"><%=b.legalstatus_alegra %></td>
                <td class="text-left" style="font-size:11px;"><%=b.governmentresponse_message %></td>
              </tr>
            <% end %>
          </table>
        <% end %>
      </div>
    </div>
  </div>
</div>




