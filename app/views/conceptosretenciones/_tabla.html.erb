<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
	  <thead class="thcolor">
      <tr>
        <td width="10%"></td>
        <th>Retencion</th>
      </tr>
    </thead>
	  <tbody id="tbody_conceptosretenciones">
	    <% @concepto.conceptosretenciones.includes([:tipospretencion]).order(id: :desc).each do |conceptosretencion| %>
	      <%= render 'conceptosretenciones/tr', conceptosretencion: conceptosretencion %>
	    <% end %>
	  </tbody>
	</table>
</div>