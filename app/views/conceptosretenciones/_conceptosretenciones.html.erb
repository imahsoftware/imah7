<div class="box box-danger">
  <div class="box-header">
    <h3 class="box-title"><strong>Retenciones Asociadas</strong></h3>
    <div class="box-tools pull-right">
        <%= link_to new_concepto_conceptosretencion_path(@concepto), id: 'new_conceptosretencion_button', class: 'btn btn-sm btn-success', remote: true do %>
          <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
        <% end %>
    </div>
  </div>
  <div class="box-body">
    <div class="flash_messages"></div>
    <div id="conceptosretencion_form" class="collapse"></div>
    <div id="conceptosretenciones">
      <% if @concepto.conceptosretenciones.present? %>
        <%= render 'conceptosretenciones/tabla' %>
      <% else %>
        <div class="alert alert-warning"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
      <% end %>
    </div>
  </div>
</div>

