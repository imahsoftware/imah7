<%= simple_form_for(@empresa) do |f| %>
  <div class="box box-danger">
    <div class="box-header">
      <legend>
          <%= link_to empresas_path, data: {toggle: 'tooltip'}, title: 'Regresar' do %>
            <i class="fa fa-arrow-left fa-fw text-success" aria-hidden="true"></i>
          <% end %>
        Información Básica Empresa
      </legend>
    </div>
    <div class="box-body">
      <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
          <%= f.input :tiposdocumento_id, collection: Tiposdocumento.order(:descripcion).collect {|p| [ p.descripcion, p.id ] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: 'Tipo de documento'%>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
          <%= f.input :identificacion, input_html: {:onchange => "javascript:this.value=this.value.toUpperCase();"}, label: 'Identificación' %>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-1 col-lg-1">
          <%= f.input :digito, input_html: {:onchange => "javascript:this.value=this.value.toUpperCase();"}, label: 'Digito' %>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7">
          <%= f.input :nombre, :input_html => {:onChange => "javascript:this.value=this.value.toUpperCase();",maxlength: "49"}, label: 'Nombre o Razon Social' %>
        </div>
      </div>
      <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
          <%= f.input :logo, as: :select, collection: select_logo, input_html: { class: 'select2' }, label: "Logo"%>
        </div>
      </div>
    </div>
    <% if is_auth_a('empresa') %>
      <div class="box-footer">
        <div class="box-tools pull-right">
          <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
        </div><!-- /.box-tools -->
      </div>
    <% end %>
  </div>
<% end %>
