<div class="box ">
  <div class="box-header with-border">
    <div class="row">
      <div class="col-md-11">
        <legend>Empresas - Buscador</legend>
      </div>
      <div class="col-md-1">
        <% if is_auth_c('empresa') %>
          <%= link_to new_empresa_path, data: {toggle: 'tooltip'}, title: 'Crear Empresa' do %>
            <button class="btn btn-info"><strong>Nuevo</strong></button>
          <% end %>
        <% end %>
      </div>
    </div>
  </div><!-- /.box-header -->
  <%= form_tag request.path, method: :get, class: 'form-inline' do %>
    <div class="box-body">
      <div class="form-group">
        <%= label_tag :identificacion, 'Identificación' %><br/>
        <%= text_field_tag :identificacion, params[:identificacion], class: 'form-control', style:'width:150px;', autocomplete: 'off' %>
      </div>
      <div class="form-group">
        <%= label_tag :nombre, 'Nombre' %><br/>
        <%= text_field_tag :nombre, params[:nombre], class: 'form-control', style:'width:240px;', autocomplete: 'off' %>
      </div>
      <div class="form-group">
        <%= button_tag type: 'submit', class: 'btn btn-primary', style: 'margin-top: 24px;', data: { toggle: 'tooltip' }, title: 'Buscar' do %>
          <i class="fa fa-search" aria-hidden="true"></i>
        <% end %>
      </div>
    </div>
  <% end %>
  <div class="box-header with-border">
    <% if @empresas.count.to_i > 0 %>
      <div class="box-body">
        <div class="box-header with-border">
          <legend>Empresas (<%=@empresas.count rescue 0%>) </legend>
        </div><!-- /.box-header -->
        <div class="table-responsive">
          <table class="table table-hover table-bordered">
            <thead>
            <tr class="thcolor">
              <th width="10%"></th>
              <th class="text-left">Identificación - Nombres</th>
            </tr>
            </thead>
            <tbody>
            <% @empresas.order(created_at: :desc).each do |empresa|
              @contratos = empresa.contratos.order("fecha_inicio desc")
            %>
              <tr id="empresa_<%= empresa.id %>">
                <td class="text-center">
                  <%= link_to edit_empresa_path(empresa, etapa: 'A'), class: 'edit_empresa_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
                    <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
                  <% end %>
                </td>
                <td><%= empresa.identnombre rescue nil %>
                  <% if @contratos.exists? %><br/><br/>
                        <div class="table-responsive">
                          <table class="table table-bordered table-condensed table-striped">
                            <thead>
                            <tr class="thcolor">
                              <th width="5%" class="text-center" style="font-size:10px;"></th>
                              <th width="15%" class="text-center" style="font-size:10px;">Nro Contrato</th>
                              <th class="text-justify" style="font-size:10px;">Objeto</th>
                            </tr>
                            </thead>
                            <tbody id="tbody">
                            <% @contratos.each do |p| %>
                              <tr>
                                <td class="text-center" style="font-size:12px;">
                                  <%= link_to edit_contrato_path(id: p.id, etapa: 'A'), class: 'edit_contrato_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
                                    <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
                                  <% end %>
                                </td>
                                <td class="text-center" style="font-size:12px;"><%= p.nro_contrato rescue nil%></td>
                                <td class="text-justify" style="font-size:10px;"><%= p.objeto.upcase rescue nil%>
                                  <br/><strong>Tipo de Contrato: <%= p.tiposcontrato.descripcion rescue nil%></strong>
                                  <br/><strong>Fecha Inicio: </strong><%= p.fecha_inicio.strftime("%Y-%m-%d") rescue nil%>
                                </td>
                              </tr>
                            <% end %>
                            </tbody>
                          </table>
                        </div>
                  <% end %>

                </td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>
        <div class="box-tools pull-right">
          <%= will_paginate @empresas, :previous_label => '&laquo; Anterior', :next_label => 'Siguiente &raquo;', renderer: BootstrapPagination::Rails  %>
        </div><!-- /.box-tools -->
      </div>
    <% else %>
      <div class="alert alert-danger">
        <h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %></div>
      </div>
    <% end %>
    </div>
</div>
