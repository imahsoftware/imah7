<div class="box-body">
  <legend>Información Contratos </legend>
  <% if @contratos.exists? %>
    <div class="row">
      <div class="col-md-12">
        <div class="table-responsive">
          <table class="table table-bordered table-condensed table-striped">
            <thead>
            <tr class="thcolor">
              <th width="10%" class="text-center"></th>
              <th width="10%" class="text-center">Nro Contrato</th>
              <th width="60%" class="text-justify" style="font-size:12px;">Objeto</th>
              <th width="10%" class="text-center">Fecha Inicio</th>
              <th width="10%" class="text-center">Fecha Fin</th>
            </tr>
            </thead>
            <tbody id="tbody">
            <% @contratos.each do |p| %>
              <tr>
                <td class="text-center" style="font-size:12px;">
                  <%= link_to edit_contrato_path(p), class: 'edit_contrato_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
                    <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
                  <% end %>
                </td>
                <td class="text-center" style="font-size:12px;"><%= p.nro_contrato rescue nil%></td>
                <td class="text-justify" style="font-size:12px;"><%= p.objeto.upcase rescue nil%><br/>
                  <br/><strong>Tipo de Contrato: <%= p.tiposcontrato.descripcion rescue nil%></strong>
                  <br/><strong>Municipio: </strong><%= p.municipio.autobuscar rescue nil%>
                  <br/><strong>Dirección: </strong><%= p.direccion rescue nil%>
                  <br/><strong>Estado: </strong><%= p.estado rescue nil%>
                </td>
                <td class="text-center" style="font-size:12px;"><%= p.fecha_inicio.strftime("%Y-%m-%d") rescue nil%></td>
                <td class="text-center" style="font-size:12px;"><%= p.fecha_fin.strftime("%Y-%m-%d") rescue nil%></td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% else %>
    <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
  <% end %>
</div>