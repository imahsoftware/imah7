<%
  @eproveedorescompra = Eproveedorescompra.find(params[:id])
  @logo = @eproveedorescompra.portafolio.logoportafolio.to_s
%>
<div align="center">
  <table width="100%" border="0">
    <tr>
      <td width="30%" style="font-size: 12px; font-family: Tahoma; line-height:150%">
        <div align="center">
          <%= wicked_pdf_image_tag "#{image_url(@logo)}", size: "280x120" %><br/>Nit: 811044253-8
        </div>
      </td>
      <td style="font-size: 14px; font-family: Tahoma; line-height:150%">
        <div align="center">
          <strong><div style="font-size: 22px; font-family: Tahoma;"><%=@eproveedorescompra.portafolio.razon_social rescue nil %></div></strong>
          <%=@eproveedorescompra.portafolio.direccion rescue nil %> MEDELLÍN<br/>
          Tel: (604) <%=@eproveedorescompra.portafolio.telefono_empresa rescue nil %> Ext 101<br/>
          Email: asearesp@gmail.com
        </div>
      </td>
      <td width="15%" style="font-size: 14px; font-family: Tahoma; line-height:150%">
        <table width="100%" border="1" cellspacing="2" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 16px; font-family: Tahoma;">
          <tr>
            <th height="70" style="font-size: 16px; font-family: Tahoma;">Nro.<br/><strong>DS-<%= @eproveedorescompra.nro_adquisicion rescue nil%></strong></th>
          </tr>
        </table>
      </td>
    </tr>
  </table>
  <br/>
  <div style="font-size: 15px; font-family: Tahoma;"><strong>------ DOCUMENTO SOPORTE EN ADQUISICIONES EFECTUADAS A NO OBLIGADOS A FACTURAR ------</strong></div>
  <div style="font-size: 10px; font-family: Tahoma;">Numeral 5 artículo 1.6.1.4.12 del decreto 1625 del 2016 único reglamentario en materia tributaria, sustituido por el decreto 358 del 2020, resol.0042 de 05/05/2020</div>
  <br/>
  <table width="100%" border="0" cellspacing="0" cellpadding="0">
    <tr>
      <td>
        <table width="100%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
          <tr>
            <td width="30%" height="25" style="background: #E8E3E3; font-size: 10px; font-family: Tahoma;">&nbsp;<strong>CLIENTE : </strong></td>
            <td width="70%" style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma;">&nbsp;<%=@eproveedorescompra.eproveedor.nombre rescue nil%></td>
          </tr>
          <tr>
            <td height="25" style="background: #E8E3E3; font-size: 10px; font-family: Tahoma;">&nbsp;<strong>NIT : </strong></td>
            <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma;">&nbsp;<%=@eproveedorescompra.eproveedor.identificacion rescue nil%><% if @eproveedorescompra.eproveedor.digito.to_i > 0 %>-<%=@eproveedorescompra.eproveedor.digito rescue nil%><% end %></td>
          </tr>
          <tr>
            <td height="25" style="background: #E8E3E3; font-size: 10px; font-family: Tahoma;">&nbsp;<strong>DIRECCION : </strong></td>
            <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma;">&nbsp;<%=@eproveedorescompra.eproveedor.direccion rescue nil%></td>
          </tr>
          <tr>
            <td height="25" style="background: #E8E3E3; font-size: 10px; font-family: Tahoma;">&nbsp;<strong>TELEFONO : </strong></td>
            <td style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma;">&nbsp;<%=@eproveedorescompra.eproveedor.telefono rescue nil%> - <%=@eproveedorescompra.eproveedor.celular rescue nil%> </td>
          </tr>
        </table>
      </td>
      <td width="5%" style="font-size: 14px; font-family: Tahoma; line-height:150%">&nbsp;</td>
      <td width="25%" style="font-size: 14px; font-family: Tahoma; line-height:150%">
        <table width="100%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
          <tr>
            <th width="50%" height="25" style="background: #E8E3E3; font-size: 10px; font-family: Tahoma;">&nbsp;<strong>FECHA : </strong></th>
            <th width="50%" style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma;">&nbsp;<%=@eproveedorescompra.fecha.strftime("%Y-%m-%d") rescue nil%></th>
          </tr>
          <tr>
            <th height="25" style="background: #E8E3E3; font-size: 10px; font-family: Tahoma;">&nbsp;<strong>VENCE : </strong></th>
            <th style="border:1px solid #CCCCCC;font-size: 10px; font-family: Tahoma;">&nbsp;<%=@eproveedorescompra.fecha_vence.strftime("%Y-%m-%d") rescue nil%></th>
          </tr>
        </table>
      </td>
    </tr>
  </table>
  <br/>
  <table width="100%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
    <thead>
      <tr>
        <th colspan="2" height="25" width="10%" class="text-center" style="background: #E8E3E3;font-size:10px;">Observaciones</th>
        <td colspan="4" class="text-left" style="font-size:10px;"><%=@eproveedorescompra.observacion %></td>
      </tr>
      <tr>
        <th height="25" width="10%" class="text-center" style="background: #E8E3E3;font-size:10px;">Fecha</th>
        <th width="10%" class="text-center" style="background: #E8E3E3;font-size:10px;">Nro factura</th>
        <th class="text-right" style="background: #E8E3E3;font-size:10px;">Valor</th>
        <th class="text-right" style="background: #E8E3E3;font-size:10px;">Iva</th>
        <th class="text-right" style="background: #E8E3E3;font-size:10px;">Retencion</th>
        <th width="15%" class="text-right" style="background: #E8E3E3;font-size:10px;">Total</th>
      </tr>
    </thead>
    <tr>
      <td rowspan="2" height="25" align="center" style="font-size:11px;"><%= @eproveedorescompra.fecha %></td>
      <td height="25" align="center" style="font-size:11px;"><%= @eproveedorescompra.nro_factura %></td>
      <td align="right" style="font-size:10px;"><%= camponumerico @eproveedorescompra.valor %></td>
      <td align="right" style="font-size:10px;"><%= camponumerico @eproveedorescompra.valor_iva %></td>
      <td align="right" style="font-size:10px;"><%= camponumerico @eproveedorescompra.valor_retencion %></td>
      <td rowspan="2" align="right" style="font-size:10px;"><%= camponumerico @eproveedorescompra.total %></td>
    </tr>
    <tr>
      <th colspan="4" class="text-left" style="font-size:10px;"><br/>
        <% if Eproveedorescompretencion.where(eproveedorescompra_id: @eproveedorescompra.id).exists? %>
          <div align="center">
            <table width="98%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
              <tr>
                <th colspan="3" width="18%" class="text-center" style="font-size: 9px; font-family: Verdana, Geneva, sans-serif; background: #E8E3E3;">Detalle de retenciones</th>
              </tr>
              <tr>
                <td width="22%" class="text-left" style="font-size: 9px; font-family: Verdana, Geneva, sans-serif; background: #E8E3E3;"><strong>Concepto</strong></td>
                <td class="text-left" style="font-size: 9px; font-family: Verdana, Geneva, sans-serif; background: #E8E3E3;"><strong>Retencion</strong></td>
                <td width="12%" class="text-right" style="font-size: 9px; font-family: Verdana, Geneva, sans-serif; background: #E8E3E3;"><strong>Valor</strong></td>
              </tr>
              <% Eproveedorescompretencion.includes([:tipospretencion,:concepto]).where(eproveedorescompra_id: @eproveedorescompra.id).each do |a| %>
                <tr>
                  <td align="left" style="font-size:8px;"><%= a.concepto.descripcion rescue nil %></td>
                  <td align="left" style="font-size:8px;"><%= a.tipospretencion.descripcion rescue nil %> - (<%= a.tipospretencion.porcentaje rescue nil %>%)</td>
                  <td align="right" style="font-size:8px;"><%= camponumerico a.valor %></td>
                </tr>
              <% end %>
            </table>
            <br/>
          </div>
        <% end %>
      </th>
    </tr>
  </table>
  <div align="left" style="font-size: 10px; font-family: Tahoma;"><%=@eproveedorescompra.portafolio.resol_regimensimpli.to_s rescue nil%></div>
</div>

