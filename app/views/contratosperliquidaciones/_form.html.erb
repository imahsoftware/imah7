<%= simple_form_for(@contratosperliquidacion) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.association :contratosperfecha %>
    <%= f.input :autobuscar %>
    <%= f.input :salario_mes %>
    <%= f.input :auxilio %>
    <%= f.input :subtotal %>
    <%= f.input :dias %>
    <%= f.input :cesantias %>
    <%= f.input :int_cesantias %>
    <%= f.input :vacaciones %>
    <%= f.input :prima %>
    <%= f.input :novedades %>
    <%= f.input :total %>
    <%= f.input :estado %>
    <%= f.input :liquidacionimagen %>
  </div>

  <div class="form-actions">
    <%= f.button :submit %>
  </div>
<% end %>
