<div class="modal-header">
  <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
  <h4 class="modal-title">Insumo
    <br/>
    <small><%= @insumo.bien_servicio rescue nil %></small></h4>
</div>

<div class="modal-body">
  <div class="row">
    <div class="col-md-12">
      <table class="table table-bordered table-condensed table-striped">
        <thead class="thcolor">
        <tr>
          <th width="20%" class="text-left text-table">Fecha</th>
          <th width="28%" class="text-left text-table">Marca</th>
          <th width="30%" class="text-left text-table">Referencia</th>
          <th width="12%" class="text-center text-table">Estado</th>
        </tr>
        </thead>
        <tbody id="tbody_insumosfichas">
        <% @insumo.insumosfichas.where("estado = 'ACTIVO'").order(id: :desc).each do |insumosficha| %>
          <tr id="insumosficha_<%= insumosficha.id %>">
            <td align="left" class="text-table"><%= insumosficha.created_at.strftime("%Y-%m-%d %X") rescue nil %>
              <br/><small><%= insumosficha.user.nombre rescue nil %></small></td>
            <td align="left" class="text-table"><%= insumosficha.marca rescue nil %>
              <% if insumosficha.docficha_file_name.present? %><br/>
                <%= link_to insumosficha.docficha.url(:original, false), data: { toggle: 'tooltip' }, title: "Ver Documento", onclick: 'window.open(this.href,"new_window","height=450,width=600,scrollbars=yes");return false;' do %>
                  <%= insumosficha.docficha_file_name rescue nil %>
                <% end %>
              <% end %>
            </td>
            <td align="left" class="text-table"><%= insumosficha.referencia rescue nil %></td>
            <td align="center" class="text-table"><%= insumosficha.estado rescue nil %></td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>