<tr id="contratosperexamen_<%= contratosperexamen.id %>">
  <td class="text-center">
    <%# if is_auth_e("contratosperexamen")%>
    <%= link_to edit_contratospersona_contratosperexamen_path(@contratospersona, contratosperexamen), remote: true, class: 'edit_contratosmodificacion_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
      <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
    <% end %>
    <% if is_auth_e("contratosperexamen")%>
      <%= link_to contratospersona_contratosperexamen_path(@contratospersona, contratosperexamen), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
         <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
      <% end %>
    <% end %>
    <button class="btn btn-xs btn-info"><span data-toggle="tooltip" data-html="true" data-original-title="<div align='left'><%= contratosperexamen.user_nombre.html_safe rescue nil %><%= contratosperexamen.user_actnombre.html_safe rescue nil %></div>"><i class="fa fa-user" aria-hidden="true"></i></span></button>
  </td>
  <td align="left"><%= contratosperexamen.descripcion rescue nil %></td>
  <td align="left"><%= contratosperexamen.direccion rescue nil %>
  <br/><small><strong>Nota: <%= contratosperexamen.observacion_llamada rescue nil %></strong></small>
  </td>
  <td align="center"><%= contratosperexamen.fecha rescue nil %>-<%= contratosperexamen.hora rescue nil %><br/>
    <strong><%= contratosperexamen.estado rescue nil %></strong></td>
</tr>
