<div class="box-header">
  <h3 class="box-title"><strong>Grupos</strong></h3>
  <div class="box-tools pull-right">
    <% if is_auth_c('contratosgrupo') %>
      <%= link_to new_contrato_contratosgrupo_path(@contrato), id: 'new_contratosgrupo_button', class: 'btn btn-sm btn-warning', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
      <% end %>
    <% end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="contratosgrupo_form" class="collapse"></div>
  <div id="contratosgrupos">
    <% if @contrato.contratosgrupos.present? %>
      <%= render 'contratosgrupos/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
    <% end %>
  </div>
</div>
