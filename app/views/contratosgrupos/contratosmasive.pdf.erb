%>
  <style type="text/css">H1.SaltoDePagina { PAGE-BREAK-AFTER: always}</style>
  <% if @contratosperfecha.tipo_contrato.to_s == 'OBRA O LABOR' or @contratosperfecha.tipo_contrato.to_s == 'OBRA O LABOR - GOBERNACION' %>
    <table width="100%">
      <tr>
        <td>
          <table width="100%" border="0">
            <tr>
              <td style="font-size: 14px; font-family: Tahoma; line-height:150%">
                <div align="center">
                  <strong><div style="font-size: 18px; font-family: Tahoma;">CONTRATO INDIVIDUAL DE TRABAJO POR OBRA O LABOR DETERMINADA</div></strong>
                </div>
              </td>
              <td width="30%">
                <div align="center">
                  <%= wicked_pdf_image_tag "#{image_url(@logo)}", size: "280x120" %>
                </div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
      <tr>
        <td>
          <table width="100%" border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border:1px solid #CCCCCC; font-size: 12px; font-family: Verdana, Geneva, sans-serif;">
            <tr>
              <td width="40%" height="25" style="background: #E8E3E3;"><strong>NOMBRE DEL EMPLEADOR : </strong></td>
              <td>&nbsp;<%=portafolio.razon_social rescue nil %></td>
            </tr>
            <tr>
              <td height="25" style="background: #E8E3E3;"><strong>DOMICILIO DEL EMPLEADOR: </strong></td>
              <td>&nbsp;<%=portafolio.direccion rescue nil %>, MEDELLIN - ANTIOQUIA</td>
            </tr>
            <tr>
              <td height="25" style="background: #E8E3E3;"><strong>IDENTIFICACION DEL EMPLEADOR: </strong></td>
              <td>&nbsp;<%=portafolio.identificacion rescue nil %>-<%=portafolio.digito rescue nil %></td>
            </tr>
            <tr>
              <td height="25" style="background: #E8E3E3;"><strong>NOMBRE DEL TRABAJADOR: </strong></td>
              <td>&nbsp;<%=contratospersona.nombre_completo rescue nil%></td>
            </tr>
            <tr>
              <td height="25" style="background: #E8E3E3;"><strong>DIRECCION DEL TRABAJADOR: </strong></td>
              <td>&nbsp;<%=contratospersona.direccion rescue nil%></td>
            </tr>
            <tr>
              <td height="25" style="background: #E8E3E3;"><strong>CORREO ELECTRONICO TRABAJADOR: </strong></td>
              <td>&nbsp;<%=contratospersona.correo rescue nil%></td>
            </tr>
            <tr>
              <td height="25" style="background: #E8E3E3;"><strong>IDENTIFICACION DEL TRABAJADOR: </strong></td>
              <td>&nbsp;<%=camponumerico2(contratospersona.identificacion) rescue nil%></td>
            </tr>
            <tr>
              <td height="25" style="background: #E8E3E3;"><strong>CARGO: </strong></td>
              <td>&nbsp;<%=@contratosperfecha.contratoscargo.perfil rescue nil%></td>
            </tr>
            <tr>
              <td height="25" style="background: #E8E3E3;"><strong>SALARIO: </strong></td>
              <td>&nbsp;<%=camponumerico(@contratosperfecha.contratoscargo.salario) rescue nil%></td>
            </tr>
            <tr>
              <td height="25" style="background: #E8E3E3;"><strong>FRECUENCIA: </strong></td>
              <td>&nbsp;<%=@contratosperfecha.contratosgrupo.termino rescue nil%></td>
            </tr>
            <tr>
              <td height="25" style="background: #E8E3E3;"><strong>FECHA INICIO DEL CONTRATO: </strong></td>
