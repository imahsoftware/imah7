<%
  isadmin = is_admin
  # 2021-10-02 FFA - Este codigo es exactamente el que esta en contratosperfechas/contrato.pdf...
  @contratosperfechas.includes([:contratoscargo,:contratospersona,:contrato,:contratosgrupo]).each do |pf|
    @contratosperfecha = pf
    #@logo = pf.contrato.empresa.logo.to_s
    contratospersona = pf.contratospersona
    portafolio = Portafolio.find(pf.contrato.empresa.portafolio_id)
