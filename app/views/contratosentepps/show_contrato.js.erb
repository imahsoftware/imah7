<% if @ruta == 'ABRIR' %>
$("#abrir_detalle_contrato<%= @contrato.id %>").html('<%= j render "contratosentepps/show_contrato" %>');
$("#abrir_contrato<%= @contrato.id %>").addClass("hide");
$("#cerrar_contrato<%= @contrato.id %>").removeClass("hide");
$("#tr_show_contrato<%= @contrato.id %>").removeClass("hidden");
<% else %>
$("#abrir_contrato<%= @contrato.id %>").removeClass("hide");
$("#cerrar_contrato<%= @contrato.id %>").addClass("hide");
$("#abrir_detalle_contrato<%= @contrato.id %>").html(null);
$("#tr_show_contrato<%= @contrato.id %>").addClass("hidden");
<% end %>
$(function(){
    $('.pagination a').attr('data-remote', 'true')
});