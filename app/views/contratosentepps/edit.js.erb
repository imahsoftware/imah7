$("#contratosentepp_form").collapse("hide");

$("#contratosentepp_form").empty();

<% if @active_record.present? %>
	$("#contratosentepp_<%= @active_record.id %>").replaceWith("<%= j render 'tr', contratosentepp: @active_record %>");
<% end %>

$("#contratosentepp_<%= @contratosentepp.id %>").html("<td colspan='7'><%= j render 'form' %></td>");

$("#contratosentepp_<%= @contratosentepp.id %>").addClass("active_contratosentepp");

$(".select2").select2();

$(".tooltip").tooltip("hide");

$('[data-toggle="tooltip"]').tooltip();
$(".datetimepicker").datetimepicker({
	showClear: true
});


$(function() {
	return $('.select2User').select2({
		minimumInputLength: 3,
		maximumInputLength: 20,
		placeholder: "[ Seleccionar Usuario... ]",
		ajax: {
			url: '/menus/searchUser.json',
			dataType: 'json',
			delay: 250,
			data: function(params) {
				return {
					q: params.term,
					page: params.page
				};
			},
			processResults: function(data) {
				return {
					results: $.map(data, function(item) {
						return {
							text: item.name,
							id: item.id
						};
					})
				};
			}
		}
	});
});
