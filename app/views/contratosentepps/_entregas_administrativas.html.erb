<div class="row">
  <div class="col-xs-12">
    <div class="nav-tabs-custom">
      <ul class="nav nav-tabs">
        <li class="<%= @etapaa == 'A' ? 'active' : '' %>">
          <%= link_to procesos_contratossolepps_path(etapa: etapa, etapaa: 'A') do %>
            <i class="fa fa-calendar"></i>&nbsp;Por Días
          <% end %>
        </li>
        <li class="<%= @etapaa == 'B' ? 'active' : '' %>">
          <%= link_to procesos_contratossolepps_path(etapa: etapa, etapaa: 'B') do %>
            <i class="fa fa-users"></i>&nbsp;Por Supervisor
          <% end %>
        </li>
        <li class="<%= @etapaa == 'C' ? 'active' : '' %>">
          <%= link_to procesos_contratossolepps_path(etapa: etapa, etapaa: 'C') do %>
            <i class="fa fa-area-chart"></i>&nbsp;Dashboard
          <% end %>
        </li>
      </ul>
      <div class="tab-content">
        <% if @etapaa == 'A' %>
          <table class="table table-bordered table-condensed table-striped">
            <thead>
            <tr class="thcolor">
              <th class="text-left">Fecha</th>
            </tr>
            </thead>
            <tbody>
            <% Contratosentepp.select("DISTINCT DATE_FORMAT(created_at, '%Y-%m-%d') AS fecha_data")
                              .where(estado: 'FINALIZADO')
                              .order("DATE_FORMAT(created_at, '%Y-%m-%d') ASC").each do |fecha|
            %>
              <tr>
                <td>
                  <div id="abrir_epps<%= fecha.fecha_data.gsub('-', '_') %>" class="pull-left">
                    <%= link_to show_detalle_epps_contratosentepps_path(fecha: fecha.fecha_data, ruta: 'ABRIR'), remote: true do %>
                      <i class="fa fa-arrow-circle-down" data-toggle="tooltip" style="color:green;" data-original-title="Pulsa aquí para Ver el Día"></i>
                      <% if fecha.fecha_data == Time.now.strftime('%Y-%m-%d') %>
                        <i class="text-red fa fa-star"></i> <%= fecha.fecha_data %>
                      <% else %>
                        <%= fecha.fecha_data %>
                      <% end %>
                    <% end %>
                  </div>
                  <div id="cerrar_epps<%= fecha.fecha_data.gsub('-', '_') %>" class="pull-left hide">
                    <%= link_to show_detalle_epps_contratosentepps_path(fecha: fecha.fecha_data, ruta: 'CERRAR'), remote: true do %>
                      <i class="fa fa-arrow-circle-up" data-toggle="tooltip" style="color:red;" data-original-title="Pulsa aquí para Ver el Día"></i>
                      <% if fecha.fecha_data == Time.now.strftime('%Y-%m-%d') %>
                        <i class="text-red fa fa-star"></i> <%= fecha.fecha_data %>
                      <% else %>
                        <%= fecha.fecha_data %>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
              <tr id="tr_show_epps<%= fecha.fecha_data.gsub('-', '_') %>" class="hidden">
                <td>
                  <div id="abrir_detalle_epps<%= fecha.fecha_data.gsub('-', '_') %>" style="padding-left: 30px; padding-right: 30px;"></div>
                </td>
              </tr>
            <% end %>
            </tbody>
          </table>
        <% end %>

        <% if @etapaa == 'B' %>
          <table class="table table-bordered table-condensed table-striped">
            <thead>
            <tr class="thcolor">
              <th class="text-left">Usuario</th>
            </tr>
            </thead>
            <tbody>
            <% Contratosentepp.select('DISTINCT contratosentepps.user_id, users.nombre')
                              .joins('INNER JOIN users ON contratosentepps.user_id = users.id')
                              .where(estado: 'FINALIZADO')
                              .order('users.nombre').each do |usuario|

            %>
              <tr>
                <td>
                  <div id="abrir_usuario<%= usuario.user_id %>" class="pull-left">
                    <%= link_to show_detalle_usuario_contratosentepps_path(user_id: usuario.user_id, ruta: 'ABRIR'), remote: true do %>
                      <i class="fa fa-arrow-circle-down" data-toggle="tooltip" style="color:green;" data-original-title="Pulsa aquí para Ver el Supervidor"></i>
                      <%= usuario.nombre %>
                    <% end %>
                  </div>
                  <div id="cerrar_usuario<%= usuario.user_id %>" class="pull-left hide">
                    <%= link_to show_detalle_usuario_contratosentepps_path(user_id: usuario.user_id, ruta: 'CERRAR'), remote: true do %>
                      <i class="fa fa-arrow-circle-up" data-toggle="tooltip" style="color:red;" data-original-title="Pulsa aquí para Ver el Supervidor"></i>
                      <%= usuario.nombre %>
                    <% end %>
                  </div>
                </td>
              </tr>
              <tr id="tr_show_usuario<%= usuario.user_id %>" class="hidden">
                <td>
                  <div id="abrir_detalle_usuario<%= usuario.user_id %>" style="padding-left: 30px; padding-right: 30px;"></div>
                </td>
              </tr>
            <% end %>
            </tbody>
          </table>
        <% end %>
        <% if @etapaa == 'C' %>
          <div class="row">
            <div class="col-md-12">
              <IFRAME SRC=<%= "/contratosentepps/dash_epps?periodo=#{@annomes}" %> WIDTH="100%" HEIGHT="500" MARGINWIDTH=0 MARGINHEIGHT=0 FRAMEBORDER="NO" SCROLLING="YES" STYLE="border-width:0px;"></IFRAME>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>