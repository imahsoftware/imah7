<div class="box-header">
  <h3 class="box-title"><strong>Seguimiento</strong></h3>
  <div class="box-tools pull-right">
    <% if @contratosactnovedad.estado.to_s != 'ATENDIDO' %>
      <%= link_to new_contratosactnovedad_contratosactnovnota_path(@contratosactnovedad), id: 'new_contratosactnovnota_button', class: 'btn btn-sm btn-warning', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
      <% end %>
    <% end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="contratosactnovnota_form" class="collapse"></div>
  <div id="contratosactnovnotas">
    <% if @contratosactnovedad.contratosactnovnotas.order("created_at desc").present? %>
      <%= render 'contratosactnovnotas/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
    <% end %>
  </div>
</div>
