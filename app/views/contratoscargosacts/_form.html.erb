
<%= simple_form_for([@contratoscargo, @contratoscargosact], remote: true) do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-9 col-lg-9"><%= f.input :descripcion, as: :text,:input_html => {:onchange => "javascript:this.value=this.value.toUpperCase();", :rows => 2 }, label: "Actividad" %></div>
      <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :estado, as: :select, collection: select_estado, input_html: { class: 'select2' } %></div>
    </div>
    <div class="row">
      <div class="col-md-6">
        <% if @contratoscargosact.new_record? %>
          <%= button_tag "#{t :cancelar}", type: 'button', data: { target: '#contratoscargosact_form' }, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}", contratoscargo_contratoscargosact_path(@contratoscargo, @contratoscargosact), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
<br/>