$(".alert_flash").fadeOut(300, function() {
	$(this).remove();
});

<% if @contratoscargo.contratoscargosacts.count == 1 %>
	$("#contratoscargosacts").html("<%= j render 'tabla' %>");
<% else %>
	$("#tbody_contratoscargosacts").prepend("<%= j render 'tr', contratoscargosact: @contratoscargosact %>");
<% end %>

$(".clean").val("").trigger('change');

$("#contratoscargosact_form").collapse("hide");

$('[data-toggle="tooltip"]').tooltip();

$(".flash_messages").html("<%= j render 'layouts/flash_messages' %>");

$(".form-group").removeClass("has-error");
$(".form-group > .help-block.help-block-error").remove();

setTimeout(function() {
	$(".alert_flash").fadeOut(300, function() {
		$(this).remove();
	});
}, 5000);


