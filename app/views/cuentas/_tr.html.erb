<tr id="cuenta_<%= cuenta.id %>">
  <% if is_auth_c('cuenta') %>
  	<td class="text-center">
      <%= link_to edit_cuenta_path(cuenta), class: 'edit_cuenta_button', remote: true, data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
         <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
      <% end %>
      <%= link_to cuenta, remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
          <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
      <% end %>
    </td>
  <% end %>
  <td><%= cuenta.id %></td>
  <td><%= cuenta.descripcion %></td>
</tr>