<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
    <thead>
      <tr class="thcolor">
        <% if is_auth_c('cuenta') %>
          <th width="10%"></th>
        <% end %>
        <th width="10%">ID</th>
        <th>Descripción</th>
      </tr>
    </thead>
    <tbody id="tbody_cuentas">
      <% @cuentas.each do |cuenta| %>
        <%= render 'cuentas/tr', cuenta: cuenta %>
      <% end %>
    </tbody>
  </table>
</div>