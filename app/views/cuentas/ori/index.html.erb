<p id="notice"><%= notice %></p>

<h1>Cuentas</h1>

<table>
  <thead>
    <tr>
      <th>Codigo</th>
      <th>Descripcion</th>
      <th>Tipo</th>
      <th>Nro</th>
      <th>Estado</th>
      <th>User</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @cuentas.each do |cuenta| %>
      <tr>
        <td><%= cuenta.codigo %></td>
        <td><%= cuenta.descripcion %></td>
        <td><%= cuenta.tipo %></td>
        <td><%= cuenta.nro %></td>
        <td><%= cuenta.estado %></td>
        <td><%= cuenta.user %></td>
        <td><%= link_to 'Show', cuenta %></td>
        <td><%= link_to 'Edit', edit_cuenta_path(cuenta) %></td>
        <td><%= link_to 'Destroy', cuenta, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Cuenta', new_cuenta_path %>
