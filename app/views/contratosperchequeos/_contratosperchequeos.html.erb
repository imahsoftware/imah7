<div class="box-header">
  <h3 class="box-title"><strong>Chequeos</strong></h3>
  <div class="box-tools pull-right">
    <%# if is_auth_c('contratosperchequeo') %>
      <%= link_to new_contratospersona_contratosperchequeo_path(@contratospersona), id: 'new_contratosperchequeo_button', class: 'btn btn-sm btn-warning', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
      <% end %>
    <%# end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="contratosperchequeo_form" class="collapse"></div>
  <div id="contratosperchequeos">
    <% if @contratospersona.contratosperchequeos.present? %>
      <%= render 'contratosperchequeos/tabla' %>
    <% else %>
      <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
    <% end %>
  </div>
</div>
