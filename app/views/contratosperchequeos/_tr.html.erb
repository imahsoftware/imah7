<tr id="contratosperchequeo_<%= contratosperchequeo.id %>">
  <td class="text-center">
    <%# if is_auth_e("contratosperchequeo")%>
    <%= link_to edit_contratospersona_contratosperchequeo_path(@contratospersona, contratosperchequeo), remote: true, class: 'edit_contratosmodificacion_button', data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
      <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
    <% end %>
      <%= link_to contratospersona_contratosperchequeo_path(@contratospersona, contratosperchequeo), remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
         <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
      <% end %>
    <%# end %>
    <button class="btn btn-xs btn-info"><span data-toggle="tooltip" data-html="true" data-original-title="<div align='left'><%= contratosperchequeo.user_nombre.html_safe rescue nil %><%= contratosperchequeo.user_actnombre.html_safe rescue nil %></div>"><i class="fa fa-user" aria-hidden="true"></i></span></button>
  </td>
  <td align="left"><%= contratosperchequeo.fecha rescue nil %></td>
  <td align="left"><%= contratosperchequeo.nombre_obra rescue nil %></td>
  <td align="left"><%= contratosperchequeo.nombre_empresa rescue nil %></td>
</tr>