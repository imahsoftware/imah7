$("#centro_form").collapse("hide");

$("#centro_form").empty();

<% if @active_record.present? %>
	$("#centro_<%= @active_record.id %>").replaceWith("<%= j render 'tr', centro: @active_record %>");
<% end %>

$("#centro_<%= @centro.id %>").html("<td colspan='7'><%= j render 'form' %></td>");

$("#centro_<%= @centro.id %>").addClass("active_centro");

$(".select2").select2();

$(".tooltip").tooltip("hide");

$('[data-toggle="tooltip"]').tooltip();
